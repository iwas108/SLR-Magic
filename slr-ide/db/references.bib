@inproceedings{fang_data-driven_2025,
	address = {Shenyang, China},
	title = {Data-{Driven} {Intelligence} for {Distribution} {Networks}: {An} {Integrated} {Big}-{Data} and {Machine}-{Learning} {Control} {Strategy}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9711-5},
	shorttitle = {Data-{Driven} {Intelligence} for {Distribution} {Networks}},
	url = {https://ieeexplore.ieee.org/document/11379237/},
	doi = {10.1109/ICCSIE67394.2025.11379237},
	abstract = {Rapid proliferation of renewable energy, electric vehicles and 5G base-stations has transformed traditional distribution networks into stochastic, highdimensional and strongly-coupled cyber-physical systems. Central to this transformation is the demand for control strategies that can exploit the ever-increasing volume of multisource data while guaranteeing real-time responsiveness and security. In this paper we propose a holistic big-data \& machine-learning (BDML) control framework that fuses cloud-scale analytics with edge intelligence to realize self-healing, optimal and secure operation of active distribution networks. First, a lambda architecture based data pipeline is designed to ingest 1.3 billion measurement tuples per day from AMI, µPMUs and IoT sensors with sub-second latency. Second, a two-stage control strategy is presented: offline, a graph-enhanced Transformer learns a stochastic policy from 5 years of historical and synthetic scenarios; online, a light-weight deep-reinforcement-learning (DRL) agent fine-tunes the policy every 100 ms by interacting with a digital-twin network. Third, safety is enforced through a differentiable chance-constraint layer that embeds N-1 security and voltage limits into the policy gradient. The proposed strategy is benchmarked on the IEEE 123-/8500-node test feeders augmented with real load/generation profiles from the Smart-Grid Ireland project. Results demonstrate 37 \% reduction in active power losses, 0.42 \% improvement in voltage regulation index and 68 \% faster fault recovery compared with the state-of-the-art model predictive controller. More importantly, the BDML controller exhibits linear scalability up to 104 nodes and generalizes to unseen topologies without retraining, paving the way toward plugand-play autonomy of future distribution grids.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {Third} {International} {Conference} on {Cyber}-{Energy} {Systems} and {Intelligent} {Energy} ({ICCSIE})},
