	pages = {267--285},
	file = {Wang_2026_Physicsinformed_1b4a3:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Wang_2026_Physicsinformed_1b4a3.pdf:application/pdf},
