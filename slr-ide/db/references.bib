@article{sharma_fully_2026,
	title = {A fully online {Creep} {Digital} {Twin} for real-time deformation monitoring, prediction, and early warning in geotechnical engineering},
	volume = {199},
	issn = {0266352X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0266352X26004994},
	doi = {10.1016/j.compgeo.2026.108393},
	abstract = {Time-dependent (creep) deformation is a key factor governing the long-term response of geotechnical structures, yet its reliable monitoring and prediction remain challenging due to the need to process continuously evolving field data. Although digital twin concepts have recently been introduced in geotechnical engineering, most existing implementations rely on offline or semi-online strategies, which limits their suitability for realtime applications. This paper presents a fully online Creep Digital Twin (CDT) framework for real-time creep deformation monitoring, prediction, and early warning. The proposed CDT couples a physics-based rheological creep model with an online Bayesian state-space formulation solved using the Unscented Kalman Filter (UKF). This approach enables real-time assimilation of streaming deformation measurements and continuous updating of model parameters without the need for batch re-calibration. The numerical performance of the framework is first assessed using synthetic examples under constant loading, cyclic loading–unloading, and stepped loading conditions. Subsequently, the CDT is applied to several field-scale monitoring problems, including building foundation settlement, tunnel vault deformation, dam embankment displacement, and slope deformation. Results demonstrate that the proposed framework accurately tracks and predicts time-dependent deformation in online mode, making it suitable for real-time deployment. This study is applicable to uniaxial creep formulation.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Computers and Geotechnics},
	author = {Sharma, Atma and Zhang, Jie and Lu, Meng and Dias, Daniel},
	month = nov,
	year = {2026},
	pages = {108393},
	file = {Sharma_2026_AfullyonlineCre_6bf9c:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Sharma_2026_AfullyonlineCre_6bf9c.pdf:application/pdf},
}

@article{mohammadi_comprehensive_2026,
	title = {A comprehensive study to predict steam turbine power of a {CCPP} using data-driven models based on a holistic approach with a novel set of practical descriptive features},
	volume = {354},
	issn = {03605442},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0360544226009412},
	doi = {10.1016/j.energy.2026.140838},
	abstract = {Steam turbines (ST) are critical components in combined cycle power plants (CCPP). While recent interest has shifted toward data-driven modeling over traditional physics-based approaches, most existing models focus on the ST boundary steam conditions. This study proposes a data-driven framework that eliminates reliance on dependent ST boundary variables by introducing a novel feature engineering con0guration based on independent, practically measurable inputs, including ambient conditions and controllable setpoints. The proposed features are designed to represent the thermodynamic coupling among the gas turbine (GT), heat recovery steam generator (HRSG), air-cooled condenser (ACC), and ST. Three machine learning models—support vector regression (SVR), random forest (RF), and multilayer perceptron (MLP)—were trained and validated using one year of operational data from a 159 MW ST. A domain-informed preprocessing pipeline, incorporating physicsguided feature selection and combined univariate–multivariate outlier detection, improved prediction accuracy by up to 42\%. Under optimized models, more than 94.0\% of test samples achieved prediction errors below 2 MW using proposed feature engineering con0guration, compared to 99.6\% for the boundary-based con0guration. Average test errors were maintained below 0.8 MW for the proposed data-driven framework and 0.3 MW for boundary-based con0guration. Among the evaluated models, MLP exhibited the strongest generalization capability. Although boundary-based con0guration yields marginally higher accuracy, proposed feature engineering con0guration provides comparable performance without requiring boundary steam measurements, signi0cantly enhancing practical deployability. The proposed framework establishes a scalable foundation for ST real-time performance monitoring, predictive control, and digital twin applications in industrial CCPP operations.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Energy},
	author = {Mohammadi, Mobin and Esfahanian, Vahid},
	month = jul,
	year = {2026},
	pages = {140838},
	file = {Mohammadi_2026_Acomprehensives_8e872:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Mohammadi_2026_Acomprehensives_8e872.pdf:application/pdf},
}

@article{burnett_variational_2026,
	title = {Variational digital twins},
	volume = {24},
	issn = {26665468},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2666546826000820},
	doi = {10.1016/j.egyai.2026.100756},
	abstract = {While digital twins (DT) hold promise for providing real-time insights into complex energy assets, much of the current literature either does not offer a clear framework for information exchange between the model and the asset, lacks key features needed for real-time implementation, or gives limited attention to model uncertainty. Here, we aim to address these gaps by proposing a variational digital twin (VDT) framework that augments standard neural architectures with a single Bayesian output layer. This lightweight addition, along with a novel VDT updating algorithm, lets a twin update in seconds on commodity GPUs while producing calibrated uncertainty bounds that can inform experiment design, control algorithms, and model reliability.},
	language = {en},
	urldate = {2026-07-23},
