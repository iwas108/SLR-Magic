@inproceedings{liao_digital_2026,
	address = {Harbin, China},
	title = {Digital {Twin} {Fault} {Diagnosis} {Model} of {Industrial} {Production} {Line} {Based} on {Deep} {Learning}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-7820-6},
	url = {https://ieeexplore.ieee.org/document/11485244/},
	doi = {10.1109/ETAI68332.2026.11485244},
	abstract = {With the development of intelligent manufacturing, the complex operation of industrial production line has put forward higher requirements for the real-time and accuracy of fault diagnosis. Traditional maintenance methods lag behind, while digital twin technology provides a new way for real-time perception and simulation by building virtual mapping of physical entities. In this paper, a fault diagnosis framework based on deep integration of digital twins and deep learning is constructed. The framework first designs a four-layer digital twin system including physical layer, data processing layer, intelligent diagnosis layer and application service layer to realize the closed-loop from data to decision. The CNN-LSTM hybrid diagnosis model extracts the spatial and time-dependent features of the monitoring data through the parallel branch structure, and effectively fuses them to achieve accurate fault mode recognition. Experimental results show that the proposed hybrid model significantly outperforms the baseline models such as support vector machine, single CNN or LSTM in terms of diagnosis accuracy, precision, recall and F1 score. In addition, the model also shows the optimal stability and anti-interference ability in the robustness test of simulating different intensity noise interference. This study provides an effective and feasible solution for the realization of intelligent predictive maintenance of industrial production lines.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 5th {International} {Conference} on {Electronics} {Technology} and {Artificial} {Intelligence} ({ETAI})},
