}

@inproceedings{shashidhar_survey_2024,
	title = {A {Survey} of {Digital} twins in {Smart} {Farming} {Systems}},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001481879&doi=10.1109%2FICEI64305.2024.10912241&partnerID=40&md5=97b341e3648a3961e936f8db7a3da68e},
	doi = {10.1109/ICEI64305.2024.10912241},
	abstract = {Digital twins (DTs) have developed as a transformative technology in smart farming, facilitating real-time simulation, monitoring, and optimization of agricultural processes. This survey explores DTs' definition and their various applications in agriculture, underscoring their ability to enhance decision-making and upsurge farm productivity. It analyses the existing surveys and explains different use cases, highlighting the projects that exemplify the DT's practical integration in smart farming systems. The role of the Internet of Things (IoT) and machine learning (ML) in DT is also discussed for creating accurate and efficient DTs for precision agriculture. To identify gaps and areas for further research, a comparative analysis of these technologies is presented. This comprehensive survey intends to deliver understandings into the present state of DTs in smart farming, addressing challenges and providing directions for future development to improve agricultural practices. © 2024 IEEE.},
