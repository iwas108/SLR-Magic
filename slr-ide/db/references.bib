	file = {Samsher_2026_DigitalTwinDriv_82116:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Samsher_2026_DigitalTwinDriv_82116.pdf:application/pdf},
