@inproceedings{mohamed_network_2025,
	address = {Pisa, Italy},
	title = {Network {Data} {Based} {Transfer} {Learning} {Failure} {Prediction} {Agent} {Pre}-{Trained} {Using} {Digital} {Twin}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {978-3-903176-67-6},
	url = {https://ieeexplore.ieee.org/document/11029222/},
	doi = {10.23919/ONDM65745.2025.11029222},
	abstract = {This paper describes the use of Transfer Learning (TL) using experimental data and a Machine Learning (ML) model pre-trained with a Digital Twin (DT) for the prediction of ampliﬁer failures in optical networks. Using GNPy, an opensource framework, ampliﬁer failure conditions are simulated, creating the required training dataset for the ML model. Later, by implementing TL using optical transmission testbed network data, the model is able to capture realtime network ﬂuctuations, thereby enabling it to distinguish network parameters variations due to any incoming failures from the regular network dynamics, thus enhancing the practical applicability of the model. The model is based on the Long Short-Term Memory (LSTM) ML Technique and is shown to achieve a TL accuracy of 99\%, demonstrating the ability of the model to effectively predict failures. This method facilitates early identiﬁcation and intervention, reduces service interruptions, and improves network reliability. Leveraging TL from network data provides a scalable and datadriven solution to enhance the resilience, efﬁciency, and ongoing operation of contemporary optical communication systems.},
