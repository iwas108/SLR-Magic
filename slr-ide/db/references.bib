@inproceedings{zhang_reward-model-guided_2025,
	address = {Macau, China},
	title = {A {Reward}-{Model}-{Guided} {Parameter} {Tuning} {Framework} for {Optical} {Cable} {Manufacturing} {Optimization}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9447-3},
	url = {https://ieeexplore.ieee.org/document/11402198/},
	doi = {10.1109/BigData66926.2025.11402198},
	abstract = {Process parameter tuning is critical for optical cable extrusion, where small deviations can cause signiﬁcant losses in quality and efﬁciency. Existing optimization methods such as Bayesian optimization, genetic algorithms, or regression-based machine learning often suffer from oversimpliﬁed assumptions, blind search, or poor generalization under limited and imbalanced data. To address these issues, we propose a Reward-ModelGuided Parameter Tuning Framework (RPTF) that integrates our proposed Dual-Path Preference-Aware Residual Network (DPPR-Net) with a Correlation-Guided Genetic Algorithm (CGGA). DPPR-Net serves as a high-ﬁdelity reward model, digitaltwin-like evaluator, providing robust assessments even with smallsample data, while CG-GA leverages parameter correlations to transform blind exploration into directed search. Experiments on real-world optical cable production data show that RPTF consistently outperforms regression-based baselines, classical optimizers, and surrogate-assisted variants, achieving up to 13.9\% improvement in lean production score and 10.5\% improvement in quality score. Furthermore, our sensitivity analysis demonstrates that the framework offers a ﬂexible trade-off between the two scores, enabling adaptation to different manufacturing strategies. These results demonstrate the potential of RPTF as a generalizable, adaptable, and effective solution for data-driven industrial parameter optimization.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {IEEE} {International} {Conference} on {Big} {Data} ({BigData})},
