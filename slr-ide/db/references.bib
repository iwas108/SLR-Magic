	address = {Washington DC, DC, USA},
	title = {Event-{Driven} and {Scalable} {Digital} {Twin} {System} for {Real}-{Time} {Non}-{Destructive} {Testing} in {Industrial} {Computational} {Systems}},
	copyright = {https://doi.org/10.15223/policy-029},
