@inproceedings{kadirvel_multi-protocol_2026,
	address = {Bangkok, Thailand},
	title = {A {Multi}-{Protocol} {Digital} {Twin} {Framework} for {Intelligent} {Fault} {Diagnosis} in {Industrial} {IoT} {Using} {Hybrid} {Deep} {Learning} and {Low}-{Power} {Routing} {Techniques}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-7457-4},
	url = {https://ieeexplore.ieee.org/document/11483683/},
	doi = {10.1109/ICMLAS67792.2026.11483683},
	abstract = {This paper suggests a way to find faults in IIoT setups using digital twins. The framework's use of both hybrid deep learning models and simplified communication protocols makes things more efficient, reliable, and able to forecast when maintenance is needed. The suggested system uses a multi-layer Digital Twin to keep physical industrial assets in sync all the time. It has a real-time health score of 92 and a minimal synchronization delay of 12 ms. We can find flaws with 96\% accuracy and anticipate failures up to 18 hours in advance using hybrid CNN-LSTM and anomaly detection models. Important diagnostic indicators like vibration severity (20.21), heat index (60.09), and pressure deviation (9.83) make it possible to accurately check the condition of equipment. The framework's mix of RPL for energy-efficient routing in low-power and lossy networks, MQTT for publish-subscribe messaging, and CoAP for lightweight resource discovery makes it possible for machines to talk to each other on a large scale. In terms of experimental results, MQTT has the lowest latency (22 ms) and the highest throughput (85 msg/s). RPL, on the other hand, uses the least energy (10 mW). The model's energy optimization cuts energy use by a total of 22\%. This composite architecture makes it easier to find faults in IIoT systems, offers a predictive maintenance solution that is fast, reliable, and energy-efficient, and is perfect for real-time industrial operations.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 {International} {Conference} on {Machine} {Learning} and {Autonomous} {Systems} ({ICMLAS})},
	publisher = {IEEE},
	author = {Kadirvel, Manikandan and Lenin, Anselm W. A. and Pagunuran, Jubert R. and Katta, Madhusudhan Reddy and Krishnankutty, Jishor Erat and Arumuganainar, Rajalingam},
