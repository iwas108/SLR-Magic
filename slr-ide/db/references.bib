@article{han_online_2026,
	title = {Online dynamic parameter calibration of a physics-driven hybrid model for tool wear prediction},
	volume = {86},
	issn = {02786125},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0278612526000981},
	doi = {10.1016/j.jmsy.2026.04.012},
	abstract = {Accurate tool wear prediction is essential for maintaining machining quality and production stability in modern manufacturing systems. Physics-driven hybrid models provide physical interpretability while leveraging measurement data, yet their accuracy can degrade over long horizons when model parameters are treated as 7xed and online calibration is absent. This study presents an online dynamic parameter calibration framework within a physics-driven hybrid model for tool wear prediction. An Iterative Extended Kalman Filter (IEKF) is used to continuously estimate time-varying wear-related parameters from cutting force signals. In addition, a singlepoint recalibration is introduced that combines an anchored Bayesian-style update with a directional correction, while an adaptive weight blends the two components to suppress drift and improve long-horizon consistency. Full-lifecycle milling experiments on a titanium alloy show improved prediction accuracy and computational ef7ciency over the baseline hybrid model. Tests under a second cutting-parameter setting and alternative initialization indicate that the proposed method remains effective under the tested variations, providing a practical basis for online physics-driven tool wear prediction and digital-twin-oriented monitoring work9ows.},
