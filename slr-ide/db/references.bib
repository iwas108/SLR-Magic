@inproceedings{arlimatti_digital_2025,
	address = {Sofia, Bulgaria},
	title = {A {Digital} {Twin} {Approach} to {Assessing} {Post}-{Monsoon} {Air} {Quality} {Impacts} of {Agricultural} {Stubble} {Burning} in {Delhi}},
	copyright = {https://doi.org/10.15223/policy-029},
