@article{zhang_scientific_2026,
	title = {A scientific deep learning framework integrating process stochasticity with high-fidelity simulation for millisecond-scale melt pool prediction for {L}-{PBF} process},
	volume = {121},
	issn = {22148604},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2214860426000643},
	doi = {10.1016/j.addma.2026.105138},
	abstract = {The integration of in-situ monitoring systems in laser powder bed fusion (L-PBF) has greatly enhanced the ability to capture process stochasticity and detect abnormalities during fabrication. However, sensor and camera data are typically limited to surface observations, sparse sampling, and are often corrupted by noise and disturbances such as plumes. While high- delity simulations provide detailed insights into melt pool dynamics, their computational cost and lack of process stochasticity limit their utility for online control. In this work, we present a scienti c deep learning (SciDL) framework that combines process stochasticity with high- delity simulations to enable millisecond-scale, stochastic-aware modeling of melt pool dynamics. The framework is built on an encoder-decoder architecture with a soft-conditional attention mechanism, which learns a shared embedding space to capture stochastic variations of the process stochasticity. A stochastic simulation database is constructed by integrating a probabilistic model into experimentally calibrated melt pool simulations, allowing comprehensive sampling across the process parameter space. Once trained, the model reconstructs and forecasts full 3D melt pool elds from in-situ laser power/position signals and top-surface temperature images in about 6–8 ms, making it suitable for real-time monitoring, digital-twin implementations, and future closed-loop control. By explicitly embedding stochastic process variations into a physics-informed latent space, the framework bridges the gap between high- delity simulation and fast, in-situ-driven prediction.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Additive Manufacturing},
	author = {Zhang, Yunhao and Fu, Yao and Cheng, Lin},
	month = apr,
	year = {2026},
	pages = {105138},
	file = {Zhang_2026_Ascientificdeep_ba647:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Zhang_2026_Ascientificdeep_ba647.pdf:application/pdf},
}

@article{jiang_engineering_2026,
	title = {Engineering mechanics-aware digital twin for pipeline condition assessment},
	volume = {189},
	issn = {09265805},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0926580526003110},
	doi = {10.1016/j.autcon.2026.107070},
	abstract = {Pipeline inspection gauges are popular robots employed to inspect pipeline internal conditions. However, it has been a challenge to evaluate the mechanical performance of degraded pipelines based on inspection results. This paper presents a mechanics-aware digital twin framework that enables ef(cient assessment and prediction of the mechanical performance of degraded pipelines through automating the construction and updating of mechanical models of pipelines based on vision inspection data. The framework integrates machine learning-based computer vision, three-dimensional reconstruction, digital twinning, (nite element analysis, damage prediction, and databased decision-making. The framework was implemented into pipe testing, and a low-cost pipeline inspection robot was utilized to collect vision data. The results revealed that the presented approach provided accurate predictions of the stresses and failure risks of a degraded pipe. This capability supports a promising shift to inspection data-based proactive maintenance with the potential to reduce maintenance cost by over 50\%.},
