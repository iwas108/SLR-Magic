@article{yi_real-time_2025,
	title = {The {Real}-{Time} {Prediction} of {Cracks} and {Wrinkles} in {Sheet} {Metal} {Forming} {According} to {Changes} in {Shape} and {Position} of {Drawbeads} {Based} on a {Digital} {Twin}},
