@article{al_muttaki_demand-based_2026,
	title = {Demand-based anomaly detection algorithm in electric vehicle charging systems using machine learning and digital twin simulation},
	volume = {170},
	issn = {2352152X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2352152X2602459X},
	doi = {10.1016/j.est.2026.122795},
	abstract = {The rapid expansion of electric vehicle (EV) charging infrastructure has intensi0ed operational challenges, including idle sessions, metering faults, and demand spikes that compromise grid stability and service reliability. Existing frameworks treat demand forecasting and anomaly detection as isolated tasks, and no prior work conditions session-level anomaly scores on a supervised spatio-temporal demand model, leaving operational irregularities largely undetected. This study presents ST-DAD, a Spatio-Temporal Demand-Aware Anomaly Detection framework that uni0es both tasks by training a stacking ensemble of XGBoost, LightGBM, and Random Forest models to forecast expected session-level energy consumption, then z-score normalizing prediction residuals to produce continuous, statistically interpretable anomaly scores. Validated on 148,136 real charging sessions under a temporal holdout split and a grid-aware digital twin simulation with four injected anomaly types, ST-DAD achieved an F1-score of 0.7906 and ROC-AUC of 0.8147 on real data, outperforming all 0ve evaluated baselines, and an ROC-AUC of 0.8087 on simulated data. These results establish that demand-aware residual scoring with event-level spatio-temporal context conditioning provides a practical and interpretable foundation for data-driven operational monitoring of smart charging networks.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Journal of Energy Storage},
	author = {Al Muttaki, Md. Reshad and Afrin, Sadia and Anil, Alvi Ibn Amzad and Hasan, Shameem},
	month = aug,
