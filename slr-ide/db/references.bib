@inproceedings{shrivastava_digital_2025,
	address = {Bhubaneswar, India},
	title = {Digital {Twin} {Framework} for {Voltage} {Control} and {Power} {Quality} {Optimization} in {Single}-{Stage} {Grid}-{Connected} {Solar} {PV} {System}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-6637-1},
	url = {https://ieeexplore.ieee.org/document/11411561/},
	doi = {10.1109/ICPEE65973.2025.11411561},
	abstract = {Single-stage grid-connected photovoltaic (PV) systems face signiﬁcant challenges in maintaining voltage stability and meeting accurate power quality (PQ) standards during rapidly ﬂuctuating irradiance, load variations, and grid disturbances. This study presents a Digital Twin (DT) architecture that enables real-time voltage regulation and PQ optimization by digitally replicating the physical PV system for predictive analysis, controller tuning, and operational decision-making. The proposed framework integrates a highly accurate physical model, analytical computations, and adaptive control algorithms driven by data to minimize total harmonic distortion (THD), maintain voltage within allowable limits, and comply with IEEE 1547 and IEC 61727 standards. The DT synchronizes real-time data from voltage and current sensors to capture dynamic system behavior, allowing for pre-deployment testing of voltage regulation strategies, including classical, adaptive, and AI-assisted methods. The architecture incorporates enhanced ﬁltering and stability assessment techniques based on classical control and predictive \& nonlinear control techniques, ensuring robustness under weak grid conditions. Simulation and hardware-in-the-loop (HIL) evaluations demonstrate that the DT-assisted control framework reduces THD by more than 40\%, maintains voltage within ±1\%, and improves transient settling times compared to conventional control methods. Future work will explore the integration of DTs with distributed energy resource (DER) coordination, cyberphysical security mechanisms, and self-learning controllers to enable fully autonomous, grid-supportive PV operations in nextgeneration smart grids.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {International} {Conference} on {Power} {Electronics} and {Energy} ({ICPEE})},
	publisher = {IEEE},
