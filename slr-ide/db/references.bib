	journal = {Annals of Nuclear Energy},
	author = {Jiang, Yingying and Xia, Hong and Zhang, Jinming and Zhu, Yihu and Zhang, Kaige and Huang, Xueying and Yin, Wenzhe and Jiang, Peiqi},
	month = dec,
