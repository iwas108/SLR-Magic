	pages = {102365},
	file = {Liu_2022_Adigitaltwinbas_b2b59:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Liu_2022_Adigitaltwinbas_b2b59.pdf:application/pdf},
