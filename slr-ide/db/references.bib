@article{thosar_adaptive_2026,
	title = {Adaptive physics-informed neural network-based digital twins integrated with {Ensemble} {Kalman} {Filter}},
	volume = {210},
	issn = {00981354},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0098135426000785},
	doi = {10.1016/j.compchemeng.2026.109625},
	abstract = {With the advent of Industry 4.0, the growing use of machine learning-based predictive models has accelerated their adoption as digital twins for online applications. However, most existing models assume constant process parameters and lack real-time updating mechanisms. In reality, process parameters change due to various factors, and the parameters in physics-based models may also be inaccurate. This highlights the need for a parameter-sensitive digital twin that can adapt to such changes. In this work, we introduce a novel, robust, adaptive digital twin based on a physics-informed neural network (PINN), capable of adjusting in real time to changes in process parameters to maintain the performance of predictive models. Model updates are performed on the deep neural network using the Ensemble Kalman Filter (EnKF). We implement the adaptive digital twin on a real-world polymerization process for Polymethyl-Methacrylate (PMMA), considering various scenarios involving process parameter changes, model-plant mismatches, and different measurement scenarios. The results demonstrate a 10- to 20-fold improvement in accuracy compared to digital twins that do not incorporate parameter updates. The adaptive PINN also achieves approximately a 96\% reduction in computation times compared to the EnKF with a physics-based model predictor, making it highly suitable for online applications. This emphasizes that the physics-based model is only necessary for training the PINN offline, and can be completely discarded during online implementation. This approach provides a recursive, hybrid modeling framework that is modularizable and scalable, generalizable, robust, and maintains model performance under changing environmental conditions.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Computers \& Chemical Engineering},
	author = {Thosar, Devavrat and Bhakte, Abhijit and Li, Zukui and Srinivasan, Rajagopalan and Prasad, Vinay},
	month = jul,
