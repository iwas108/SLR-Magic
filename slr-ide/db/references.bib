@article{al_muttaki_state--charge-aware_2026,
	title = {State-of-charge-aware charging opportunity detection for electric vehicles using data-driven learning and digital twin simulation},
	volume = {30},
	issn = {25901745},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2590174526002588},
	doi = {10.1016/j.ecmx.2026.101775},
	abstract = {As the number of electric vehicles (EVs) rises, ineffective and needless charging during parking events is reducing battery life, user comfort, grid stability, and charging infrastructure usage. Current charging schedules do not take into account whether a charging activity is required in the 1rst place; instead, they optimize for power or scheduling after the charging choice. Additionally, many methods scale poorly and cannot be implemented in practice because they rely on grid-side data, battery physics models, or static heuristics. Using historical operational data, a completely data-driven, vehicle-centric State-of-Charge–Aware Charging Opportunity Detection (SoC-COD) framework is provided to determine if charging during a parking event can successfully enable SoC recovery without utilizing any real-time information. SoC-COD, which combines optimization-based labeling and probabilistic machine learning to infer the charging opportunities (i.e., whether a vehicle would charge) and counterfactual SoC trajectories if they could, is a parking-event level approach that combines churn prediction and charging opportunity identi1cation. Validation using digital twin simulations and the California Audi EV Dataset is shown; SoC-COD achieves near-perfect opportunity discrimination (ROC–AUC = 0.9915) with a strong SoC prediction accuracy (R2 = 0.8297), while also reducing charging events by 85.00\% and lowering energy and cost by 52.50\%. It also improves the minimum SoC by 24\%.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Energy Conversion and Management: X},
