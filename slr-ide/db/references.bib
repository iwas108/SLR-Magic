@article{kurt_reactive_2026,
	title = {From {Reactive} to {Resilient}: {A} {Hybrid} {Digital} {Twin} and {Deep} {Learning} {Framework} for {Mining} {Operational} {Reliability}},
	volume = {6},
	issn = {2673-6489},
	shorttitle = {From {Reactive} to {Resilient}},
