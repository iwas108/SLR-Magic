}

@article{sun_digital_2026-1,
	title = {Digital twin assisted surface roughness prediction in milling processes},
	volume = {258},
	issn = {08883270},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0888327026007983},
	doi = {10.1016/j.ymssp.2026.114641},
	abstract = {In milling processes, surface roughness prediction is essential for enhancing machining efficiency and reducing production costs, as it can effectively save the measurement time. In recent years, data-driven methods have made significant progress in surface roughness prediction research. However, existing methods are highly dependent on sufficient historical data. To overcome this limitation, a digital twin assisted surface roughness prediction method is proposed in this paper, in which abundant simulated data are utilized for model training. First, the dynamic and mechanistic models of milling force and surface roughness are established based on the physical entity of the machine tool to generate simulated data as the corresponding virtual entity. Then, a network architecture integrating mechanistic information and signal features is designed to deep learn surface roughness knowledge from both simulated data and measured data. Furthermore, the maximum mean discrepancy is introduced into the loss function to enable domain adaptation from the virtual entity to the physical entity. Experimental results on a milling dataset under different machining conditions demonstrate the proposed method’s effectiveness. When measured data is limited, the proposed method can improve surface roughness prediction performance, overcoming the typical challenges of data-driven methods.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Mechanical Systems and Signal Processing},
	author = {Sun, Liangshi and Huang, Xianzhen and Zhang, Yongchao and Wang, Xu and Tang, Liye and Liu, Zheng},
