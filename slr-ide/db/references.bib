@article{wilsdon_autonomous_2023,
	title = {Autonomous control of heat pipes through digital twins: {Application} to fission batteries},
	volume = {163},
	issn = {01491970},
	shorttitle = {Autonomous control of heat pipes through digital twins},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0149197023002482},
	doi = {10.1016/j.pnucene.2023.104813},
	abstract = {Fission batteries are envisioned as nuclear energy systems and associated technology that can be fully utilized in a battery-like operation, where the system is delivered as a ‘plug-and-play’ service. Several key attributes de ne the desired functionality of these systems: economic, standardized, installed, unattended, and reliable. The construction and operation of unattended, plug-and-play ssion batteries will require suf ciently robust hardware and software technologies. Using a digital twin (DT) may reduce costs and risk associated with employing ssion batteries through the integration of the disparate systems used in the design, construction, and operation of these nuclear energy systems. A DT employing machine-learning (ML) and physics-based representations to forecast future performance could potentially be used for anticipatory control. Before application of a DT in the ssion domain, the DT technology should be validated in a non- ssion environment. A DT of a single-heat-pipe test article in the Microreactor AGile Non-nuclear Experimental Testbed (MAGNET) was demonstrated with predictive, self-adjusting capability on 30 March 2022. The test plan stated that: (1) the operators will manually change the temperature set point of the heat pipe to an upper limit or lower limit; and (2) the DT will predict the temperature will go beyond this temperature threshold, and then will update the temperature set point to the baseline temperature without any human intervention. The DT used a two-step process including a least absolute shrinkage and selection operator (LASSO) for variable selection between the sensors followed by vector autoregressive (VAR) models for multivariate forecasting to predict future performance of the heat pipe within MAGNET. Additionally, a physics model was created within the Sockeye framework that would be applied in future tests. With controlled rates of temperature change, the DT successfully self-adjusted the heat pipe before reaching the lower limit under expected conditions. Ultimately, this DT could be leveraged as a foundational framework in future ssion battery applications for continuously monitoring and actively self-adjusting a heat pipe.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Progress in Nuclear Energy},
	author = {Wilsdon, Katherine and Hansel, Joshua and Kunz, M. Ross and Browning, Jeren},
	month = sep,
	year = {2023},
	pages = {104813},
	file = {Wilsdon_2023_Autonomouscontr_f1352:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Wilsdon_2023_Autonomouscontr_f1352.pdf:application/pdf},
}

@inproceedings{hussaini_digital_2023,
