	file = {Salah_2025_AIDrivenDigital_15657:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Salah_2025_AIDrivenDigital_15657.pdf:application/pdf},
