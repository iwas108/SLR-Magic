@inproceedings{sobha_cnc-mind_2026,
	address = {Jinan, China},
	title = {{CNC}-{MIND}: {An} {Explainable} {Multi}-{Task} {Digital} {Twin} for {CNC} {Machining}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-8325-5},
	shorttitle = {{CNC}-{MIND}},
	url = {https://ieeexplore.ieee.org/document/11509230/},
	doi = {10.1109/ICAACE69793.2026.11509230},
	abstract = {Computer Numerical Control (CNC) machining generates rich multi-modal sensor data during operation, yet practical monitoring systems typically assess tool condition, process execution, and part quality in isolation. This separation limits diagnostic insight and reduces the effectiveness of digital twin–based decision support in production environments. This paper presents CNC-MIND, an explainable multi-task digital twin framework for CNC machining that jointly predicts tool condition, machining completion status, and post-process visual inspection outcomes from time-windowed sensor signals and process metadata. The framework employs a hybrid CNN–LSTM–DNN architecture to capture local signal patterns, longterm temporal dynamics, and operational context within a shared representation. To improve physical consistency, a physics-guided regularization term penalizes predictions that violate known relationships between vibration energy and tool degradation. Model transparency is achieved through integrated SHAP explanations, enabling both global feature attribution and instancelevel diagnostic reasoning. The proposed approach is evaluated on a real-world CNC milling dataset from the University of Michigan SMART Lab, demonstrating consistent performance gains over tuned DNN, CNN, and LSTM baselines across all tasks. CNC-MIND is further deployed within an interactive web-based digital twin platform, illustrating how multi-task predictions and explainability can be operationalized for humanin-the-loop CNC monitoring.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 9th {International} {Conference} on {Advanced} {Algorithms} and {Control} {Engineering} ({ICAACE})},
	publisher = {IEEE},
	author = {Sobha, Shakil Mohammad Nurus and Li, Xiaobin and Ariful, Islam and Bahmaninezhad, Fatemeh},
	month = mar,
	year = {2026},
	pages = {525--531},
	file = {Sobha_2026_CNCMINDAnExplai_8eda1:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Sobha_2026_CNCMINDAnExplai_8eda1.pdf:application/pdf},
