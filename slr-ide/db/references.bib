	file = {Shrivastava_2025_ResilientSmartG_520f1:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Shrivastava_2025_ResilientSmartG_520f1.pdf:application/pdf},
