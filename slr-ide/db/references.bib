	file = {Zhang_2026_ADigitalTwinPro_f15a5:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Zhang_2026_ADigitalTwinPro_f15a5.pdf:application/pdf},
