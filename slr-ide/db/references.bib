@article{vadnerkar_digital_2026,
	title = {Digital {Twins} as {Predictive} {Models} for {Real}-{Time} {Probabilistic} {Risk} {Assessment} of {Autonomous} {Vehicles}},
	volume = {27},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {1524-9050, 1558-0016},
	url = {https://ieeexplore.ieee.org/document/11301017/},
	doi = {10.1109/TITS.2025.3641530},
	abstract = {Autonomous vehicle deployment demands real-time risk assessment systems capable of detecting sensor faults without extensive labeled fault datasets. While physics-based models lack adaptability and data-driven approaches require rare fault data, nominal driving data is abundant. We present a digital twin framework that learns exclusively from fault-free operation to detect anomalies through prediction-observation residuals. Our Spatio-Temporal Graph Attention Network (ST-GAT) fuses multimodal sensor data with HD map topology, explicitly quantifying both epistemic and aleatoric uncertainties through deep ensembles. The framework compares real-time observations against predicted nominal behavior using three residual types (Raw, KL Divergence, CUSUM), achieving 93.7\% fault detection accuracy with 1.13ms processing time across Camera, IMU, and LiDAR faults. Principal component analysis reduces the 540-dimensional residual space to 8 components while preserving 95\% variance, enabling Random Forest classiﬁcation with 200 trees. Feature importance analysis reveals Traﬃc Light Status Flag (29.7\%) and CUSUM residuals as most discriminative, validating our hypothesis that sensor faults manifest as persistent accumulated deviations. Unlike existing approaches requiring fault-labeled data or perfect sensors, our sensor-agnostic framework provides interpretable, real-time fault detection generalizable across operational domains, advancing practical autonomous vehicle safety systems.},
	language = {en},
	number = {4},
	urldate = {2026-07-23},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
	author = {Vadnerkar, Kalpit and Pisu, Pierluigi},
	month = apr,
