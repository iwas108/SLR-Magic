	keywords = {Digital twin, Digital twins, Interoperability, data integration, Scalability, Data visualization, data visualization, Data models, Smart cities, Biological system modeling, data management, data quality, data security, Medical services, Real-time systems, Reviews},
	pages = {2224--2243},
