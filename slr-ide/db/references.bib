@article{hekmatnejad_toward_2025,
	title = {Toward intelligent tunnel construction: {The} universal discontinuity index for rapid probabilistic prediction of progressive batch rock-block failure—{A} theoretical, numerical, and experimental validation framework},
	volume = {166},
	issn = {08867798},
