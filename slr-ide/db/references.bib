@inproceedings{sanku_design_2025,
	address = {Bhopal, India},
	title = {Design and {Development} of {Resilient} {Cyber}-{Physical} {Systems} for {Real}-{Time} {Monitoring} and {Control} in {Critical} {Infrastructure}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9126-7},
	url = {https://ieeexplore.ieee.org/document/11506911/},
	doi = {10.1109/RCSM67767.2025.11506911},
	abstract = {Critical infrastructure systems, such as grids, transport systems, and water chains, are increasingly becoming more reliant on cyber-physical systems (CPS) as far as real-time monitoring and control are concerned. However, such connectivity exposes dependence on systems not only to cyber but also physical attack and thus resiliency is a significant operational requirement. The choice of older protocols to maintain either cybersecurity or fault resilience is usually restricted and not as flexible as it would be in a dynamic and real-world environment. The solution proposed in this paper is the Hybrid Resilience Intelligence-Driven Framework (HRIF) that is a holistic solution that seeks to enhance reliability, security and resilience of CPS to the critical infrastructures. HRIF also integrates edge-cloud collaboration, self-healing intelligence, in order to promote continuous local decisionmaking, as well as the ability to re-establish the system on time. Mechanisms based on blockchain promote trust, integrity of data, is not tampered with and digital twins allow the strategy of failure forecasting and predicting and testing of the measures of adaptive strategy in real-time. Moreover, a bio-inspired game-theoretic defense system predictively combats adversarial behavior and an energy-efficient delay-reduction system helps to optimize resource use throughout the system. Combined together, these capabilities allow general sustainability in uncertain operating periods, reduce the impact of disruptions, as well as provide safe, adaptable, and resilient real-time control. The framework also shows enormous possibilities when it comes to their strength and resilience of critical infrastructure CPS, responding to the threats of cyber outages that arise as well as operational problems. The total accuracy of 95\% was attained by the suggested HRIF framework, proving its usefulness in guaranteeing safe and robust CPS operations.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {IEEE} 1st {International} {Conference} on {Recent} {Trends} in {Computing} and {Smart} {Mobility} ({RCSM})},
