@inproceedings{kumar_hybrid_2025,
	address = {Surat, India},
	title = {Hybrid {Digital} {Twin} and {AI} {Framework} for {Predictive} {Maintenance} in {Renewable} {Energy}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9894-5},
	url = {https://ieeexplore.ieee.org/document/11469257/},
	doi = {10.1109/SPERT67079.2025.11469257},
	abstract = {Digital twin technology is the future of green energy systems with the way that these systems are maintained being altered fully by incorporating artificial intelligence (AI). The renewable resources such as wind mills, solar farms, and storage units are complex, movable, and may stop being effective after some time. Conventional curative processes rely on either ad hoc or proactive measures, and this may be time and money wastage and may lead to an unexpected breakdown of equipment. The issues can be resolved through a system that involves a combination of a digital twin and AI to create a real-time virtual replica of the green energy assets. This allows them to be tracked all the time, errors identified and performance anticipated. The digital twin presents the condition of the physical system through sensor data. This data is then used in AI algorithms, including machine learning, deep learning, and reinforcement learning to identify problems, anticipate errors, and take the most optimal operating decisions. This standardized approach ensures reliability in things, manages assets in a better way throughout their entire life span and reduces organizational risks. A digital twin environment of simulations and optimizations also allows testing repair plans and putting them into practice, reducing costs and risks. The proposed framework can encourage proactive repair methods, which are smart and can make energy production safer and more efficient. This paper explains how these mixed systems are structured, how they are used, and how they can be used in the green energy fields.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {IEEE} {International} {Conference} on {Smart} {Power}, {Energy}, {Renewables}, and {Transportation} ({SPERT})},
