	year = {2025},
	keywords = {Digital Twin, Internet of Things, Smart agriculture, Food production, Machine-learning, Boosted tree, Boosted Tree, Green house, Image Processing, Images processing, Machine Learning, Simulink, SIMULINK model, SIMULINK Model, Smart green house system, Smart Green House System, Smart greenhouse, Sustainable development goal, Sustainable Development Goals (SDGs)},
