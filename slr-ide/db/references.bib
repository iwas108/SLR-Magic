@article{liu_digital_2022-2,
	title = {Digital {Twin}-{Based} {Reconfiguration} {Time} {Point} {Prediction} {Method} for {Reconfigurable} {Manufacturing} {Systems}},
	volume = {2173},
	issn = {1742-6588, 1742-6596},
