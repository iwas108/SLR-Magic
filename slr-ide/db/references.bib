	file = {Meenakshi_2025_AIDrivenPredict_673b4:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Meenakshi_2025_AIDrivenPredict_673b4.pdf:application/pdf},
