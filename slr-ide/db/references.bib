@article{ragazzini_digital_2024,
	title = {Digital {Twin}-based bottleneck prediction for improved production control},
	volume = {192},
	issn = {03608352},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0360835224003528},
	doi = {10.1016/j.cie.2024.110231},
	abstract = {Bottlenecks in manufacturing systems may signi+cantly reduce their ef+ciency and productivity. Therefore, bottleneck analysis is a consolidated topic in Industrial Engineering, both in research and practice. Recently, traditional methods for bottleneck analysis have been enhanced with data-driven approaches, such as arti+cial intelligence and big data analytics. Nevertheless, their exploitation built on the full scope of technologies from digitalization is still not ful+lled. Indeed, the integration with simulation-based methods remains underexplored. This work aims to address bottleneck prediction leveraging on Digital Twin simulation capabilities to predict manufacturing system behavior. For this purpose, the work +rst offers an extensive review of bottleneck identi+cation methods, inclusive of the ones based on Digital Twin. The main contribution of the work lies in the proposal of a novel Digital Twin-based bottleneck prediction framework with the end purpose to achieve performance improvements actuated through production control. The framework utilizes the Digital Twin for predicting and mitigating bottlenecks in manufacturing systems. The Digital Twin enables the simulation of the future system behavior, while accounting for the current conditions. This insight can then be used by a bottleneck identi+cation method to infer future system bottleneck. The information on the predicted bottleneck is eventually used to support production control decisions, by adapting the order release and sequencing according to the predicted bottleneck. The bene+ts of adapting production control to the predicted bottleneck are evaluated quantitatively, highlighting how system performance is enhanced. By doing so, this research contributes to bridging the gap between Digital Twin-based performance analysis and production control, providing knowledge and a practical framework transferable to researchers and industrial practitioners.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Computers \& Industrial Engineering},
	author = {Ragazzini, Lorenzo and Negri, Elisa and Fumagalli, Luca and Macchi, Marco},
	month = jun,
	year = {2024},
	pages = {110231},
	file = {Ragazzini_2024_DigitalTwinbase_ad422:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Ragazzini_2024_DigitalTwinbase_ad422.pdf:application/pdf},
}

@inproceedings{shetty_ai-powered_2025,
	address = {Glasgow, United Kingdom},
	title = {{AI}-{Powered} {Production} {Forecasting} and {Optimization} of {Energy} {Generation} in {Smart} {Grid} {Technologies}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-2557-6},
	url = {https://ieeexplore.ieee.org/document/11071789/},
	doi = {10.1109/icSmartGrid66138.2025.11071789},
	abstract = {With the increasing integration of renewable energy sources into smart power grids, the mean time between failures and average system failure frequency increase; meanwhile, this technology brings new challenges in forecast accuracy, operational optimization of steady ingrid generation and stability. Bai proha Now we propose an AI-driven framework based on advanced deep learning and metaheuristic optimization methods combining innovative energy production forecasting generation schedule designs that suit the unique features of smart grid systems. With a digital twin simulation of the urban grid in Visakhapatnam, India, the hybrid model fitted for power load forecasting was CNNLSTM, and the optimization algorithm used Particle Swarm Optimization (PSO) to dispatch the output in a way that is cost-effective. The CNN-LSTM model achieved a forecasting MAPE of 3.69\% and an R² of 0.981, demonstrating superior accuracy in handling the variability of solar and wind generation. Scheduling generation by PSO brought an optimized mix--one that advanced renewable energy penetration from 3.8\% to 4.4\%, reduced thermal dependency and dropped average generation costs by 15.03\% compared with traditional methods. The mitigation of peak load was also greatly improved, and the load could be shifted by up to 1.1 MW, saving 18.8\% in peak-hour costs. Environmentally, the benefits included an energy curtailment decrease of 66\% and monthly CO₂ emissions 26.3\% lower than in the first six months. In a resilience test, the system was able to restore power within 5 minutes after a simulated 1.5 MW wind generation breakdown--72\% faster than traditional methods-and with low loss of load or damage to economic life. These results show that by combining AI forecasting with evolutionary optimization, it provides a scalable solution to enhance the performance, reliability, and sustainability of smart grids.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 13th {International} {Conference} on {Smart} {Grid} ({icSmartGrid})},
	publisher = {IEEE},
	author = {Shetty, Nayana and Kothuri, Sri Raman and Patil, Nandini S and Kumar, Polamarasetty Praveen and R, Hushein and Sahoo, Dillip Kumar},
	month = may,
	year = {2025},
	pages = {358--366},
	file = {Shetty_2025_AIPoweredProduc_7bd51:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Shetty_2025_AIPoweredProduc_7bd51.pdf:application/pdf},
