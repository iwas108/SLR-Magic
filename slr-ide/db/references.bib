@article{ren_edge-fog-cloud_2023,
	title = {An {Edge}-{Fog}-{Cloud} {Computing}-{Based} {Digital} {Twin} {Model} for {Prognostics} {Health} {Management} of {Process} {Manufacturing} {Systems}},
