@article{zhang_physics-informed_2026,
	title = {Physics-informed machine learning modeling and inferencer-in-the-loop based real-time digital-twin emulation for a {Maglev} transportation system},
	volume = {285},
	issn = {02632241},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0263224126020282},
	doi = {10.1016/j.measurement.2026.122319},
	abstract = {In response to the increasing demands for efficient, sustainable, and high-speed transportation systems, magnetic levitation (Maglev) train technology has garnered significant attention due to its frictionless operation, high efficiency, low maintenance and environmental benefits. Accurate real-time modeling of Maglev transportation systems remains challenging due to the strong nonlinear coupling among electrical, mechanical, and electromagnetic subsystems. This paper proposes a physics-informed machine learning based real-time digital-twin framework for Maglev transportation systems, in which a physics-informed partitioned neural network (PIPNN) is developed to improve modeling accuracy, interpretability, and computational efficiency. By embedding physical knowledge into a modular neural architecture, the proposed method overcomes the limitations of conventional monolithic neural models and provides a more hardware-efficient representation for real-time deployment. To enhance adaptability, a hybrid offline–online training strategy is further integrated into an inferencer-in-the-loop (IIL) framework for continuous model refinement under changing operating conditions. The proposed approach is implemented on a Xilinx® UltraScale+ VCU118 FPGA platform and validated on the linear induction motor (LIM) drive system together with the phase-shifting transformer rectifier unit (PSTRU) and energy storage system (ESS). Results show that the proposed method closely matches EMT-based reference models across representative operating scenarios while achieving deterministic sub-microsecond inference. For the LIM subsystem, the FPGA-based PIPNN reduces execution latency from 1.82 𝜇s to 0.67 𝜇s, with prediction errors generally below 5\% and as low as 2\% for selected variables. The proposed framework therefore offers a promising solution for high-fidelity, adaptive, and real-time digital-twin emulation of complex Maglev transportation systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Measurement},
	author = {Zhang, Yuzhong and Zhang, Songyang and Dinavahi, Venkata},
	month = sep,
	year = {2026},
	pages = {122319},
	file = {Zhang_2026_Physicsinformed_81910:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Zhang_2026_Physicsinformed_81910.pdf:application/pdf},
