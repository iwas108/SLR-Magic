@inproceedings{land_integrating_2026,
	address = {Perth, Australia},
	title = {Integrating {Digital} {Twins} into the {System} {Architecture} of {Brownfield} {Filtration} {Plants}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3195-1722-7},
