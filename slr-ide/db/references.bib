@article{jiang_digital_2026,
	title = {Digital twin-empowered buffeting analysis of a long-span suspension bridge},
	volume = {274},
	issn = {01676105},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0167610526001327},
	doi = {10.1016/j.jweia.2026.106463},
	abstract = {The buffeting analysis of a long-span suspension bridge commonly relies on aerodynamic force coef*cients, aerodynamic admittance functions (AAFs), and -utter derivatives (FDs) obtained from wind tunnel tests. Due to inherent disparities in Reynolds number, blockage effects, and wind characteristics between the wind tunnel and the bridge site, the direct application of these parameters can introduce systematic uncertainties, leading to discrepancies between predicted and *eld-measured buffeting responses. This study thus develops a framework of digital twin-empowered buffeting analysis for a long-span suspension bridge. A real long-span suspension bridge with its structural health monitoring (SHM) system and wind *eld are taken as the physical entity. The *nite element model and wind loading models of bridge are taken as a virtual entity. By leveraging the measured acceleration responses and wind data, the *nite element model is updated, the modal damping ratios, coherence functions, AAFs and aerodynamic force coef*cients of bridge are measured or identi*ed, and the wind *eld is constructed. The digital twin for buffeting analysis is then established by identifying the FDs using the particle swarm optimization algorithm. Finally, the developed digital twin is employed for simulating and predicting the buffeting response which is compared with the measured buffeting response. The comparison results verify the effectiveness of the developed digital twin and demonstrate its accuracy of prediction.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Journal of Wind Engineering and Industrial Aerodynamics},
