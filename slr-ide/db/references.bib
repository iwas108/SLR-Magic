@article{tian_cross-domain_2026,
	title = {Cross-domain adaptive digital twin modelling for dam structures using graph attention networks},
	volume = {70},
	issn = {14740346},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1474034625011024},
	doi = {10.1016/j.aei.2025.104209},
	abstract = {Digital twin technology has emerged as a promising paradigm for advancing instrumentation and measurement in dam safety monitoring. However, existing models often face signi.cant cross-domain discrepancies between numerical simulations (source domain) and in-situ measurement data (target domain), which constrain prediction accuracy and generalization under varying operating conditions. To address these challenges, this study proposes a novel cross-domain adaptive digital twin framework that integrates graph attention networks, gating mechanisms, and feature alignment strategies to enhance measurement consistency and predictive reliability. Multi-source numerical simulation domains are systematically constructed to enrich input variability and improve measurement-domain coverage. The proposed framework is comprehensively validated through ablation studies and comparisons with six state-of-the-art baseline models, achieving superior accuracy with mean errors as low as 0.44 mm and 0.99 \%, thereby demonstrating excellent measurement precision. Furthermore, validation under extreme water-level and temperature scenarios con.rms strong generalization, with the inclusion of extreme-condition samples further reducing errors and mitigating prediction degradation at critical monitoring points. The results show that the proposed approach provides a physically consistent, generalizable, and robust digital twin measurement framework for dam structures, enabling reliable real-time deformation monitoring and safety evaluation. These .ndings establish a foundation for intelligent, large-scale, and multicondition applications of digital twins in civil infrastructure monitoring and measurement science.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Advanced Engineering Informatics},
	author = {Tian, Jichen and Yu, Ruijie and Chen, Chen and Li, Yanling and Huang, Huibao and Chen, Jiankang},
