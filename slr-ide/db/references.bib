@article{qiu_physics-guided_2026,
	title = {Physics-guided, uncertainty-aware machine learning for non-invasive deep thermal interface characterization in hybrid-bonded {3D} {ICs} without prior geometric knowledge},
	volume = {263},
	issn = {00179310},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0017931026003935},
	doi = {10.1016/j.ijheatmasstransfer.2026.128717},
	abstract = {Three-dimensional integrated circuits (3D ICs) with sub-10-μm hybrid Cu–Cu/SiO2 bonding are increasingly limited by interfacial thermal conductance (ITC) at buried metal–metal and metal–dielectric junctions. Industrial thermal metrology largely relies on JEDEC-style structure–function analysis and one-dimensional models that collapse complex heat-flow paths and multiple buried interfaces into junction-to-ambient resistances, which become inaccurate for laterally heterogeneous hybrid-bonded layouts. Advanced thermoreflectance and scanning thermal microscopy workflows, including recent ML variants, typically assume a known, laterally uniform geometry and therefore cannot separate process-induced geometry changes from true ITC variations or quantify their impact.},
	language = {en},
	urldate = {2026-07-23},
	journal = {International Journal of Heat and Mass Transfer},
