	pages = {114492},
	file = {Lin_2025_TransPhyXAdatad_3de9a:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Lin_2025_TransPhyXAdatad_3de9a.pdf:application/pdf},
