@article{cheng_sfdpose_2026,
	title = {An {SFDPose} network with credible evolution mechanism for digital twin systems in industrial applications},
	volume = {86},
	issn = {02786125},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0278612526000257},
	doi = {10.1016/j.jmsy.2026.01.014},
	abstract = {The rapid rise of Industry 4.0 and the Internet of Things (IoT) has elevated digital twins from a novel concept to an indispensable tool for real-time monitoring, prediction, and optimization in complex systems. Yet, maintaining the accuracy and reliability of digital twins remains a formidable challenge. As physical entities evolve and operational environments shift, especially in data-driven and resource-constrained contexts, digital twins are prone to degradation, reducing their value and trustworthiness. To address these challenges, in this paper, we introduce a framework that integrates a Separated-Feature Dual-Branch Pose Network (SFDPoseNet) with a credible evolution mechanism. The architecture disentangles and extracts both long-term and shortterm features of the twin system in parallel. Specifically, Long Short-Term Memory (LSTM) networks capture long-range temporal dependencies, while Temporal Convolutional Networks (TCN) extract multi-scale local patterns. We propose a lightweight residual Feedforward Neural Network (FFN) that integrates features from dual branches to achieve robust and expressive multivariate time-series forecasting. Complementing this hybrid model, an uncertainty-aware online evolution strategy ensures adaptability. Real-time prediction errors trigger dynamic model updates, while incremental learning with Fisher information–based regularization stabilizes the adaptation process and mitigates catastrophic forgetting. Extensive validation on a quadrotor UAV (unmanned aerial vehicle) flight dataset confirms that the proposed method significantly outperforms state-of-the-art temporal prediction models in both forecasting accuracy and adaptability. Additional ablation studies highlight the distinct contributions of the dual-branch architecture and the evolution mechanism, underscoring the framework’s capability to sustain digital twin reliability under dynamic conditions.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Journal of Manufacturing Systems},
	author = {Cheng, Hongbo and Qiao, Yiming and Zhang, Lin and Liu, Yongkui and Ren, Lei and Wang, Kunyu and Cheng, Qingsha S. and Zhou, Xiaokang and Deen, M. Jamal},
	month = jun,
	year = {2026},
