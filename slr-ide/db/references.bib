@inproceedings{ababneh_integrating_2025,
	address = {Bangkok, Thailand},
	title = {Integrating {Digital} {Twin} with {Small}-{Scale} {Energy} {Storage} {Systems}: {A} {Design}-{Based} {Methodology}},
