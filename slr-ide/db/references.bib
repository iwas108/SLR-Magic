	doi = {10.1109/ICPEE65973.2025.11411224},
	abstract = {This paper presents a data-driven Digital Twin (DT) framework for real-time state replication and parameter estimation of a single-stage, three-phase grid-connected photovoltaic (PV) inverter system. A Temporal Convolutional Network (TCN) maps measurable PV and grid-side signals to unmeasured internal states, enabling accurate prediction of DClink currents, inductor currents, and capacitor voltages under dynamic operating conditions. A CSTOGI–NSB–CGI ﬁltering framework is incorporated for robust extraction of fundamental grid voltage components in the presence of noise and distortion, while an Adaptive Inﬂuence Electromagnetic Field Optimization with Diversity Control (AI-EFO-DC) algorithm facilitates online parameter estimation to enhance model adaptability. The framework is validated under two representative scenarios: a dynamic irradiance ramp and grid voltage unbalance conditions. Results demonstrate strong agreement between predicted and measured responses, with normalized root-mean-square errors not exceeding 9\% for key inverter states, conﬁrming the DT’s capability for accurate monitoring and predictive analysis of PV inverters in dynamic grid environments.},
	language = {en},
