@article{li_multi-physics_2026,
	title = {A multi-physics digital twin-enhanced meta-learning framework for multi-mode coupled failure in offshore wind-powered hydrogen production systems},
	volume = {363},
	issn = {00298018},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S002980182602411X},
	doi = {10.1016/j.oceaneng.2026.126577},
	abstract = {Offshore wind-powered hydrogen production (OWPH) systems under North Sea intermittent conditions are subject to 5ve deeply coupled failure modes: PEM electrolyzer membrane degradation (F1), BoP compressor valve fatigue cracking (F2), alkaline electrolyzer electrode passivation (F3), PCU IGBT thermal cycling failure (F4), and PSA sieve bed channeling (F5). Their concurrent nonlinear interactions—collectively termed multimode failure (MMF)—fundamentally invalidate the single-fault assumption in existing prognostics and health management (PHM) frameworks, while severe labeled data scarcity constitutes a persistent bottleneck. This paper proposes DT-RDPNet-H, a uni5ed physics-informed learning framework encompassing three contributions: (1) a multi-physics digital twin (MPDT-H) coupling electrochemical, thermodynamic, @uid dynamic, and power electronics sub-models, calibrated via multi-objective particle swarm optimization (MOPSO); (2) adaptive multisource process signal fusion (AMSPF) integrating 5ve heterogeneous monitoring channels under cross-domain physical consistency (CDPC) constraints; and (3) RDPNet-H, a regularized dynamic prototype network incorporating electrochemical order constraints (EOC). MPDT-H is calibrated against measured PEM stack voltage, EIS spectra, and @uoride release rate data from a North Sea operational platform, achieving a normalized stack voltage RMSE of 9.1\%, EIS spectral error of 6.3\%, and FRR relative error of 11.7\%, con5rming the physical 5delity of the digital twin. On the validated synthetic dataset, concurrent F1+F2+F4 advances the operational threshold by {\textasciitilde}16\%, and RDPNet-H achieves 90\% classi5cation accuracy with K = 5 support samples—three times fewer than an unconstrained baseline. Economically, DT-RDPNet-H is projected to contribute a levelized cost of hydrogen (LCOH) reduction of €0.08–0.14 kg 1 H2, advancing the 2035 target of €2.0 kg 1 H2 for largescale offshore green hydrogen production.},
	language = {en},
	urldate = {2026-07-23},
