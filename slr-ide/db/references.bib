@article{yang_robust_2026,
	title = {Robust temperature prediction of {HTS} cable using an informer-based long-sequence forecasting model},
	volume = {32},
	issn = {25901230},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2590123026017597},
	doi = {10.1016/j.rineng.2026.110726},
	abstract = {The secure operation of high-temperature superconducting (HTS) cables requires temperature forecasting that captures both rapid transients and long-term thermal inertia. However, existing data-driven methods rarely translate predictions into physically interpretable insights for protection decisions. This paper proposes a Physics-Informed Informer (PI-Informer) framework that integrates a long-sequence forecaster with an analytical heat-transfer model. The predicted liquid-nitrogen outlet temperatures serve as boundary conditions for thermal balance equations, enabling inverse estimation of axial temperature distribution and external heat leakage—thus turning a black-box forecast into actionable physical diagnostics. Validated using operational data from a 400 m three-phase coaxial HTS cable system, the PI-Informer framework achieves a 51.8 \% reduction in mean absolute error compared to a standard LSTM. Furthermore, the predicted temperatures enable precise estimation of axial temperature distributions, hot-spot and heat loss, offering critical insights for thermal management and protection strategy design. The framework demonstrates strong robustness against sensor noise and disturbances, providing a reliable foundation for digital twin-based monitoring of HTS power systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Results in Engineering},
	author = {Yang, Junfeng and Li, Zhonghang and Yu, Peng and Wang, Zhenzi and Lu, Feiyu and Wang, Bangzhu},
