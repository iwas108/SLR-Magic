@inproceedings{badajena_digital_2025,
	address = {Hyderabad, India},
	title = {Digital {Twin}-{Driven} {Bearing}-{Fault} {Detection} in {Induction} {Motor} and {Drives} using {Graph} {Sampling} and {Aggregation} {Network}},
	copyright = {https://doi.org/10.15223/policy-029},
