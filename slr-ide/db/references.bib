@inproceedings{yang_aircraft_2026,
	address = {Wuhan, China},
	title = {Aircraft center of gravity dynamic cooperative trim methodology based on multiagent reinforcement learning},
	isbn = {979-8-90232-394-5 979-8-90232-395-2},
	url = {https://www.spiedigitallibrary.org/conference-proceedings-of-spie/14170/3112025/Aircraft-center-of-gravity-dynamic-cooperative-trim-methodology-based-on/10.1117/12.3112025.full},
	doi = {10.1117/12.3112025},
	abstract = {Confronting the trimming predicaments engendered by dynamic center of gravity fluctuations in contemporary wide-body airliners during flight operations, this investigation propounds a dynamic cooperative trim methodology predicated upon multi-agent reinforcement learning. Primarily, a multi-agent trim system architecture encompassing fuel management, cargo distribution, and passenger allocation subsystems is formulated, achieving synergistic decision-making through distributed frameworks. Subsequently, an attention mechanism-enhanced Multi-Agent Deep Deterministic Policy Gradient (MA-DDPG) algorithm is architected, accomplishing center of gravity optimization control under multiple constraints incorporating aerodynamic characteristics, fuel efficiency, and passenger comfort. Furthermore, hierarchical reward functions and curricular learning strategies are introduced, enhancing algorithmic convergence and stability through progressive training mechanisms. Validation within an A320-based digital twin simulation environment demonstrates our methodology achieves 23.7\% improvement in trim precision, 15.3\% reduction in fuel consumption compared to conventional trimming approaches, while simultaneously significantly ameliorating passenger comfort experience.},
	language = {en},
	urldate = {2026-07-23},
