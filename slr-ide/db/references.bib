@article{ye_digital_2026,
	title = {Digital twin-based multiscale fatigue crack life prediction of rib-to-deck weld joints},
	volume = {244},
	issn = {0143974X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0143974X26002129},
	doi = {10.1016/j.jcsr.2026.110443},
	abstract = {Fatigue cracks are prone to initiate in rib-to-deck (RTD) weld joints of orthotropic steel decks (OSD) under traf2c loading, posing a serious threat to functionality and safety of bridge structures. To achieve accurate fatigue crack life prediction of RTD weld joints of OSD, a digital twin-based multiscale fatigue crack life prediction framework from microcrack initiation and propagation to macrocrack propagation is proposed. Eccentric tensile fatigue tests as a physical entity are 2rst conducted to obtain test data on fatigue crack propagation. A multiscale crack propagation model coupling crystal plasticity 2nite element model with fracture mechanics is then established as a virtual entity to describe microcrack initiation and propagation as well as macrocrack propagation. A dynamic Bayesian network integrated with a particle 2lter algorithm is 2nally introduced to fuse the test data from the physical entity with the numerical results from the virtual entity, enabling real-time updating of key model parameters and crack propagation states as well as quantitative uncertainty assessment and digital twin construction. The results from this study demonstrate that the proposed digital twin effectively suppresses model uncertainty and signi2cantly improves the prediction accuracy of crack propagation process and remaining fatigue life.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Journal of Constructional Steel Research},
	author = {Ye, Yang and Xu, You-Lin and Lao, Wulve and Cui, Chuang and Zhang, Qinghua},
