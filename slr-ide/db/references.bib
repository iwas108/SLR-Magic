@article{ebrahimian_automated_2025,
	title = {Automated model updating of digital twins using double-deep {Q} network with dueling architecture for damage detection},
	volume = {80},
	issn = {23520124},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2352012425016509},
	doi = {10.1016/j.istruc.2025.109835},
	abstract = {Digital twins have transformed structural health monitoring by enabling real-time model updates for damage detection. Although machine learning techniques have been thoroughly investigated for automating model updates, reinforcement learning (RL) has not been utilized in this 0eld. This study presents the reinforcement learning-based framework for the complete automation of incremental updates to a digital twin’s model utilizing modal characteristics. The methodology employs Double Deep Q-Network (DDQN) with dual architecture, integrating reinforcement learning and deep learning to autonomously determine damage location and its severity. An essential innovation is the integration of a label-free, physics-informed reward function that guarantees physical consistency and adaptability without dependence on prede0ned damage labels. The framework was implemented on a four-story numerical steel structure, veri0ed by experimental data, achieving a damage localization accuracy of approximately 0.99 and an R² of 0.99 for damage severity prediction over successful episodes (damage scenarios). These 0ndings highlight the method’s considerable potential for autonomous, realtime updating of digital twins, offering an innovative paradigm for structural health monitoring and damage assessment.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Structures},
	author = {Ebrahimian, Parinaz and Bitaraf, Maryam},
	month = oct,
	year = {2025},
