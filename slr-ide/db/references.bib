@article{li_physically_2026,
	title = {Physically structured and robust distributed recurrent neural networks for modeling hydropower generator cooling systems},
	volume = {681},
	issn = {09252312},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0925231226007472},
	doi = {10.1016/j.neucom.2026.133350},
	abstract = {This paper proposes a physically structured and robustness-enhanced distributed recurrent neural network (RNN) for data-driven modeling of hydropower generator cooling systems. Leveraging the physical topology and sym metry of the cooling system, the proposed framework decomposes the overall system into multiple interacting subsystems and employs a shared recurrent architecture to capture their coupled thermal dynamics. To address the instability and error accumulation issues commonly encountered in long-horizon multistep prediction, a ro bustness enhancement mechanism grounded in small-gain–based analysis is integrated into the distributed RNN, providing theoretical guarantees on stability and bounded error propagation. The proposed approach is validated using real-world operational data collected from an industrial hydropower plant. Extensive one-step and multi step prediction experiments demonstrate that, while baseline feedforward and recurrent neural network models su˫er from signiˡcant performance degradation in closed-loop operation, the proposed distributed RNN achieves stable sub-degree prediction accuracy across all temperature channels. Moreover, the robustness-enhanced vari ant consistently improves long-term prediction reliability and substantially reduces bias in the prediction errors, particularly for dynamically complex cooling air and cooling water temperature variables. These results highlight the e˫ectiveness of incorporating physical structure and robustness-oriented design into RNNs for digital twin modeling of safety-critical energy systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Neurocomputing},
	author = {Li, Xianning and Yin, Zhun and Jia, Wenbo and Wang, Hong and Jiang, Zhong-Ping},
