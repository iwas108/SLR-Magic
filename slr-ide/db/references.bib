@inproceedings{guo_sefm_2026,
	address = {Shenzhen, China},
	title = {{SEFM}: {A} {Self}-{Evolving} {Framework} for {Multirobot} {Embodied} {Agents} with {Semantic} {Frontier} {Assessment} and {Collective} {Long}-{Term} {Memory}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3195-2002-9},
	shorttitle = {{SEFM}},
	url = {https://ieeexplore.ieee.org/document/11545289/},
	doi = {10.1109/ISoIRS70157.2026.11545289},
	abstract = {With advances in robotics and artificial intelligence, autonomous embodied agents are increasingly deployed in large-scale dynamic settings, including smart manufacturing, emergency response, and urban digital twins. These applications demand system-level capabilities such as cross-domain collaboration, scalable coordination, and longterm adaptability. However, many multi-robot exploration and navigation methods still require expensive multi-agent training, generalize poorly, and lack reusable shared experience or reliable correction when environments evolve. This study presents SEFM, a self-evolving framework for multi-robot embodied agents with semantic frontier assessment and collective long-term memory. In pre-exploration, agents run simultaneous localization and mapping (SLAM) to build occupancy maps and extract geometric frontiers. A visionlanguage model interprets the visual context near each frontier to estimate semantic utility, and then performs global task allocation to reduce overlap and prioritize informative regions. Observations about places, objects, and attributes are consolidated into shared memory for open-vocabulary retrieval in downstream object search. During object retrieval, if memory provides no valid cue or the target is absent at a memorized location, a large language model (LLM) proposes relocation hypotheses and dispatches agents to verify them in parallel. New evidence is written back to memory to refine subsequent search. On HM3D-OVON with TurtleBot3 Burger using RGB-D and 2D LiDAR, and with Qwen-VL-Plus and DeepSeek-R1, SEFM achieves a success rate of 70.6\% and a success weighted by path length of 30.6\% with two agents, and a success rate of 74.0\% and a success weighted by path length of 35.9\% with three agents. SEFM outperforms representative HM3D-aligned baselines such as Co-NavGPT. Results demonstrate robust closed-loop collaboration without dense semantic maps or multi-agent reinforcement learning, supporting continual adaptation in dynamic indoor environments.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 6th {International} {Symposium} on {Intelligent} {Robotics} and {Systems} ({ISoIRS})},
	publisher = {IEEE},
	author = {Guo, Junning and Li, Zhenyuan and Lin, Zibin and Lin, Dahai and Zheng, Hexiang and Lin, Tingyun},
	month = mar,
	year = {2026},
	pages = {1--5},
	file = {Guo_2026_SEFMASelfEvolvi_e6681:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Guo_2026_SEFMASelfEvolvi_e6681.pdf:application/pdf},
}

@inproceedings{yun_federated_2026,
	address = {Albany, NY, USA},
	title = {Federated {Learning} for {Semiconductor} {Digital} {Twins}: {A} {Privacy}-{Preserving} {Framework} for {Collaborative} {DUV} {Nanolithography}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-8050-6},
	shorttitle = {Federated {Learning} for {Semiconductor} {Digital} {Twins}},
	url = {https://ieeexplore.ieee.org/document/11551197/},
	doi = {10.1109/ASMC69324.2026.11551197},
	abstract = {We present a federated learning (FL) framework for privacy-preserving collaborative training of a conditional generative adversarial network (cGAN) applied to Deep UV nanolithography digital twins. Using the Flower platform with FedAvg aggregation, multiple clients collaboratively train a deep learning model to translate mask layouts into synthetic SEM images without sharing manufacturing and metrology data. We evaluate two federated split conﬁgurations: balanced (50/50) and imbalanced (30/70), against centralized and local-only baselines across a dataset of 7,844 CD-SEM image pairs spanning six nanostructure types representing building blocks for in-plane NEMS switch. The FL 50/50 global model achieves a PSNR of 19.87 dB (vs. 19.25 dB centralized) and a width MAE of 4.54 nm (vs. 5.01 nm centralized), consistently matching or outperforming both centralized and local-only models, with notable gains in image quality (PSNR) and width accuracy. These results demonstrate that federated learning preserves and even enhances predictive quality while ensuring data conﬁdentiality, providing a viable pathway for collaborative, cross-foundry digital twin development in advanced semiconductor manufacturing.},
	language = {en},
