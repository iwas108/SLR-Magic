@article{zhang_real-time_2026-1,
	title = {Real-time structural flexibility compensation for modal decoupling control of hydraulic redundant parallel mechanism via digital twins},
	volume = {175},
	issn = {09670661},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0967066126003345},
	doi = {10.1016/j.conengprac.2026.107091},
	abstract = {High-ﬁdelity vibration testing using hydraulic redundant 6-DOF parallel mechanisms (HR6DPMs) is fundamentally constrained by acceleration coupling and structural ﬂexibility, which conventional controllers designed under rigid-body assumptions fail to address in real-time. This paper proposes a dedicated Digital Twin (DT) framework designed to achieve simultaneous real-time multi-dimensional condition monitoring and active structural ﬂexibility compensation during operation. To overcome the computational latency of traditional ﬁnite element analysis (FEA), a deep learning (DL) surrogate model is constructed to predict global stress and deformation. This model not only oﬀers real-time visualization of global stress distribution but also enables synchronized feedback within the millisecond-level control loop. By integrating real-time deformation prediction into the inverse kinematics (IK) solver, a novel Flexibility-considered Modal (Modal-FM) decoupling control strategy is proposed to dynamically compensate for deformation errors. Experimental validation on the physical HR6DPM demonstrates the feasibility of real-time condition monitoring and conﬁrms that the Modal-FM strategy signiﬁcantly outperforms standard modal decoupling. The results validate a new paradigm for fusing data-driven surrogate models with physical control, providing an integrated solution from state perception to high-precision vibration suppression for complex ﬂexible systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Control Engineering Practice},
	author = {Zhang, Bing and Han, Pengzhi and Tang, Xinrui and Liu, Hongyu and Khalid, Ahtesham and Dai, Kaiyu and Zhang, Zhongqiang},
