@inproceedings{mahmud_digital_2025,
	address = {Dhaka, Bangladesh},
	title = {Digital {Twin} {Technology} for {Real}-{Time} {Monitoring} and {Optimization} of {5G} {Networks}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-8827-4},
	url = {https://ieeexplore.ieee.org/document/11414941/},
	doi = {10.1109/ICTP68765.2025.11414941},
	abstract = {The fast globalizing 5G networks come with peaked data rates latency as well as connectivity density but with an augmented complexity of conducting operations. The active and distributed nature of 5G infrastructure is a problem that traditional methods of network monitoring have a hard time addressing since they tend to be reactive in nature. In that regard, this paper proposes a system of real-time monitoring that can be performed on the basis of Digital Twin (DT) within a 5G network. The framework integrates telemetry enabled by Internet of Things, predictive analytics guided by artificial intelligence and bi-directional synchronization of physical and virtual network elements. The combination provides a possibility of anomalies detection and predictive maintenance at an early stage as well as performance optimization on a continuing basis. Tested in a controlled lab setting, the detection accuracy on anomalies is proven to be 94.6\% and the median time of prediction is 120 seconds. Also, there is a 23 percent decrease within Mean Time to Repair (MTTR) and about 18 percent increase in Quality of Service (QoS) amid high network loads as compared with traditional monitoring systems. These findings demonstrate the opportunities that DT-enabled monitoring has to improve fault detection abilities, minimize downtime, and ostensibly network resilience. Digital Twin technology is presented as a major facilitator of future intelligent network management due to the proposed framework providing a scalable and effective mechanism to plan the complexities of the 5G operations.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {IEEE} {International} {Conference} on {Telecommunications} and {Photonics} ({ICTP})},
