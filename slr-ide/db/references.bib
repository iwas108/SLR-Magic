@article{li_digital_2026-1,
	title = {Digital twin of temperature field in collimating optical system based on hybrid neural network},
	volume = {273},
	issn = {02632241},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S026322412600895X},
	doi = {10.1016/j.measurement.2026.121186},
	abstract = {In cryogenic environments, optical systems play an increasingly critical role in areas such as space exploration, infrared guidance and detection systems. Real-time monitoring and prediction of temperature fluctuations and the resultant structural changes in optical systems are complex challenges. Digital twin approaches have achieved significant progress in system monitoring and prediction across various fields. A hybrid neural network–based digital twin of the temperature field in the collimating optical system is proposed. The proposed hybrid model, which combines long short-term memory (LSTM) and Transformer networks, models sensor data to develop a temperature prediction model. The model demonstrates high prediction accuracy, with a mean absolute percentage error (MAPE) of 2.812\% and a root mean square error (RMSE) of 2.999 on the test data. The temperature predictions of the primary, secondary, and tertiary mirrors under different environmental conditions through transfer learning also achieved satisfactory predictive accuracy. Finally, based on the temperature prediction model, the key parameters of the collimating optical system such as temperature field, stress strain, surface shape are characterized. This model provides a scientific basis for system maintenance and fault prevention within the validated experimental framework, and demonstrates potential for enhancing the reliability of similar collimating optical systems under cryogenic conditions.},
	language = {en},
