	doi = {10.1109/ICHBC68357.2025.11414619},
	abstract = {The proliferation of sensing terminals in industrial monitoring environments has led to a signiﬁcant increase in computational tasks, imposing stringent demands on both computing power and low-latency. With the limited resources of terminals, the mismatch between demands and resource constraints constitutes a key bottleneck to improve monitoring efﬁciency. Although resource pressure is alleviated by edge computing through the end-edge direct ofﬂoading mode, the signiﬁcant spatial imbalance in monitoring tasks often leads to issues. To fully unleash the potential of distributed computing resources, when a direct edge server lacks sufﬁcient resources, permitting tasks to be forwarded via a multi-hop mechanism to more suitable nodes, is a promising solution. To this end, a digital-twin (DT)-driven edge computing power network framework for industrial monitoring is constructed. On the basis of clarifying the models design, with the objective of minimizing the average task processing delay, the multi-hop collaborative ofﬂoading is formulated as an optimization problem. Leveraging the DT environment as a reliable platform for training and validation, a proximal policy optimization (PPO)-based ofﬂoading algorithm combined with a cosine annealing learning rate scheduler, dubbed PPOCALR, is designed, autonomously learning to generate optimal ofﬂoading decisions, and achieving low-latency and highly reliable monitoring services. Simulation results demonstrate that PPOCALR outperforms compared algorithms in key performance metrics, validating the effectiveness and superiority.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 5th {International} {Conference} on {High} {Performance} {Computing}, {Big} {Data} and {Communication} {Engineering} ({ICHBC})},
