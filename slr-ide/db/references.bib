	title = {{TwinExplainer}: {Explaining} {Predictions} of an {Automotive} {Digital} {Twin}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-2400-5},
	shorttitle = {{TwinExplainer}},
	url = {https://ieeexplore.ieee.org/document/11050678/},
	doi = {10.1109/CAI64502.2025.00186},
	abstract = {Modern vehicles are complex Cyber-Physical Systems (CPS) that operate across diverse environments, where the failure of critical subsystems such as the engine, transmission, brakes, and fuel system can lead to unplanned downtime and signiﬁcant maintenance costs. To mitigate these challenges, continuous health monitoring and early detection of abnormal sensor behavior are essential. Data-driven Digital Twin (DT) systems offer a promising solution to this problem by leveraging sensor data to model and predict the state of vehicle subsystems. However, existing DT solutions primarily rely on Deep Learning (DL) techniques, which often function as blackbox models, providing little to no insight into their decisionmaking processes. This lack of explainability hinders trust and informed decision-making among automotive stakeholders. To address this challenge, this paper presents TwinExplainer, a novel three-layered architectural pipeline designed to explain the predictions made by deep learning algorithms in data-driven DT. TwinExplainer provides visual explanations through graphs and complements them with linguistic explanations generated by Large Language Models (LLM), offering stakeholders intuitive insights into feature contributions and model behavior at both local and global levels.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {IEEE} {Conference} on {Artificial} {Intelligence} ({CAI})},
	publisher = {IEEE},
	author = {Neupane, Subash and Mitra, Shaswata and Fernandez, Ivan A. and Mittal, Sudip and Rahimi, Shahram},
