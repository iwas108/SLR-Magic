@article{ganji_physics-informed_2026,
	title = {Physics-informed deep operator network for real-time dynamic simulation of extruded-absorber photovoltaic/thermal collectors},
	volume = {289},
	issn = {13594311},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1359431126000037},
	doi = {10.1016/j.applthermaleng.2026.129695},
	abstract = {Photovoltaic/thermal (PVT) collectors with extruded absorbers offer superior thermal coupling and enhanced heat extraction compared to conventional sheet-and-tube designs. However, their dynamic modeling under realistic, time-varying environmental and operational conditions remains computationally prohibitive for realtime applications such as digital twins, predictive control, and online optimization. To address this gap, this study introduces a novel hybrid physics-informed deep operator network (PINN-DeepONet) speci6cally tailored for PVT-water collectors. A high-6delity transient numerical model based on 6rst-principles energy balances was developed and solved across variable solar irradiance (43–850 W/m²), ambient temperatures (22–25 ◦C), wind speeds (1–4 m/s), and coolant mass ?ow rates (2.8–14.1 kg/h) to generate a comprehensive training dataset. The proposed PINN-DeepONet uniquely integrates operator learning with embedded thermodynamic constraints, ensuring physical consistency while enabling ultra-fast inference. The model accurately predicts the spatiotemporal temperature evolution across all seven structural layers of the PVT collector, achieving a mean absolute error (MAE) below 0.8 ◦C and a coef6cient of determination (R²) exceeding 0.99. Rigorous validation against both experimental and numerical benchmarks con6rms the framework’s reliability. By enabling millisecondlevel dynamic simulation without sacri6cing physical 6delity, this approach provides a robust foundation for real-time digital twin deployment, control, and optimal design of advanced water-cooled extruded-absorber PVT systems. The methodology is readily extensible to other hybrid energy systems governed by coupled thermal–electrical dynamics.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Applied Thermal Engineering},
	author = {Ganji, Ali Mirzagoli and Ganji, Davood Domiri and Jalili, Payam and Jalili, Bahram},
