@inproceedings{ma_hierarchical_2025,
	address = {Xining, China},
	title = {Hierarchical {Edge}-{Cloud} {Digital} {Twin} for {Power} {Systems}: {Real}-{Time} {Simulation} and {Adaptive} {Regulation}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9118-2},
	shorttitle = {Hierarchical {Edge}-{Cloud} {Digital} {Twin} for {Power} {Systems}},
	url = {https://ieeexplore.ieee.org/document/11413556/},
	doi = {10.1109/PSGAI68158.2025.11413556},
	abstract = {As modern power systems become more complex and time-critical, an edge-cloud collaborative digital twin that supports sensing, prediction, and control is essential for reliable operation. This paper proposes a Hierarchical Edge-Cloud Digital Twin Framework (HECDTF) for real-time simulation and adaptive regulation. HECDTF consists of: (1) a Multi-Granularity State Synchronization Module (MG-SSM) that fuses high-frequency edge measurements with lower-frequency cloud dispatch states via a time-aware graph encoder; (2) a Distributed Event-Driven Simulation Scheduler (DEDSO) deployed at the edge to trigger millisecond-level simulation only when anomalies occur; and (3) a Cloud Adaptive Regulation Planner (CARP) that combines deterministic actor-critic learning with cooperative multi-agent policy optimization for generation-load coordination and adaptive relay protection. Importantly, the framework is evaluated under severe disturbances and extreme failure emulations, where it maintains stable synchronization and timely control. Experiments show that compared with representative edge-only and cloudcentralized baselines, HECDTF reduces decision-making delay by 35.6\% while achieving lower synchronization latency and more robust stability across disturbance conditions.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {International} {Conference} on {Power} {Systems}, {Smart} {Grid}, and {Artificial} {Intelligence} ({PSGAI})},
	publisher = {IEEE},
	author = {Ma, Fuliang and Ma, Yuping and Dang, Yuzhen and Lu, Gong},
	month = dec,
