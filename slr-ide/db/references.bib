	abstract = {Thermo-mechanical degradation in Solid Oxide Fuel Cells (SOFCs) during dynamic thermal cycling is induced by localized temperature gradients, leading to strains that can cause fractures and seal failures. This initiative creates an AI-based digital twin framework for real-time predictive defect identification. The framework integrates a proven two-dimensional thermo-electrochemical model, an Unscented Kalman Filter (UKF) for realtime state estimation, and machine learning models (LSTM/CNN) for anomaly detection. The system, employing a 5 × 5 node discretization, was assessed against 500 h of experimental data and simulated fault scenarios, exhibiting consistent performance despite @ow or current variations of up to 25\%. The hybrid physics-AI methodology achieves sub-degree accuracy in thermal field predictions and exhibits high reliability in defect detection, reliably identifying leaks (even simulated severe leaks), cracks, and delamination with 93.4\% precision. The architecture demonstrates simulated scalability across stack size (from 15 × 15 cm2 to 20 × 20 cm2), enabling predictive maintenance and enhancing the operational resilience of next-generation SOFC systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Journal of Power Sources},
	author = {Christopher, George Gershom and Olalekan, Olajide Rasheed and Huguette Maeva, Monkam Ngameni and Hassan, Butera and Ayegba, Sunday},
	month = jun,
