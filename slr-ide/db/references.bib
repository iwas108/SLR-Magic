@inproceedings{ravikanth_digital_2026,
	address = {Kanyakumari, India},
	title = {A {Digital} {Twin}–{Assisted} {Industrial} {IoT} {Framework} for {Predictive} {Maintenance} and {Energy} {Optimization}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-7006-4},
	url = {https://ieeexplore.ieee.org/document/11506661/},
	doi = {10.1109/ICTMIM68190.2026.11506661},
	abstract = {IIoT (Industrial Internet of Things) provides the means to support smart Manufacturing through continuous monitoring, automated processes, and data driven decision making. Traditional methods of predictive maintenance that use the IIOT tend to focus on the use of static analytics and the cloud, which limit the flexibility of predictive maintenance systems. Because of this limitation, predictive maintenance systems become less effective in situations where operations are frequently changing. In addition, unplanned downtime and excessive power consumption result from these limitations. To resolve the issues created by these limitations, this study discusses the incorporation of a digital twin supported by an IIOT framework into a predictive-maintenance and energyoptimization setting. A digital twin is created by synchronizing real-time data from multiple sensors with an edge-based digital twin model of the system being monitored. The machine learning techniques used to embed the digital twins allow for increased accuracy in determining future failures of an asset as well as a better estimate of how long the asset will continue to function productively. Finally, the digital twin model provides a mechanism to manage a dynamic infrastructure of the predictive-maintenance and energy-optimization processes. Compared with existing IoT Repair and Maintenance Solutions, our proposed method has greater flexibility, lower energy consumption, and higher accuracy for Maintenance. The results from testing in a hybrid hardware/simulation configuration show that the framework decreased both operational energy consumption and Maintenance overheads whilst increasing System Reliability. The results show that Digital Twin Driven Intelligence can be used as a scalable and sustainable Solution for Next Generation Industrial Internet of Things Systems.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 6th {International} {Conference} on {Trends} in {Material} {Science} and {Inventive} {Materials} ({ICTMIM})},
