@inproceedings{yang_study_2026,
	address = {Guangzhou, China},
	title = {A {Study} on {Digital} {Twin}-{Driven} {Predictive} {Maintenance} {Methods} for {High}-{Speed} {Winding} and {Baling} {Equipment}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-6178-9},
	url = {https://ieeexplore.ieee.org/document/11525488/},
	doi = {10.1109/ICMTIM69588.2026.11525488},
	abstract = {The application of artificial intelligence and advanced intelligent algorithms has significantly promoted the development of predictive maintenance in industrial equipment. In this study, a digital twin-driven predictive maintenance framework is proposed for high-speed winding and packaging equipment, with a focus on capturing multi-physics coupling characteristics and fault propagation behavior. Specifically, a hierarchical virtual-physical mapping mechanism is established to construct the digital twin, in which physical components, operational states, and dynamic parameters are continuously synchronized within a unified information space. Multi-source sensor data, including vibration signals, temperature responses, load variations, and rotational speed, are collected and processed through a series of steps, including noise filtering, time alignment, feature extraction, and feature-level fusion. This process enables the construction of a unified and dynamically updated health state representation of the equipment. Based on the fused state representation, dynamic parameter updating strategies and degradation modeling methods are integrated into a time-series prediction framework to perform fault prediction and remaining useful life (RUL) assessment. Experimental results demonstrate that the proposed method achieves a fault prediction accuracy of 95.2\%, outperforming the LSTM model by 1.7\%, while reducing the MAE of RUL prediction to 12.1 cycles, approximately 20\% lower than that of the baseline model. These results indicate that the proposed framework exhibits strong accuracy, robustness, and stability under complex operating conditions.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 7th {International} {Conference} on {Mechatronics} {Technology} and {Intelligent} {Manufacturing} ({ICMTIM})},
