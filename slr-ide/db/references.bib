@article{chen_automatic_2026,
	title = {Automatic management of shield attitude: insights from sensor data analysis and hybrid machine learning},
	volume = {73},
	issn = {14740346},
	shorttitle = {Automatic management of shield attitude},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1474034626002132},
	doi = {10.1016/j.aei.2026.104521},
	abstract = {Shield attitude control is vital for tunnel safety, yet existing single-scene models lack generalization and real-time adaptability across diverse geologies. Herein, a digital twin (DT)-driven intelligent control framework integrating the improved black kite algorithm (IBKA), natural gradient boosting (NGBoost), and NSGA-III is proposed to achieve automated, optimal attitude management. Using a Wuhan metro underpass as a case study, the framework’s performance was validated across typical geological conditions. Key results demonstrate that (1) the IBKA-NGBoost prediction model achieves an optimal accuracy-ef9ciency trade-off for small-sample data under two geological conditions, with R2values exceeding 0.91 for seven attitude indicators and a training time of only 29.2 s; (2) the integrated IBKA-NGBoost-NSGA-III framework enables adaptive multiscenario optimization, reducing deviations of the seven attitude parameters by an average of 69.3\%; adjustment of the 12 key construction variables yielded a maximum improvement of 84.8\%; and (3) embedding this algorithm into a DT system enhanced real-time regulatory capability, supporting adaptive adjustment for improved construction guidance and safety. Consequently, the proposed method enables adaptive adjustment, thereby supporting construction guidance and safety management.},
	language = {en},
	urldate = {2026-07-23},
