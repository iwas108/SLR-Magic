	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-6606-7},
	url = {https://ieeexplore.ieee.org/document/11390992/},
	doi = {10.1109/ISPDS67367.2025.11390992},
	abstract = {Digital-twin systems rely on multivariate time-series data to enable dynamic mapping of physical processes and to support decision optimization. Despite their high predictive accuracy, many deep-learning models provide limited interpretability. In contrast, traditional Granger causality (GC) methods often show weak robustness when faced with nonlinear coupling, long time lags, and high-dimensional dependencies typical of industrial processes.To address these challenges, we propose an end-to-end causal-discovery framework, GC-HCTCN. The framework uses differentiable group gating (HardConcrete) to perform structured, variable-level sparsification, thereby mitigating multicollinearity at its source. A Temporal Convolutional Network (TCN) acts as the core predictor and leverages dilated convolutions and residual connections to capture nonlinear dynamics and long-range temporal dependencies. Causal strength is estimated by a gating-based zeroing mechanism that simulates variable exclusion; the induced change in prediction error yields an interpretable causal measure.Experiments on the Lorenz–96 and titanium-smelting-furnace datasets show that GCHC-TCN accurately identifies causal structures in strongly nonlinear, long-lag settings and outperforms conventional GC baselines. Ablation studies further confirm that sparse gating and the TCN backbone are key contributors to the observed gains in causal-discovery performance.},
	language = {en},
	urldate = {2026-07-23},
