@article{cureno-ramirez_data-driven_2026,
	title = {Data-{Driven} estimation of experimental signals in {TJ}-{II}: {A} proof of principle},
	volume = {230},
	issn = {09203796},
	shorttitle = {Data-{Driven} estimation of experimental signals in {TJ}-{II}},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0920379626002346},
	doi = {10.1016/j.fusengdes.2026.115847},
	abstract = {Magnetic confinement fusion experiments operate with extensive diagnostic coverage and high per-shot costs. Although machine operation is guided primarily by expert knowledge, theoretical understanding and decades of experimental experience, many aspects of scenario development still require exploring actuator trajectories whose consequences are uncertain until a discharge is executed. In this context, it is appealing to develop fast surrogate models capable of forecasting selected diagnostic signals, enabling in silico evaluation of candidate scenarios before committing machine time. Such capabilities would contribute to the long-term vision of digital twin infrastructures, which are beginning to gain traction in fusion but are not yet standard tools.},
