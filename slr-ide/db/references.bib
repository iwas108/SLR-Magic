@article{thosar_online_2026,
	title = {Online parameter estimation and model maintenance using parameter-aware physics-informed neural network},
	volume = {204},
	issn = {00981354},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0098135425004065},
	doi = {10.1016/j.compchemeng.2025.109403},
	abstract = {Machine learning-based (ML) digital twins for chemical processes are gaining popularity with the advent of Industry 4.0. These digital twins are often developed under the assumption of constant process parameters. However, in most chemical engineering processes, parameters often change during operations. To ensure optimal performance under such evolving conditions, there is a need for models that can adapt to these changes. In this work, we propose a framework for developing a PINN-based (Physics-Informed Neural Network) digital twin that is sensitive to parameter variations. The proposed framework also monitors the process in real-time using physics-based residual equations, identifies the parameters undergoing changes using sensitivity matrices, and re-estimates them to maintain the performance of the PINN model. We demonstrate the utility of the framework through a case study involving a continuous stirred tank reactor experiencing changes in activation energy and the overall heat transfer coefficient. The results show that the proposed framework improves the predictive accuracy of the PINN by approximately 84\% for ramp changes and 12\% for step changes in parameters. The framework is further applied to more realistic case studies, including a polymethyl methacrylate polymerization reactor and a pressure swing adsorption process, highlighting its applicability to high-dimensional nonlinear systems and cyclic separation processes. These findings indicate that the performance of digital twins can be significantly enhanced in the presence of varying process parameters by employing a PINN architecture that incorporates parameters as inputs and solves real-time inverse problems to estimate parameter values.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Computers \& Chemical Engineering},
	author = {Thosar, Devavrat and Bhakte, Abhijit and Li, Zukui and Srinivasan, Rajagopalan and Prasad, Vinay},
	month = jan,
	year = {2026},
	pages = {109403},
	file = {Thosar_2026_Onlineparameter_a4cee:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Thosar_2026_Onlineparameter_a4cee.pdf:application/pdf},
}

@article{zhumadillayeva_intelligent_2026,
