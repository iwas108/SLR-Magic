@article{zhu_digital_2026,
	title = {A digital twin framework for real-time operation monitoring and its future prediction for space nuclear power},
	volume = {267},
	issn = {09518320},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0951832025010439},
	doi = {10.1016/j.ress.2025.111843},
	abstract = {To address the scarcity of data in space nuclear power (SNP) systems, this study presents a novel digital twin (DT) framework for SNPs that integrates of1ine and online stages. The framework ensures real-time interaction and supports online state correction and prediction. In the of1ine stage, sensitivity and grey relational analyses are combined to identify measurement parameters. A real-time multivariate )lter is developed to suppress noise and outliers, and the Gaussian process regression is optimized to establish an effective data-driven model. In the online stage, a hybrid data–model driven framework corrects the DT system and predicts future state intervals, supported by an adaptive period update method to balance real-time response and computational accuracy. Six transient datasets are used to validate the framework. The results show that the maximum relative error is reduced from 10.58 \% to 1.56 \%, with the )lter achieving a maximum average error of 0.3 \% and an average computational time of 897 ms per 1 s step. The uncertainty interval encompasses the true value with a coverage probability of approximately 99 \%, and the corrected results for the 3D reactor and 2D heat pipe agree well with the reference results. Therefore, the DT framework meets real-time and accuracy requirements.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Reliability Engineering \& System Safety},
	author = {Zhu, Enping and Li, Tao and Xiong, Jinbiao and Chai, Xiang and Zhang, Tengfei and Liu, Xiaojing},
