	doi = {10.1109/ICPS70486.2026.11567939},
	abstract = {Driven by the need for process optimization and flexible adaptation of process plants for new recipes in the food industry, Digital Twins (DTs) offer a high potential for supporting plant operators to achieve these ambitious control objectives. However, integrating DTs into legacy brownfield filtration plants, characterized by legacy PLCs and limited connectivity to highperformance clouds, presents a major challenge. This article’s main contribution is an investigation into how DTs can be effectively integrated into legacy system architectures, while considering the unique requirements and constraints of two representative industrial use cases (UCs) from the food industry: Offline recommendation of process control settings (UC1) and automated real-time process optimization (UC2). As a result, a generalized system architecture concept for integrating DTs is derived. A second, parallel data channel implemented via hardware gateways facilitates data aggregation across automation pyramid levels without requiring modifications to legacy PLCs. The specific needs of each UC are addressed through a multi-stage approach that combines a cloud DT for high-performance data analysis (UC1) and a local edge DT for live process intervention (UC2). The architecture's functional suitability is evaluated by running a DT’s representative data-driven forecasting model on different hardware platforms and database technologies to assess data handling and processing for the local DT.},
	language = {en},
	urldate = {2026-07-23},
