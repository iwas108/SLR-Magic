@article{luo_benchmarking_2025,
	title = {Benchmarking deep learning models for {ET0} forecasting on edge devices},
	volume = {56},
	issn = {19989563},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1998956326005276},
	doi = {10.2166/nh.2025.130},
	abstract = {This study addresses the hydrological challenge of precision irrigation scheduling by developing an edge-computing framework for multivariate forecasting using meteorological and soil sensor data. We evaluate ﬁve deep learning (DL) architectures – Gated Recurrent Unit (GRU), Long Short-Term Memory (LSTM), Recurrent Neural Network (RNN), Temporal Convolutional Network (TCN), and Lightweight Transformer (L-Transformer) – across three input window lengths (6, 12, 24 h) on two platforms: Intel i5 CPU and Raspberry Pi 4B. On Raspberry Pi 4B, the GRU model achieved R2 ¼ 0.9888, MAE ¼ 0.0108, average inference latency per input sample ¼ 1.33 ms, and optimized memory usage ≈106 MB. Results show that deployment constraints and system conﬁguration signiﬁcantly impact forecasting performance. Among all models, GRU achieves R2 . 0.98 and demonstrates superior robustness across platforms. For real-world deployment in edge-AI irrigation systems, we propose a dual-axis evaluation framework – normalized accuracy vs. inference efﬁciency – and a three-stage optimization roadmap. This includes model quantization, hybrid inference, and integration into cloud-edge digital twin systems. Validated with real-world data from Sichuan, China, this work provides hydrologists and agricultural water managers with a reproducible methodology for deploying low-power forecasting systems in bandwidth-limited catchments, emphasizing trade-offs between prediction ﬁdelity and operational viability.},
	language = {en},
	number = {12},
	urldate = {2026-07-23},
	journal = {Hydrology Research},
	author = {Luo, Kai and Lim, Cheng Siong and Ishak, Mohamad Hafis Izran Bin and Mahmud, Mohd Saiful Azimi and Ba, Ni},
