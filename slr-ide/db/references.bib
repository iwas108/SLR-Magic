@article{ebrahimi_digital_2025,
	title = {Digital {Twin}-{Driven} {Health} {Management} in {Microgrids}},
	volume = {13},
	copyright = {https://creativecommons.org/licenses/by/4.0/legalcode},
	issn = {2169-3536},
