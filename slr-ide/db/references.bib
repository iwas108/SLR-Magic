	pages = {670},
	file = {Xing_2025_EngineeringOrie_326ee:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Xing_2025_EngineeringOrie_326ee.pdf:application/pdf},
