@inproceedings{li_fault_2024,
	address = {Beijing, China},
	title = {Fault {Mechanism} {Assisted} {Intelligent} {Fault} {Diagnosis} {Method} {Based} on {Improved} {Generative} {Adversarial} {Network} for {Two}-{Stage} {Gearbox}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3503-5401-0},
	url = {https://ieeexplore.ieee.org/document/10874587/},
	doi = {10.1109/PHM-Beijing63284.2024.10874587},
	abstract = {Artificial intelligence and digital twin technology show the excellent ability in the fault prognostic and health management of machinery equipment. However, interaction between the data driven and physical informed is a challenge for modeling the digital twin framework. In response to this limitation, a fault mechanism assisted intelligent fault diagnosis method based on improved generative adversarial network for digital twin twostage gearbox is proposed. Firstly, the twenty-six degree-offreedom dynamic model is established to realize the virtual entity of two-stage gearbox. The initial parameters of dynamic model are determined by the prior knowledge based on the fault mechanism of gear. Then, the improved generative adversarial network is designed to achieve the interaction of virtual entity and physical entity. The measured signal from the physical entity is used to train the proposed model for minimizing the difference of simulation signal from the dynamic model. The loss of proposed model is introduced by combining the physics knowledge of gear dynamic mechanism and observations from the sensor. Finally, the proposed method is applied to simulate the vibration signal of gear fault under different conditions that is consistent with the measured signal, which can be applied for the fault diagnosis of gear. The two-stage gearbox fault experiments with missing sample are used to verify the effectiveness of the proposed methods.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2024 {Global} {Reliability} and {Prognostics} and {Health} {Management} {Conference} ({PHM}-{Beijing})},
