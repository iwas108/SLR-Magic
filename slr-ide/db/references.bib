@inproceedings{wang_energy-adaptive_2025,
	address = {Tumkur, India},
	title = {Energy-{Adaptive} {Reinforcement} {Learning} {Integrated} with {Safe} {Model} {Predictive} {Control} for {Electrical} {Automation} system},
