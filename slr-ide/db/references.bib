@article{tessaro_hybrid_2026,
	title = {Hybrid symbolic regression framework for digital twin modeling of gas internal combustion engines},
	volume = {344},
	issn = {03605442},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0360544226001374},
	doi = {10.1016/j.energy.2026.140035},
	abstract = {This study introduces a real-time, control-oriented digital twin framework for hydrogen internal combustion engines (H2ICEs) identified from production actuator command signals and a measured torque target. The objective is to reproduce the torque-path input–output behavior seen by the engine control unit under transient operation, enabling controller prototyping (including predictive strategies that rely on torque prediction), hardware-in-the-loop evaluation, and fault detection under a fixed calibration. A recursive symbolic regression framework is developed by integrating the Robust Iterated Local Search with Ordinary Least Squares (RILSROLS) and Operon algorithms within a Nonlinear Finite Impulse Response (NFIR) configuration. The method iteratively refines model accuracy while maintaining low computational cost and interpretability. Using experimental data from a heavy-duty 13-liter spark-ignited H2ICE operated under the World Harmonized Transient Cycle (WHTC), the recursive NFIR model improved its root mean square error (RMSE) by 47.2\% over 27 iterations, achieving a coefficient of determination (𝑅2) of 0.9892 and an RMSE of 52.33 [N .m] (newtonmeter) with a final model size of 632 [B] (bytes). To capture residual dynamics, a hybrid modeling strategy was employed in which the NFIR model served as a baseline predictor and black-box regressors were trained on its residuals. The best configuration, HNFIRTabPFN, reached an 𝑅2 of 0.9981 and an RMSE of 21.90 [N .m], improving accuracy at the expense of model size of 101 [MB] (megabytes). This trade-off highlights that while the standalone NFIR model is ideal for embedded real-time deployment, the hybrid models are better suited for high-fidelity offline simulation within the studied operating domain when maximum predictive precision is required.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Energy},
	author = {Tessaro, Iron and Mariani, Viviana Cocco and Coelho, Leandro Dos Santos and Ayala, Helon Vicente Hultmann},
	month = feb,
	year = {2026},
	pages = {140035},
	file = {Tessaro_2026_Hybridsymbolicr_49117:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Tessaro_2026_Hybridsymbolicr_49117.pdf:application/pdf},
}

@article{malgi_digital_2026,
	title = {Digital twin-enabled crop yield prediction in semi-arid agriculture: a continuous feedback machine learning framework},
	volume = {157},
	issn = {0177-798X, 1434-4483},
	shorttitle = {Digital twin-enabled crop yield prediction in semi-arid agriculture},
	url = {https://link.springer.com/10.1007/s00704-026-06150-w},
	doi = {10.1007/s00704-026-06150-w},
	abstract = {Agricultural productivity faces signi¿cant challenges from erratic monsoon patterns, soil degradation, and climate variability, necessitating advanced predictive systems for informed decision-making. This study develops and validates a comprehensive machine learning framework for crop yield prediction and introduces a novel digital twin architecture with continuous feedback mechanisms for operational deployment in semi-arid rainfed agriculture. Data spanning ¿ve years (2019–2024) were compiled from eight districts covering 55,000 square kilometers, integrating weather parameters (temperature, rainfall, humidity, wind speed), soil properties (pH, organic carbon, NPK nutrients, electrical conductivity), and yield records for major crops including jowar, cotton, groundnut, and pulses. Four machine learning algorithms—Random Forest (RF), Gradient Boosting (GB), Support Vector Regression (SVR), and Arti¿cial Neural Networks (ANN)—were systematically evaluated using ¿ve-fold cross-validation and rigorous hyperparameter optimization. Random Forest demonstrated superior performance with R² values of 0.87, 0.84, and 0.82 for jowar, cotton, and groundnut respectively, with corresponding mean absolute errors of 0.94, 2.21, and 1.52 quintals per hectare. Feature importance analysis revealed rainfall distribution during critical growth stages (14–18\% importance) and soil organic carbon content (11–15\% importance) as dominant predictors across all crops, providing actionable insights for agricultural interventions. The study’s distinctive contribution lies in the proposed digital twin framework enabling sequential prediction updates throughout the growing season through real-time data assimilation and automated model retraining protocols. Preliminary pilot implementation across 50 farmers in Dharwad and Belgaum districts demonstrated operational feasibility with comparable prediction accuracy (R²: 0.85–0.88) and high farmer satisfaction (85\%). Spatial validation revealed systematic performance variation with weather station density and climate variability, with R² ranging from 0.79 to 0.90 across districts. This research advances precision agriculture in rainfed semi-arid systems by demonstrating that ensemble machine learning, coupled with continuous learning architectures, can transform agricultural decision-making under increasing climate uncertainty, o൵ering a scalable framework for similar agro-ecological zones globally.},
	language = {en},
	number = {4},
	urldate = {2026-07-23},
	journal = {Theoretical and Applied Climatology},
	author = {Malgi, Shrikant and K, Manjunath M and T, Avinash H},
	month = apr,
	year = {2026},
	pages = {230},
	file = {Malgi_2026_Digitaltwinenab_148a2:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Malgi_2026_Digitaltwinenab_148a2.pdf:application/pdf},
}

@article{noauthor_international_2003,
	title = {International {Journal} of {Computer} {Integrated} {Manufacturing}},
	volume = {16},
	issn = {0951-192X, 1362-3052},
	url = {http://www.tandfonline.com/doi/abs/10.1080/0951192031000075962},
	doi = {10.1080/0951192031000075962},
	abstract = {In the Industry 5.0 era, managing complex multi-source sensor data has become critical for manufacturing system design. Conventional methods face signiﬁcant challenges in handling spatiotemporal correlations, data incompleteness, and external disturbances. This paper introduces an innovative digital twin (DT) framework inspired by the concept of digital cousins (DCs) to address these challenges. The proposed architecture enables continuous system monitoring and predictive analytics, even under partial sensor failure conditions. Our approach integrates two key components: spatiotemporal recovery through twin modeling and predictive analysis utilizing DCs. The twin modeling component prioritizes error minimization in monitoring systems aﬀected by data attacks or sensor malfunctions. We develop a specialized twin model for nonlinear time-series data, achieving high-precision reconstruction of low-rank spatiotemporal information to enhance sparse sensing capabilities. Meanwhile, DCs perform semantic analysis on multivariate time-series data, strengthening critical feature representation through hierarchical abstraction. The framework synergistically combines twin models, DCs, and an iterative inference mechanism to create interactive prediction capabilities that dynamically adapt to missing data states. Extensive experiments conducted in large-scale industrial environments demonstrate that our proposed approach achieves outstanding recovery and predictive accuracy for monitoring systems.},
	language = {en},
	number = {3},
	urldate = {2026-07-23},
	journal = {International Journal of Computer Integrated Manufacturing},
	month = jan,
