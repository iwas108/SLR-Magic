@article{pena_architecting_nodate,
	title = {Architecting {Machine} {Learning} and {Digital} {Twin} {Solutions} for {Emissions} {Mitigation} and {Maintenance} in {Large}-{Bore} {Spark}-{Ignition} {Engines}},
	abstract = {A digital twin-based framework for predictive maintenance, load estimation, and emissions control in large-bore sparkignition engines is presented in this study. The methodology integrates laboratory development on an AJAX DPC-81 testbed with field validation on an IoT-instrumented AJAX DPC-42, demonstrating robustness under real-world conditions. Benchmarking of twenty candidate machine-learning models identified Ridge Regression as the preferred estimator, combining 94.1 \% load-prediction accuracy with a 240 ms inference latency that fits the edge-device budget. Sensitivity analysis shows that suction pressure, engine speed, and discharge pressure dominate load behavior, incorporating these variables in the twin’s closed-loop control reduced CH₄ emissions by 84 \% and NOₓ by 63 \%. During a two-year field deployment, the anomaly-detection module predicted a suction-pressure drift 36 h before the high-alarm threshold, demonstrating early-fault capability. These results confirm that integrating physics-based modelling with machine-learning analytics in a digital twin can enhance operational efficiency, cut emissions, and deliver actionable diagnostics for large industrial engines.},
	language = {en},
	author = {Pena, Carlos C and Ansari, Mohammed A and Yousuf, Abu and Hassan, Hafiz A and Kazempoor, Pejman},
	file = {Pena_2025_ARCHITECTINGMAC_bc055:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Pena_2025_ARCHITECTINGMAC_bc055.pdf:application/pdf},
}

@article{gu_digital_2025,
	title = {Digital twin-driven real-time collaborative scheduling for {U}-shaped automated container terminals},
	volume = {63},
	issn = {0020-7543, 1366-588X},
	url = {https://www.tandfonline.com/doi/full/10.1080/00207543.2025.2555540},
	doi = {10.1080/00207543.2025.2555540},
	abstract = {Focusing on the multi-equipment cooperative scheduling problem of U-shaped automated container terminals (MECSP-UACT), this paper investigates the dynamic cooperative optimisation of automated guided vehicles (AGVs), external trucks (ETs), and yard cranes (YCs). Existing scheduling models diverge significantly from real-world logistics systems, limiting their practical application. High-fidelity digital twin (DT) environment accurately replicates logistics processes and provides an effective platform for algorithm training and validation. A DT-based collaborative scheduling environment using deep reinforcement learning (DRL) is proposed. A three-layer ‘Physical-Twin-Decision’ architecture is built. The physical layer collects real-time data from AGV locations, ET appointments, and YC statuses via IoT. The twin-layer model uses the U-ACT as a training environment to ensure model completeness. The decision layer uses Proximal Policy Optimization (PPO) for offline training and online scheduling, addressing real-time scheduling challenges. Historical freight data from a southeastern hub port is used for experiments. Results demonstrate the method’s applicability under complex and dynamic conditions.},
	language = {en},
	number = {24},
	urldate = {2026-07-23},
