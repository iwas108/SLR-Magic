@article{gu_digital_2026,
	title = {Digital twin based thermo-mechanical durability prediction of scaled specimens of non-pneumatic tires fabricated via subtractive manufacturing},
	volume = {353},
	issn = {00323861},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0032386126003629},
	doi = {10.1016/j.polymer.2026.129915},
	abstract = {Non-pneumatic tires (NPTs) eliminate the potential blowout risks associated with traditional pneumatic designs, effectively improving tire durability and vehicle reliability under complex or extreme operating conditions. This study proposes a digital twin framework to evaluate the durability of scaled NPT specimens, aiming to support integrated material-structure optimization. A novel NPT structure combining honeycomb and spoke features was designed, and a thermo-mechanical fatigue life prediction method was established. The mechanical behavior, viscoelastic self-heating characteristics, and fatigue performance of polyurethane (PU) elastomers were systematically characterized. Scaled NPT specimens were fabricated using subtractive manufacturing and subjected to rolling durability tests to validate the proposed method. The primary objective of this study is to reveal the signi3cant in4uence of thermo-mechanical coupling on the fatigue life prediction of the scaled NPT specimens and its role in improving prediction accuracy through numerical simulations and experimental validations. The results show that, under the rolling conditions considered in this study, the prediction errors of the surface temperatures of the scaled specimens are less than 3\%. Based on high-accuracy mechanical analysis and heat generation simulation, the predicted durability results exhibit an opposite trend compared with traditional approaches that neglect thermo-mechanical coupling, while accurately identifying the fatigue failure locations, and the predicted fatigue life falls within the range of the experimental data. The 3ndings con3rmed the critical role of multi-physics coupling in durability assessment of NPTs. This study provides theoretical and methodological support for the optimization design of long service life NPTs.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Polymer},
	author = {Gu, Bochao and Ning, Yao and Liu, Jun and Lu, Bo and Lu, Yonglai and Li, Fanzhu},
