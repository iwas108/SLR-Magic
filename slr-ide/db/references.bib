@article{raeesi_physics-informed_2026,
	title = {Physics-informed curriculum learning for real-time calibration of double wiebe combustion models: a deep reinforcement learning approach},
	volume = {31},
	issn = {25901745},
	shorttitle = {Physics-informed curriculum learning for real-time calibration of double wiebe combustion models},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2590174526004691},
	doi = {10.1016/j.ecmx.2026.101986},
	abstract = {Accurate calibration of double Wiebe combustion models is a prerequisite for achieving the sub-4\% pressure reconstruction error required by modern Digital Twin and adaptive emission-control applications, yet the problem is fundamentally ill-posed: multiple parameter combinations produce thermodynamically equivalent pressure traces, causing conventional optimizers to generate physically inconsistent calibration maps across the operating envelope. Genetic Algorithm-based calibration, the current industrial standard requires approximately 1,900 ms per operating point and is incompatible with real-time on-board deployment and Hardware-in-the-Loop (HIL) validation work:ows. We hypothesize that a physics-informed Proximal Policy Optimization (PPO) agent trained through a three-stage curriculum can simultaneously achieve competitive pressure-trace accuracy, enforce physical feasibility constraints, and attenuate the compensation effect through the implicit regularization of policy-gradient optimization on degenerate solution manifolds. A PPO agent was trained on 1,258 operating points from a 499.4 cm3 single-cylinder GDI engine and benchmarked against A2C, GA, and an XGBoost supervised-learning baseline across four partitioning strategies spanning distributional distances from 0.161σ (interpolation) to 1.112σ (out-of-distribution holdout). The framework achieves R2 = 0.971 and a 91.5\% physical-feasibility success rate on the out-of-distribution holdout 25.4 percentage points above XGBoost reduces the Total-Variation ratio of the three ill-posed parameters (Δθ, λw, ht,c) by 67\% relative to GA, and delivers actoronly inference in 0.26 ms (7,314 × faster than GA), with an estimated MCU latency of {\textasciitilde} 1.8 ms satisfying the 10 ms HIL deadline with a 5.5 × margin. These results establish physics-informed curriculum DRL as a deploymentready calibration strategy that uniquely combines physical constraint satisfaction, compensation-effect mitigation, and ECU-compatible memory footprint (712 kB vs. {\textasciitilde} 12 MB for XGBoost), providing a viable pathway toward real-time on-board combustion model calibration in next-generation powertrain systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Energy Conversion and Management: X},
	author = {Raeesi, Mehrdad and Shojaeefard, Mohammad Hassan},
