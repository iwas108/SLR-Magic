	title = {Monitoring of infiltration processes in hydraulic structures using distributed acoustic sensing technology},
	volume = {22},
	issn = {22261494},
	url = {https://ntv.ifmo.ru/en/article/21283/monitoring_infiltracionnyh_processov_v_gidrotehnicheskih_sooruzheniyah_s_ispolzovaniem_raspredelennogo_akusticheskogo_sensora.htm},
	doi = {10.17586/2226-1494-2022-22-3-610-622},
	abstract = {The article proposes a new method of monitoring the in¿ltration processes developing inside the body of hydraulic structures. The method is based on the use of DAS (distributed acoustic sensing) ¿ber-optic technology which provides high spatial continuity of hydraulic structure seismoacoustic ¿eld analysis; digital twin in¿ltration dynamics and ef¿cient signal processing methods based on machine learning. As a distributed sensor of the object’s seismoacoustic ¿eld, a DAS system is used the ¿ber-optic sensor of which is installed inside the body of the structure according to the principle of maximum coverage. The in¿ltration activity inside the structure body is estimated based on the analysis of an in¿ltration Àows ensemble which are detected and classi¿ed by machine learning (ML) methods. These in¿ltration Àows are sources of seismoacoustic emission and are therefore con¿dently detected by the DAS system. A digital twin of the in¿ltration dynamics based on the equations of mathematical physics is used as the normal basis for estimating the current state of Àuid activity in the body of the structure. The risk of a structure failure under the inÀuence of the observed in¿ltration Àow is estimated within the framework of the proposed formal method based on the digital twin data. Based on the analysis of Data Set, consisting of real signals of in¿ltration processes, the high ef¿ciency of detection and classi¿cation of this type of signals with the special ML-classi¿er included in the monitoring system is proved. A digital twin model of the in¿ltration processes dynamics in the body of a hydraulic structure is proposed. On the basis of the digital twin model, a method for estimating the risk of damage to the body of a hydraulic structure, which may occur as a result of the observed in¿ltration activity, is proposed. The method of controlling in¿ltration processes inside hydraulic structures can be used to monitor the operational condition of almost any hydraulic structures, including those in the cryolithic zone.},
	language = {en},
	number = {3},
	urldate = {2026-07-23},
	journal = {Scientific and Technical Journal of Information Technologies, Mechanics and Optics},
	author = {Timofeev, A.V. and Groznov, D.I.},
