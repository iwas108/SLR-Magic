@article{tuo_application_2026,
	title = {Application of data-driven modeling and calibration methods in nuclear power plant prognosis digital twins},
	volume = {227},
	issn = {03064549},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0306454925008047},
	doi = {10.1016/j.anucene.2025.111987},
	abstract = {Accurate prediction of nuclear power plant operational parameters is crucial for safety and performance optimization. However, existing data-driven models exhibit systematic deviations when encountering unseen transient scenarios, compromising their real-world reliability. This study develops a two-stage predictive digital twin framework combining a Transformer-based basic predictor with a Multi-Layer Perceptron calibrator. The basic predictor is trained on 163 transient cases covering 11 accident types, capturing fundamental temporal patterns across diverse scenarios. The calibrator employs a rapid adaptation utilizing initial data from new transients to correct systematic prediction errors. Evaluation on simulation data and real-world M310 + reactor operational data demonstrates substantial improvements across multiple unseen scenarios, with accuracy enhancements ranging from 30.77 \% to 99.71 \%. For real-world loss-of-off-site-power data, the framework achieves 81.6 \% normalized mean squared error reduction. The basic predictor maintains robustness to 1 \% input noise. These results validate the framework’s strong generalization capability and practical applicability for nuclear power plant operations.},
	language = {en},
