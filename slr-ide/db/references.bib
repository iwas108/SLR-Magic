@article{chen_develop_2022,
	title = {Develop a {Smart} {Microclimate} {Control} {System} for {Greenhouses} through {System} {Dynamics} and {Machine} {Learning} {Techniques}},
	volume = {14},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2073-4441},
	url = {https://www.mdpi.com/2073-4441/14/23/3941},
	doi = {10.3390/w14233941},
	abstract = {Agriculture is extremely vulnerable to climate change. Greenhouse farming is recognized as a promising measure against climate change. Nevertheless, greenhouse farming frequently encounters environmental adversity, especially greenhouses built to protect against typhoons. Short-term microclimate prediction is challenging because meteorological variables are strongly interconnected and change rapidly. Therefore, this study proposes a water-centric smart microclimate-control system (SMCS) that fuses system dynamics and machine-learning techniques in consideration of the internal hydro-meteorological process to regulate the greenhouse micro-environment within the canopy for environmental cooling with improved resource-use efficiency. SMCS was assessed by in situ data collected from a tomato greenhouse in Taiwan. The results demonstrate that the proposed SMCS could save 66.8\% of water and energy (electricity) used for early spraying during the entire cultivation period compared to the traditional greenhouse-spraying system based mainly on operators’ experiences. The proposed SMCS suggests a practicability niche in machine-learning-enabled greenhouse automation with improved crop productivity and resource-use efficiency. This will increase agricultural resilience to hydro-climate uncertainty and promote resource preservation, which offers a pathway towards carbon-emission mitigation and a sustainable water–energy–food nexus.},
	language = {en},
	number = {23},
	urldate = {2026-04-16},
	journal = {Water},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Chen, Ting-Hsuan and Lee, Meng-Hsin and Hsia, I.-Wen and Hsu, Chia-Hui and Yao, Ming-Hwi and Chang, Fi-John},
	month = jan,
	year = {2022},
	keywords = {machine learning, agricultural resilience, smart microclimate-control system (SMCS), system dynamics, water–energy–food nexus},
	pages = {3941},
	file = {Full Text PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\RWRMASCR\\Chen et al. - 2022 - Develop a Smart Microclimate Control System for Greenhouses through System Dynamics and Machine Lear.pdf:application/pdf},
}

@article{sun_empowering_2023,
	title = {Empowering {Greenhouse} {Cultivation}: {Dynamic} {Factors} and {Machine} {Learning} {Unite} for {Advanced} {Microclimate} {Prediction}},
	volume = {15},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2073-4441},
	shorttitle = {Empowering {Greenhouse} {Cultivation}},
	url = {https://www.mdpi.com/2073-4441/15/20/3548},
	doi = {10.3390/w15203548},
	abstract = {Climate change has led to more frequent extreme weather events such as heatwaves, droughts, and storms, which significantly impact agriculture, causing crop damage. Greenhouse cultivation not only provides a manageable environment that protects crops from external weather conditions and pests but also requires precise microclimate control. However, greenhouse microclimates are complex since various heat transfer mechanisms would be difficult to model properly. This study proposes an innovative hybrid model (DF-RF-ANN), which seamlessly fuses three components: the dynamic factor (DF) model to extract unobserved factors, the random forest (RF) to identify key input factors, and a backpropagation neural network (BPNN) to predict greenhouse microclimate, including internal temperature, relative humidity, photosynthetically active radiation, and carbon dioxide. The proposed model utilized gridded meteorological big data and was applied to a greenhouse in Taichung, Taiwan. Two comparative models were configured using the BPNN and the Long short-term memory neural network (LSTM). The results demonstrate that DF-RF-ANN effectively captures the trends of the observations and generates predictions much closer to the observations compared to LSTM and BPNN. The proposed DF-RF-ANN model hits a milestone in multi-horizon and multi-factor microclimate predictions and offers a cost-effective and easily accessible approach. This approach could be particularly beneficial for small-scale farmers to make the best use of resources under extreme climatic events for contributing to sustainable development goals (SDGs) and the transition towards a green economy.},
	language = {en},
	number = {20},
	urldate = {2026-04-16},
	journal = {Water},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Sun, Wei and Chang, Fi-John},
	month = jan,
	year = {2023},
	keywords = {microclimate, back propagation neural network (BPNN), dynamic factor, random forest (RF)},
	pages = {3548},
	file = {Full Text PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\GFW85YSK\\Sun and Chang - 2023 - Empowering Greenhouse Cultivation Dynamic Factors and Machine Learning Unite for Advanced Microclim.pdf:application/pdf},
}

