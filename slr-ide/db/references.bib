	url = {https://ieeexplore.ieee.org/document/11494546/},
	doi = {10.1109/ICERAI69511.2026.11494546},
	abstract = {Automatic Dependent Surveillance-Contract (ADS-C) is the primary surveillance mechanism used by aircraft in oceans and remote regions where radar coverage is unavailable, and ADS-B coverage is limited. Although ADS-C reports are highly accurate, they are transmitted only at specific events, not continuously. As a result, extended communication gaps may occur due to satellite outages, avionics failures, and abnormal operational conditions. During such gaps, conventional trajectory prediction methods rapidly lose accuracy and implicitly assume that the aircraft could be located isotropic. This leads to extensive and operationally unrealistic search regions, complicating air traffic management and search-and-rescue (SAR) decisionmaking. This paper proposes a digital twin framework that integrates a numerically stable local East-North-Up(ENU) Kalman filtering architecture, soft geometric constraints derived from the flight management system route intent, and selective wind-aware state propagation during communication silence. Unlike baseline kinematic filters, the proposed framework explicitly decomposes uncertainty into along-track and cross-track components, enabling the construction of bounded, anisotropic uncertainty corridors rather than unconstrained circular regions. The framework is evaluated using a real dataset from aircraft experiencing a prolonged communication loss. Despite operating in prediction-only mode for most of the flight, the digital twin maintains the possible aircraft location within a small and well-defined area. The results demonstrate that the proposed approach is practical and reliable, aligning with operational SAR reasoning observed in MH370-style investigations, and establishes a foundation for resilient oceanic surveillance under communication loss.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 {International} {Conference} on {Electrical}/{Electronics}, {Robotics}, {Artificial} {Intelligence}, and {Informatics} ({ICERAI})},
	publisher = {IEEE},
	author = {Baba, Saranya Mohan and Sreepathi, Bhargava Krishna and Ganesan, Chandramouli and Mustaphi, Saswati and Alhabshi, Mosab and Arora, Kapil},
	month = apr,
