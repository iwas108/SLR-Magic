@article{li_budget-constrained_2025,
	title = {Budget-{Constrained} {Digital} {Twin} {Synchronization} and {Its} {Application} on {Fidelity}-{Aware} {Queries} in {Edge} {Computing}},
	volume = {24},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {1536-1233, 1558-0660, 2161-9875},
	url = {https://ieeexplore.ieee.org/document/10668861/},
	doi = {10.1109/TMC.2024.3455357},
	abstract = {With the advance of mobile edge computing (MEC) and the Internet of Things (IoT), digital twin (DT) has become an emerging technology for provisioning IoT services between the real world and the cyber world. In this paper, we consider the state updating of DTs in an MEC network through synchronizing DTs with their physical objects. We make use of an energy-constrained UAV for data collection in a sensor network, as an illustrative example for the DT state updating of each object (sensor), and then use the DT data of objects (sensors) later for ﬁdelity-aware query services. To this end, we ﬁrst formulate a novel DT state staleness minimization, under a given update budget per update round. We then propose an optimal algorithm for a special case of the problem where the budget per update round is exactly K objects synchronizing with their DTs. We then devise an algorithm for the DT state staleness minimization problem by reducing to the award collection maximization problem, assuming that the volume of the update data generated by each object per update round is given. Otherwise, we adopt a deep learning method to predict the volume of the update data. To demonstrate the importance of the DT state staleness in practical applications, we consider ﬁdelity-aware query services in the MEC network, and we develop a cost-effective evaluation plan for each query. We ﬁnally evaluate the performance of the proposed algorithms through simulations. Simulation results demonstrate that the proposed algorithms are promising.},
	language = {en},
	number = {1},
	urldate = {2026-07-23},
	journal = {IEEE Transactions on Mobile Computing},
	author = {Li, Yuchen and Liang, Weifa and Xu, Zichuan and Xu, Wenzheng and Jia, Xiaohua},
	month = jan,
	year = {2025},
	pages = {165--182},
	file = {Li_2025_BudgetConstrain_74537:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Li_2025_BudgetConstrain_74537.pdf:application/pdf},
}

@inproceedings{niu_ltigtdigital_2025,
	title = {\&lt;i\&gt;{Digital} {Twin} {Method} for {Lifetime} {Prediction} of {Critical} {Components} in {Drip} {Irrigation} {Tape} {Production} {Line}\&lt;/i\&gt;},
	url = {https://elibrary.asabe.org/abstract.asp?JID=5&AID=55450&CID=tor2025&T=1},
	doi = {10.13031/aim.202500842},
	abstract = {Drip irrigation tape production lines are fundamental to modern agriculture, where the performance and lifespan of critical components play a decisive role in ensuring production efficiency and operational reliability. Among these components, bearings serve as essential elements, yet they are particularly susceptible to wear, corrosion, and other stress-induced degradations during extended operation. Such vulnerabilities often result in unpredictable failures that disrupt the entire production line. To address this challenge, this study presents a digital twin methodology for accurately predicting the lifespan of bearings in drip irrigation tape production lines. This approach integrates real-time sensor data, simulation models, and advanced machine learning techniques to establish a dynamic, data-driven framework for predictive maintenance. Bearings, as the critical focus, are modeled both physically and through data-driven methods. High-precision sensors are deployed to monitor temperature, vibration, rotational speed, and load, providing comprehensive operational data. The raw data undergoes preprocessing to eliminate noise and anomalies, ensuring robust inputs for predictive algorithms. The study leverages attention mechanisms combined with bidirectional long short-term memory networks (BiLSTM) to forecast the remaining useful life (RUL) of bearings under diverse operational conditions while accounting for dynamic environmental influences. The methodology employs SolidWorks software to construct a detailed bearing model, which is subsequently imported into Ansys software for simulation analysis. A dynamic digital twin model is developed by mapping real-time operational data onto the virtual simulation environment, facilitating continuous model updates. This enables highly accurate condition monitoring and lifespan prediction of bearings. Experimental validation on a real-world drip irrigation tape production line demonstrates the effectiveness of this approach in enhancing predictive accuracy and real-time adaptability. The outcomes of this study include the development of a robust digital twin framework tailored to bearings in drip irrigation tape production lines, a high-precision methodology for lifespan prediction, and verification of its substantial potential in reducing maintenance costs and minimizing downtime. By advancing the predictive maintenance of bearings, this research contributes to the broader digitalization and intelligent transformation of agricultural production systems. Furthermore, the proposed methodology is scalable and adaptable, offering applicability across other agricultural and industrial domains.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {Toronto}, {Ontario}, {Canada} {July} 13-16, 2025},
	publisher = {American Society of Agricultural and Biological Engineers},
	author = {Niu, RenZhong and Li, Zhigang and Zhang, Qi and Jin, Peilin},
	year = {2025},
	file = {Niu_2025_DigitalTwinMeth_1a99c:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Niu_2025_DigitalTwinMeth_1a99c.pdf:application/pdf},
}

@inproceedings{sadiq_digital_2025,
