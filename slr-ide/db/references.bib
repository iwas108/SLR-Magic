	file = {Ziadia_2025_Digitaltwindriv_5683c:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Ziadia_2025_Digitaltwindriv_5683c.pdf:application/pdf},
