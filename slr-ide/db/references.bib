}

@article{wan_dynamic_nodate,
	title = {Dynamic {Optimization} {Method} for {Distillation} {Processes} {Combining} {Digital} {Twins} and {Deep} {Learning}},
	abstract = {To solve the problems of response delay and poor adaptability existing in traditional dynamic optimization methods caused by the strong nonlinearity, time-varying characteristics and multiple uncertainties of distillation processes, this paper proposes an intelligent dynamic optimization method based on digital twins and deep learning. The high-fidelity synchronization is realized by establishing a digital twin that integrates mechanism and data. CNN-BiLSTM-Attention (Convolutional Neural NetworkBidirectional Long Short-Term Memory-Attention) model is designed to capture dynamic features, and then Proximal Policy Optimization (PPO) method is employed to generate optimization strategies online. The experimental results show that compared with the traditional method, the proposed method not only decreases the integral of absolute error (IAE) of product purity control to 0.45, but also reduces the energy consumption per unit product of distillation process to 127.8 kW•h/kg. Especially, the recovery time is greatly improved compared with comparative method when dealing with untrained disturbances. The closed loop of perception, decision-making and optimization is realized by this framework, which enhances the dynamic performance, economy and robustness of distillation process.},
	language = {en},
	author = {Wan, Lianyin},
	file = {Wan_2026_DynamicOptimiza_50a78:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Wan_2026_DynamicOptimiza_50a78.pdf:application/pdf},
