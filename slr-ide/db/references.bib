@article{li_active_2026,
	title = {Active control of bubbling fluidized bed by coupling deep reinforcement learning with reduced-order model},
	volume = {325},
	issn = {00092509},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0009250926000655},
	doi = {10.1016/j.ces.2026.123353},
	abstract = {The dense gas–solid ow in a bubbling uidized bed (BFB) is an extremely complex physical and chemical process controlled by turbulent ow, heat and mass transfer, and chemical reactions. Rapid prediction and realtime control of the dense gas–solid ow in the uidized bed are highly challenging. To overcome these dif2culties, this study develops a BFB active control framework based on a reduced-order model (ROM) and deep reinforcement learning (DRL), achieving real-time dynamic optimization of the global features within the uidized bed. Fast prediction of the ow 2eld is realized in the ROM stage. The snapshots of the uidized bed are decomposed into spatial modes and their corresponding time coef2cients. By utilizing enhanced compressed sensing (ECS) and time convolutional neural networks (TCN), a mapping relationship is established from sparse measurement points at the current time to the global ow 2eld at future moments. A DRL framework can be constructed based on the ow 2eld obtained from the ROM. Active control of the gas velocity distribution at the inlet of the BFB is performed based on the volume and amount of bubbles, ultimately achieving dynamic optimization of the BFB ow. This study introduces the novel integration of ECS-ROM and DRL for the 2rst time, enabling online optimization of the global ow 2eld features. The volume of the bubbles in the BFB was reduced by 50\%, while the amount of bubbles has increased to 2.5 times. This approach provides a novel implementation for real-time prediction and control in digital twin systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Chemical Engineering Science},
	author = {Li, Xiaofei and Wang, Shuai and Lin, Junjie and Luo, Kun and Fan, Jianren},
