	title = {Digital {Twin} {Architectures} for {Maritime} {Microgrids}: {Toward} {Resilient} and {Intelligent} {Port} {Operations}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9515-9},
