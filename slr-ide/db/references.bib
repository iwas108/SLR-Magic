@article{liang_digital_2025,
	title = {Digital twin modelling of lettuce growth under extreme earth conditions on earth: a very first step to plant growth in outer space},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012609799&doi=10.1007%2Fs10098-025-03293-8&partnerID=40&md5=416439e111955c05962b0545bf53039f},
	doi = {10.1007/s10098-025-03293-8},
	abstract = {Abstract: Investigation of space plant growth under real conditions is restricted currently to studies at the International Space Station (ISS), satellites, and suborbital rocket flights. This study aims at informing controlled environment agriculture under stress, with potential application to space analogue modelling. Space studies suffer from limitations in repeatability and failures of process control have been reported. The value of space studies could possibly could be amplified, when there is a possibility to reproduce the space experiment on Earth, and, at best, performing this in real-time to inform and optimize the space experiment. Therefore, we propose, for the first time, the concept of ‘physical twin-sender’ (“space”) and ‘physical twin-receiver’ (“Earth”), as a communicative and finally decision-making interaction within a digital twin concept. To test the efficacy of commercial machine-leaning modelling of plant growth for these connected physical twins, lettuce growth was investigated on a mountain with extreme weather (physical twin-sender) and the extreme conditions were replicated in a growth chamber (physical twin-receiver). This follows ESA’s credo to develop joint space-Earth engineering challenges and NASA’s ‘digital triplet’ framework. In this lieu, lettuce is grown in pots with soil and as hydroponic solution. © The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature 2025.},
	journal = {Clean Technologies and Environmental Policy},
	author = {Liang, S. and Long, N. and Lantin, S. and Escribà-Gelonch, M. and Hessel, V.},
	year = {2025},
	keywords = {Agriculture, Digital twin, Digital twins, Decision making, Earth (planet), Plant life extension, Space farming, Condition, Agricultural machinery, International Space stations, Lettuce growth, Modeling, Modelling, NASA, Outer space, Plant growth, Plant stress, Process control, Rocket flight, Space experiments, Space flight, Space stations},
	file = {J2SMURZU.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\PYXW6KK5\\J2SMURZU.pdf:application/pdf},
}

@inproceedings{ribeiro_leveraging_2025,
	title = {Leveraging {IoT} {Data} and {AI} for {Intelligent} {Decision}-{Support} in {Hydroponic} {Farming}},
	volume = {12},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012427060&doi=10.1007%2F978-3-031-93995-2_5&partnerID=40&md5=d84e82c65f5b2c3e1ea79fa57e5cbf61},
	doi = {10.1007/978-3-031-93995-2_5},
	abstract = {In the current state of Agriculture 4.0, digital technology can be harnessed to further improve farming conditions as we rise to the challenges of Agriculture 5.0. With a focus on the potential for automating, hydroponic systems can implement the concepts of the Internet of Things (IoT) and cyber-physical system (CPS) technologies following a scalable architecture. This contemporary engineering applied to the ancient science of hydroponics, using water as a growth medium, poses a viable solution to the steady depletion of soil with added benefits related to accuracy, logistics, and time. Nutrient Film Technique (NFT) offers benefits that can be explored within these parameters and where we can combine new technologies to achieve real-time monitoring. This paper shows the potential of leveraging technologies such as IoT, CPS and AI, to effectively collect, monitor and analyze data for decision-making, through a conversational AI user interface, in the context of an NFT hydroponic system. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author = {Ribeiro, R.A.S.A. and Seixas-Lopes, F. and Agostinho, C. and Gonçalves, R.J.},
	year = {2025},
	keywords = {IoT, Hydroponics, CPS},
	pages = {53--63},
}

@inproceedings{cosma_ensemble_2025,
	title = {Ensemble {Deep} {Learning} {Model} for {AI}-{Powered} {Cyber}-{Physical} {Systems} in {Precision} {Agriculture}},
	volume = {759},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010113750&doi=10.1007%2F978-3-031-97051-1_8&partnerID=40&md5=63f34562470e80a6e3255555bb3912bd},
	doi = {10.1007/978-3-031-97051-1_8},
	abstract = {The integration of Artificial Intelligence into Cyber-Physical Systems (CPS) is transforming precision agriculture by enabling automated, real-time plant health monitoring. AI-driven models enable the early detection of nutrient deficiencies, infections, and pests, allowing for timely intervention with effective treatments. This paper presents an ensemble deep learning model for image-based plant health monitoring, optimized for mobile agricultural equipment and autonomous systems. Preliminary results show significant improvements over existing plant monitoring solutions. Future research will focus on integrating this model into an AI-powered CPS, such as a drone or ground vehicle, for systematic field scanning, and crop health reporting. Unlike conventional CPS with multiple sensors, the final system will rely solely on computer vision, demonstrating that a high-resolution camera can serve as a powerful data acquisition tool in an AI-driven CPS. © IFIP International Federation for Information Processing 2025.},
