@article{zong_knowledge-driven_2026,
	title = {Knowledge-driven spatiotemporal graph learning framework for high-fidelity digital twin: {Real}-time springback prediction via multi-sensor fusion},
	volume = {340},
	issn = {09507051},
	shorttitle = {Knowledge-driven spatiotemporal graph learning framework for high-fidelity digital twin},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0950705126005058},
	doi = {10.1016/j.knosys.2026.115779},
	abstract = {Standard spatiotemporal prediction models often fail in complex manufacturing processes, such as free-bending, because they lack the domain knowledge needed to interpret noisy, multi-sensor data and complex physical phenomena, notably springback. This study presents a framework that enables the creation of a real-time digital twin for the tube bending process by accurately predicting springback. The proposed method synchronously acquires three-dimensional point cloud sequences and servo motor control signals to construct a uni ed spatiotemporal graph of curvature and torsion. A multi-sensor prediction network is designed for both short-term and long-term dependencies through a decision-level asymmetric fusion strategy. To enhance industrial adaptability, a pre-training and ne-tuning paradigm facilitates rapid transfer to new processes. Experimental results demonstrate that our framework outperforms mainstream spatiotemporal prediction models in terms of global accuracy and local stability. Critically, the ne-tuning strategy reduces training time to approximately 25\% of that required when training from scratch while maintaining a high level of precision, validating its feasibility for agile manufacturing scenarios and rapid digital twin deployment.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Knowledge-Based Systems},
	author = {Zong, Yue and Wang, Zili and Zhang, Shuyou and Fang, Yun and Tan, Jianrong and Wang, Caicheng and Xiang, Yongzhe},
