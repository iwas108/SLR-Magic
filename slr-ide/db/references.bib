	title = {Instrumentation and {Measurement} {Systems}: {Digital} {Twin} for {Horticulture} {Farm}: {Data} {Source} and {Data} {Domain} {Architecture}},
	volume = {28},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007773655&doi=10.1109%2FMIM.2025.11021356&partnerID=40&md5=6308aee88759166c34ee1c1fe0d6f864},
	doi = {10.1109/MIM.2025.11021356},
	abstract = {Digitalization of agriculture has the potential to improve productivity, profitability, sustainability and resilience of farms by ensuring the seamless flow of knowledge that optimizes the processes and mitigates uncertainties in production. The diffusion and implementation of Information and Communication Technologies (ICT) that enhance access of digital content within the agricultural sector and support collection and analysis of data from farms contributes to digitalization of agriculture [1]. Innovations in technologies for smart machines (e.g., GPS guidance systems for tractors), plant breeding for improved productivity and diseases resistance, plants and animals' genome editing, Internet of Things, Big Data and Artificial Intelligence technologies contribute to precision agriculture and smart farms development. Whereas farms that use precision agriculture employ advanced techniques and technologies to collect, process and analyze temporal, spatial and individual plants or animals data for estimation of variability in plants' or animals' development, to support decision making for improvement in resource use, productivity, quality and profitability of production, (https://www.ispag.org/about/definition), smart farms adopt advanced technologies to optimize the entire process of farming and improve sustainability in agricultural production. However, it is reported that many digital technologies have low adoption by farmers mainly because of perceived needs for employing highly trained professionals to lead with those technologies, high financial costs, unfriendly interfaces, and low knowledge on potential benefits [2]. © 1998-2012 IEEE.},
