	address = {Utrecht, Netherlands},
	title = {Concepts for {Efficient} {Coupling} of {Thermal} and {Electrical} {Domains} for {Monitoring} the {Thermomechanical} {Degradation} {Behavior} of {Electronic} {Systems}},
	copyright = {https://doi.org/10.15223/policy-029},
