	file = {Tian_2025_Adigitaltwinmet_b237d:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Tian_2025_Adigitaltwinmet_b237d.pdf:application/pdf},
