@article{ur_rehman_digital_2026,
	title = {Digital twin-augmented proximal policy optimization for real-time home energy management: addressing uncertainties in renewables, pricing, and loads},
	volume = {51},
	issn = {1382-6905, 1573-2886},
	shorttitle = {Digital twin-augmented proximal policy optimization for real-time home energy management},
	url = {https://link.springer.com/10.1007/s10878-025-01386-0},
	doi = {10.1007/s10878-025-01386-0},
	abstract = {The escalating global energy demand, combined with intermittent renewable energy sources and dynamic electricity pricing, highlights the critical requirement for intelligent home energy management systems to optimize consumption, minimize expenses, and promote sustainability. Conventional home energy management systems face di൶culties in managing uncertainties in power generation, household loads, and tari൵ variations, resulting in operational ine൶ciencies and increased grid pressure. This paper introduces a novel framework that integrates a digital twin with Proximal Policy Optimization for real-time home energy management, building on previous e൵orts by adding a digital twin for predictive validation and adaptive control. The framework structures the home energy management system as a Markov decision process, featuring extensive state-action spaces that handle energy storage systems, electric vehicles, photovoltaic panels, wind turbines, heating ventilation air conditioning, water heater, and schedulable loads through clipped Proximal Policy Optimization and generalized advantage estimation for reliable learning. Trained on a 180-day dataset and validated on a 96-step real-time dataset, it delivers 42.8\% cost reduction from 23.68 to 13.53 euros compared to the baseline, achieves complete comfort compliance at 100\%, and operates with 125 ms inference time, exceeding benchmarks by 7–30\% through digital twin-enhanced robustness. This advancement establishes a scalable, resilient home energy management system for prosumer environments.},
	language = {en},
	number = {5},
	urldate = {2026-07-23},
	journal = {Journal of Combinatorial Optimization},
	author = {Ur Rehman, Ubaid},
