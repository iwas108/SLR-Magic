@article{zhang_two-stage_2026,
	title = {A two-stage physics-informed graph neural network approach for rapid and accurate turbine blade temperature field prediction and data fusion},
	volume = {176},
	issn = {12709638},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1270963826010928},
	doi = {10.1016/j.ast.2026.112713},
	abstract = {Accurate and rapid prediction of the temperature eld on turbine blades is critical for the safety, performance, and lifespan of modern gas turbines. Computational Fluid Dynamics (CFD) and machine learning are two mainstream prediction methods. While CFD provides detailed thermal analysis, it suffers from high computational costs and inherent discrepancies with physical reality. Furthermore, traditional machine learning approaches are not suitable for unstructured meshes and lack physical interpretability. To address these challenges, this paper proposes a two-stage Physics-Informed Graph Neural Network (PIGNN) framework for precise turbine blade temperature prediction and data fusion. In the rst stage, a physics embedded GNN model is developed to learn the complex mapping from boundary conditions to the steady-state temperature eld across the blade’s unstructured mesh, which explicitly embeds the steady-state heat conduction mechanism into the message passing process of the graph neural network. In the second stage, the framework learns the deviation eld between the previous PIGNN’s prediction and sparse, high- delity temperature measurements from experiments, effectively fusing the global information from CFD with the local accuracy of experimental data. Results demonstrate that the proposed two-stage PIGNN framework enables fast and accurate temperature eld prediction, achieving prediction within 8 ms and the average relative error below 0.41\%. Furthermore, when corrected by sparse experimental data, the model’s nal prediction error is reduced by 83\%. This work presents both a novel PIGNN method for rapid thermal prediction and a robust paradigm for fusing multi-source data to develop reliable digital twins.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Aerospace Science and Technology},
	author = {Zhang, Yimin and Tong, Zi-Xiang and Ni, Shuzhi and Mi, Jin and Zhu, Jianqin},
	month = sep,
	year = {2026},
	pages = {112713},
	file = {Zhang_2026_Atwostagephysic_77e53:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Zhang_2026_Atwostagephysic_77e53.pdf:application/pdf},
}

