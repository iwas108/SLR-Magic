@inproceedings{dmitriev_integrated_2025,
	address = {Magnitogorsk, Russian Federation},
	title = {Integrated {Intelligent} {Power} {Supply} {Management} in {Mechatronics}-{Intensive} {Manufacturing} {Facilities}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-5323-4},
	url = {https://ieeexplore.ieee.org/document/11206681/},
	doi = {10.1109/UralCon67204.2025.11206681},
	abstract = {Intelligent power supply management in manufacturing shops with a high proportion of mechatronic equipment requires the coordination of active power control loops, power quality indices, and network constraints within an integrated digital framework. The objective of this work is to design and validate a control architecture capable of simultaneously mitigating load peaks, reducing the risk of voltage sags, and maintaining harmonic distortion within permissible limits in accordance with industry standards. A multi-tier digital architecture is proposed, comprising: an Industrial IoT (IIoT) layer for measurement and synchronization; edge-level control for real-time dispatch of DC-bus energy storage systems with state-ofcharge (SoC) constraints and no-export policies; a cloud-based digital twin for parameter identification, automatic controller tuning, and forecasting; and an event analysis service (PCA + kmeans) for disturbance classification. The control criterion is formulated as a multi-objective optimization with respect to energy cost, demand peaks, voltage sag risk, and penalties for exceeding total harmonic distortion (THD) thresholds, subject to equipment constraints. The testing methodology includes load duration curve analysis to justify energy storage power and capacity, correlation analysis of P–Q–THD relationships, and scenario testing using empirically collected shop-floor telemetry. Experiments were conducted using empirical plant data (Δt = 10 s, {\textasciitilde}8 h, 12 machines, 3 DC cells, 2 sections). The results are applicable to mechanical engineering practice, with deployment through SCADA/MES integration, embedding into the facility’s digital twin, and scalability to machining, electronics assembly, and automotive component manufacturing lines.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {International} {Ural} {Conference} on {Electrical} {Power} {Engineering} ({UralCon})},
	publisher = {IEEE},
