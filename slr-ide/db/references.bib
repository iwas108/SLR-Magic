@article{xin_research_2025,
	title = {Research on digital twin method for structural damage identification using cross-domain awareness technology},
	volume = {68},
	issn = {14740346},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1474034625007153},
	doi = {10.1016/j.aei.2025.103822},
	abstract = {The problems of cross-domain data shift and insuf cient mining of inter-label correlations in structural damage identi cation represent key challenges faced in digital twin applications for engineering structures. Addressing the practical problem of scarce labeled samples in marine engineering, this paper proposes a multi-label damage identi cation framework based on cross-domain adaptive learning. This method integrates domain adversarial training with label semantic guidance mechanisms, effectively enhancing feature transferability between simulation and real measurement domains. Meanwhile, a label correlation graph neural network encoder is constructed to characterize the dependency relationships between structural components, and an uncertaintyaware meta-threshold adjustment module is introduced to dynamically adjust decision boundaries according to model uncertainty. Analysis results from multiple datasets including ASCE standard tests demonstrate that the proposed method achieves an identi cation accuracy of 88.3\% on the IASC-ASCE benchmark dataset, an F1 score of 1.0 on the ASCE custom multi-damage dataset, and an F1 score of 0.927 in actual complex structure validation under the cross-domain awareness approach. Ablation experiments further validate the effectiveness of each submodule, demonstrating the robustness of the proposed method in addressing domain shift and label noise. This study introduces a systematic and uni ed framework that addresses simulation-experiment domain differences and enables multi-label damage identi cation, achieving engineering applications of cross-domain multi-label damage identi cation.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Advanced Engineering Informatics},
	author = {Xin, Su and Mengyao, Ren and Zhongyuan, Feng and Qi, Zhang and Yi, Huang},
