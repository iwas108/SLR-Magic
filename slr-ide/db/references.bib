@inproceedings{banerjee_development_2023,
	title = {{DEVELOPMENT} {OF} {AN} {ARTIFICIAL} {INTELLIGENCE} ({AI}) {FOR} {THE} {PREDICTION} {OF} {FATIGUE} {FAILURE} {IN} {NAVAL} {STRUCTURES}: {A} {DIGITAL} {TWIN} {APPLICATION}},
