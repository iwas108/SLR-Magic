@inproceedings{gopinath_spatial-temporal_2025,
	address = {Coimbatore, India},
	title = {Spatial-{Temporal} {Digital} {Twin} for {Crop} {Disease} {Prediction}: {A} {Hybrid} {ConvLSTM}-{Graph} {Neural} {Network} {Approach}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {978-1-6654-5753-8},
	shorttitle = {Spatial-{Temporal} {Digital} {Twin} for {Crop} {Disease} {Prediction}},
	url = {https://ieeexplore.ieee.org/document/11253080/},
	doi = {10.1109/ICoICI65217.2025.11253080},
	abstract = {The increasing worldwide menace of plant diseases, causing, inter alia, annual losses of \$3B due to coffee leaf rust, calls for the deployment of high-tech predictive tools above traditional reactive measures. Existing Systems relies upon manual scouting or analysis based on past weather information and incidents within the vicinity of a plantation, or basic machine learning methods (e.g., random forests) applied to segregated data sets, which results in suboptimal accuracy (60-70\%) and fairly late detection (≤7 days preceding visible symptoms). The thrust of this work goes to proposing Innovative Method a spatiotemporal digital twin integrating a hybrid ConvLSTM-Graph Neural Networks (GNNs) for 14 days presymptom disease prediction. The framework fuses multi-modal data, such as satellite NDVI (10m resolution Sentinel-2), drone thermal imagery (0.5 cm/pixel), IoT soil sensors (pH/moisture 15 min interval), and ERA5 microclimate forecasts into a physics-informed deep learning architecture. The ConvLSTM models temporal dynamics of canopy health, whereas the GNN models pathogen spread across the plants represented by graphs using graph attention (GAT) layers. Next, intervention strategies from the digital twin simulation layer built in Unity3D are tested with reinforcement learning (PPO algorithm). Validated with the 50 Colombian coffee farms dataset from 2021 to 2023, this system has obtained early rust detection with 88.3\% precision (14.2 days of average lead time), with optimized treatment plans allowing a 34.7\% reduction in pesticide usage, and increasing yields by 16.1\% versus control groups. The model was 22.8\% ahead of existing systems in F1-score and demonstrated generalizability to wheat rust in synthetic trials. This demonstration established that operational digital twins in hybrid deep learning architectures can bring crop protection from reactive to the predictive stage, hence working towards the sustainable agricultural goals set by FAO for 2030. Future directions may include edge AI deployment via NVIDIA Jetson with alerts in the field and prescription tracking via blockchain.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 3rd {International} {Conference} on {Intelligent} {Cyber} {Physical} {Systems} and {Internet} of {Things} ({ICoICI})},
