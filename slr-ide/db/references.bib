@article{nirapure_visual-data_2026,
	title = {Visual-data sampling strategies for pool boiling heat flux prediction: {Enhancing} pathways to data-driven digital twins},
	volume = {290},
	issn = {13594311},
	shorttitle = {Visual-data sampling strategies for pool boiling heat flux prediction},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1359431126003054},
	doi = {10.1016/j.applthermaleng.2026.129997},
	abstract = {This work aims to develop a data acquisition methodology for visual data-based deep learning models to predict boiling heat flux. Conventional deep learning models often rely on a fixed architecture and uniform training data sampling across the nucleate boiling regime, which can lead to suboptimal performance because visual patterns are sensitive to changes in heat flux. To address this challenge, we developed an approach that uses the Index of Visual Similarity (IVS) to guide training data sampling (𝛥𝑄). To investigate the problem, we developed an interpolation framework that uses high-speed pool-boiling images and leverages global visual features via a VGG-16-based convolutional neural network to estimate heat flux. This model has been used to test the developed IVS-based methodology. The methodology uses IVS as a visual indicator to assess the degree of change in identifiable physical features with respect to heat flux. Hence, changes in IVS can be used to guide the selection of an optimal data sampling distribution across the heat flux range under consideration. The study further examines how the heat flux sampling used for training influences both model accuracy and computation overhead. A Genetic Algorithm (GA) is developed and employed to optimize the training interval, balancing predictive accuracy against computational cost. The optimization results reveal variations in boiling visual patterns across the explored heat flux range of 50-90 W/cm2. These findings from the genetic algorithm were used to validate the IVS-guided heat flux sampling. Finally, it was observed that an IVS-guided training reduced training time by 39.1\% compared with training at the lowest uniform sampling rate (𝛥𝑄 = 1 W/𝑐𝑚2), while maintaining high accuracy, with a mean absolute percentage error of 1.59\%. Overall, this work demonstrates that efficient data sampling strategies can significantly reduce computational overhead without compromising accuracy, providing new opportunities for AI-driven thermal diagnostics.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Applied Thermal Engineering},
	author = {Nirapure, Pranay and Singh, Ayushman and Rangarajan, Srikanth and Sammakia, Bahgat},
	month = apr,
	year = {2026},
	pages = {129997},
	file = {Nirapure_2026_Visualdatasampl_ca156:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Nirapure_2026_Visualdatasampl_ca156.pdf:application/pdf},
}

@article{sayghe_fourier_2026,
	title = {Fourier {Neural} {Operators} for {Fast} {Multi}-{Physics} {Sensor} {Response} {Prediction}: {Applications} in {Thermal}, {Acoustic}, and {Flow} {Measurement} {Systems}},
	volume = {26},
	issn = {1424-8220},
	shorttitle = {Fourier {Neural} {Operators} for {Fast} {Multi}-{Physics} {Sensor} {Response} {Prediction}},
	url = {https://www.mdpi.com/1424-8220/26/4/1165},
	doi = {10.3390/s26041165},
	abstract = {Accurate and rapid prediction of sensor responses is critical for real-time measurement systems, digital twin implementations, and sensor design optimization. Traditional numerical methods such as Finite Element Method (FEM) and Computational Fluid Dynamics (CFD) provide high-ﬁdelity solutions but suffer from prohibitive computational costs, limiting their applicability in time-sensitive applications. This paper presents a novel framework utilizing Fourier Neural Operators (FNO) as surrogate models for fast multi-physics sensor response prediction across thermal, acoustic, and ﬂow measurement domains. Unlike conventional neural networks that learn ﬁnite-dimensional mappings, FNO learns operators between inﬁnite-dimensional function spaces by parameterizing the integral kernel in Fourier space, enabling resolution-invariant predictions with remarkable computational efﬁciency. We demonstrate the framework’s efﬁcacy through three comprehensive case studies: (1) thermal sensor response prediction achieving R2 {\textgreater} 0.98 with 8300× speedup over FEM, (2) acoustic sensor array modeling with mean absolute error below 0.5 dB and 4000× speedup over BEM, and (3) ﬂow sensor characterization with velocity ﬁeld prediction accuracy exceeding 97\% and 31,000× speedup over CFD. The proposed FNObased surrogate models are trained on simulation datasets generated from high-ﬁdelity numerical solvers and validated against simulation holdout data for all three case studies, with additional experimental validation conducted for the thermal sensor case. Results indicate that FNO architectures effectively capture the underlying physics governing sensor behavior while reducing inference time from minutes to milliseconds. The framework enables real-time sensor calibration, uncertainty quantiﬁcation, and design optimization, opening new possibilities for intelligent measurement systems and Industry 4.0 applications. We also investigate the spectral characteristics of FNO predictions, addressing the inherent low-frequency bias through a hybrid architecture combining FNO with local convolutional layers. The primary contributions of this work include: (1) the ﬁrst systematic application of FNO-based surrogate modeling speciﬁcally tailored for sensor response prediction across multiple physics domains, (2) a novel H-FNO architecture that combines spectral operators with local convolutions to mitigate spectral bias in sensor applications, and (3) comprehensive validation including both simulation and experimental data for practical deployment. This work establishes FNO as a powerful tool for accelerating sensor simulation and advancing the ﬁeld of AI-enhanced instrumentation and measurement.},
	language = {en},
	number = {4},
	urldate = {2026-07-23},
	journal = {Sensors},
	author = {Sayghe, Ali and Mousa, Mohammed and Batiyah, Salem and Husawi, Abdulrahman},
	month = feb,
	year = {2026},
	pages = {1165},
	file = {Sayghe_2026_FourierNeuralOp_931ca:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Sayghe_2026_FourierNeuralOp_931ca.pdf:application/pdf},
}

@article{duarte_physics-informed_2026,
	title = {Physics-informed neural networks for {3D} transient thermal simulation of {MIG} welding},
	volume = {29},
	issn = {25901230},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S259012302600589X},
	doi = {10.1016/j.rineng.2026.109549},
	abstract = {Accurate and fast prediction of transient temperature ﬁelds in MIG/MAG welding is essential for process qualiﬁcation and weld integrity, yet high ﬁdelity mesh-based simulations can become computationally expensive for fully transient 3D problems with moving heat sources. To circumvent these computational bottlenecks, this study delineates an advanced simulation architecture founded upon Physics-Informed Neural Networks (PINNs). This paradigm shifts the solution strategy from mesh-based integration to physics-constrained optimization, ensuring thermodynamic consistency while signiﬁcantly accelerating time-to-solution. The proposed architecture directly assimilates the partial diﬀerential equation governing three-dimensional transient heat conduction, incorporating a dynamic Gaussian volumetric energy source, into the network’s objective function. Consequently, the training process minimizes the residuals of the governing physics, constraining the predicted manifold to satisfy Fourier’s law of conduction without the necessity for spatial discretization. Empirical validation against previously published bead-on-plate experiments on 6061-T6 aluminum alloy substrates conﬁrms the model’s ﬁdelity. The framework successfully reproduces complex transient thermal proﬁles, yielding a minimized 𝑙2 error metric of 2.28 K, demonstrating robust agreement with thermocouple telemetry. Furthermore, a systematic hyperparameter study was conducted, as PINN performance is highly sensitive to parameter choices. Finally, this study identiﬁed an optimal conﬁguration that balances predictive accuracy with computational cost. Notably, the optimized hyperparameters facilitate model convergence in approximately 14 min utilizing a single consumer-grade graphics processing unit. This eﬃciency establishes the PINN framework as a viable engine for real-time digital twinning and rapid iterative design in high-throughput manufacturing environments.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Results in Engineering},
	author = {Duarte, Carlos Antonio Ribeiro and De Resende, André Alves and De Souza, Francisco José and Andrade, João Rodrigo and Paes, Luiz Eduardo Dos Santos and Da Silva, Leonardo Rosa Ribeiro and Dias, João Marcos Souza and Teloli, Rafael De Oliveira and Jacob, Bruno},
	month = mar,
