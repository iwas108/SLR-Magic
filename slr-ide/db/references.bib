@article{zhang_degradation_2025,
	title = {Degradation prognostics of gas turbine performance in icing condition based on physics-data hybrid modeling method},
	volume = {269},
	issn = {13594311},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1359431125007707},
	doi = {10.1016/j.applthermaleng.2025.126178},
	abstract = {Degradation prognostics play a key role in the safety and reliability of gas turbines, assessing the health status and supporting maintenance decision-making. However, the degradation caused by ice accumulation has the characteristics of complex mechanism, uncertain structure, and nonlinear state, which limits the prediction performance of traditional physics-based model. In this paper, a novel physics-data hybrid method is proposed for degradation prognostics, including multi-model fusion among mechanism model, online learning machine, and time series prediction model. The online extreme learning machine is employed to dynamically learn the adaptation results of the mechanism model. The updated network is used as a calibration module to improve the timeliness and accuracy of the performance monitoring. Then, the feature enhance framework is designed to make full use of the analysis information derived from the monitoring module. High-dimensional features are generated to support the degradation prognostics of the time series model. Icing tests of a micro turboshaft were carried out to verify the proposed method. The maximum percentage errors of the prognostic results are within 2\%. Results suggest the proposed fusion strategy can signi-cantly reduce modeling errors, achieving accurate monitoring and early warning for gas turbine operation and maintenance.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Applied Thermal Engineering},
	author = {Zhang, Jingkai and Wang, Zhitao and Ming, Liang and Li, Shuying},
	month = jun,
