@inproceedings{pandey_real-time_2025,
	address = {Bhubaneswar, India},
	title = {Real-{Time} {Health} {Monitoring} and {Parameter} {Estimation} of {PV} {Systems} {Using} a {Data}-{Driven} {Digital} {Twin} with {DropKAN} and {MDA}-{EFO}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-6637-1},
	url = {https://ieeexplore.ieee.org/document/11410865/},
	doi = {10.1109/ICPEE65973.2025.11410865},
	abstract = {Data-driven Digital Twin (DT) technology enables enhanced reliability and maintainability of grid-connected photovoltaic (PV) inverters. This work develops a DT framework for real-time parameter estimation and health monitoring of a singlestage three-phase grid-tied PV system. The framework combines a high-ﬁdelity MATLAB/Simulink physical model with a Dropout Kolmogorov–Arnold Network (DropKAN) for dynamic state prediction, Magnetic-Domain Alignment Electromagnetic Field Optimization (MDA-EFO) for parameter estimation, and a CSTOGNSB-CGI ﬁltering stage for accurate grid signal extraction. Continuous tracking of key component parameters enables nonintrusive health assessment of the DC-link capacitor, interfacing inductors, and ﬁlter elements. Case studies under degraded conditions show strong agreement between DT predictions and physical responses, achieving low NMSE, high R2, and clear diagonal dominance in proportion matrices. These results validate the proposed DT as an effective tool for predictive maintenance and reliable operation of PV inverters under dynamic and aginginduced stress.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {International} {Conference} on {Power} {Electronics} and {Energy} ({ICPEE})},
	publisher = {IEEE},
	author = {Pandey, Rituvic and Kumar, Nishant},
	month = dec,
