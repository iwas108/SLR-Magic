@article{zhao_physics-aligned_2026,
	title = {Physics-aligned virtual sensing with {AI}-enhanced reduced-order modeling for structural digital twins},
	volume = {219},
	issn = {09659978},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0965997826001237},
	doi = {10.1016/j.advengsoft.2026.104217},
	abstract = {Inferring full-range response -elds from limited physical sensors is a central obstacle to realizing digital twins (DTs) for civil engineering structures. Virtual sensing (VS) addresses this gap, yet existing approaches struggle to simultaneously deliver accuracy, real-time inference, and robustness to model-form uncertainties under nonlinear, history-dependent structural behavior. This paper proposes a physics-aligned VS framework that integrates arti-cial intelligence (AI) with reduced-order modeling (ROM), in which a cross-attention network dynamically reweights a physics-enriched library of reduced bases from sparse sensor inputs. The framework was validated on a 1:10 steel plate-concrete composite nuclear containment specimen, where full-range Mises stress, displacement, and plastic strain -elds were reconstructed from only 8 linear variable displacement transducers (LVDTs) and 16 strain gauges. Benchmarking against four mainstream methods—graph neural network (GNN), modal expansion (ME), model updating (MU), and Kalman -lter (KF)—the proposed framework attained the highest predictive accuracy and converged with substantially less training than the GNN, while delivering inference orders of magnitude faster than the iterative MU and KF work=ows. Mechanistically, the learned coef-cients act as data-driven modal corrections that absorb model-form discrepancies, enabling the framework to outperform the high--delity -nite element (FE) simulation that supplied its training data. Generalization studies further con-rm robustness under unseen multi-cycle loading paths and transferability across distinct structural con-gurations of the same specimen. Together, these results position AI-enhanced ROM as a viable backbone for real-time virtual sensing in structural DTs.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Advances in Engineering Software},
	author = {Zhao, Haoyang and Wang, Chen and Fan, Jiansheng and Ding, Ran},
