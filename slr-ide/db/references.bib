@article{ma_multi-view_2026,
	title = {A multi-view depth-camera point cloud processing pipeline for pre-harvest maize stand counting},
	volume = {266},
	issn = {15375110},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1537511026000681},
	doi = {10.1016/j.biosystemseng.2026.104450},
	abstract = {During maize harvesting, feed rate critically in2uences grain loss and kernel breakage. Machine-vision techniques can estimate crop density ahead of the harvester, enabling proactive feed rate control. However, densely packed mature maize with interlaced leaves and indistinct boundaries makes conventional image-processing pipelines unreliable for stand counting. This work develops a /eld-deployable approach that fuses point-cloud data from multiple depth-camera viewpoints. Sequential clouds are integrated using a Soft–Hard Hierarchical Kalman Filter (SH-HKF) to enhance data redundancy for stable, on-machine processing. An Adaptive Octree Weighted Downsampling (Aoct-DS) algorithm then compresses the point cloud to reduce computational load while retaining morphology-critical structural details. A Partial Differential Equation Morphology Attention Counting Network (PMAC-Net), equipped with adaptive layers and physics-informed priors, enables real-time end-to-end counting under /eld conditions. The system is evaluated across diverse operating scenarios, including high-density stands, severe occlusion, daylight, and low-illumination night conditions. Results show counting accuracies of 94.2 \% in sunny and 90.3 \% in night conditions, with attention-visualisation con/rming focus on plant structural cores. The proposed method provides an engineering-ready solution for pre-harvest maize stand counting, delivering robust input for anticipatory feed rate regulation in combine harvesters and offering a transferable framework for other high-density crops.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Biosystems Engineering},
	author = {Ma, Ruofei and Du, Yuefeng and Liu, Lei and Guo, Dafang and Wang, Linze and Chen, Du and Song, Zhenghe},
	month = jun,
