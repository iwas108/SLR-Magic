@article{xin_zero-shot_2026,
	title = {Zero-shot prediction method for offshore platforms driven by multimodal feature fusion and information entropy measurement},
	volume = {165},
	issn = {09521976},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0952197625035717},
	doi = {10.1016/j.engappai.2025.113540},
	abstract = {This study proposes a machine learning-based zero-shot learning cross-domain prediction method for offshore jacket platform structural health monitoring to address prediction challenges in non-measured regions caused by limited sensor deployment and data sparsity. The arti1cial intelligence (AI) framework integrates deep learning and ensemble learning techniques for mechanical response prediction, featuring three core components: (1) a residual learning-based panoramic prediction model that bridges simulation-measurement domain gaps by mapping environmental loads to structural responses; (2) a heterogeneous fusion mechanism integrating timedomain statistical features with wavelet-domain frequency features using information entropy optimization for adaptive feature weighting; and (3) a mutual information-based framework quantifying nonlinear dependencies between measurement points to enable zero-shot knowledge transfer. Validation on the LF15-1 offshore platform dataset demonstrates substantial performance improvements in axial force prediction applications under extreme marine conditions. The proposed AI-driven method achieves a maximum coef1cient of determination (R2) value of 0.868 at critical unmeasured reference locations, representing up to 51.7 \% improvement over Long Short-Term Memory (LSTM) baselines. Compared to coarse-grained spatial extrapolation, zero-shot prediction accuracy improved by up to 41.0 \%, with error reductions exceeding 35 \%. Ablation studies con1rm the necessity of each component, with individual removal causing R2 drops of 0.20–0.30 (corresponding to 30–70 \% performance degradation relative to baseline methods), demonstrating their synergistic contribution to overall performance. The method demonstrates robust performance under extreme typhoon conditions, providing a practical AI-driven solution for marine structural safety assessment with sparse sensor data.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Engineering Applications of Artificial Intelligence},
	author = {Xin, Su and Qi, Zhang and Zhongyuan, Feng and Mengyao, Ren and Yi, Huang},
