@article{kuang_evidence-optimized_2026,
	title = {Evidence-optimized physics-informed digital twin for probabilistic prediction and risk assessment of wall deflection in braced excavations},
	volume = {199},
	issn = {0266352X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0266352X26004829},
	doi = {10.1016/j.compgeo.2026.108376},
	abstract = {Accurate prediction and risk assessment of time-varying wall de ection during staged braced excavations remain challenging due to evolving system behavior and multiple sources of uncertainty. To address this issue, an evidence-optimized physics-informed digital twin framework is developed for stage-wise probabilistic prediction, sequential Bayesian updating and risk assessment. A high-3delity 3nite element model is employed as the physics-based baseline to generate training data for a sparse Gaussian process regression surrogate. Physically interpretable composite kernel structures are designed to encode covariance assumptions for the coupled effects of soil parameters, wall depth, and excavation stage, and are ranked using Bayesian model evidence. The resulting surrogate balances predictive accuracy, model parsimony, and physical interpretability. During the online phase, monitoring data are assimilated stage by stage to update selected soil parameters and depthdependent discrepancy terms, while posterior predictive distributions are used to quantify uncertainty. The proposed framework is validated through two representative braced excavation cases: the Taipei National Enterprise Center excavation and the launching shaft of the Wuhu Yangtze River-Crossing Tunnel. Results show that sequential data assimilation drives progressive posterior contraction of key parameters and improves the agreement between predicted and measured wall-de ection pro3les. The posterior distribution of maximum wall de ection is further transformed into exceedance probabilities and stage-wise risk levels, enabling posterior predictive risk inference during excavation. Through evidence-supported selection of physically interpretable kernel structures, the proposed framework provides a closed-loop digital twin for probabilistic prediction, risk assessment, and early warning in staged braced excavations.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Computers and Geotechnics},
	author = {Kuang, Xing-Chen and Wang, Zuo-Cai and Yuan, Zi-Qing and Zhang, Ning and Xin, Yu},
	month = nov,
	year = {2026},
	pages = {108376},
	file = {Kuang_2026_Evidenceoptimiz_67dfd:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Kuang_2026_Evidenceoptimiz_67dfd.pdf:application/pdf},
}

@article{m_hybrid_2026,
	title = {A {Hybrid} {Machine} {Learning} and {Swarm} {Optimization} {Framework} for {Real}-{Time} {Energy} {Prediction} and {Optimization} in {Additive} {Manufacturing}},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {2582-1040},
	url = {https://journals.asianresassoc.org/index.php/irjmt/article/view/5982},
	doi = {10.54392/irjmt26314},
	abstract = {Additive Manufacturing (AM) enables unprecedented design flexibility and decentralized production; however, its high energy consumption remains a critical sustainability challenge. While recent digital twin and machine learning (ML)-based studies have focused primarily on quality monitoring, defect detection, or thermal modeling, limited research has developed integrated predictive–optimization pipelines specifically targeting real-time energy management across multiple AM platforms. This study proposes a hybrid machine learning framework that combines predictive modeling, clustering-based data compression, and swarm intelligence optimization to estimate and minimize energy consumption using real-time process parameters. Experimental data were collected from Selective Laser Sintering (SLS) and Fused Deposition Modeling (FDM) systems, incorporating layer-wise geometric descriptors, process variables (laser power, scan speed, build temperature, extrusion rate), and environmental conditions. Multiple supervised learning models—including Support Vector Regression (SVR), XGBoost, Deep Neural Networks (DNN), and a DBSCAN–XGBoost hybrid—were trained and evaluated under a controlled benchmarking protocol. The DNN with feature selection achieved the best predictive performance (RMSE = 0.72 kWh, R≤ = 0.96), outperforming conventional regression and ensemble models across identical datasets. Statistical comparisons confirmed a consistent improvement in prediction accuracy relative to baseline linear and non-deep learning models. The predicted energy profiles were integrated into a Particle Swarm Optimization (PSO) module to identify energy-efficient process parameter configurations under manufacturability constraints. The optimization stage achieved up to an 18\% reduction in energy consumption for both SLS and FDM builds while maintaining tensile strength and dimensional accuracy within acceptable tolerances. By explicitly integrating clustering-based compression, deep learning prediction, and swarm-based optimization into a unified pipeline, this framework extends beyond existing standalone digital twin or energy estimation approaches. The results demonstrate the potential of hybrid ML–optimization architectures for scalable, real-time, energy-aware additive manufacturing and sustainable industrial deployment.},
	language = {en},
	urldate = {2026-07-23},
	journal = {International Research Journal of Multidisciplinary Technovation},
	author = {M, Jayakrishna and M, Vijay and Mohanty, Ramesh Chandra},
	month = may,
	year = {2026},
	pages = {218--235},
	file = {Jayakrishna_2026_AHybridMachineL_64d3a:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Jayakrishna_2026_AHybridMachineL_64d3a.pdf:application/pdf},
}

@article{wang_mixed_2026,
	title = {Mixed reality and machine learning-guided cable robot framework ({MMCR}) for real-time prefabricated construction automation},
	volume = {74},
	issn = {14740346},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1474034626002727},
