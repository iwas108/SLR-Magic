@inproceedings{zhang_digital-twin-based_2026,
	address = {Guangzhou, China},
	title = {Digital-{Twin}-{Based} {Dynamic} {Bottleneck} {Identification} and {Prediction} for {Discrete} {Manufacturing} {Workshops}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-6178-9},
	url = {https://ieeexplore.ieee.org/document/11525860/},
	doi = {10.1109/ICMTIM69588.2026.11525860},
	abstract = {To address the dynamic migration of bottlenecks, limited real-time responsiveness, and insufﬁcient interpretability of conventional bottleneck analysis in discrete manufacturing workshops, this paper proposes a digital-twin-based dynamic bottleneck identiﬁcation and prediction framework. The framework ﬁrst integrates sensor signals, equipment logs, buffer events, transport records, and production activity trajectories to construct a process-oriented workshop state representation. On this basis, a digital twin state synchronization mechanism and a sliding-window model updating strategy are designed to maintain continuous consistency between the physical workshop and the cyber model. A multi-decision-tree ensemble is then developed to quantify bottleneck risks from workload, work-in-process accumulation, blockage or starvation, cycle-time ﬂuctuation, and disturbance events. To enhance repeatability and universality, the experiment veriﬁed four manufacturing scenarios, resulting in 332 activities and 2,988 experimental samples. Experimental results show that the proposed method achieves the best regression performance among all comparison methods, with a mean absolute error of 0.0331 and a coefﬁcient of determination of 0.8217. In the online updating setting, the model remains stable and correctly tracks the migration of high-risk bottleneck processes. The tree-level interpretation results further reveal how individual trees contribute through dominant features and split thresholds. Digital-twin-guided optimization improves overall equipment effectiveness by up to 18.6\%, value-added rate by up to 25.0\%, reduces waste by up to 25.2\%, and shortens cycle time by up to 9.4\% in representative bottleneck processes.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 7th {International} {Conference} on {Mechatronics} {Technology} and {Intelligent} {Manufacturing} ({ICMTIM})},
