	pages = {115172},
	file = {Wang_2023_Combineddigital_d787d:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Wang_2023_Combineddigital_d787d.pdf:application/pdf},
}

@article{lee_digital_2022,
