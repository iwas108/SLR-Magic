@article{costantino_energy_2021,
	title = {Energy performance and climate control in mechanically ventilated greenhouses: {A} dynamic modelling-based assessment and investigation},
	volume = {288},
	issn = {0306-2619},
	shorttitle = {Energy performance and climate control in mechanically ventilated greenhouses},
	url = {https://www.sciencedirect.com/science/article/pii/S0306261921001288},
	doi = {10.1016/j.apenergy.2021.116583},
	abstract = {Controlled environment agriculture in greenhouse is a promising solution for meeting the increasing food demand of world population. The accurate control of the indoor environmental conditions proper of greenhouses enhances high crop productivity but, contemporarily, it entails considerable energy consumption due to the adoption of mechanical systems. This work presents a new modelling approach for estimating the energy consumption for climate control of mechanically ventilated greenhouses. The novelty of the proposed energy model lies in its integrated approach in simulating the greenhouse dynamics, considering the dynamic thermal and hygric behaviour of the building and the dynamic response of the cultivated crops to the variation of the solar radiation. The presented model simulates the operation of the systems and the energy performance, considering also the variable angular speed fans that are a new promising energy-efficient technology for this productive sector. The main outputs of the model are the hourly thermal and electrical energy use for climate control and the main indoor environmental conditions. The presented modelling approach was validated against a dataset acquired in a case study of a new fully mechanically controlled greenhouse during a long-term monitoring campaign. The present work contributes to increase the knowledge about the dynamics and the energy consumption of greenhouses, and it can be a valuable decision support tool for industry, farmers, and researchers to properly address an energy efficiency optimisation in mechanically ventilated greenhouses to reach the overall objective of decreasing the rising energy consumption of the agricultural sector.},
	urldate = {2026-08-24},
	journal = {Applied Energy},
	author = {Costantino, Andrea and Comba, Lorenzo and Sicardi, Giacomo and Bariani, Mauro and Fabrizio, Enrico},
	month = apr,
	year = {2021},
	keywords = {Agricultural buildings, Controlled environment agriculture, Energy consumption assessment, Greenhouse dynamics, Intensive horticulture, Variable speed fan simulation},
	pages = {116583},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\IM6QCMG6\\Costantino et al. - 2021 - Energy performance and climate control in mechanically ventilated greenhouses A dynamic modelling-b.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\WVPDTEQN\\S0306261921001288.html:text/html},
}

@article{larochelle_low-power_2024,
	title = {A {Low}-{Power} {Optical} {Sensor} {With} {Dynamically} {Adjustable} {Field} of {View} for {Photosynthetically} {Active} {Radiation} ({PAR}) {Measurement}},
	volume = {24},
	issn = {1558-1748},
	url = {https://ieeexplore.ieee.org/abstract/document/10421776},
	doi = {10.1109/JSEN.2024.3361086},
	abstract = {The characterization of light as photosynthetically active radiation (PAR) is crucial for modeling and monitoring plant metabolism and development. Existing intercepted PAR sensing solutions are limited by the requirement to average many below-canopy measurements to account for heterogeneity in the plant canopy, which requires a human operator. In this work, we address this issue by introducing a novel sensing concept to measure the light coming from different areas of the tree canopy with a single sensor by dynamically varying the sensor’s field of view (FOV) in the zenith and azimuth directions. The sensing system consists of: 1) an imaging lens that collects the incoming light; 2) a programmable liquid-crystal display (LCD), which acts as an optical shutter; 3) a diffuser; and 4) the AS7341 multispectral sensor. In this work, the PAR model required to calibrate the sensor is derived and the sensing system is calibrated and characterized. A sensor prototype is then assembled, calibrated, and characterized, achieving competitive performance with a mean average percentage error of 6.78\% and a normalized root mean square error of 4.82\% on PAR measurements. Tests using a custom LED test sphere show that the sensor has a spatial resolution of 7° and 15° in the þeta - and {\textbackslash}phi -directions, respectively. With a power consumption of 19.54 mW mainly attributable to the LCD, our new sensing system could be used for more than two years at one hour of measurements per day, which paves the way toward long-term continuous monitoring of PAR.},
	number = {6},
	urldate = {2026-08-24},
	journal = {IEEE Sensors Journal},
	author = {Larochelle, Jonathan and Klueppel, Johannes and McCormick, Roy and Biegert, Konni and Comella, Laura Maria},
	month = mar,
	year = {2024},
	keywords = {Lenses, Liquid crystal displays, Liquid-crystal display (LCD), long term deployment, Monitoring, Optical sensors, photodiode array, photosynthetically active radiation (PAR), sensor node, Sensor phenomena and characterization, Sensor systems, Sensors},
	pages = {7711--7728},
	file = {PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\GALQTI8P\\Larochelle et al. - 2024 - A Low-Power Optical Sensor With Dynamically Adjustable Field of View for Photosynthetically Active R.pdf:application/pdf;Snapshot:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\3HQRF4FJ\\10421776.html:text/html},
}

@article{kussainov_as7341_2026,
	title = {{AS7341} {Spectral} {Sensor} with {Machine} {Learning} for {Non}-{Contact} {Temperature} {Monitoring} in {Electrolytic}-{Plasma} {Hardening}},
	volume = {26},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {1424-8220},
	url = {https://www.mdpi.com/1424-8220/26/10/3080},
	doi = {10.3390/s26103080},
	abstract = {Electrolytic-plasma hardening of steel components requires reliable non-contact temperature monitoring, but traditional pyrometry is complicated by the variable emissivity of steel and the intense radiation of the plasma envelope. This work presents an approach that repurposes a compact multispectral AS7341 sensor into a virtual temperature sensor based on physically grounded spectral feature engineering and regularized machine learning. The use of logarithmic ratios of the near-infrared channel (940 nm) to the visible channels suppresses the plasma contribution and linearizes Wien’s radiation law. On a controlled dataset of 20 cycles, this increases the Pearson correlation with the peak temperature from r = 0.498 (raw NIR channel) to r = 0.781 for the log(NIR/Clear) feature. Current is identified as a confounding variable; normalizing the NIR/Clear ratio by the cycle-averaged current (r = 0.761) ensures correct signal interpretation under varying process conditions. Two narrow channels–NIR (940 nm) and F8 (680 nm)–provide accuracy equivalent to the broadband Clear channel (r = 0.778 vs. 0.781), thus simplifying hardware implementation. Ridge regression using three weakly correlated features (log(NIR/Clear), cycle duration, and initial temperature) achieves a mean absolute error of 91.4 °C under leave-one-out cross-validation (LOOCV) and 85.5 °C on an independent current-group test (R2 = 0.536). Independent verification by scanning electron microscopy and Vickers microhardness on 30KhGSA steel confirms reliable separation of the three thermal regimes: underheating ({\textless}800 °C, 280–320 HV), optimal quenching (800–900 °C, 620–680 HV, fine-needle martensite), and overheating ({\textgreater}900 °C, 540–590 HV). The proposed set of spectral features provides a physically justified basis for a low-cost industrial temperature sensor for electrolytic-plasma processing.},
	language = {en},
	number = {10},
	urldate = {2026-08-24},
	journal = {Sensors},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Kussainov, Rinat and Erboluly, Aikyn and Bakyt, Zhanel and Kadyrbolat, Nurlat and Kurmangaliyev, Rinat and Rakhadilov, Bauyrzhan and Koc, Vladislav and Rakhmetollayeva, Aknur and Satbayeva, Zarina},
	month = jan,
	year = {2026},
	keywords = {AS7341, electrolytic-plasma hardening, feature selection, machine learning, metallographic analysis, microhardness, NIR/Clear, non-contact temperature measurement, regression models},
	pages = {3080},
	file = {Full Text PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\BUHK35B9\\Kussainov et al. - 2026 - AS7341 Spectral Sensor with Machine Learning for Non-Contact Temperature Monitoring in Electrolytic-.pdf:application/pdf},
}

@article{rahman_open-source_2025,
	title = {Open-{Source} {Photosynthetically} {Active} {Radiation} {Sensor} for {Enhanced} {Agricultural} and {Agrivoltaics} {Monitoring}},
	volume = {14},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2079-9292},
	url = {https://www.mdpi.com/2079-9292/14/11/2225},
	doi = {10.3390/electronics14112225},
	abstract = {Photosynthetically active radiation (PAR) is crucial for plant growth, influencing photosynthesis efficiency and crop yield. The increasing adoption of controlled-environment agriculture (CEA) necessitates precise PAR monitoring. The high cost of commercial PAR sensors, however, limits their accessibility and widespread use, creating a growing need for a low-cost alternative capable of reliable deployment in diverse agricultural environments. Building on recent advancements in PAR sensing using multi-channel spectral sensors such as the AS7341 and AS7265, this study develops the electronics for an AS7341-based, open-source, cost-effective ({\textasciitilde}USD 50) PAR sensor validated across a broad PPFD range and conditions, ensuring reliability and ease of replication. It uses a relatively simple multi-linear regression that offers real-time applications without energy intensive machine learning. The developed sensor is calibrated against the industry-standard Apogee SQ-500SS PAR sensor in four distinct farming environments: (i) horizontal grow lights, (ii) vertical agrotunnel lighting, (iii) agrivoltaics, and (iv) in greenhouses. A mean error ranging from 1 to 5\% indicates its suitability for controlled environment farming and continuous data logging. The open-source hardware design and systematic installation guidelines enable users to replicate, calibrate, and integrate the sensor with minimal background in electronics and optics.},
	language = {en},
	number = {11},
	urldate = {2026-08-24},
	journal = {Electronics},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Rahman, Md Motakabbir and Jamil, Uzair and Pearce, Joshua M.},
	month = jan,
	year = {2025},
	keywords = {agriculture, agrivoltaics, controlled environmental agriculture, greenhouses, multiple linear regression, PAR, photosynthetic photon flux density, photosynthetically active radiation, PPFD, vertical farming},
	pages = {2225},
	file = {Full Text PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\2ES7DKN2\\Rahman et al. - 2025 - Open-Source Photosynthetically Active Radiation Sensor for Enhanced Agricultural and Agrivoltaics Mo.pdf:application/pdf},
}

@article{hasan_advancing_2025,
	title = {Advancing energy storage: {The} future trajectory of lithium-ion battery technologies},
	volume = {120},
	issn = {2352-152X},
	shorttitle = {Advancing energy storage},
	url = {https://www.sciencedirect.com/science/article/pii/S2352152X25012241},
	doi = {10.1016/j.est.2025.116511},
	abstract = {Lithium-ion batteries are pivotal in modern energy storage, driving advancements in consumer electronics, electric vehicles (EVs), and grid energy storage. This review explores the current state, challenges, and future trajectory of lithium-ion battery technology, emphasizing its role in addressing global energy demands and advancing sustainability. Despite achieving energy densities up to 300 Wh/kg, cycle lives exceeding 2000 cycles, and fast-charging capabilities, lithium-ion batteries face significant challenges, including safety risks, resource scarcity, and environmental impacts. Recycling inefficiencies and the need for sustainable material alternatives further underscore the urgency for innovation. This paper highlights recent breakthroughs in silicon-based anodes, solid-state electrolytes, and advanced cell designs, which promise to push energy densities beyond 400 Wh/kg and extend cycle lives to over 5000 cycles. Additionally, alternative battery technologies, such as solid-state, sodium-ion, and metal-air systems, are explored for their potential to complement or surpass lithium-ion batteries in specific applications. By bridging the gap between academic research and real-world implementation, this review underscores the critical role of lithium-ion batteries in achieving decarbonization, integrating renewable energy, and enhancing grid stability. Collaborative efforts among researchers, industry stakeholders, and policymakers are essential to overcoming these challenges and driving the transition to cleaner, more sustainable energy systems.},
	urldate = {2026-08-25},
	journal = {Journal of Energy Storage},
	author = {Hasan, M. M. and Haque, R. and Jahirul, M. I. and Rasul, M. G. and Fattah, I. M. R. and Hassan, N. M. S. and Mofijur, M.},
	month = jun,
	year = {2025},
	keywords = {Battery technology, Electric vehicles, Energy storage, Lithium-ion batteries, Recycling, Sustainability},
	pages = {116511},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\28GR6DC4\\Hasan et al. - 2025 - Advancing energy storage The future trajectory of lithium-ion battery technologies.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\XRND4EMP\\S2352152X25012241.html:text/html},
