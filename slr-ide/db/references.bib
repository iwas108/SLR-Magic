@inproceedings{tan_design_2025,
	address = {Kuala Lumpur, Malaysia},
	title = {Design and {Implementation} of {Intelligent} {Power} {Outage} {Pre}-{Scheduling} {System} for {Improving} {Power} {Supply} {Reliability}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-3792-0},
	url = {https://ieeexplore.ieee.org/document/11447024/},
	doi = {10.1109/AECSPE66597.2025.00142},
	abstract = {At present, there are many problems in prescheduled outage management, such as multi-objective conflict, lagging dynamic response, and insufficient data value. Moreover, the existing system is static, localized and relies on "black box" algorithm. Therefore, an intelligent power outage pre-scheduling system is designed in this study, which adopts a three-layer dynamic closed-loop architecture of "perceptiondecision-execution", with digital twinning and real-time optimization as the core. The data sensing layer integrates multi-source data to construct a coupling model, and realizes the accurate evaluation of equipment real-time failure rate through LSTM; Intelligent decision layer integrates deep reinforcement learning (DRL) and multi-objective optimization (MOO) engines to generate Pareto optimal outage plan set; The feedback layer is implemented to form closedloop learning and continuous optimization. In terms of key algorithms and models, a quantitative model of user needs is constructed to transform user sensitivity into quantitative indicators; MOO model based on NSGA-III is designed to realize multi-objective collaborative optimization, and DRL module is introduced as a dynamic adjustment mechanism to form a hybrid optimization architecture of offline planning and online adjustment. Based on the data of Meizhou Power Supply Bureau, the experiment verifies the effectiveness of the system by comparing with the traditional manual mode and business optimization software. In the scene of sudden change of new energy output, the system adjustment delay is only 48s, and the fault risk prediction error is reduced to 8.2\%; On the 7th, the comprehensive index showed that its SAIFI (System Average Interruption Frequency Index) was 0.61 times/household, the comprehensive cost was 2.93 million yuan, and the compliance rate of high-priority users was 96\%, all of which were better than the comparison scheme and could effectively meet the differentiated needs of different users. The system breaks through the limitation of traditional mode, improves the reliability of power supply, reduces the cost, improves the satisfaction of users, and provides an effective solution for the power outage management of complex power systems.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {Asia} {Conference} on {Energy} {Conversion} {Systems} and {Power} {Electronics} ({AECSPE})},
