	file = {Costa_2025_Lowcostandnonin_763f3:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Costa_2025_Lowcostandnonin_763f3.pdf:application/pdf},
