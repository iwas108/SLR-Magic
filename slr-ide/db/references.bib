	file = {PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\LBAJCQ6A\\Kent et al. - 2024 - Controlling chaos using edge computing hardware.pdf:application/pdf},
}

@article{ojo_crop_2026,
	title = {A crop digital twin system for predictive growth monitoring and adaptive light control in controlled environment agriculture},
	volume = {37},
