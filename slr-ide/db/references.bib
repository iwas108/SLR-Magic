	pages = {110139},
	file = {Xu_2023_Deeplearningenh_15f01:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Xu_2023_Deeplearningenh_15f01.pdf:application/pdf},
}

@article{ward_challenges_2023,
	title = {The challenges of using live-streamed data in a predictive digital twin},
