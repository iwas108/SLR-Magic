@article{qian_pitting_2025,
	title = {Pitting corrosion diagnostics and prognostics for miter gates using multiscale simulation and image inspection data},
	volume = {24},
	issn = {1475-9217, 1741-3168},
	url = {https://journals.sagepub.com/doi/10.1177/14759217241264291},
	doi = {10.1177/14759217241264291},
	abstract = {Physics-based high-fidelity pitting corrosion simulation models have successfully predicted the evolution of corrosion pit morphology for given mechanical and environmental conditions. However, applying such models for pitting corrosion diagnostics and prognostics in large civil infrastructures such as found in the inland waterways navigation enterprise is very challenging, primarily due to the impracticality of measuring individual pits. This paper addresses this challenge by bridging the gap between physics-based pitting corrosion simulation and vision-based pitting corrosion inspection of large civil infrastructures. The framework proposed in this paper consists of four main modules: mesoscale pitting corrosion simulation using the phase-field method, macroscale structural analysis, pitting corrosion detection using machine learning, and updating physics-based simulation models based on pitting corrosion detection. It begins with developing a forward simulation framework to predict the evolution of pitting corrosion on large civil infrastructure using multiscale analysis. A convolutional neural network (CNN)-based pit detection method is created in parallel to autonomously identify and extract pitting corrosion observations from corrosion inspection images. Finally, an approximate Bayesian computation numerical framework is proposed to update three key model parameters in the forward pitting corrosion simulation model using the detection results from the trained CNN model. The updated multiscale simulation model can then be used for pitting corrosion prognostics. A practical application example is demonstrated on miter gates to show the effectiveness of the proposed framework.},
	language = {en},
	number = {4},
	urldate = {2026-07-23},
	journal = {Structural Health Monitoring},
	author = {Qian, Guofeng and Wu, Zihan and Hu, Zhen and Todd, Michael D.},
	month = jul,
	year = {2025},
	pages = {2008--2030},
	file = {Qian_2025_Pittingcorrosio_0fd2b:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Qian_2025_Pittingcorrosio_0fd2b.pdf:application/pdf},
}

@article{liu_physics-based_2025,
	title = {Physics-{Based} {Data} {Augmentation} {Enables} {Accurate} {Machine} {Learning} {Prediction} of {Melt} {Pool} {Geometry}},
	volume = {15},
	issn = {2076-3417},
	url = {https://www.mdpi.com/2076-3417/15/15/8587},
	doi = {10.3390/app15158587},
	abstract = {Accurate melt pool geometry prediction is essential for ensuring quality and reliability in Laser Powder Bed Fusion (L-PBF). However, small experimental datasets and limited physical interpretability often restrict the effectiveness of traditional machine learning (ML) models. This study proposes a hybrid framework that integrates an explicit thermal model with ML algorithms to improve prediction under sparse data conditions. The explicit model—calibrated for variable penetration depth and absorptivity—generates synthetic melt pool data, augmenting 36 experimental samples across conduction, transition, and keyhole regimes for 316 L stainless steel. Three ML methods—Multilayer Perceptron (MLP), Random Forest, and XGBoost—are trained using ﬁvefold cross-validation. The hybrid approach signiﬁcantly improves prediction accuracy, especially in unstable transition regions (D/W ≈ 0.5–1.2), where morphological ﬂuctuations hinder experimental sampling. The best-performing model (MLP) achieves R2 {\textgreater} 0.98, with notable reductions in MAE and RMSE. The results highlight the beneﬁt of incorporating physically consistent, nonlinearly distributed synthetic data to enhance generalization and robustness. This physics-augmented learning strategy not only demonstrates scientiﬁc novelty by integrating mechanistic modeling into data-driven learning, but also provides a scalable solution for intelligent process optimization, in situ monitoring, and digital twin development in metal additive manufacturing.},
	language = {en},
	number = {15},
	urldate = {2026-07-23},
	journal = {Applied Sciences},
	author = {Liu, Siqi and Li, Ruina and Zhou, Jiayi and Dai, Chaoyuan and Yu, Jingui and Zhang, Qiaoxin},
	month = aug,
	year = {2025},
	pages = {8587},
	file = {Liu_2025_PhysicsBasedDat_6f11c:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Liu_2025_PhysicsBasedDat_6f11c.pdf:application/pdf},
}

@inproceedings{nadeem_artificial_2026,
	address = {Málaga, Spain},
	title = {Artificial {Intelligence}-{Driven} {Smart} {Approaches} for {Structural} {Health} {Monitoring} in {Critical} {Infrastructure}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3195-1965-8},
	url = {https://ieeexplore.ieee.org/document/11499463/},
	doi = {10.1109/GCWOT69191.2026.11499463},
	abstract = {The growing need for resilient and sustainable infrastructure has increased the pace of evolution of intelligent Structural Health Monitoring (SHM) systems. This paper proposes an AI-based SHM model for real-time monitoring and predictive maintenance of critical infrastructure. The suggested system will combine wireless sensor networks, deep learning models, and digital twin technology to identify structural anomalies and predict deterioration. Multimodal data were collected using a hybrid sensing architecture (accelerometers, strain gauges, acoustic emission, and fiber-optic temperature sensors) under different environmental conditions. Adaptive filtering and principal component analysis (PCA) were used as preprocessing methods to improve signal quality and isolate damage-sensitive features. A number of machine learning and deep learning systems, including SVM, Random Forest, CNN, and LSTM, were tested for damage classification. The LSTM outperformed others with 97.5\% accuracy and ROC-AUC of 0.99 by effectively learning temporal patterns in vibration data. The system was also found to have strong predictive value, with the ability to estimate remaining useful life (RUL), yielding R 2 = 0.94, and provided a 9-day early warning. The integration of digital twins enabled real-time visualisation of conditions. The framework was tested under various environmental conditions and proved sound and applicable to the field. Unlike many prior studies that focus on isolated AI models or lab-only validation, this work integrates digital twins with robust LSTM-based forecasting and validates performance under real-world environmental variability.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 {Global} {Conference} on {Wireless} and {Optical} {Technologies} ({GCWOT})},
	publisher = {IEEE},
	author = {Nadeem, Muhammad and Haider, Waleej and Shaikh, Muhammad Kashif and Pitafi, Abdul Hameed and Khan, Sallar and Ahmed, Haris},
	month = feb,
	year = {2026},
	pages = {1--6},
	file = {Nadeem_2025_ArtificialIntel_0bfe8:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Nadeem_2025_ArtificialIntel_0bfe8.pdf:application/pdf},
}

@inproceedings{baghaee_mipmap_2025,
	address = {Sile, Istanbul, Turkiye},
	title = {{MipMap} {Digital} {Twin}: {A} {Scalable} {IoT}-{Based} {Framework} for {Smart} {Cities} and {Circular} {Economy}},
