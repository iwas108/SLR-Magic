@article{luo_adaptive_2026,
	title = {Adaptive digital twin framework for monitoring and predicting the performance of composite adhesive joints},
	volume = {102},
	issn = {0021-8464, 1545-5823},
	url = {https://www.tandfonline.com/doi/full/10.1080/00218464.2025.2535687},
	doi = {10.1080/00218464.2025.2535687},
	abstract = {This study explores the integration of machine learning models with a digital twin (DT) framework to predict and correlate the performance of CFRP-to-aluminum adhesive joints under hygrothermal aging. The research bridges the gap between natural and accelerated aging eﬀects by combining experimental bending tests with data-driven approaches. A total of 145 specimens were fabricated and exposed to natural aging for up to 36 months and to accelerated hygrothermal conditions ranging from 100 to 1200 hr. Three-point bending tests were conducted to assess joint strength. Five machine learning models – SVR, ANN, Linear Regression, Random Forest, and XGBoost – were employed to estimate natural aging behavior based on accelerated aging data. Furthermore, a digital twin system was developed and dynamically updated in three consecutive rounds using 110 separate data points to enhance model adaptability in real time. XGBoost consistently achieved perfect prediction metrics, outperforming all other models. Scanning Electron Microscopy (SEM) revealed that hygrothermal exposure signiﬁcantly altered the aluminum substrate’s surface morphology, showing increased roughness, matrix degradation, and crystalline deposits. Moisture-driven degradation mechanisms such as oxidation, hydrolysis, and polymer chain scission were observed to reduce joint strength and shift failure modes from cohesive to mixed-mode failures. Overall, the integration of DT with machine learning enables accurate, real-time prediction and monitoring of adhesive joint performance, improving the durability and reliability of composite structures for critical applications such as aerospace and automotive industries.},
	language = {en},
	number = {4},
	urldate = {2026-07-23},
	journal = {The Journal of Adhesion},
	author = {Luo, Shiqiang and Karimi, Sajjad},
	month = mar,
	year = {2026},
	pages = {321--350},
	file = {Luo_2026_Adaptivedigital_d534f:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Luo_2026_Adaptivedigital_d534f.pdf:application/pdf},
}

@inproceedings{s_scalable_2026,
	address = {Bangkok, Thailand},
	title = {A {Scalable} {Digital} {Twin} {Architecture} for {Intelligent} {Cyber} {Physical} {Systems}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-7457-4},
	url = {https://ieeexplore.ieee.org/document/11483673/},
	doi = {10.1109/ICMLAS67792.2026.11483673},
	abstract = {Real time monitoring, intelligent control and scalability of infrastructure to support the large scale distributed environment are necessary in Cyber Physical Systems (CPS). (Model Predictive) Digital Twin (DT etc.) technology provides a virtual model of real systems, supports predictive analytics, optimization and autonomous decision making. But scalability, latency and intelligent integration remain limitations in the current digital twin architectures. In this paper, we outline a scalable digital twin architecture that combines of physical systems, edge computing, cloud infrastructure and artificial intelligence for smart CPS. Key functionalities such as predictive maintenance, anomaly detection and autonomous control are realized by the use of Neural Networks, Random Forest and Reinforcement Learning in the presented infrastructure. Edge processing decreases the latency by processing the data locally and concurrent cloud infrastructure also provides scalability in terms of storage and computation. Experiments with IoT data from industrial equipments results in better performance, 92.3\% prediction accuracy, lowered latency and increased throughput when compared with typical architectures. Scalability studies indicate its reliable operation as the size of the devices is increased. The architecture is an effective, scalable and intelligent solution for the future cyber physical systems.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 {International} {Conference} on {Machine} {Learning} and {Autonomous} {Systems} ({ICMLAS})},
	publisher = {IEEE},
	author = {S, Priyadarshini and Althati, Chandrashekar and Tomar, Manish and Jinna, Kartheek Reddy and Pichaimani, Thirunavukkarasu and Rambabu, Venkatesha Prabhu},
