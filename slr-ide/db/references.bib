@article{wang_combined_2023,
	title = {Combined digital twin and hierarchical deep learning approach for intelligent damage identification in cable dome structure},
	volume = {274},
	issn = {01410296},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0141029622012482},
	doi = {10.1016/j.engstruct.2022.115172},
	abstract = {Accurate identi cation of structural damage is the most critical step in structural health monitoring. Traditional damage identi cation strategies are easily interfered by environmental and human factors, resulting in lowaccuracy of identi cation. In this light, a combined digital twin (DT) and hierarchical deep learning (DL) approach for intelligent damage identi cation in cable dome structures is proposed in this paper. Based on actual engineering cases, a DT model that accurately maps the physical structure of the cable dome is constructed using APDL based on data. A cable dome structure damage sample database is then automatically established through the large-scale nite element analysis of DT. Finally, the damage features of the data samples are extracted using the hierarchical DL framework proposed in this study. Accuracy veri cation based on cable force con rms that the established DT model can accurately re2ect the mechanical state of the physical structure. The identi cation results of the trained network on a test set demonstrate that the proposed framework can intelligently identify the damage type, damage location, and damage degree in the cable dome structure with a high accuracy and strong robustness. The proposed intelligent damage identi cation approach is feasible and reliable and can provide a new basis for structural damage identi cation with broad application prospects.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Engineering Structures},
	author = {Wang, Longxuan and Liu, Hongbo and Chen, Zhihua and Zhang, Fan and Guo, Liulu},
	month = jan,
