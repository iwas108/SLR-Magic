@article{badjadi_novel_2026,
	title = {Novel entropy framework for physics-guided reconstruction of subsurface fracture networks},
	volume = {266},
	issn = {29498910},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S294989102600268X},
	doi = {10.1016/j.geoen.2026.214624},
	abstract = {Accurate characterization of three-dimensional subsurface fractures and 2uid pathways is essential for the safe and ef3cient development of enhanced geothermal systems (EGS). The cvPINN-AE-UCA framework is a novel physics-constrained deep learning model that integrates multimodal experimental data with a control-volume physics-informed neural network (cvPINN) to reconstruct 3D fracture geometries and dynamic 2uid transport in crystalline rock under coupled thermo-hydro-mechanical (THM) conditions. Acoustic emission (AE) data capture microcrack initiation and propagation, while Sonazoid per2uorobutane microbubbles serve as ultrasound contrast agents (UCAs) to enhance detection of active 2uid pathways via strong acoustic backscattering. These signals are fused with high-resolution optical images of granite specimens and synthetic images generated by CycleGAN, signi3cantly expanding the training dataset. The model incorporates Darcy 2ow, Mohr–Coulomb failure, mass-energy conservation, and entropy regularization to ensure mechanical validity and prevent nonphysical tensile fractures. Applied to granite blocks under EGS-relevant conditions, the framework achieves 91\% fracture-type classi3cation accuracy, 96\% cluster connectivity with ±6◦ dip-angle continuity, and 2ow-rate prediction error below 4.2\%. Permeability increased by 3ve orders of magnitude following hydraulic breakthrough. The model resolves fractures as small as 0.6 mm and delivers full 3D volume inference in approximately 8 s. This scalable and interpretable platform establishes a foundation for next-generation digital twins in THMcoupled subsurface systems relevant to geothermal energy, CO2 storage, and fault reactivation monitoring.},
	language = {en},
