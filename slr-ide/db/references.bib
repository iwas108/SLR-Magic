@article{hua_digital-twin-driven_2025,
	title = {Digital-{Twin}-{Driven} {Clearance} {Prediction} and {Adjustment} of {Isothermal} {Forging} {Hydraulic} {Press}},
	volume = {74},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {0018-9456, 1557-9662},
	url = {https://ieeexplore.ieee.org/document/11015344/},
	doi = {10.1109/TIM.2025.3573372},
	abstract = {In isothermal forging (ISF), the clearance between the slide and guide signiﬁcantly inﬂuences the slide’s vibration and the ﬁnal forging quality. Because of the friction and wear in the slide guide system, real-time clearance measurement and clearance adjustment, however, remain a challenge. In order to address this issue, a two-stage digital-twin-driven framework that integrates a data-driven model and an optimization model for clearance adjustment was proposed. Initially, a ﬁnite element model of the slide and guide system and the random forest (RF) algorithm was employed to build a data-driven model; moreover, to determine the real-time clearance adjustment, the temporal convolutional network-RF (TCN-RF) machine-learning model was proposed. The model feature importance analysis showed that the model structure had a greater impact on accuracy than the hyperparameters, accounting for 63.42\%. Then, the Bayesian optimization algorithm was used to determine the clearance adjustment. The proposed solution was validated on a 20 MN ISF hydraulic press. The adjustment results showed that the slide stability along the X-, Y- and Z-axis was improved by 89\%, 58\% and 28\%, respectively. Finally, based on the high-precision machine-learning model and digital twin, an ISF hydraulic press real-time clearance adjustment visualization software was developed.},
	language = {en},
	urldate = {2026-07-23},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	author = {Hua, Lin and Yin, Chunyang and Hu, Zhili and Zheng, Fangyan and Qin, Xunpeng},
	year = {2025},
	pages = {1--15},
	file = {Hua_2025_DigitalTwinDriv_323f5:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Hua_2025_DigitalTwinDriv_323f5.pdf:application/pdf},
}

@inproceedings{jacob_towards_2025,
	address = {Kyoto, Japan},
	title = {Towards {Artifacts}-{Based} {Behavior} {Modeling} of {Cyber}-{Physical} {Systems} for {Building} {Digital} {Twins}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-2026-7},
	url = {https://ieeexplore.ieee.org/document/11073032/},
	doi = {10.1109/ICCAR64901.2025.11073032},
	abstract = {Behavior modeling of complex systems is a critical aspect in developing digital systems, such as Digital Twins (DT). It enables accurate representation of intricate dynamics and interactions, facilitating predictive capabilities that are essential for forecasting future states and behaviors. This paper presents a methodology for building predictive DTs of complex systems, addressing the critical challenge of behavior modeling. Our approach integrates data-driven techniques, including machine learning (ML), with physics-based or mathematical models, leveraging both real-time and historical data. We argue that this hybrid modeling strategy is essential for creating DTs capable of accurate prediction and "sliding forward in time" to visualize future system states. We propose a customizable framework that supports the development of a predictive maintenance module, covering physics/mathematics-based modeling, behavior learning, and uncertainty quantification. This framework is composed of programmable components derived from identified modeling artifacts, allowing for the seamless integration of diverse modeling techniques. Another key contribution of this work is the development of concrete modeling principles for designing predictive DTs, such as the principle of data-driven model calibration informed by physical constraints. We validate the effectiveness of our framework and principles through a case study that demonstrates the creation of a battery DT prototype. This is done for the battery of a laptop, utilizing real-time data collection and a discharge model to project battery discharge behavior. Our experiment highlights the potential of our approach for real-world applications in cyber-physical systems (CPS) by enabling proactive maintenance and improved system performance. Future work will extend this framework into a more sophisticated DT development environment following the artifactbased design presented here.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 11th {International} {Conference} on {Control}, {Automation} and {Robotics} ({ICCAR})},
	publisher = {IEEE},
	author = {Jacob, Brijith and G, Santhosh Kumar},
	month = apr,
	year = {2025},
	pages = {574--579},
	file = {Jacob_2025_TowardsArtifact_0bb1d:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Jacob_2025_TowardsArtifact_0bb1d.pdf:application/pdf},
}

