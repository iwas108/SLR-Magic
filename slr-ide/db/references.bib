@article{liu_digital_2026,
	title = {Digital twin-driven deep reinforcement learning for coordinated scheduling and state prediction of distributed energy storage clusters},
	volume = {421},
	issn = {03062619},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0306261926009049},
	doi = {10.1016/j.apenergy.2026.128250},
	abstract = {Optimal scheduling of distributed energy storage systems relies on accurate perception of battery operating states. However, existing deep reinforcement learning scheduling methods conˡne their state spaces to direct sensor measurements, lacking access to deep-level information such as internal resistance variations, model deviations, and health degradation trends, which constrain decision accuracy and foresight. To address this limitation, a digital twin-driven deep reinforcement learning-based coordinated scheduling and state predic tion method is proposed. First, a digital twin model integrating a second-order RC equivalent circuit with unscented Kalman ˡlter online parameter identiˡcation is constructed, deˡning a cluster coordination state vector that encapsulates online-identiˡed internal resistance, model deviation, and state of health, achieving bidirectional real-time synchronization between physical and digital systems. Second, this state vector is incor porated as augmented input into a deep deterministic policy gradient scheduling algorithm, forming a closed-loop “perception–decision–execution–feedback” architecture, complemented by an LSTM-based state prediction model enhanced with digital twin features. Comprehensive validation is conducted on both a custom simulation platform and the IEEE 33-bus test system across multiple scales (5/15/30 units) and scenarios (normal/PV ˣuctuation/load surge/communication anomaly), with state prediction veriˡed on the NASA battery dataset. Results demonstrate that the proposed method achieves 87.8\% scheduling e˥ciency in the 5-unit scenario, surpassing standard DDPG by 4.1 percentage points (𝑝 = 0.0002) and PI control by 9.3 percentage points. Dimension-e˫ect control experi ments conˡrm that performance gains originate from digital twin information rather than dimensional increase. DT-SAC comparative experiments verify the generalizability of the proposed state augmentation method across di˫erent base algorithms (𝑝 = 0.384). SOC prediction RMSE is 0.028, and SOH prediction RMSE on NASA realworld data is 0.032. Under communication anomaly, scheduling e˥ciency degrades by only 1.7 percentage points, signiˡcantly outperforming the 4.1-point degradation of standard DDPG.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Applied Energy},
	author = {Liu, Huwei and Liang, Kaibo and Zhao, Junhui and Yang, Jianglong and Zhou, Li},
	month = oct,
