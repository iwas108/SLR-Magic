	title = {Design of {Intelligent} {Operation} and {Maintenance} {Management} {System} for {Substation} {Integrating} {Digital} {Twin} and {BIM}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-8536-5},
	url = {https://ieeexplore.ieee.org/document/11454957/},
	doi = {10.1109/PEEEC67807.2025.00120},
	abstract = {Targeting the cutting-edge field of power systems, we have developed an intelligent substation operation and maintenance system based on a four-layer architecture of "acquisition-edge-bus-application" and combined digital twin and BIM technologies. The system has also completed engineering certification: in accordance with the IEC 61850-92 specification, 4 kHz synchronous sampling is implemented on the device side, and the edge gateway implements Kalman filtering and Δ-compression optimization. Data is uploaded to the 5G gNodeB via the MQTT-TLS protocol. The data flows through 25 Gbps optical fiber and converges to the data lake and partitioned Kafka bus, achieving a 1-second update rate for twin-BIM. At the application level, rigid body registration and least squares correction are used to achieve the unification of the twin state and BIM-IFC 3D posture, maintaining the spatial error value below 2 cm. With the help of Forge-API WebSocket and OPC UA technology, a closed-loop structure of "physical-virtual-decision-making" is formed. Relying on the SoCal 28-Bus measured data set, functional performance testing and analysis were carried out: the average response time was less than 300 milliseconds, the end-to-end data delay was 87.5 milliseconds, the throughput reached 9,230 messages per second, the system reliability was 99.87\%, the digital twin synchronization frequency was 1.12Hz, and the BIM refresh frequency was 0.98Hz; the fault warning system used convolutional neural networks and bidirectional long shortterm memory networks, and adopted a dynamic threshold control method. The accuracy of the warning 48 hours ago was 96.4\%, the missed alarm rate was 1.8\%, the false alarm rate was 3.5\%, and the consistency error between BIM and physical mapping did not exceed 0.6\%. The operating stability of the equipment was improved from 97.2\% to 99.1\%, and the full life cycle cost was reduced by 11.4 percentage points. This architecture is in line with the current intelligent operation and maintenance specifications of the power industry and adapts to the scalable capabilities of AI diagnosis and energy consumption forecasting.},
	language = {en},
	urldate = {2026-07-23},
