@inproceedings{cassimo_hybrid_2025,
	address = {Turin, Italy},
	title = {Hybrid {Reliability} {Digital} {Twin} for {Smart} {Street} {Lighting}: {Thermo}-{Electrical} {Modeling} and {Scalable} {Deployment} {Architectures}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-4952-7},
	shorttitle = {Hybrid {Reliability} {Digital} {Twin} for {Smart} {Street} {Lighting}},
	url = {https://ieeexplore.ieee.org/document/11422124/},
	doi = {10.1109/ICSRS68021.2025.11422124},
	abstract = {Street lighting is a critical infrastructure for smart cities that impacts public safety and energy efﬁciency. Traditional maintenance strategies, including corrective and preventive approaches, often result in operational shortcomings such as premature replacement of components, excessive downtime, and inefﬁcient resource allocation. To address these challenges, Reliability Digital Twins (RDTs) offer a predictive maintenance solution by combining physics-of-failure models with real-time telemetry. Most existing RDTs for LED luminaires in street lighting focus primarily on thermal stress, while overlooking the signiﬁcant impact of electrical stressors such as overvoltage and overcurrent. This work aims to address this gap, proposing a hybrid RDT for smart street lighting that integrates both thermal and electrical acceleration factors to model component degradation using a Weibull-like formulation. The scalability of the proposed RDT is further evaluated across three deployment architectures—device, edge, and cloud–edge. A proof of concept, developed in Node-RED with synthetic telemetry, demonstrates that electrical stresses can reduce the Remaining Useful Life by up to 27\%, an effect comparable to or even greater than thermal stress. Moreover, the deployment analysis shows that a cloud-only architecture is economically prohibitive at scale, whereas edgecentric strategies reduce costs by up to two orders of magnitude, enabling city-wide implementation.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 9th {International} {Conference} on {System} {Reliability} and {Safety} ({ICSRS})},
