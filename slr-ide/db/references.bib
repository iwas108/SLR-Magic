	pages = {104039},
	file = {Tang_2026_Physicsinformed_81ee3:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Tang_2026_Physicsinformed_81ee3.pdf:application/pdf},
