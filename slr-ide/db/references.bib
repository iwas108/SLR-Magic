@inproceedings{pandey_data-driven_2025,
	address = {Bhubaneswar, India},
	title = {A {Data}-{Driven} {Digital} {Twin} {Formation} with {TCN} for {State} {Prediction} of {Grid}-{Tied} {PV} {Systems}},
	copyright = {https://doi.org/10.15223/policy-029},
