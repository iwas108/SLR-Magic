@inproceedings{uhrich_mpgt_2025,
	address = {Santa Clara, CA, USA},
	title = {{MPGT}: {Multimodal} {Physics}-{Constrained} {Graph} {Transformer} {Learning} for {Hybrid} {Digital} {Twins}},
	copyright = {https://doi.org/10.15223/policy-029},
