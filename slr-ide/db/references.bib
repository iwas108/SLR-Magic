@article{thakur_raise_2026,
	title = {{RAISE}: {Real}-{Time} {Adaptive} {Artificial} {Intelligence} {System} for {Safety} {Enforcement}},
	volume = {65},
	copyright = {https://doi.org/10.15223/policy-029},
	issn = {0888-5885, 1520-5045},
	shorttitle = {{RAISE}},
	url = {https://pubs.acs.org/doi/10.1021/acs.iecr.6c00106},
	doi = {10.1021/acs.iecr.6c00106},
	abstract = {Autonomous process systems evolve rapidly, yet they still rely on safety functions that are largely reactive and operator-dependent, intervening only after alarms are triggered. Existing fault-prognosis frameworks typically serve as monitoring tools and lack a direct mechanism for converting predictions into safety actions. This disconnection between prediction and enforcement limits the safety value of digital twins and AI-enabled operation in safety-critical plants. To address this gap, this paper proposes RAISE (Real-time Adaptive Artiﬁcial Intelligence System for Safety Enforcement), a closed-loop framework that transforms fault prognosis into proactive safety action. A key innovation of RAISE is the GRU-SINDy model, which uses a gated recurrent unit (GRU) to capture temporal dependencies and estimates local time-varying coeﬃcients via sparse identiﬁcation of nonlinear dynamics (SINDy), thereby enabling stable multistep state forecasts for proactive decision-making. These forecasts are evaluated by a dynamic risk assessment (DRA) module that quantiﬁes risk in real time. Case study results on a nonlinear CSTR demonstrate that the GRU-SINDy model achieves greater accuracy and computational eﬃciency than OASIS, with reliable performance across regime shifts. The framework continuously evaluates predicted system evolution to generate risk-informed actions, providing an early warning lead time of 0.1−0.11 h before threshold violations. These results demonstrate that RAISE enables real-time, risk-informed safety actions and provides a safety-twin capability to support reliable autonomous operation in process systems.},
	language = {en},
	number = {18},
	urldate = {2026-07-23},
	journal = {Industrial \& Engineering Chemistry Research},
	author = {Thakur, Rohan and Sajid, Zaman and Amin, Md Tanjin and Kwon, Joseph and Khan, Faisal},
	month = may,
	year = {2026},
	pages = {9519--9539},
	file = {Thakur_2026_RAISERealTimeAd_fe929:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Thakur_2026_RAISERealTimeAd_fe929.pdf:application/pdf},
}

@article{xue_space-time-factor_2026,
	title = {A space-time-factor coupled framework for multi-point collaborative deformation prediction of high arch dams},
	volume = {76},
	issn = {14740346},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S147403462600649X},
	doi = {10.1016/j.aei.2026.104957},
	abstract = {Accurate deformation prediction is essential for safety monitoring and early warning of dams. However, existing prediction models still struggle to dynamically capture the multidimensional, coupled, and nonlinear relationships among environmental factors, temporal evolution, and spatial correlations across monitoring points, which limits their applicability in multi-point deformation prediction under complex operating conditions. To address this challenge, this study proposes a deep learning-based framework for multi-point collaborative deformation prediction, featuring deep fusion of space-time-factor information. Prior spatial information of monitoring points is embedded into a graph convolutional network with trainable edge weights and an adaptive graph-structure mechanism to accurately characterize dynamic spatial relationships. Meanwhile, a gated fusion strategy is introduced to coordinate multidimensional dependencies in the factor-time domains within a Transformer architecture. An Optuna optimization strategy is further employed to jointly optimize graph structures and model hyperparameters, resulting in a spatial prior perception deep capture Transformer (SppDcTransformer) model. Application results from a high arch dam demonstrate that the proposed model consistently outperforms baseline and ablation models, achieving average evaluation metrics of RMSE = 0.57 mm, MSE = 0.48 mm2, MAE = 0.44 mm, and MAPE = 1.25\%. These results con{\textgreater}rm the effectiveness, robustness, and generalization capability of the proposed framework for multi-point collaborative deformation prediction, providing reliable technical support for dam structural health monitoring and digital twin–oriented safety management.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Advanced Engineering Informatics},
	author = {Xue, Jianghan and Zhang, Pengtao and Lu, Xiang and Zhou, Jingren and Li, Zefa and Li, Yanling and Chen, Jiankang},
	month = nov,
	year = {2026},
	pages = {104957},
	file = {Xue_2026_Aspacetimefacto_2943b:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Xue_2026_Aspacetimefacto_2943b.pdf:application/pdf},
