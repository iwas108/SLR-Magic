@inproceedings{zhang_ai_2025,
	address = {Changchun, China},
	title = {{AI} and {Digital} {Twin}-{Driven} {Dynamic} {Optimization} for {Electromechanical} {Systems}},
	copyright = {https://doi.org/10.15223/policy-029},
