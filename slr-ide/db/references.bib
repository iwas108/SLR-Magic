@inproceedings{jaksimov_methods_2025,
    address = {Istanbul, Turkiye},
    title = {Methods and {Algorithm} for {AI}-based {Monitoring} of the {Automated} {Power} {Supply} {System} {Status} in {Mobile} {Control} and {Communication} {Complexes} {Under} {Crisis} {Conditions}},
    copyright = {https://doi.org/10.15223/policy-029},
