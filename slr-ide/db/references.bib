	pages = {129153},
	file = {Souby_2026_AIdrivenmodelin_9992b:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Souby_2026_AIdrivenmodelin_9992b.pdf:application/pdf},
