@article{zheng_prognostic_2025,
	title = {Prognostic digital twinning of lattice-tubular hybrid wind turbine towers exposed to deterioration},
	volume = {79},
	issn = {23520124},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2352012425012767},
	doi = {10.1016/j.istruc.2025.109461},
	abstract = {Lattice-tubular hybrid (LTH) towers, designed to harness high-altitude wind resources above 150 m, face increasing challenges of structural deterioration due to the combination of high-speed winds, large turbines, and greater tower height. These factors demand advanced methods for assessing and predictinfg structural conditions, particularly through prognostics. While the emerging digital twinning (DT) technology shows promising potentials for such prognostic assessment, its application to LTH wind turbine towers remains unexplored. The present study develops a prognostic DT framework for deteriorating LTH towers by integrating simulation models, SCADA, and SHM data. A joint iterative approach is tailored to couple load reconstruction and model updating, while the Bayesian Dynamic Linear Model (BDLM), a probabilistic machine learning algorithm, is employed to predict future loading conditions. By leveraging virtual sensing technology, the framework enables predictive fatigue analysis of critical components, such as 8anges and bolts, improving the understanding of structural reliability and integrity. A case study, based on site-speci9c conditions for LTH applications, not only validates the framework in enhancing structural prognostics, but also inspires intelligent operation and maintenance strategies, as well as advancements in LTH tower design.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Structures},
	author = {Zheng, Tao and Heng, Junlin and Song, Jing and Zhou, Dong and Luo, Yuxiao and Dai, Kaoshan},
