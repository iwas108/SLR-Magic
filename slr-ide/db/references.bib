@article{ni_data-driven_2026,
	title = {Data-{Driven} {Performance} {Prediction} of {Lead}–{Carbon} {Batteries}: {Integrating} {Experimental} {Validation} and {Reduced}-{Order} {Model}-{Guided} {Neural} {Networks}},
	volume = {43},
	issn = {0256-1115, 1975-7220},
	shorttitle = {Data-{Driven} {Performance} {Prediction} of {Lead}–{Carbon} {Batteries}},
	url = {https://link.springer.com/10.1007/s11814-025-00603-0},
	doi = {10.1007/s11814-025-00603-0},
	abstract = {Accurate and e൶cient prediction of battery degradation is essential for optimizing energy storage system design and control. This study introduces a hybrid modeling framework that combines reduced-order modeling (ROM) insights with experimentally validated deep neural networks (DNNs) to predict degradation in lead–carbon (PbC) batteries. Using voltage–capacity pro¿les from 258 experimental charge/discharge cycles, we extract four physically meaningful input features—cycle number, capacity, charge voltage, and discharge voltage—to train a ROM-guided DNN surrogate. The model predicts two key health indicators: capacity retention (CapRet) and end-of-discharge voltage (EoDV). It generalizes well across ¿ve scenario types, including extrapolated conditions up to 700 cycles and varying voltage/capacity inputs. Predictions remain smooth and physically consistent, with validation yielding R² {\textgreater} 0.99 and low MSE. In terms of computational performance, the DNN achieves sub-second inference ({\textasciitilde} 0.02 s), o൵ering over ¿ve orders of magnitude speedup compared to full COMSOL simulations ({\textasciitilde} 25 h), and {\textasciitilde} 1000× faster than ROM ({\textasciitilde} 22 s). This enables rapid scenario testing and real-time diagnostics. The proposed framework provides a scalable and interpretable solution for battery performance forecasting, well-suited for deployment in digital twins, battery management systems, and advanced energy storage design workÀows.},
	language = {en},
	number = {3},
	urldate = {2026-07-23},
	journal = {Korean Journal of Chemical Engineering},
	author = {Ni, Aleksey and Syauqi, Ahmad and Thong, Pham Tan and Uwitonze, Hosanna and Kim, Heehyang and Nagulapati, Vijay Mohan and Song, Inkyung and Jung, Ho-Young and Lim, Hankwon},
