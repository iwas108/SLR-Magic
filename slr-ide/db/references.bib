	url = {https://linkinghub.elsevier.com/retrieve/pii/S0264127525013255},
	doi = {10.1016/j.matdes.2025.114905},
	abstract = {Ceramic particle reinforced metal matrix composites (PRMMCs) fabricated by laser additive remanufacturing (LARM) provide a new route for the in-situ restore and surface enhancement of high value-added parts. However, the absence of an effective quality description method for LARMed PRMMCs hinders their application due to the complex multi-scale defects. This work presents promising results aimed to develop an innovative multi-scale quality monitoring method for comprehensive quality description of LARM-prepared PRMMCs utilizing a single sensor. An innovative classi6cation-regression multi-task framework with fully depth-separable convolutional backbone (CRM-F model) was introduced to simultaneously predict mesoscopic surface continuity and macroscopic hardness. The results show that the prediction results of the CRM-F model exceed 95 \% accuracy on the surface continuity branch, and the prediction errors on the hardness regression prediction branch are stabilized within 5 \%. Meanwhile, the CRM-F model with concise single-path architecture demonstrates excellent inference ef6ciency, and its inference time of 8.10 ms/frame provides an irreplaceable advantage for real-time monitoring on micro-industrial computers with Intel-CPUs. A prototype human–machine interfacing system developed on the basis of the CRM-F model lays a solid foundation for subsequent closed-loop control and digital twins in LARMed PRMMCs.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Materials \& Design},
	author = {Xu, Hongmeng and Chen, Ying and Qian, Zhengchun and Cheng, Huanbo and Huang, Haihong},
	month = nov,
	year = {2025},
	pages = {114905},
