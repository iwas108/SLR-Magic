	address = {Prague, Czech Republic},
	title = {Prior {Knowledge}-{Embedded} {Machine} {Learning}-{Driven} {Cutting} {Force} {Monitoring} in {Machinery} {Industry}},
	copyright = {https://doi.org/10.15223/policy-029},
