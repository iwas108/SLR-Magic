@article{song_aircraft_2026,
	title = {Aircraft engine performance prediction via a physics-informed two-stage network framework},
	volume = {176},
	issn = {12709638},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1270963826004311},
	doi = {10.1016/j.ast.2026.112051},
	abstract = {Digital twin technology has become increasingly important in aero-engine performance analysis and virtual testing through data-driven modeling, but the limitations of black-box models pose signiﬁcant challenges for safety-critical applications. This study proposes a physics-informed two-stage network framework for engine performance prediction, in which key engine state parameters are implicitly embedded through a stage-wise training strategy, thereby reducing the reliance on internal measurements during inference. Once trained, the model can eﬃciently predict engine performance using only ambient temperature, ambient pressure, and power lever angle. Furthermore, a graph neural network is introduced to explicitly encode the engine’s physical structural topology, and dynamic adjacency matrices are employed under diﬀerent operating conditions to model the coupling relationships among engine components, enhancing model interpretability and enabling more accurate characterization of the engine’s complex internal interactions. Validation on a real engine test dataset demonstrated that the proposed method achieves high accuracy and strong robustness in predicting thrust, highpressure compressor outlet pressure and exhaust gas temperature. In actual physical units, the maximum mean absolute percentage error (MAPE) for all performance parameters is 2.63\%, and the maximum root mean square percentage error (RMSPE) is 4.65\%.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Aerospace Science and Technology},
	author = {Song, Chenchen and Shi, Hao and Xiao, Hong and Yu, Aiyang},
	month = sep,
	year = {2026},
