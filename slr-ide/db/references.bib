	pages = {4598--4607},
	file = {Vadnerkar_2026_DigitalTwinsasP_c2968:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Vadnerkar_2026_DigitalTwinsasP_c2968.pdf:application/pdf},
