@article{kim_event-based_2026,
	title = {Event-{Based} {Digital} {Twin} {State} {Formulation} for {Probabilistic} {Prognostics} {Under} {Sparse} {Industrial} {Sensing}},
	volume = {14},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0/},
	issn = {2169-3536},
	url = {https://ieeexplore.ieee.org/document/11550130/},
	doi = {10.1109/ACCESS.2026.3699754},
	abstract = {Digital twin (DT) technologies are increasingly adopted for condition monitoring and predictive maintenance; however, many existing implementations rely on high-ﬁdelity physical replication or data-intensive learning architectures that are impractical in the context of sparse sensing and limited fault data. This work proposes a deployment-oriented DT paradigm that represents the twin as a compact stochastic health state rather than a signal-level replica. Sparse and intermittent ﬂow measurements are transformed into an event-based health indicator (HI) that captures degradation dynamics while remaining robust to periods of inactivity and measurement variability. The HI evolution is modeled as a drifted Wiener process, enabling closed-form and uncertainty-aware estimation of remaining useful life (RUL) without requiring labeled fault datasets. The framework is evaluated using both physics-consistent simulation and real operational data from an industrial diaphragm pump. Simulation results validate monotonic HI evolution and achieve 100\% empirical coverage of 90\% prediction intervals across three degradation trajectories, while real-world experiments conﬁrm transferability of the event-based representation without retraining. A six-method, three-tier comparison demonstrates that the proposed feature space is highly discriminative for unsupervised fault detection (OC-SVM: F1 = 0.854, FAR = 0.045). Furthermore, a twostage architecture that combines OC-SVM detection with PCA-HI Wiener prognostics enables accurate fault identiﬁcation and probabilistic RUL estimation, with calibrated uncertainty bounds and 100\% predictioninterval coverage. Sensitivity analysis conﬁrms robustness to key parameters, and runtime evaluation demonstrates sub-second processing for million-sample datasets, indicating suitability for real-time and edge deployment. The proposed framework provides a practical DT-based prognostics methodology for data-scarce industrial environments, integrating lightweight DT abstraction, unsupervised anomaly detection, and uncertainty-aware degradation modeling.},
	language = {en},
	urldate = {2026-07-23},
	journal = {IEEE Access},
	author = {Kim, Seong-Wook and Kareem, Akeem Bayo and Hur, Jang-Wook},
	year = {2026},
	pages = {84822--84840},
	file = {Kim_2026_EventBasedDigit_26858:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Kim_2026_EventBasedDigit_26858.pdf:application/pdf},
}

@article{hu_digital_2026,
	title = {Digital {Twin}-enabled failure prediction for indoor air quality: {A} {CNN}-{BiLSTM} model with multi-head attention mechanism},
	volume = {117},
	issn = {23527102},
	shorttitle = {Digital {Twin}-enabled failure prediction for indoor air quality},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2352710225029924},
	doi = {10.1016/j.jobe.2025.114755},
	abstract = {Accurate failure prediction is critical to achieving Predictive Maintenance (PdM) for Indoor Air Quality (IAQ), which is highly related to resident well-being and operational effectiveness. However, most existing studies emphasise anomaly detection rather than prediction. To develop a precise and robust method for pre-emptive IAQ warning, this article integrated Convolutional Neural Network (CNN), Bidirectional Long Short-Term Memory (BiLSTM), and Muti-Head Attention (MHA) mechanism into a novel C-B-M model, synergistically incorporating feature extraction, temporal dependency analysis, and contextual weighting mechanisms. Additionally, a real-world dataset collected from various buildings in Singapore is employed in a detailed comparative experiment with other benchmark models for different prediction periods, dataset selection, and failure severity levels to illustrate the effectiveness and robustness of the proposed method. Finally, a Digital Twin (DT)-oriented failure prediction framework for the indoor climate is introduced and validated through the prototype system demonstrating the 3D building model and IAQ alert information.},
