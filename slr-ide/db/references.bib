	url = {https://linkinghub.elsevier.com/retrieve/pii/S0166361526000771},
	doi = {10.1016/j.compind.2026.104510},
	abstract = {Metal tube bending is widely used in high-tech elds such as aerospace. High-precision tube bending processes typically rely on pre-bending simulations to determine parameters that improve bending quality. Traditional machine learning methods focus only on predicting individual defects. In contrast, Finite Element Analysis (FEA) can simulate the entire deformation region (full- eld) throughout the whole bending process (full-process), but it requires high computational resources. To address these challenges, this paper proposes a spatio-temporal deep learning method, SimTubeFormer, for full- eld and full-process prediction of tube bending. Unlike existing methods that focus only on the nal forming state or predicting individual defects, SimTubeFormer enables multi-frame spatio-temporal prediction across the entire deformation region throughout the bending process. SimTubeFormer also incorporates time-varying process parameters, including the bending speed and pressure die feed rate. This allows the model to accurately represent variable-speed bending operations. SimTubeFormer employs a temporal convolutional network to embed both static and dynamic process parameters. The embedded features are then fed into a spatio-temporal simulator based on a U-Net architecture. To reduce the computational complexity of 3D U-Net architectures, SimTubeFormer uses 2D convolutional modules for spatial feature extraction. Additionally, it integrates multi-head attention along the temporal dimension to capture dynamic evolution and ef ciently model spatio-temporal features. The model is trained with a spatio-temporal smoothing loss. This loss function enhances prediction accuracy by enforcing both spatial consistency and temporal continuity. Experimental results show that SimTubeFormer outperforms traditional data-driven methods in prediction accuracy. In real physical experiments, it achieves a nodal error of 0.13 mm, which is comparable to the 0.12 mm error obtained by FEA. Crucially, SimTubeFormer reduces computation time from several hours required by FEA to mere tens of milliseconds, enabling rapid and accurate tube bending simulations. These results show that the proposed SimTubeFormer method can achieve accurate and real-time full- eld and fullprocess virtual simulation. They also highlight its potential to support the development of digital twins and optimize tube bending quality.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Computers in Industry},
	author = {Li, Jie and Wang, Zili and Zhang, Shuyou and Lin, Yaochen and Li, Liangyou and Tan, Jianrong and Li, Zheyi and Hu, Xinlei},
	month = nov,
	year = {2026},
	pages = {104510},
	file = {Li_2026_SimTubeFormerAs_d94d0:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Li_2026_SimTubeFormerAs_d94d0.pdf:application/pdf},
}

@inproceedings{shrivastava_resilient_2025,
	address = {Singapore, Singapore},
	title = {Resilient {Smart} {Grids}: {Digital} {Twin}-{Driven} {Predictive} {Control} for {Renewable} {Energy} {Integration}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9604-0},
	shorttitle = {Resilient {Smart} {Grids}},
	url = {https://ieeexplore.ieee.org/document/11548366/},
	doi = {10.1109/IIPEM65914.2025.11548366},
	abstract = {This paper presents a comprehensive study on resilient smart grids enabled by digital twin–driven predictive control for seamless integration of renewable energy resources. We propose a layered framework that combines high-fidelity digital twins of grid assets, real-time state estimation, probabilistic renewable generation forecasting, and modelpredictive control (MPC) enriched with learning-based surrogate models to achieve adaptive, robust, and low-latency operational decisions. The framework explicitly addresses multi-timescale coordination between transmission, distribution, and distributed energy resources (DERs), and incorporates resilience metrics to quantify and optimize the grid’s ability to withstand and recover from disturbances (e.g., extreme weather, cyber incidents, and component failures). Key technical contributions include (1) a hybrid physicsinformed/data-driven digital twin architecture that fuses physics models with online machine-learning updates for drift correction; (2) a predictive-control algorithm that integrates probabilistic forecasts and constraint tightening to guarantee safe operation under uncertainty; (3) a scalable data-federation and communications design tailored for near-real-time twinning and closed-loop control; and (4) resilience-aware objective formulations and recovery strategies that minimize service disruption while respecting DER and network constraints. We validate the proposed approach via case studies on a benchmark test feeder and a meshed transmission–distribution test system under high renewable penetrations, demonstrating improvements in renewable curtailment reduction, frequency and voltage regulation, and faster recovery from contingencies compared with baseline control strategies. The results show that digital twin–driven predictive control substantially enhances operational flexibility and resilience, while highlighting open challenges in scalability, interoperability, cybersecurity, and standards for practical deployment.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {International} {Conference} on {Intelligent} \&amp; {Innovative} {Practices} in {Engineering} \&amp; {Management} ({IIPEM})},
	publisher = {IEEE},
	author = {Shrivastava, Anurag and Hussein, Layth and Singh, Navdeep and Badhoutiya, Arti and Karuna, Gudapalli and Dwivedi, Shashi Prakash},
	month = nov,
	year = {2025},
