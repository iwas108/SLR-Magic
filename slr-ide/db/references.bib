    publisher = {IEEE},
    author = {Jaksimov, Dauletmurat and Dauletov, Adilbek},
    month = sep,
    year = {2025},
    pages = {1444--1448},
}
@article{krayem_digital_2026,
    title = {A digital twin solution for optimizing productivity and energy performance in hybrid ventilated office space},
    volume = {349},
    issn = {01968904},
    url = {https://linkinghub.elsevier.com/retrieve/pii/S0196890425014049},
    doi = {10.1016/j.enconman.2025.120880},
    abstract = {Digital twins are increasingly used in intelligent building systems to improve energy ef ciency and comfort. This study develops a real-time digital twin framework for a hybrid ventilated of ce space, integrating natural ventilation through automated window operation with air-conditioning. A physics-based building energy model was rst developed and validated, then used to train a machine learning surrogate model to enable fast predictions suitable for real-time model predictive control (MPC). The MPC continuously selected the optimal ventilation mode, whether natural ventilation, mechanical ventilation, or air conditioning with an appropriate setpoint, based on predicted indoor conditions, outdoor weather, and occupancy. The framework was implemented and experimentally evaluated in a controlled of ce test cell under real environmental conditions. Its performance was compared against a conventional rule-based strategy. The digital-twin-driven MPC reduced total HVAC energy consumption by 14 \% and improved estimated occupant productivity by 22 \%, with a PMVto-productivity relationship. The MPC maintained indoor thermal conditions closer to the comfort-neutral zone throughout working hours, while avoiding prolonged cooling cycles observed in the rule-based case. These results demonstrate the potential of real-time MPC-enabled digital twins to enhance energy ef ciency and occupant well-being in hybrid ventilation systems, offering a promising pathway for intelligent building operation.},
    language = {en},
    urldate = {2026-07-23},
    journal = {Energy Conversion and Management},
    author = {Krayem, Hussein and Younes, Jaafar and Ghali, Kamel and Jradi, Muhyiddine and Ghaddar, Nesreen},
    month = feb,
    year = {2026},
    pages = {120880},
}
@inproceedings{congzhong_research_2025,
    address = {Jinzhou, China},
    title = {Research on {Intelligent} {Maintenance} {System} for {Vertical} {Cigarette} {Sorting} {Cabinets} {Based} on {Large} {Language} {Models}},
    copyright = {https://doi.org/10.15223/policy-029},
    isbn = {979-8-3315-0356-7},
    url = {https://ieeexplore.ieee.org/document/11256982/},
    doi = {10.1109/ICSECE65727.2025.11256982},
    abstract = {This study proposes a comprehensive intelligent O\&M system integrating multimodal perception, Boosting-LSTM hybrid prediction, Weibull-based dynamic threshold management, a retrieval-augmented generation (RAG) decision engine, and a Unity3D-based digital twin platform. A multimodal sensing network composed of vibration, thermal imaging, and acoustic emission sensors is constructed. AdaBoost is used for feature selection, and an LSTM model is employed to predict the equipment health index (EHI) with a mean absolute error (MAE) of 0.07. A Weibull reliability function dynamically adjusts thresholds for early warnings, enhancing response efficiency. To replace manual, rule-based decision-making, the RAG engine—integrating Sentence-BERT and a LoRA-tuned LLaMA-7B model—generates repair plans within 20 seconds, improving efficiency by 60 times. The digital twin platform simulates OEE changes after component replacement (error {\textless}5\%) and provides cost-effectiveness analysis. Validated on 36 machines in a tobacco factory, the system improved mean time between failures (MTBF) from 312h to 587h, increased OEE from 68.2\% to 85.5\%, and reduced annual maintenance costs by 76.6\%. Innovations include model distillation (32B → 7B, {\textless}3\% accuracy loss) and edge-cloud cooperative inference (XGBoost delay {\textless}10ms), offering a replicable framework for industrial intelligent maintenance.},
    language = {en},
    urldate = {2026-09-07},
    booktitle = {2025 {IEEE} 3rd {International} {Conference} on {Sensors}, {Electronics} and {Computer} {Engineering} ({ICSECE})},
    publisher = {IEEE},
    author = {Congzhong, Jin and Bo, Jin and Hao, Sun and Liangjun, Chen and Xiran, Wang and Yang, Zhou and Deji, Wang},
    month = aug,
    year = {2025},
    pages = {235--238},
}
@inproceedings{li_design_2025,
    address = {Bhopal, India},
    title = {The {Design} of {Micro}-{Energy} {Storage} {Module} {Adaptive} {Control} {Technology} and {Platform} {Integrating} {Edge} {Computing} and {Intelligent} {Algorithm}},
    copyright = {https://doi.org/10.15223/policy-029},
    isbn = {979-8-3315-2595-8},
    url = {https://ieeexplore.ieee.org/document/11211746/},
    doi = {10.1109/ICoEIT63558.2025.11211746},
    abstract = {With the popularization of distributed energy, micro energy storage modules face challenges such as insufficient real-time control accuracy and poor adaptability to multiple operating conditions. This paper proposes an adaptive control technology integrating edge computing and intelligent algorithms, builds a three-tier architecture of "cloud edge end", and develops a self evolving platform driven by digital twins. The edge layer achieves joint estimation of SOC/SOH (error ≤ 1.5\%) through Unscented Kalman Filter (UKF), combined with improved TD3 algorithm (10ms cycle) for real-time power allocation; Cloud based optimization of economic scheduling using mixed integer linear programming (MILP) and dynamic updating of digital twin model parameters through improved grey wolf algorithm (IGWO). The experiment shows that this scheme shortens the rise time of the micro energy storage module to 89ms (58.6\% higher than traditional PID), increases daily revenue by 35.6\%, and extends battery cycle life by 25.6\%, providing technical support for the efficient operation of micro energy storage systems in smart grids.},
    language = {en},
    urldate = {2026-09-07},
    booktitle = {2025 {International} {Conference} on {Engineering} {Innovations} and {Technologies} ({ICoEIT})},
    publisher = {IEEE},
    author = {Li, Jichu and Wu, Yunlong and Wen, Jiang and Tang, Fei and Hong, Gang},
    month = jul,
    year = {2025},
    pages = {914--919},
}
@article{wang_augmented_2024,
    title = {Augmented {Intelligence} in {Smart} {Intersections}: {Local} {Digital} {Twins}-{Assisted} {Hybrid} {Autonomous} {Driving}},
    copyright = {https://creativecommons.org/licenses/by/4.0/legalcode},
    issn = {2379-8904, 2379-8858},
    shorttitle = {Augmented {Intelligence} in {Smart} {Intersections}},
    url = {https://ieeexplore.ieee.org/document/10729655/},
    doi = {10.1109/TIV.2024.3485132},
    abstract = {Vehicle-road collaboration is a promising approach for enhancing the safety and efﬁciency of autonomous driving by extending the intelligence of onboard systems to smart roadside infrastructures. The introduction of digital twins (DTs), particularly local DTs (LDTs) at the edge, in smart mobility presents a new embodiment of augmented intelligence, which could enhance information exchange and extract human driving expertise to improve onboard intelligence. This paper presents a novel LDT-assisted hybrid autonomous driving system for improving safety and efﬁciency in trafﬁc intersections. By leveraging roadside units (RSUs) equipped with sensory and computing capabilities, the proposed system continuously monitors trafﬁc, extracts human driving knowledge, and generates intersectionspeciﬁc local driving agents through an ofﬂine reinforcement learning (RL) framework. When connected and automated vehicles (CAVs) pass through RSU-equipped intersections, RSUs can provide local agents to support safe and efﬁcient driving in local areas. Meanwhile, they provide real-time cooperative perception (CP) to broaden onboard sensory horizons. The proposed LDT-assisted hybrid system is implemented with stateof-the-art products, e.g., CAVs and RSUs, and technologies, e.g., millimeter-wave (mmWave) communications. Hardware-in-theloop (HiL) simulations and proof-of-concept (PoC) tests validate system performance from two standpoints: (i) The peak latency for CP and local agent downloading are 8.51 ms and 146 ms, respectively, aligning with 3GPP requirements for vehicle-toeverything (V2X) and model transfer use cases. Moreover, (ii) local driving agents can improve safety measures by 10\% and reduce travel time by 15\% compared with conventional onboard systems. The implemented prototype also demonstrates reliable real-time performance, fulﬁlling the targets of the proposed system design.},
    language = {en},
    urldate = {2026-09-07},
    journal = {IEEE Transactions on Intelligent Vehicles},
    author = {Wang, Kui and Nonomura, Kazuma and Li, Zongdian and Yu, Tao and Sakaguchi, Kei and Hashash, Omar and Saad, Walid and She, Changyang and Li, Yonghui},
    year = {2024},
    pages = {1--15},
}
@article{kondo_industrial_2024,
    title = {An industrial edge computing architecture for {Local} {Digital} {Twin}},
    volume = {193},
    issn = {03608352},
    url = {https://linkinghub.elsevier.com/retrieve/pii/S0360835224003784},
    doi = {10.1016/j.cie.2024.110257},
    abstract = {Cyber–Physical Production Systems usher in a new era of smart manufacturing, with Digital Twin being a pivotal concept driving their adoption. Most literature concentrates on global Digital Twin deployment, typically enterprise servers or the cloud. However, manufacturing relies on real-time control and decisionmaking, demanding swift system response. To address this, we introduce a novel Local Digital Twin architecture, bringing processing to the edge to meet strict timing constraints. We also introduce a Fivedimension GDT/LDTs model aligned with RAMI4.0 for practical application and integration. The LDT was implemented on a multinational company’s Brazilian subsidiary assembly line, predicting optimal assembly components. Machine learning techniques were employed, improving the First Pass Yield by 1.3 to 2.5\% in a test machine, affirming the feasibility of the LDT approach.},
    language = {en},
    urldate = {2026-07-23},
    journal = {Computers \& Industrial Engineering},
    author = {Kondo, Ricardo Eiji and Andrade, Willian Jeferson and De Mello Henequim, Clayton and Lazzaretti, André Eugenio and De Souza Britto, Alceu and De Freitas Rocha Loures, Eduardo and Santos, Eduardo Alves Portela and Reynoso-Meza, Gilberto},
    month = jul,
    year = {2024},
    pages = {110257},
}
@article{liu_intelligent_2023,
    title = {Intelligent digital-twin prediction and reverse control system architecture for thermal errors enabled by deep learning and cloud-edge computing},
    volume = {225},
    issn = {09574174},
    url = {https://linkinghub.elsevier.com/retrieve/pii/S0957417423006243},
    doi = {10.1016/j.eswa.2023.120122},
    abstract = {The heat generation is signi/cant in the machining process, leading to thermal errors, and /nally the geometric precision of machined parts is reduced. So the precision machine tool is a key factor in determining the geometric precision of complex parts. In recent years, the error control method is applied. But the method fails in reducing thermal errors because it cannot effectively process large-volume data, resulting from its low executing ef/ciency. To solve above issues, a new intelligent digital-twin prediction and reverse control system is designed for thermally induced errors based on the user-edge-cloud architecture to expedite the executing ef/ciency. The data-driven error modeling method is augmented by an error mechanism-based modeling to express the thermal error as a function with the temperature, armature current, rotational speed, and ambient temperature as independent variables, and then the long-term memorizing behavior of thermal errors is demonstrated. The error model is established based on an improved wavelet threshold denoising (IWTD) and a (long short-term memory) LSTM network to describe the memorizing behavior, and IWTD-LSTM network error prediction model is embedded into the digital-twin system. The digital-twin system and IWTD-LSTM network model were veri/ed on a precision machine tool. With the implementation of the digital-twin system, the thermal error and the volume of the transferred data are reduced by 88.72\% and 56.36\%, respectively.},
    language = {en},
    urldate = {2026-07-23},
    journal = {Expert Systems with Applications},
    author = {Liu, Jialan and Ma, Chi and Gui, Hongquan and Wang, Shilong},
    month = sep,
    year = {2023},
    pages = {120122},
}
@inproceedings{ni_edge-based_2024,
    address = {Toulouse, France},
    title = {Edge-based {Parametric} {Digital} {Twins} for {Intelligent} {Building} {Indoor} {Climate} {Modeling}},
    copyright = {https://doi.org/10.15223/policy-029},
    isbn = {979-8-3503-1934-7},
    url = {https://ieeexplore.ieee.org/document/10540966/},
    doi = {10.1109/WFCS60972.2024.10540966},
    abstract = {Digital transformation in the built environment generates vast data for developing data-driven models to optimize building operations. This study presents an integrated solution utilizing edge computing, digital twins, and deep learning to enhance the understanding of climate in buildings. Parametric digital twins, created using an ontology, ensure consistent data representation across diverse service systems equipped by different buildings. Based on created digital twins and collected data, deep learning methods are employed to develop predictive models for identifying patterns in indoor climate and providing insights. Both the parametric digital twin and deep learning models are deployed on edge for low latency and privacy compliance. As a demonstration, a case study was conducted in a historic building in ¨Ostergo¨tland, Sweden, to compare the performance of ﬁve deep learning architectures. The results indicate that the timeseries dense encoder model exhibited strong competitiveness in performing multi-horizon forecasts of indoor temperature and relative humidity with low computational costs.},
