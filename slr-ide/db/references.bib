@article{yin_stress_2026,
	title = {Stress state perception and prediction of isothermal forging hydraulic press driven by digital twin and machine learning},
	volume = {331},
	issn = {09574174},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0957417426021184},
	doi = {10.1016/j.eswa.2026.133209},
	abstract = {The stress state of an isothermal forging hydraulic press (ISFHP) has a signiﬁcant impact on the equipment life and service performance. Traditionally, dynamic modeling is used to predict the stress state oﬀ-line. However, uncertain boundary conditions give rise to a substantial prediction error. To address these challenges, an intelligent framework for ISFHP stress state prediction and maintenance is proposed, which integrates digital twins and machine learning. Firstly, a ﬁve-dimensional digital twin of the ISFHP is constructed based on geometric, physical, behavioral, and rule-based model. Subsequently, machine learning is introduced to promote the real-time of stress state prediction. The K-Nearest Neighbor (KNN) algorithm is employed to map high-ﬁdelity stress data between the real and virtual domains, enabling stress ﬁeld reconstruction on a reduced representation. The Random Forest (RF) model is utilized to predict stress states from measured and simulated data, for its higher accuracy over Deep Neural Network (DNN), Support Vector Regression (SVR) and eXtreme gradient boosting (XGBoost). The framework is veriﬁed on a 20MN ISFHP, with performance metrics showing the RF model achieves a MAE of 2.9 and R2 of 0.95. Furthermore, based on the digital twin-driven closed-loop optimization, the peak stress during the forming process is reduced by 6.4\%. Finally, a visualization interface and stress state prediction engineering software for the ISFHP is developed based on the Unity platform, providing a visual display of the equipment working status and stress state prediction.},
	language = {en},
