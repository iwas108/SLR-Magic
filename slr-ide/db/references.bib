	file = {Zotov_2021_CycleStyleGANBa_2cd7c:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Zotov_2021_CycleStyleGANBa_2cd7c.pdf:application/pdf},
