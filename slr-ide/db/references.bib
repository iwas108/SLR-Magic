}

@article{wen_digital_2023,
	title = {Digital twin-driven fatigue life prediction framework of mechanical structures using a power density theory: {Application} to off-road vehicle front axle housing},
	volume = {220},
	issn = {02632241},
	shorttitle = {Digital twin-driven fatigue life prediction framework of mechanical structures using a power density theory},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0263224123009168},
	doi = {10.1016/j.measurement.2023.113352},
	abstract = {Accurate fatigue life prediction is bene1cial for fatigue maintenance of complex mechanical structures of off-road vehicles. For fatigue life prediction of mechanical structures subjected to non-stationary random loads during operation, this paper proposes a digital twin-driven fatigue life prediction method for mechanical structures. The core consists of improved fatigue theory, stress online measurement, and fatigue damage veri1cation. In this study, a digital twin (DT) prediction framework containing multiple correction factors is established, in which the actual stress values in the physical world and the stress predictions of the estimated twin model can be obtained in real time. The remaining strength degradation of the structure and material can be compared to correct the prediction accuracy of fatigue analysis. In addition, based on the power density theory, combined with the short-time Fourier transform, a fatigue life analysis method that can comprehensively calculate the effect of load amplitude and frequency on fatigue is proposed. A test case has been demonstrated using a front axle housing of the off-road vehicle. The difference between the results predicted by the method in this paper and the actual fatigue results in failure time is only 2.65 h, with a relative error of only 3.95 \%. In terms of failure location, the relative error is only 3.15 \%.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Measurement},
	author = {Wen, Chang-kai and Liu, Zhi-yong and Wu, Guang-wei and Zhao, Chun-jiang and Chen, Li-ping and Yin, Yan-xin and Meng, Zhi-jun},
