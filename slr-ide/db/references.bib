@inproceedings{qu_intelligent_2025,
	address = {Nanjing, China},
	title = {Intelligent {Machining}-{Quality} {Control} via {Multi}-{Source} {Data} {Fusion}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-7797-1},
	url = {https://ieeexplore.ieee.org/document/11407296/},
	doi = {10.1109/MLCIPR68329.2025.11407296},
	abstract = {Stable machining quality is hard to guarantee under variable material batches, tool aging, and fluctuating cutting regimes. This paper proposes an intelligent control model that fuses multi-source data—acoustic emission, tri-axial vibration, spindle/axis currents, cutting force proxies from drive power, CNC logs, and post-process vision—into a unified representation for real-time quality prediction and closed-loop actuation. A lightweight temporal encoder (1D-CNN+GRU) and a compact image encoder are coupled through a graph-attention fusion layer that treats sensors as nodes with learnable edge weights. Quality heads jointly estimate surface roughness (Ra), chatter state, and tool wear classes, while a policy head outputs feed-override and spindle-speed recommendations through an MPC-guided reinforcement learning scheme. On a 3-machine, 16-material, 28tool dataset (4,320 cuts), the model improves cross-domain quality classification accuracy from 90.2\% (plain CNN) to 97.6\%, reduces Ra MAE by 23.4\%, and cuts out-of-tolerance rate by 42\% compared with strong baselines. Ablations confirm the contribution of sensor graph fusion and domain-shift handling. The framework runs in real time at 40–70 ms per decision on a modest edge GPU and integrates with a line-side digital twin for traceability and SPC analytics.},
	language = {en},
	urldate = {2026-07-23},
