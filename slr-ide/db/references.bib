@inproceedings{xu_process_2026,
	address = {Bidar, India},
	title = {Process {Optimization} in {Mechanical} {Manufacturing} {Through} {TabNet} with {Multi}-{Objective} {Soft} {Actor}-{Critic}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-8871-7},
	url = {https://ieeexplore.ieee.org/document/11566068/},
	doi = {10.1109/ICISCN67954.2026.11566068},
	abstract = {Nowadays, the optimization plays a crucial role in improving the efficiency, quality and sustainability of modern mechanical manufacturing processes. Here, the Machine Learning (ML) and Reinforcement Learning (RL) are increasingly used to analyze the manufacturing data and determine the optimal process with the growth of smart manufacturing as well as Digital Twin (DT) technologies. However, the existing Deep RL-based Extra Trees (DRL-ETR) mainly focused on single-objective optimization which does not capture the complex relationships among manufacturing parameters. Hence, this research proposes a feature-engineered TabNet with Multi-Objective Soft Actor-Critic (TabNetMOSAC) to improve the process optimization performance. Initially, the manufacturing process data is collected from the industrial injection molding systems by using the PLC and communication protocols. Then, the data is preprocessed through the cleaning and normalization procedures to improve the data quality. After that, the feature engineering is performed to derive the informative relationships among the process variables. Next, a TabNet-based prediction model is developed to accurately estimate the product quality from the manufacturing parameters and then, the trained model is integrated into a DT environment to simulate the behavior of physical manufacturing system. Finally, a MOSAC optimization algorithm is employed to determine the optimal process parameters by considering the product quality, energy consumption and production efficiency. From the experimental results, the proposed TabNet-MOSAC framework achieved improved prediction accuracy and more balanced optimization performance in terms of low MAE (0.0218), RMSE (0.0436) and improved R-Square (0.912) respectively than the existing DRLETR model.},
