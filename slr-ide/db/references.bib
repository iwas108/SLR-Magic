	url = {https://linkinghub.elsevier.com/retrieve/pii/S0020740324005034},
	doi = {10.1016/j.ijmecsci.2024.109461},
	abstract = {This paper introduces a novel hybrid model designed for the damage identi.cation and remaining useful life (RUL) assessment of the adhesively bonded .bre-reinforced polymer (FRP) structures. By integrating fracture mechanics (FM) with digital twin (DT) technology, this model trains a deep learning (DL) model collaboratively using physical and simulation data to detect failure and predict the RUL. The signi.cant highlight of this model over previous knowledge is to reduce the dif.culty of the framework structure and parameter adjustment during the prediction process, while simultaneously offering a method to quantify damage to the adhesive bond lines experimentally. A damage characteristics quanti.cation method based on guided waves is used to detect the damage extent of the bonded zone in experiments, which provides an experimental damage quanti.cation method for the construction of DT. In addition, highlights a crack growth simulation method that combines extended .nite element and FM. The relationship between the degradation of the bonded area and the fatigue cycles is rede.ned from the perspective of stress and energy changes. Finally, based on the samples in the digital twin hybrid model database, the paper combines long short-term memory networks (LSTM)-dropout and Monte Carlo sampling methods to replace the conventional Bayesian dynamic network quantitative uncertainty. Based on the comparison of the prediction results of different RUL prediction models, the advantages of the hybrid method in realizing RUL prediction with con.dence intervals are demonstrated.},
	language = {en},
	urldate = {2026-07-23},
	journal = {International Journal of Mechanical Sciences},
