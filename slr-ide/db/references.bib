@article{r_lakkundi_physics-informed_2026,
	title = {Physics-informed hybrid digital twin for real-time multi-sensor intelligence and adaptive control in wire electrical discharge machining},
	volume = {198},
	issn = {15684946},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1568494626007155},
	doi = {10.1016/j.asoc.2026.115267},
	abstract = {In manufacturing settings, digital twins are advancing beyond static simulations to dynamic informatics systems that exhibit reasoning, {\textgreater}exibility and real-time control. This research proposes a physics-informed Hybrid Digital Twin (HDT) that integrated multi-sensor data (acoustic emission (AE), current, voltage and temperature) with machine-learning inference and real-time physics-informed constraints for process intelligence in Wire Electrical Discharge Machining (WEDM). The HDT architecture consists of ?ve informatics layers: data acquisition, signal preprocessing, frequency domain reasoning (FFT–STFT–WPSD), features correlation analytics, and adaptive learning based control systems. Real-time experiments are presented based on 36 WEDM runs from AISI D2 steel, demonstrating AE\_RMS as the most signi?cant diagnostic feature (r = 0.99 with surface roughness), exceeding sensitivity and predictive reliability as compared to other data modalities based on time, frequency and timefrequency domains. Both Random Forest and ANN achieved R² {\textgreater} 0.95 and detection latency speed of under 20 ms, demonstrating the feasibility of a closed-loop control system. The adaptive decision logic was also constrained to maintain discharging current within ± 3\% of nominal, directly causing a 4.9\% improved material removal rate, keeping surface variation ≤ 5\%, with wire rupturing incidents going reduced by 75\%. The proposed approach HDT gives a self-learning, data–physics fusion architecture for system observability, real-time adaptation and zero defect manufacturing – an architect created for Industry 4.0 to adapt multi-sensor data informatics and autonomous machining intelligence.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Applied Soft Computing},
	author = {R Lakkundi, Anand and N Kulkarni, Vinayak},
	month = jul,
