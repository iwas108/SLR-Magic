@article{cui_designing_2026,
	title = {Designing a digital twin framework for degraded engines using an interpretable ensemble model with spatiotemporal graph learning and physics knowledge},
	volume = {167},
	issn = {09521976},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0952197626000199},
	doi = {10.1016/j.engappai.2026.113738},
	abstract = {Accurate estimation of key parameters during aero-engine degradation is crucial for safe and reliable operation. This study presents a digital twin framework that integrates physics-informed graph correction with spatiotemporal graph learning to predict performance and compensate thrust loss in degraded engines. The framework constructs an initial sensor correlation graph from operational data and refines its connectivity using thermodynamic relationships to obtain a physically consistent graph structure. A spatio-temporal model combining graph convolutional networks and gated recurrent units estimates unmeasured parameters and predicts thrust under degradation, and its output drives a proportional–integral feedback controller that compensates performance loss in real time. The framework is validated on real-world aero-engine degradation data, achieving a root mean squared error of 0.022 and a mean absolute error of 0.017, outperforming baseline models. The results demonstrate improved robustness and practical applicability for aero-engine condition monitoring and performance retention.},
