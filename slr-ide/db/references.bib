	keywords = {Artificial intelligence, Decision making, 'current, Remote sensing, Fruits, digital twin, artificial intelligence, Horticulture, smart horticulture, Systematic Review, remote sensing, Remote-sensing, Orchards, Gap analysis, Information sources, orchard, Research object, Research questions, Scopus database, Smart horticulture, Technology gap},
	pages = {128--143},
