@article{deng_hybrid_2026,
	title = {A hybrid {VMD}-{TimesNet} framework for short-term forecasting of mooring line tension in floating offshore wind turbines},
	volume = {363},
	issn = {00298018},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0029801826025783},
	doi = {10.1016/j.oceaneng.2026.126744},
	abstract = {Accurate short-term forecasting of mooring line tension is essential for structural health monitoring, conditionbased maintenance, and digital-twin-enabled operation of FOWTs. However, mooring line tension is governed by coupled wave-frequency oscillations, low-frequency drift motions, and intermittent peaks, dif0cult to capture using conventional one-dimensional sequential models. To address this challenge, we propose a hybrid VMDTimesNet framework, in which variational mode decomposition decomposes the non-stationary tension signal into multi-scale components and TimesNet learns their inter-period and intra-period dynamics. The framework is evaluated using a benchmark 5 MW spar-type FOWT under 0ve representative seastates. Compared with TimesNet trained on the raw signal, VMD preprocessing improves the coef0cient of determination from 0.805 to 0.850 and reduces the RMSE by approximately 11.0\%. Among the tested training con0gurations, the combination of the Adam optimizer and MAE loss function achieves the best performance. Sensitivity analyses further show that including surge motion in the input set and using a 30s historical window with a 10s prediction horizon provide favourable predictive accuracy for short-term real-time monitoring. Additional tests across different seastates and mooring lines indicate consistent predictive performance within the FOWT system. The proposed framework therefore offers a potential tool for real-time safety assessment and predictive maintenance of offshore renewable-energy assets.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Ocean Engineering},
	author = {Deng, Yulin and Tao, Longbin},
	month = aug,
	year = {2026},
	pages = {126744},
	file = {Deng_2026_AhybridVMDTimes_55487:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Deng_2026_AhybridVMDTimes_55487.pdf:application/pdf},
}

@article{zhang_real-time_2026,
	title = {Real-{Time} fatigue crack growth prediction for welded structures based on digital twin framework considering residual stress and variable amplitude loading},
	volume = {206},
	issn = {01421123},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0142112325006723},
	doi = {10.1016/j.ijfatigue.2025.109475},
	abstract = {This paper proposes a dynamic digital twin framework driven by real-time physical information, which integrates a Radial Basis Function (RBF) neural network and a Dynamic Bayesian Network (DBN). A time-varying fatigue crack growth program is developed to update uncertain crack growth parameters and to enable real-time life prediction under welding residual stress and variable-amplitude loading conditions. A 2nite element model of welding residual stress is established based on thermo-elastic–plastic theory, and the associated stress intensity factor is calculated using the weight function method. A nonlinear mapping between the stress intensity factor and crack length is constructed using the RBF neural network, accounting for both welding residual stress and variable-amplitude loading. The physics-informed digital twin framework, where the Particle Filter (PF) algorithm drives the DBN, is applied to predict fatigue crack growth and update uncertain parameters in Middle Tension (MT) specimens. Under conditions of periodic multiple overloads, the predicted fatigue life closely matches the experimental results, with an error under 1\%. The crack growth process is validated through the cosimulation of ABAQUS and FRANC3D using the updated parameters, with the error between simulated and experimental results remaining below 1\%, which demonstrates the high accuracy and robustness of the proposed digital twin framework for fatigue life prediction.},
	language = {en},
	urldate = {2026-07-23},
	journal = {International Journal of Fatigue},
	author = {Zhang, Wenyue and Chen, Yong and He, Xing and Xue, Fang and Xu, Peng and He, Wentao},
	month = may,
	year = {2026},
	pages = {109475},
	file = {Zhang_2026_RealTimefatigue_34ce8:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Zhang_2026_RealTimefatigue_34ce8.pdf:application/pdf},
}

@article{duan_digital_2026,
	title = {A digital twin framework for damage detection and localization of self-sensed cured-in-place underground pipelines},
	volume = {354},
	issn = {01410296},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0141029626003147},
	doi = {10.1016/j.engstruct.2026.122401},
	abstract = {As the underground pipelines deteriorate with age, their structural vulnerability increases. Cured-in-place pipe (CIPP) lining is an emerging trenchless technology used to rehabilitate deteriorated pipes. However, the buckling behavior of CIPP liner-rehabilitated pipes is insuf-ciently investigated. This study presents an integrated framework for real-time structural health monitoring and damage detection for underground pipelines by leveraging the knowledge of distributed -ber optic sensors (DFOS), -nite element analysis (FEA), deep learning (DL) algorithms, and digital twin. The study experimentally and computationally investigates the structural behavior of a single steel substrate and a CIPP-rehabilitated steel substrate under eccentric compression conditions. The application of DFOS enables the self-sensing function of the pipelines with high-resolution, continuous strain measurement. The -nite element model and DL-based strain -eld correlation are employed to complement the function of DFOS from strain -eld monitoring to structural deformation assessment, facilitating the development of virtual replicates of self-sensed pipes. The study further explores the location and severity of structural damage through numerical and theoretical strain analysis, enabling the detection of minor but critical defects. The developed digital twin framework enables real-time structural visualization and enhances structural damage assessment. By accurately identifying the early-stage plastic region of deformation and quantifying crack severity, the framework supports predictive maintenance and improves pipeline reliability. This proactive approach improves the safety of underground pipelines, extends their service life, and reduces maintenance costs, demonstrating its practical potential for long-term pipeline infrastructure management.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Engineering Structures},
	author = {Duan, Junyi and Wang, Xingyu and Yan, Huaixiao and Wang, Sike and Huang, Ying and Tao, Chengcheng},
	month = may,
	year = {2026},
	pages = {122401},
	file = {Duan_2026_Adigitaltwinfra_442c9:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Duan_2026_Adigitaltwinfra_442c9.pdf:application/pdf},
}

@article{zhou_transformer_2026,
	title = {Transformer self-attention encoder–decoder with multimodal deep learning for response time series forecasting and digital twin support in wind structural health monitoring},
	volume = {326},
	issn = {00457949},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0045794926001203},
	doi = {10.1016/j.compstruc.2026.108216},
	abstract = {The wind-induced structural response forecasting capabilities of a novel transformer methodology are examined here. The model also provides a digital twin component for bridge structural health monitoring. Firstly, the approach uses the temporal characteristics of the system to train a forecasting model. Secondly, the vibration predictions are compared to the measured ones to detect large deviations. Finally, the identiˡed cases are used as an early-warning indicator of structural change. The artiˡcial intelligence-based model outperforms approaches for response forecasting as no assumption on wind stationarity or on structural normal vibration behavior is needed. Speciˡcally, wind-excited dynamic behavior su˫ers from uncertainty related to obtaining poor predic tions when the environmental or tra˥c conditions change. This results in a hard distinction of what constitutes normal vibration behavior. To this end, a framework is rigorously examined on real-world measurements from the Hardanger Bridge monitored by the Norwegian University of Science and Technology. The approach captures accurate structural behavior in realistic conditions, and with respect to the changes in the system excitation. The results, importantly, highlight the potential of transformer-based digital twin components to serve as nextgeneration tools for resilient infrastructure management, continuous learning, and adaptive monitoring over the system’s lifecycle with respect to temporal characteristics.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Computers \& Structures},
	author = {Zhou, Feiyu and Impraimakis, Marios},
	month = may,
