@inproceedings{neuburger_coupled_2022,
	address = {Belval, Luxembourg},
	title = {Coupled {Finite}-{Element}-{Method}-{Simulations} for {Real}-{Time}-{Process} {Monitoring} in {Metal} {Forming} {Digital}-{Twins}},
