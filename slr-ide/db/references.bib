@article{zhang_intelligent_2025,
	title = {Intelligent fault diagnosis of multi-way directional valves in hydraulic systems using digital twin and deep learning approaches},
	volume = {230},
	issn = {08883270},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0888327025002808},
	doi = {10.1016/j.ymssp.2025.112579},
	abstract = {The multi-way directional valve is a crucial control component in hydraulic systems of engineering machinery, and its reliable operation is essential for the safety and stability of such machinery. Real-time and accurate fault diagnosis of the multi-way directional valve is critical, particularly given the unique challenges posed by hydraulic systems in engineering applications, such as covert failures, complex operating environments, and significant noise interference. These factors complicate the detection of faults and the correlation between fault characteristics and their root causes. To address these challenges, this paper proposes an intelligent fault diagnosis framework leveraging digital twin (DT) technology and deep learning techniques. The approach started by establishing a simulation model, which was then updated using experimental data to calibrate the digital twin model of the multi-way directional valve. To generate reconstructed data and reduce the distributional differences between twin and real data, the domain adaptation-wasserstein generative adversarial network (DA-WGAN) technology was employed, which adjusted and transformed twin data into reconstructed data. Subsequently, a one-dimensional convolutional neural network-gated recurrent unit-attention mechanism (1DCNN-GRU-Attention) model was developed and pre-trained on labeled twin data generated by the digital twin model, ensuring precise fault diagnosis under real operating conditions. The proposed intelligent method’s effectiveness was validated through a case study with an existing commercially available multi-way directional valve on the designed hydraulic system test platform. Experimental results indicate that the model achieves intelligent fault diagnosis with an accuracy of 99.17\%, outperforming other fault diagnosis approaches that rely on limited measurement data.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Mechanical Systems and Signal Processing},
	author = {Zhang, Guangcheng and Zhang, Kai and Shen, Wei and Xu, Guoyong and Lin, Yueh-Jaw},
	month = may,
	year = {2025},
	pages = {112579},
	file = {Zhang_2025_Intelligentfaul_c2b9d:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Zhang_2025_Intelligentfaul_c2b9d.pdf:application/pdf},
}

@article{cohen_few-shot_2025,
	title = {Few-shot learning for estimating gear wear severity towards digital twinning},
	volume = {170},
	issn = {13506307},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1350630725000718},
	doi = {10.1016/j.engfailanal.2025.109330},
	abstract = {Digital twins hold the potential to revolutionize gear health monitoring by leveraging dynamic modeling and AI advancements, providing real-time insights and enabling proactive maintenance. Wear is one of the most critical fault mechanisms in gears, yet vibration-based gear diagnosis has mainly progressed for localized tooth faults due to the complexities associated with distributed wear. This study proposes a novel strategy for gear wear monitoring aligning with digital twins’ foundations, by integrating experiments, dynamic modeling, physical preprocessing, and machine learning. First, we propose an unsupervised learning-based sensitive health indicator for early wear detection, grounded in advanced physical preprocessing. Then, we introduce a novel few-shot learning approach for estimating wear severity, addressing the scarcity of labeled faulty measured data in real-world scenarios. We train a severity regressor using an extensive simulated training dataset, augmented and adapted to the inspected gear through transfer function estimation. The few-shot learning framework relies on measured training data, which includes healthy samples and a few faulty samples from a one label. The transfer of knowledge between the simulated and measured training datasets enables the severity regressor to make predictions on unseen measured data. The proposed strategy is demonstrated through controlled-degradation tests in gear wear, showcasing its superior performance in both fault detection and severity estimation, comparable to that of a fully supervised model, as if labeled measured data were available. Above all, this study highlights how a synergy between physicsbased and AI-based approaches enhances performance while addressing practical challenges in wear diagnosis, paving the way for the implementation of digital twins in future endeavors.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Engineering Failure Analysis},
	author = {Cohen, Roee and Bachar, Lior and Matania, Omri and Bortman, Jacob},
	month = mar,
	year = {2025},
	pages = {109330},
	file = {Cohen_2025_Fewshotlearning_e623c:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Cohen_2025_Fewshotlearning_e623c.pdf:application/pdf},
}

@inproceedings{boob_machine_2025,
