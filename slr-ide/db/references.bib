@article{cao_aav_2025,
	title = {{AAV} {Swarm} {Cooperative} {Search} {Based} on {Scalable} {Multiagent} {Deep} {Reinforcement} {Learning} {With} {Digital} {Twin}-{Enabled} {Sim}-to-{Real} {Transfer}},
