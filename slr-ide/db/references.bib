	pages = {104349},
	file = {Li_2025_Anonlinemilling_88e4f:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Li_2025_Anonlinemilling_88e4f.pdf:application/pdf},
