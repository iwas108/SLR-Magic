@article{zeng_energy_2026,
	title = {Energy consumption optimization control model for highway electromechanical systems integrating digital twins and reinforcement learning},
	volume = {177},
	issn = {09521976},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0952197626011644},
	doi = {10.1016/j.engappai.2026.114882},
	abstract = {Existing models for optimizing energy consumption in highway electromechanical systems, often based on static characteristics and of,ine scheduling, struggle to cope with time-varying, nonlinear dynamics caused by traf/c, environment, and equipment aging, leading to inef/ciency and delayed safety regulation. To achieve highef/ciency, real-time coordinated control, this study proposes a novel model integrating Digital Twin (DT) and Reinforcement Learning (RL). A multi-physics coupled DT body is /rst constructed by integrating the illumination, air,ow, heat, and electricity dynamics of key subsystems, and a differentiable agent model is embedded in the RL framework to provide a gradient-propagating simulator. Using Proximal Policy Optimization (PPO) as the RL policy, the model minimizes total energy consumption as a negative reward while enforcing operational safety via a Lyapunov stability constraint within the policy optimization process. Online consistency calibration combined with an Extended Kalman Filter (EKF) ensures dynamic virtual-real alignment, and a dual-time-scale architecture splits control into second-level execution and minute-level strategy optimization. Experimental results under extreme coupled conditions show the model achieves energy savings of 18.5\%, 11.9\%, and 8.6\% compared to Proportional-Integral-Derivative (PID), Model Predictive Control (MPC), and standard PPO models, respectively, with an average safety regulation lag of only 23.3 s. The study concludes that the proposed method enables coordinated energy optimization and real-time safety control under multi-source disturbances and complex coupling conditions, providing a viable path for the intelligent management of highway electromechanical systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Engineering Applications of Artificial Intelligence},
	author = {Zeng, Xiaming and Yang, Cheng and Xue, Jie},
	month = aug,
