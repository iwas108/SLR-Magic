@article{chauhan_st-gacn_2025,
	title = {{ST}-{GACN}: {A} {Lightweight} {Spatio} {Temporal} {Graph} {Attention} {Model} {With} {Online} {Adaptation} for {Real} {Time} {Congestion} {Forecasting}},
	volume = {13},
	copyright = {https://creativecommons.org/licenses/by/4.0/legalcode},
	issn = {2169-3536},
	shorttitle = {{ST}-{GACN}},
	url = {https://ieeexplore.ieee.org/document/11216334/},
	doi = {10.1109/ACCESS.2025.3625433},
	abstract = {Accurate and low latency trafﬁc prediction is a backbone for modern adaptive signal and digital twin platforms. Yet, most deep models are either too static to handle concept drift or too heavy for roadside hardware. We present ST-GACN, a spatio-temporal Graph Attention Convolutional Network that freezes a sparse multi-head attention backbone and ﬁne-tunes only a 3 k-parameter read-out layer online. The architecture couples local global graph attention with dilated causal convolutions, achieving wide receptive ﬁelds while remaining memory-thrifty. Evaluated on the METR-LA benchmark (207 sensors, ﬁve-minute granularity), ST-GACN attains MAE = 0.1752 at a ﬁve-minute horizon and 0.2511 at ﬁfteen minutes, surpassing Diffusion CNN, Graph WaveNet, and ASTGCN by 9–13\%. Ablation conﬁrms that removing either dynamic attention or online adaptation degrades accuracy by up to twenty percent. The complete forward pass, including a single EWMA weighted gradient step every thirty minutes, executes in 15ms on an NVIDIA A100 and 62ms on a Jetson Orin, comfortably within the 100ms control Budget for ﬁeld deployment. Qualitative diagnostics reveal that the model reweights upstream sensors within one interval during incidents, and spatial error maps localize residual uncertainty to stadium ramps. One factor sensitivity experiments reveal an optimal trade-off at four heads, a one-hour history window, and a thirty-minute adaptation cadence. The open source release includes Docker and Jetson ﬂash images, paving the way for drift-aware, edge-resident congestion forecasting and future multimodal extensions.},
	language = {en},
	urldate = {2026-07-23},
	journal = {IEEE Access},
	author = {Chauhan, Shishir Singh and Singh, Juhi and Kumar Bairwa, Amit},
	year = {2025},
	pages = {185674--185688},
	file = {Chauhan_2025_STGACNALightwei_372b5:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Chauhan_2025_STGACNALightwei_372b5.pdf:application/pdf},
}

@article{valsan_wide_2025,
