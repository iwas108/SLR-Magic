	doi = {10.1109/SIITME67657.2025.11293572},
	abstract = {Modern vehicles equipped with start-stop systems face a critical trade-off between emission reduction and battery longevity. While these systems effectively reduce CO2 emissions by 5-20\% in urban driving conditions, they signiﬁcantly accelerate 12V lead-acid battery degradation through increased cycling rates. Previous machine learning-enhanced optimization approaches achieved 24.2\% battery life extension but applied uniform strategies regardless of driving behavior variations. This paper investigates pattern-speciﬁc optimization strategies using digital twin simulations calibrated with 30 days of real 12V 60Ah AGM battery response data (voltage, SOC, temperature). Using K-means clustering on simulated driving patterns generated by the digital twin, we identiﬁed three distinct behavioral proﬁles: aggressive (28\%), normal (45\%), and conservative (27\%). Each pattern exhibits unique battery stress characteristics validated against real voltage drop measurements (0.6-1.2V). Simulations demonstrate that pattern-speciﬁc optimization achieves 22-28\% battery life extension compared to 15-22\% with uniform strategies, while maintaining emission reduction beneﬁts above 90\%. The simulation-based framework provides theoretical guidelines for adaptive battery management systems. Validation with realworld driving data remains necessary to conﬁrm pattern realism.},
	language = {en},
	urldate = {2026-07-23},
