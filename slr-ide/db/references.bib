@article{tang_aero-engine_2026,
	title = {An aero-engine digital twin modeling method based on steady-to-transient recursive distillation},
	volume = {74},
	issn = {14740346},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1474034626003861},
	doi = {10.1016/j.aei.2026.104694},
	abstract = {Aero-engine digital twins have emerged as a promising paradigm for performance evaluation and condition monitoring in the manufacturing phase. However, datasets from factory ground tests are highly imbalanced: steady-state samples dominate, whereas transient samples are scarce yet critical for reliable dynamic prediction. Training a single model on such data biases learning toward steady-state behavior, degrading transient fidelity. To address this challenge, this study proposes a novel steady-to-transient recursive distillation (STRD) framework, comprising three core components: (1) a temperature-based hybrid resampling strategy that constructs regime-biased datasets and progressively shifts the training distribution from steady-dominated to more transient regimes; (2) a set of regime-biased base-learners trained on these datasets and aligned using steady-to-transient recursive distillation, yielding regime-aware experts that capture distinct state tendencies while preserving shared cross-regime regularities; and (3) a meta-learner that learns inputdependent adaptive weighting over base learners and fuses their outputs for final prediction. Experiments on three operational datasets, evaluated separately with long short-term memory (LSTM) and Transformer backbones, show that STRD reduces average mean absolute percentage error (MAPE) by 11\%–64\% compared with conventional single-model and bagging ensemble baselines. Under a unified operating condition, its optimal joint-prediction trial yields highly accurate MAPE and root mean square error (RMSE) of 0.20\%/0.489 (thrust), 0.29\%/0.199 (total pressure at compressor outlet), and 0.97\%/19.821 (exhaust gas temperature). Further localized evaluations confirm enhanced accuracy in transient regimes while maintaining steadystate performance, demonstrating the robustness of STRD for reliable, high-fidelity aero-engine digital twin modeling.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Advanced Engineering Informatics},
	author = {Tang, Ke and Gao, Chuming and Huang, Zilang and Mao, Jialun and Xiao, Hong},
	month = sep,
	year = {2026},
	pages = {104694},
	file = {Tang_2026_Anaeroenginedig_d217c:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Tang_2026_Anaeroenginedig_d217c.pdf:application/pdf},
