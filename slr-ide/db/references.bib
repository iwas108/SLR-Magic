@article{xie_reusability_2026,
	title = {On the reusability of machine learning-based process monitoring systems for manufacturing digital twins},
	volume = {84},
	issn = {02786125},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0278612525003036},
	doi = {10.1016/j.jmsy.2025.12.006},
	abstract = {Advanced manufacturing is increasingly supported by machine learning (ML)-based digital twins (DTs) for realtime process monitoring and quality assurance. However, changes in physical domain con3gurations (e.g., machines, materials, and sensors) often cause domain shifts, limiting the reusability of existing DT components. Rebuilding DTs from scratch for each new con3guration is costly and time-consuming. To address this challenge, we de3ne DT reusability through three key criteria: FAIRness (3ndability, accessibility, interoperability, and reusability), transferability, and transfer ef3ciency. We propose a framework to systematically support the reuse of ML-based process modeling components in DTs, consisting of three phases: FAIR compliance, transferability analysis, and domain adaptation. To enhance transfer ef3ciency, we introduce the domain-adversarial and decision distribution alignment (DADDA) network, which enables class-conditional alignment and mitigates over3tting through competing domain alignment objectives. A case study on vision-based process monitoring in additive manufacturing was conducted to validate the proposed framework. A FAIR-compliant database of existing DT components was developed, and the most suitable source domain for the designated target domain was identi3ed through an evaluation of semantic and statistical similarity. Leveraging the selected source dataset, DADDA achieved 84 \% accuracy after unsupervised pre-training and 96.9 \% after supervised 3ne-tuning with only 210 labeled examples. Further validation on acoustic-based monitoring systems demonstrated the applicability of DADDA to various modalities.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Journal of Manufacturing Systems},
	author = {Xie, Jiarui and Yang, Zhuo and Yang, Haw-Ching and Lu, Yan and Zhao, Yaoyao Fiona},
	month = feb,
