
@article{lopez-carreno_grey-box_2026,
	title = {A grey-box temperature model for digital twins of building-integrated rooftop greenhouses},
	volume = {289},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105022633803&doi=10.1016%2Fj.buildenv.2025.114036&partnerID=40&md5=637c17000681d916ba0d526b405c9ade},
	doi = {10.1016/j.buildenv.2025.114036},
	abstract = {Urban agriculture is increasingly recognized as a strategy for enhancing food security, sustainability, and climate resilience in cities. Building-Integrated Rooftop Greenhouses (BIRTGs) offer a compelling solution by combining food production with building energy synergies. However, accurately predicting indoor temperature in such systems remains challenging due to their low thermal inertia, highly variable heat transfer dynamics, and the complex, time-dependent thermal interactions introduced by crops. This study presents a grey-box temperature model tailored for BIRTGs and designed for integration into Digital Twin (DT) frameworks. The model captures heat exchanges with the outdoor environment, host building, solar radiation, ventilation and plant evapotranspiration. Unlike traditional models, the evapotranspiration component is calibrated using sensor data, bypassing the need for complex crop-specific inputs. The model was calibrated and validated using experimental data from a BIRTG at Universitat Politècnica de Catalunya, both with and without crops. Validation results showed high predictive accuracy, with RMSE values of 2.2 °C without plants and 2.0 °C with plants. Furthermore, a systematic evaluation of 70 dataset combinations revealed that a single day of calibration data is sufficient to accurately forecast temperature over a 24-hour period. These results highlight the suitability of the model for real-time climate control and automation in urban agriculture using DTs. © 2025 The Author(s)},
	journal = {Building and Environment},
	author = {López-Carreño, R.-D. and Macarulla Martí, M. and Gassó-Domingo, S. and Tejedor Herran, B. and Pardo-Bosch, F.},
	year = {2026},
	keywords = {Food security, Urban agriculture, Greenhouses, Building energy, Building integrated, Buildings, Climate models, Crops, Digital twins, evapotranspiration, Evapotranspiration, Food production, Food supply, Gray-box models, greenhouse ecosystem, Grey-box, Grey-box modelling, Grey-box models, Indoor temperature, modeling, Sustainable development, Temperature, temperature gradient, Temperature modeling, Thermal processing (foods), urban agriculture, Urban agricultures},
	file = {USWKLZYD.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\K8WFW6SS\\USWKLZYD.pdf:application/pdf},
}

@inproceedings{lemphane_mushroom_2026,
	title = {Mushroom {Farming}, {Smart} {Farming} {Techniques} and {Challenges}: {A} {Review}},
	volume = {1660},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105022978182&doi=10.1007%2F978-3-032-07109-5_32&partnerID=40&md5=901190f92d6dadcdceca49f93d68f763},
	doi = {10.1007/978-3-032-07109-5_32},
	abstract = {Mushroom farming is now gaining popularity worldwide. In the past, mushrooms were consumed only by rural people and had little commercial value. It was not until recently, with the introduction of cultivated mushrooms, that small-scale farmers saw an opportunity that could support their livelihood. The production of mushrooms contributes significantly to food security and nutrition. Mushrooms have rich nutritional content therefore, there is a high demand since they are utilized as food and medication. Compared to other traditional crops, mushrooms are crops that can be harvested indoors which require little space and offer a faster turnaround. However, mushroom cultivation requires a controlled environment with favourable conditions, which includes monitoring of temperature, humidity, moisture, light, ventilation and carbon dioxide (CO{\textless}inf{\textgreater}2{\textless}/inf{\textgreater}) as these parameters directly affect mushroom growth. Utilization of smart farming technology has made it easy to manage these environmental parameters using modern techniques. Smart farming enables mushroom farmers to enhance productivity by integrating technologies, which include Artificial Intelligence (AI), machine learning, Internet of Things (IoT) and cloud computing. These smart systems connect the physical and digital worlds to allow automation and remote monitoring for easy management of mushroom houses. Nonetheless, even with the use of complex systems, this sector is, however, not without challenges. This paper reviews current smart farming systems deployed in mushroom farms for improved management and productivity. The paper also covers the challenges that the mushroom sector is currently facing and how digital twin technology can be a possible solution to the identified issues and problems. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	author = {Lemphane, N.J. and Kotze, B. and Kuriakose, R.B.},
	year = {2026},
	keywords = {Food security, Internet of Things, Machine learning, Smart farming, Digital twin, Artificial Intelligence, Crops, Food supply, Controlled environment, Cultivation, Distributed computer systems, Food nutrition, Fungi, High demand, Internet of things, Learning systems, Machine-learning, Mushroom cultivation, Mushroom farming, Nutrition, Rural people, Small scale farmers},
	pages = {476--486},
	file = {NPQGEQPA.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\JC39GERT\\NPQGEQPA.pdf:application/pdf},
}

@inproceedings{syed_precision_2026,
	title = {Precision {Agriculture} with {IoT}: {A} {Comprehensive} {Review} of {Innovations} and {Applications}},
	volume = {1602},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105022157998&doi=10.1007%2F978-3-032-03558-5_15&partnerID=40&md5=6f34f3d34129541529ef45f4adaf3a63},
	doi = {10.1007/978-3-032-03558-5_15},
	abstract = {Internet of Things (IoT) technology is now being used in various sectors. This enhances efficiency and productivity while also ensuring sustainability and better resource management in processes such as farming. More need to be done to address contemporary issues like, climate change, food insecurity, and other resource related matters. The advancement of IoT technologies have made real-time monitoring, predictive decision making, and vehicular automation possible. These advancements include sensor networking, computer communication interface, and AI for analytics. These technologies also allow a more in-depth study of IoT for crop and livestock monitoring and management, resource allocation, and improvement of supply chain management visibility in both developed and developing countries. It also examined the sociopolitical and economic challenges that hinder the maximum use of the mentioned technology. Proposals were made to address those issues using new technological solutions like blockchain and digital twins and established policies with better sociopolitical support. We analyse case studies and industry partnerships to uncover best practices and future trends that could optimize the next stage of IoT-centric farming. These results highlight the importance of collaboration between scholars, government, and agribusinesses in smart farming adoption. The purpose of this review is to assist stakeholders interested in IoT and smart technologies towards achieving a resilient and sustainable future in agriculture. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	author = {Syed, M.P. and Ahamed, J.},
	year = {2026},
	keywords = {Precision agriculture, Smart farming, Digital twin, Internet of Things (IoT), Smart agriculture, Automation, Sustainable development, Internet of things, Agribusiness, Block-chain, Blockchain, Computer resource management, Contemporary issues, Decision making, Digital Twins, Food insecurity, In-process, Internet of thing, Internet of things technologies, Precision Agriculture, Real time monitoring, Resource allocation, Resource management, Resource Management, Smart Farming},
	pages = {186--203},
	file = {A4KCRAVK.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\HMKG743Q\\A4KCRAVK.pdf:application/pdf},
}

@article{xu_advances_2026,
	title = {Advances in {3D} simulation technology for solar greenhouse systems: {A} review},
	volume = {226},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018306969&doi=10.1016%2Fj.rser.2025.116387&partnerID=40&md5=0b6fbf097f8dd726c84cf013833c7588},
	doi = {10.1016/j.rser.2025.116387},
	abstract = {With the rapid advancement of information technology, three-dimensional (3D) simulation has been increasingly applied in agricultural, showing significant potential for enhancing digital production processes in solar greenhouses. This paper examines the current state of 3D simulation technologies in solar greenhouse production and explores future development trends. It begins by outlining the structural characteristics of solar greenhouses and introducing key enabling technologies for practical application, including computational fluid dynamics (CFD), functional-structural plant modeling (FSPM), and building information modeling (BIM). A comprehensive analysis of application cases is then presented across three critical domains: greenhouse microclimate assessment, crop growth simulation, and structural optimization. These applications cover various stages, from design and planning to crop production and environmental control. Finally, this study identifies current technical challenges and suggests future research directions to advance the use of 3D simulation in smart facility agriculture. Overall, digital twin technology based on realistic canopy structures, combined with AI-driven greenhouse control methods, demonstrates the greatest potential for application. Future studies should prioritize the integration of multi-source heterogeneous data and the improvement of real-time responsiveness in 3D models. By continuously refining data integration and algorithmic models, smart greenhouses can provide more precise and efficient support for sustainable agricultural production. © 2025 Elsevier Ltd},
	journal = {Renewable and Sustainable Energy Reviews},
	author = {Xu, D. and Zhu, J. and Ma, Y.},
	year = {2026},
	keywords = {Smart agriculture, Greenhouses, Crops, Sustainable development, Cultivation, 'current, 3D modeling, 3D simulation, Crop model, Crop modeling, Data integration, Digital production, Environment control, Environmental management, Microclimate, Production process, Simulation technologies, Smart agricultures, Solar greenhouse, Structural optimization, Three dimensional computer graphics, Three dimensional simulations},
}

@inproceedings{long_application_2026,
	title = {Application of {Machine} {Learning} and {Digital} {Twin} in {Smart} {Farming} for {Space} and {Extreme} {Environments}},
	volume = {15740},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013616712&doi=10.1007%2F978-3-031-97772-5_5&partnerID=40&md5=9d57fc16913e8003cb6250a34d0a7a23},
	doi = {10.1007/978-3-031-97772-5_5},
	abstract = {This paper provides a concise overview of the current state of research on digital twins and machine learning in smart farming, followed by three detailed case studies that illustrate their applications in smart farming for space and extreme environments. In the first case study, we evaluated the effectiveness of commercial machine-learning models using Azure Machine Learning for predicting plant growth. Lettuce growth was observed in two distinct environments, including one on a mountain with extreme weather conditions (acting as the physical twin-sender) and the other in a controlled growth chamber that replicated those conditions (serving as the physical twin-receiver). The mountain setting functioned as a “space surrogate,” while the growth chamber represented Earth-like conditions. Lettuce was cultivated using both soil-based pots and hydroponic solutions to assess different growing methods. In the second study, the growth of lettuce under different stresses in six climate zones on Earth was considered. Linear regression, ridge regression, lasso regression, polynomial regression, random forest regression, and boosted decision tree regression were used for predicting crop yield. Finally, this paper discusses the development of a digital twin using XMPro software for the growth of lettuce under abiotic stress conditions (temperature, light, water, oxygen in water) and different cultivation methods (simulated regolith as lunar soil, hydroponics). © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	author = {Long, N. and Liang, S. and Escribà-Gelonch, M. and Hessel, V.},
	year = {2026},
	keywords = {Machine learning, Smart farming, Digital twin, Smart agriculture, Cultivation, Learning systems, Machine-learning, 'current, Case-studies, Decision trees, Earth (planet), Extreme environment, Growth chamber, Lettuce, Plant life extension, Polynomial regression, Random forests, Space environment, Space farming, State of research, XMPro},
	pages = {66--80},
	file = {R3MTIGYB.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\7JZHRCCJ\\R3MTIGYB.pdf:application/pdf},
}

@article{cao_novel_2025,
	title = {A novel resilient agro-ecological system for sustainable urban-rural agricultural integration},
	volume = {135},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105022464595&doi=10.1016%2Fj.scs.2025.106973&partnerID=40&md5=8fe8f9150f0de8e3f3424284df24ccb5},
	doi = {10.1016/j.scs.2025.106973},
	abstract = {The growing risks to global food systems caused by climate change, urban growth, and limited resources call for smart, adaptable agro-ecological modeling frameworks. This paper presents a new hybrid Transformer–BiLSTM deep learning model, fine-tuned with advanced Bayesian Optimization (BO) methods of Constrained Multi-Objective Bayesian Optimization (C-MOBO) and Deep Surrogate models (BODES) to develop agro-ecological framework. The proposed framework skillfully captures complex spatiotemporal patterns in diverse agro-environmental data—including climate factors, soil properties, crop stages, and socio-economic indicators—to provide reliable forecasts of crop yields, resource use, and supply-demand trends. Integrated within a Cyber-Physical System (CPS), the model can handle real-time multi-source data from IoT sensors and satellites, offer uncertainty-aware predictions, and enable automated decisions for precision farming and food logistics between urban and rural areas. Tests using real agro-climatic datasets show that it outperforms traditional methods (LSTM, GRU, TCN, ARIMA) when measured by RMSE, MAE, R², and sustainability metrics that factor in ecological limits. The multi-objective hyperparameter tuning balances accuracy, computational load, and ecological impact. This scalable and understandable framework supports resilient, flexible agro-ecosystem management in changing environmental and operational conditions. Future directions include using federated learning for distributed updates, edge computing for fast, local processing, and reinforcement learning for smarter resource use in climate-resilient agriculture. © 2025},
	journal = {Sustainable Cities and Society},
	author = {Cao, L. and Liu, B. and Wang, Z.},
	year = {2025},
	keywords = {Climate change, precision agriculture, Smart agriculture, sustainability, Climate models, Sustainable development, Cultivation, Learning systems, Smart agricultures, Agricultural economics, agroecology, Bayesian optimization, BiLSTM, BO, Constrained optimization, CPS, crop yield, Cybe-physical systems, Cyber-physical systems, Ecological systems, Economics, Ecosystems, machine learning, Multi objective, optimization, Resource use, Rural areas, Soil testing, spatiotemporal analysis, Statistical tests, Transformer encoder, Urban growth, Urban-rural},
	file = {NIC77CUB.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\SGDIRQKK\\NIC77CUB.pdf:application/pdf},
}

@article{xu_advancing_2025,
	title = {Advancing sustainable solar greenhouse management through digital twin enabled by functional–structural plant modeling: case study in {Beijing}, {China}},
	volume = {346},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105015380629&doi=10.1016%2Fj.enconman.2025.120505&partnerID=40&md5=381a4cbcd1cc3eb44b984e493d127955},
	doi = {10.1016/j.enconman.2025.120505},
	abstract = {Digital twin technology integrates mathematical models, scientific laws, data from physical entities, and advanced simulations, providing a robust platform for agricultural production management. In this study, a 3D greenhouse model was built to precisely replicate its shape, size, properties, crop populations and behavior. Simulations of various production scenarios provided quantitative support for greenhouse design, shading analysis, and crop cultivation management. Moreover, light interception by a single canopy under artificial lighting was quantified, enabling feedback regulation of supplemental lighting strategies. The results indicated that the ground, canopy, wall, and roof captured 32.79 \%, 29.92 \%, 25.02 \%, and 12.27 \% of radiant energy, respectively. The average shading rates of the ground, wall, and roof within the greenhouse on the winter solstice were 39.94 \%, 13.89 \%, and 16.17 \%. The light interception of cucumber plants in the northern and southern sections showed significant differences, with an average difference of 6.8 mol m−2 d−1 on sunny day and 1.4 mol m−2 d−1 on cloudy day. Under the sunny condition, the distributed quantitative control strategy proposed in this study met all cucumber plants’ light requirements while reducing electricity consumption by 52.6 \% and improving canopy light distribution uniformity by 5.8 \% compared with the conventional fixed duration lighting mode. This study introduces a novel integration of digital twin and precise canopy-scale microclimate modeling for solar greenhouses, providing actionable insights for agricultural practitioners and policymakers and supporting the digital transformation and modernization of greenhouse systems. © 2025 Elsevier Ltd},
	journal = {Energy Conversion and Management},
	author = {Xu, D. and Zhu, J. and Ma, Y.},
	year = {2025},
	keywords = {Digital twin, Smart agriculture, Greenhouses, Sustainability, Crops, Sustainable development, Cultivation, Smart agricultures, Solar greenhouse, Case-studies, Advanced simulation, Artificial light, Cucumber plants, Functional structural plant models, Greenhouse management, Light interception, Lighting, Precision control, Simulation platform},
}

@article{el_hachimi_towards_2025,
	title = {Towards collective intelligence in agriculture: {Deep} reinforcement learning and digital twins for efficient management of collective irrigation water distribution systems},
	volume = {20},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023490366&doi=10.1016%2Fj.nexus.2025.100599&partnerID=40&md5=f9df46f8eecc176ed081f4edc345db66},
	doi = {10.1016/j.nexus.2025.100599},
	abstract = {Optimizing traditional Open-Channel Irrigation Systems (OCIS) is crucial for enhancing water sustainability and food security in water-scarce regions. OCIS remains widely used in many countries but receives less research attention in optimization studies compared to the rapid advancements in precision agriculture, which leverage new technologies such as artificial intelligence, remote sensing, drones, and the internet of things. Here, this study aims to optimize Water Use Efficiency (WUE) in the context of OCIS by proposing a framework for an adaptive spatiotemporal distribution of sowing dates. The framework consists of an intelligent agent interacting with a Digital Twin (DT). R3 district, an irrigated area within the Tensift basin in Morocco was used as a study site. Agrometeorological data from an automatic weather station installed in R3 district feeds the DT. This latter operates currently as a Digital Model with no bidirectional data integration, and comprises a module based on the AquaCrop model to simulate crop growth, development, and yield, and another module using graph theory to simulate the OCIS. The study evaluates genetic algorithms (GAs), an evolutionary optimization technique, versus a deep deterministic policy gradient (DDPG) agent for recommending the adaptive spatiotemporal distribution of sowing dates. The objective function is formulated as a constrained maximization of a Lagrangian function representing WUE, subject to the constraints imposed by the OCIS. The DDPG agent was trained for 1000 epochs, while GA ran for 100 generations. Results showed that the DDPG agent effectively learned the environment's dynamics through interactions with the R3 DT, as evidenced by increasing trend in the reward signals. However, GAs showed prolonged stagnation at multiple plateaus suggesting that GAs were unable to escape suboptimal solutions. In terms of training time, GAs take the longest. Additionally, comparing a same-day sowing date scenario to the adaptive sowing dates scenario recommended by the DDPG agent revealed a 4.69\% increase in the total crop yield with WUE of 1.95 while adhering to the hydraulic constraints of OCIS. This study marks a first step toward utilizing intelligent agents in critical areas such as irrigation water management. Future work will focus on enhancing the R3 DT to increase the agent's robustness, enabling it to generate reliable recommendations for real-world applications. © © 2025. Published by Elsevier Ltd.},
	journal = {Energy Nexus},
	author = {El Hachimi, C. and Belaqziz, S. and Khabba, S. and Karjoun, H. and Kharrou, M.H. and Ait Hssaine, B.A. and Er-Raki, S. and Daccache, A. and Chehbouni, A. and Weng, Q.},
	year = {2025},
	keywords = {Deep reinforcement learning, Genetic algorithms, Irrigation water management, Open-canal irrigation systems, Optimization},
	file = {DTLG2BKN.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\ZUCHH854\\DTLG2BKN.pdf:application/pdf},
}

@article{wang_sensors_2025,
	title = {From sensors to insights: {Technological} trends in image-based high-throughput plant phenotyping},
	volume = {12},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012107558&doi=10.1016%2Fj.atech.2025.101257&partnerID=40&md5=677c2919169c52a204d88b546111190e},
	doi = {10.1016/j.atech.2025.101257},
	abstract = {With the rapid global population growth and increasing challenges in sustainable agriculture, high-throughput plant phenotyping (HTPP) has become a vital tool for advancing crop breeding and precision agriculture. This review provides a comprehensive overview of recent technological trends in image-based HTPP, focusing on the integration of advanced sensors, automated phenotyping platforms, and deep learning techniques. We summarize the evolution of imaging modalities, including 2D, 2.5D, and 3D sensors, and their respective applications in phenotype acquisition. We then examine the progress of deep learning-based models in core phenotyping tasks such as stress and disease detection, growth monitoring, organ counting, root system analysis, and postharvest quality assessment. Special attention is given to the emergence of Transformer architectures, multimodal fusion strategies, weakly supervised learning, and prompt-based foundation models. Despite significant advancements, current HTPP systems still face several challenges, including high costs, limited generalization in open-field conditions, and the need for large-scale annotated datasets. To address these, we discuss potential solutions such as transfer learning, synthetic data generation via digital twins, lightweight deployment for edge devices, and uncertainty estimation for model interpretability. By highlighting key developments and open problems, this review aims to guide future research toward scalable, robust, and intelligent plant phenotyping systems that can operate reliably in real-world agricultural environments. © 2025 The Author(s)},
	journal = {Smart Agricultural Technology},
	author = {Wang, R.-F. and Qu, H.-R. and Su, W.-H.},
	year = {2025},
	keywords = {Growth monitoring, High-throughput plant phenotyping, Postharvest quality assessment, Stress and disease diagnosis, Yield estimation},
	file = {9BRWWD8T.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\LZMBGFIR\\9BRWWD8T.pdf:application/pdf},
}

@article{trentin_optimizing_2025,
	title = {Optimizing tomato yield prediction using phenologically timed {UAV}-based spectral data and machine learning},
	volume = {12},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009751353&doi=10.1016%2Fj.atech.2025.101158&partnerID=40&md5=5b9156ea5690864d2415626c5177f4a9},
	doi = {10.1016/j.atech.2025.101158},
	abstract = {Accurate yield prediction is critical for optimizing agricultural practices and ensuring food security. This study evaluated the performance of machine learning models in predicting tomato yield using weather data, spectral bands, and vegetation indices under varying nitrogen rates and bio-stimulant treatments to induce plant growth variability. UAV-based spectral data were collected across seven dates from October 27 to December 15, 2023, corresponding to key phenological stages: vegetative growth (data collection date 1), flowering (dates 2 and 3), fruit development (dates 4, 5, and 6), and early ripening (date 7). Significant input features were identified using the Pearson correlation coefficient (r {\textgreater} 0.65, p {\textless} 0.05), including Near Infrared (NIR), Red Edge, and Red spectral bands, as well as vegetation indices such as NDVI, GNDVI, NDRE, and SAVI. Aerial spectral data collected during fruit development (dates 5 and 6) showed the strongest correlations with yield (r = 0.66–0.74), emphasizing the importance of mid-to-late-season spectral information. Among the models evaluated, linear regression (LR) and XGBoost achieved the best performance, with root mean squared error (RMSE) values of 16.13 kg and 16.15 kg, respectively, and R² values of 0.63. Support vector machine (SVM) and decision tree (DT) also perform well, with RMSE values of 17.15 kg and 17.18 kg, respectively. In contrast, the deep learning model underperformed (RMSE = 23.49 kg, R² = 0.23), likely due to the limited data. This study highlights the predictive potential of spectral bands and emphasizes the significance of phenologically timed spectral data for yield estimation. © 2025 The Author(s)},
	journal = {Smart Agricultural Technology},
	author = {Trentin, C. and Ampatzidis, Y. and Tasioulas, S. and Tsouvaltzis, P.},
	year = {2025},
	keywords = {Precision agriculture, Artificial intelligence, Predictive modeling, Data-driven agriculture, Remote sensing},
	file = {C7TG45NS.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\HSS55K4M\\C7TG45NS.pdf:application/pdf},
}

@article{elsherbiny_incorporation_2025,
	title = {Incorporation of visible/near-infrared spectroscopy and machine learning models for indirect assessment of grape ripening indicators},
	volume = {15},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003301879&doi=10.1038%2Fs41598-024-81694-3&partnerID=40&md5=fd0c5e08a40703760af6e7c9a9bc85ba},
	doi = {10.1038/s41598-024-81694-3},
	abstract = {The assessment of grape ripeness is pivotal for optimizing harvest timing and ensuring high-quality fruit production. Traditional methods, relying on manual sampling and chemical analysis, are laborious and expensive. This study proposes an innovative approach combining Visible/Near-Infrared (VIS/NIR) spectroscopy with machine learning techniques—specifically, decision trees (DT) and gradient boosting regression (GBR)—to facilitate a rapid, non-destructive, and cost-effective prediction of key grape ripening indicators such as anthocyanin (An), total acidity (TA), total soluble solids (TSS), and the TSS/TA ratio. The performance of spectral reflectance indices (SRIs) in correlating with these ripening metrics across different grape ripening stages was examined. The study findings revealed notable variations in ripening indicators across stages, with the newly developed SRIs outperforming the existing indices. The application of dual and triple-band SRIs yielded strong correlations with An (R2 = 0.75–0.88) and TSS (R2 = 0.64–0.76), and moderate correlations with TA (R2 = 0.63–0.70), but showed weaker associations with the TSS/TA ratio (R2 = 0.15–0.52). Incorporating these SRIs into the DT and GBR models significantly enhanced the accuracy of ripening indicator predictions. The integration of multiple SRIs resulted in the most precise models. The DT model delivered outstanding performance for An (R2 = 0.87, RMSE = 87.81) and TSS/TA (R2 = 0.74, RMSE = 3.12). Meanwhile, the GBR model excelled in predicting TSS (R2 = 0.82, RMSE = 0.92) and TA (R2 = 0.70, RMSE = 0.05). Overall, the combination of VIS-NIR spectroscopy and machine learning offers a promising and efficient approach for assessing grape ripeness, providing a practical solution for the agricultural industry. © The Author(s) 2024.},
	number = {1},
	journal = {Scientific Reports},
	author = {Elsherbiny, O. and El-Hendawy, S. and Elsayed, S. and Elwakeel, A.E. and Alebidi, A. and Yue, X. and Elmessery, W.M. and Galal, H.},
	year = {2025},
	keywords = {Precision agriculture, precision agriculture, machine learning, accuracy, acidity, anthocyanin, article, benchmarking, chemical analysis, chemometrics, Chemometrics, controlled study, decision tree, Decision tree, fruit, Fruit quality, Gradient boosting regression, grape, infrared radiation, near infrared spectroscopy, nonhuman, prediction, root mean squared error},
	file = {3FJICBI9.pdf:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\M3ACTC3R\\3FJICBI9.pdf:application/pdf},
}

@article{tomar_multi-objective_2025,
	title = {Multi-objective optimization of photovoltaic greenhouses with modelling and field validation},
	volume = {301},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014917174&doi=10.1016%2Fj.solener.2025.113938&partnerID=40&md5=42d7da704f185f1a59e28831882f070a},
	doi = {10.1016/j.solener.2025.113938},
	abstract = {Photovoltaic greenhouses (PVGHs) offer a sustainable solution for food and energy production, particularly in off-grid and water-scarce regions. However, optimizing their operation requires managing competing objectives across energy generation, irrigation efficiency, crop quality, and economic viability. This study presents a field-validated, first-principles-based multi-objective optimization framework tailored for PVGHs. The model concurrently maximizes four objectives: (i) photovoltaic energy efficiency, (ii) water-use-informed crop yield, (iii) composite fruit quality, and (iv) economic return. Unlike prior work, the framework integrates a dynamic quality index—combining °Brix, firmness, acidity, and size—into the optimization process and embeds real-time cost–revenue analysis into control logic. Empirical validation is conducted over a 97-day tomato crop cycle in a semi-arid, off-grid PVGH. The model achieves strong predictive agreement across key performance indicators (R2 {\textgreater} 0.92; deviation {\textless} 7 \%) for yield, water use, energy generation, and quality. Sensitivity and scenario-based analysis demonstrate system robustness under environmental and resource constraints. Implemented as a low-cost digital twin, the framework supports adaptive, quality-aware greenhouse control and holds strong potential for deployment in climate-sensitive, resource-limited agriculture. It also contributes to food-energy-water security and sustainable development in vulnerable rural regions. © 2025 International Solar Energy Society},
	journal = {Solar Energy},
	author = {Tomar, A.},
	year = {2025},
	keywords = {Greenhouses, automation, Crops, Sustainable development, crop yield, optimization, Cost benefit analysis, Crop yield, Crop yield modeling, Crop yield modelling, Energy optimization, Fruits, greenhouse gas, irrigation, model validation, Multi-objective control, Multiobjective optimization, Off-grid automation, Off-grids, Photovoltaic greenhouse, photovoltaic system, Photovoltaics, Sales, Solar energy, Solar energy optimization, solar power, Solar power generation, sustainable development, Water energy, Water-energy-food nexus, Yield models},
