@article{aminzadeh_hybrid_2026,
	title = {Hybrid {AI}-digital twin framework for predictive quality assessment in resistance spot welding of high-stack advanced high-strength steel for {BEV} body-in-white},
	volume = {70},
	issn = {0043-2288, 1878-6669},
