@article{wu_bim_2026,
	title = {From {BIM} to {Digital} {Twin}: {A} {Data}-{Driven} {Closed}-{Loop} {Framework} for {Dynamic} {Construction} {Progress} {Management}},
	volume = {16},
	issn = {2075-5309},
	shorttitle = {From {BIM} to {Digital} {Twin}},
