	pages = {119367},
	file = {Wang_2025_Intelligentpred_42477:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Wang_2025_Intelligentpred_42477.pdf:application/pdf},
}

