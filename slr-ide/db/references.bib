@article{cai_physics-guided_2026,
	title = {Physics-guided thermoelastic state-space learning for spindle thermal error in machine tools},
	volume = {322},
	issn = {09574174},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0957417426013576},
	doi = {10.1016/j.eswa.2026.132444},
	abstract = {Thermal error of motorized spindles is a primary source of accuracy degradation in machine tools. Existing prediction methods often exhibit limited reliability under varying operating conditions and sparse data, as physical mechanisms and structural information are insuf2ciently exploited, leading poor robustness and weak prediction accuracy. To address the above challenges, a physics-informed thermal error modeling and compensation framework is proposed for spindles in machine tools. An implicitly coupled thermoelastic statespace network is formulated to model temperature evolution and deformation accumulation. Sliding windows are used to extract local temperature patterns, while sensor layout and functional regions are encoded to represent structural information. Long-term thermoelastic states are propagated to capture cumulative thermal deformation. To enforce physical consistency during training, a differentiable 2nite-element residual regularization term is introduced. A weak-form heat-conduction constraint is embedded through learnable stiffness and mass operators and is optimized jointly with the data-driven loss. Experiments were conducted on spindle thermal datasets. The experimental results indicate that improved prediction accuracy and enhanced crosscondition generalization are obtained compared with several representative deep learning baselines. A digital twin system is further implemented to enable real-time sensing, prediction, and closed-loop compensation. Milling experiments on annular workpieces show a reduction in surface 4atness error of approximately 65 \%, demonstrating the practical effectiveness of the developed framework for thermal error control in precision machining.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Expert Systems with Applications},
	author = {Cai, Weijie and Ma, Chi and He, Jialong and Hua, Chunlei and Wang, Liang and Yang, Jun and Liu, Kuo},
	month = aug,
	year = {2026},
	pages = {132444},
	file = {Cai_2026_Physicsguidedth_2b1be:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Cai_2026_Physicsguidedth_2b1be.pdf:application/pdf},
}

@article{liu_topology-aware_2026,
	title = {Topology-aware graph neural network for fusing sparse sensor data with finite element predictions in structural random vibration assessment},
	volume = {325},
	issn = {09574174},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0957417426016866},
	doi = {10.1016/j.eswa.2026.132773},
	abstract = {Accurate structural response prediction under random vibration ensures the safety and reliability of aerospace structures; however, such assessments are often hindered by the discrepancy between spatially complete but systematically biased nite element (FE) models and sparse but locally accurate sensor measurements. Existing correction methods treat this task as a generic spatial interpolation problem based on Euclidean proximity. However, modeling errors—originating from idealized joints, uncertain damping, and simpli ed boundaries—tend to propagate along mechanical connectivity pathways rather than geometric distances. This study reformulates heterogeneous data fusion as a graph-based residual learning problem, leveraging nite element mesh topology to infer spatially structured modeling errors from sparse measurements. The proposed topologyaware Digital Twin Mesh Graph Neural Network (DT-MESH-GNN) employs graph distance feature vectors to encode shortest-path accessibility from mesh nodes to sensor locations. It integrates multi-scale message passing to capture local element-level stress transfer and global load-path propagation across the mesh hierarchy. Inverse-distance-weighted attention mechanisms allocate correction authority to nearby sensors proportionally to their topological relevance, embedding structural connectivity priors into the learning process. Random vibration experiments on an aerospace engine compartment mock-up under eight progressive load levels show the framework achieves topology-consistent predictions for 105,680 nodes using only 32 sensors, reducing mean prediction error from 54.32\% to 24.17\% and outperforming seven baselines. Sensor density analysis and progressive load extrapolation experiments con rm framework robustness and generalization while de ning its applicability boundary.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Expert Systems with Applications},
	author = {Liu, Haoyang and Wan, Wenqing and Chen, Jinglong and Feng, Yong},
	month = sep,
	year = {2026},
	pages = {132773},
	file = {Liu_2026_Topologyawaregr_104f4:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Liu_2026_Topologyawaregr_104f4.pdf:application/pdf},
}

@article{zhao_federated_2026,
	title = {Federated {Learning} {Intersection} {Vehicle} {Trajectory} {Prediction} {Scheme} {Within} {Digital} {Twin}},
	volume = {27},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {1524-9050, 1558-0016},
	url = {https://ieeexplore.ieee.org/document/11029602/},
	doi = {10.1109/TITS.2025.3573999},
	abstract = {Digital Twin (DT) technology has gained signiﬁcant attention for simulating and optimizing urban trafﬁc systems, especially in intersection vehicle trajectory prediction. However, digital twin trafﬁc system faces signiﬁcant challenges due to privacy and security regulations that prevent the centralized storage of trajectory and semantic data, which are essential for training accurate predictive models using sensitive trafﬁc information. To address these issues, we introduce the integration of federated learning spatio-temporal-semantic attention-based trajectory (FedSTAST) model into the DT framework for vehicle trajectory prediction. In our FedSTAST, edge servers in physical space utilize local sensor data to perform computations and train models without transmitting raw data, only the model parameters are sent to a cloud server in the twin space for aggregation. This decentralized approach ensures data privacy while enabling collaborative model training. The simulation results demonstrate that the FedSTAST model effectively handles co-training and multi-source semantic input processing within spatio-temporalsemantic attention-based trajectory (STSAT) models, enhancing trajectory prediction accuracy and robustness in the dynamic, real-time context of DT-based urban trafﬁc systems.},
	language = {en},
	number = {5},
	urldate = {2026-07-23},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
	author = {Zhao, Yanan and Yang, Yang and Yu, Haiyang and Kumari, Saru and Amoon, Mohammed and Kumar, Sachin and Ren, Yilong},
