@article{yang_model_2026,
	title = {Model predictive control of industrial steam system with digital twin and load forecasting},
	volume = {288},
	issn = {13594311},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1359431125040736},
	doi = {10.1016/j.applthermaleng.2025.129481},
	abstract = {Although industrial steam systems play a vital role in energy-intensive industries, many still experience considerable energy losses resulting from the imbalance between steam production and consumption due to outdated control strategies. In this study, an optimized model predictive control strategy is developed that integrates a Modelica-based digital twin with an adjusted Long Short-Term Memory load forecasting model. Case study results show that the adjusted neural network achieves highly reliable predictions of steam load variations (R2 = 0.9908), while the digital twin provides real-time and accurate simulations with a mean relative error below 3.3 \%. Using predicted steam demand as boundary conditions, the digital twin generates predictive control instructions including required steam pressure and mass 9ow, which are provided to the boiler’s closed-loop controller. Application of the method demonstrates that integrating mechanism-based digital twin with data-driven forecasting under model predictive control method signi:cantly reduces energy waste by less overproduction of steam and smarter regulation to boiler control process. Under typical operating conditions in the veri:cation case of a printing and dyeing industrial park, up to 35.3 \% of the steam production and 38.7 \% of fuel consumption was saved. Unlike previous studies that applied digital twins and neural networks solely without being planted into actual control systems, this work demonstrates the engineering application potential of integrating both within a model predictive control framework, offering a scalable and effective pathway to improve ef:ciency in industrial steam systems and other thermal systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Applied Thermal Engineering},
	author = {Yang, Bowen and Shou, Haipeng and Wang, Baoqi and Wang, Haoyu and Liu, Le and Guo, Chaoyang and Peng, Tianle and Cao, Lianfang and Liu, Zhaohui},
	month = mar,
