@inproceedings{r_digital_2025-1,
	address = {Goa, India},
	title = {Digital {Twin} {Framework} for {Predictive} {Maintenance} of {Autonomous} {Vehicle} {Suspension} {System}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9806-8},
	url = {https://ieeexplore.ieee.org/document/11490804/},
	doi = {10.1109/STPEC66316.2025.11490804},
	abstract = {As autonomous vehicles (AVs) evolve toward fully self-reliant mobility, the need for intelligent and real-time mechanical health management becomes critical, particularly in suspension systems, which directly affect ride comfort, dynamic safety, and operational reliability. This paper presents a novel digital twin framework designed for predictive maintenance of autonomous vehicle (AV) suspension systems. By integrating a physics-based quarter-car model with real-time sensor feedback and cloud-enabled digital twin synchronization, the proposed architecture continuously tracks mechanical degradation and accurately estimates the remaining useful life (RUL). Fatigue and damping decay models are embedded to simulate long-term wear, while machine learning algorithms based on support vector machines (SVM) model refine fault diagnosis and prognostics. The system achieves 94.8\% fault detection accuracy and predicts critical failures with {\textless}±10\% RUL estimation error, enabling maintenance lead times of up to 250 km. Compared to conventional threshold-based methods, the framework enhances diagnosis precision, reduces false positives, and offers scalable deployment potential for AV fleet management. This study demonstrates a significant step toward autonomous selfmaintenance capabilities, laying the groundwork for future integration of AI-enhanced decision-making and multi-component digital twin ecosystems.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {IEEE} 4th {International} {Conference} on {Smart} {Technologies} for {Power}, {Energy} and {Control} ({STPEC})},
