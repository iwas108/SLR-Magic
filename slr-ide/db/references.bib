@inproceedings{badajena_physics-informed_2025,
	address = {Bhubaneswar, India},
	title = {A {Physics}-{Informed} {Digital} {Twin} for {Induction} {Motor} {Fault} {Modeling} and {Validation}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-6637-1},
	url = {https://ieeexplore.ieee.org/document/11410948/},
	doi = {10.1109/ICPEE65973.2025.11410948},
	abstract = {Induction motors are critical components in industrial and transportation systems, where unexpected failures can result in signiﬁcant downtime and economic loss. Digital Twin (DT) technology offers a promising pathway for realtime fault diagnosis and predictive maintenance. This paper presents the development of a physics-informed DT framework for induction motors that captures both healthy operation and multiple fault conditions, including broken rotor bar, bearing defects, eccentricity, and broken end rings. The DT is constructed using physics-based modeling of electromagnetic and mechanical dynamics, extended with fault-speciﬁc modules to emulate abnormal behaviors. To ensure practical applicability, the framework is experimentally validated on a laboratory motor test bench equipped with current sensors under seeded fault conditions. Comparative analysis between simulated DT outputs and experimental measurements demonstrates strong agreement in time domain responses, with correlation exceeding 90\% across fault scenarios. The results conﬁrm that the DT accurately reproduces fault signatures and transient distortions. This uniﬁed DT framework establishes a robust foundation for fault detection, severity analysis, and health assessment of induction motors, enabling its deployment for predictive maintenance in industrial and electric vehicle applications.},
	language = {en},
	urldate = {2026-07-23},
