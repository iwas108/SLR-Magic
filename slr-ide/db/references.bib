@article{souby_ai-driven_2026,
	title = {{AI}-driven modeling and prediction of transient heat transfer in spray-cooled fuel cell stack radiators},
	volume = {284},
	issn = {13594311},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1359431125037457},
	doi = {10.1016/j.applthermaleng.2025.129153},
	abstract = {Accurate modeling and prediction of transient heat transfer is crucial for the design, control, and reliability of proton exchange membrane fuel cell (PEMFC) thermal management systems, particularly under highly dynamic spray cooling conditions. This study aims to introduce a novel machine learning (ML)-based framework to predict transient heat transfer behavior in a pulsating spray-cooled PEMFC stack radiator. Eight supervised learning models—Extra Trees Regressor (ETR), Random Forest Regressor (RFR), LightGBM, CatBoost, XGBoost, Multilayer Perceptron Arti*cial Neural Network (MLP-ANN), Random Vector Functional Link (RVFL), and KNearest Neighbors (KNN)—were implemented. All models were trained on a high-resolution dataset comprising 65,304 in-situ, time-resolved data points obtained under variations in eight input parameters: spray :ow rate, spray temperature, air mass :ow rate, air temperature, coolant temperature, spray duration, interval duration, and running time. The models were systematically optimized and evaluated using multiple performance metrics across training, validation, and testing sets. Among them, ETR achieved the highest predictive accuracy, with an R2 of 0.9959 and an RMSE of 0.092 on the full dataset, effectively capturing complex, nonlinear thermal dynamics. XGBoost and MLP-ANN also demonstrated strong performance, with R2 values of 0.9911 and 0.9899, and RMSEs of 0.1366 and 0.1453, respectively, indicating robust generalization across diverse operating conditions. Residual analysis revealed near-Gaussian distributions for the top-performing models, validating their predictive consistency across both central trends and extreme deviations. The developed framework enables accurate real-time prediction of heat transfer and establishes a foundation for adaptive spray control, digital twin integration, and data-driven optimization in next-generation PEMFC systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Applied Thermal Engineering},
	author = {Souby, M.Mohamed and Prabakaran, Rajendran and Kim, Sung Chul},
	month = jan,
