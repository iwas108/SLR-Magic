@inproceedings{slimani_interactive_2025,
	title = {Interactive {IoT}-{Driven} {Virtual} {Reality} {Framework} for {Advancing} {Digital} {Twin} {Applications} in {Agriculture} 5.0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007739805&doi=10.1109%2FIRASET64571.2025.11008258&partnerID=40&md5=12c67c1462818cce7f955279ab532968},
	doi = {10.1109/IRASET64571.2025.11008258},
	abstract = {Agriculture 5.0 is built on the Internet of Things (IoT) and digital twins (DT), which allow for sustainable innovation, data-driven decision-making, and accurate depiction of agricultural systems. In order to transform agricultural practices, this study presents Virtual Reality (VR)-based DTIoT, an IoT-driven interactive framework that combines DT and immersive VR technology. The framework improves user involvement by utilizing the shared virtual environment of VR, which enables stakeholders to participate in real-time virtual representations of agricultural systems. By providing a dynamic real-time monitoring and control platform, this method overcomes the drawbacks of conventional greenhouse management, including time, location, and platform limitations. Head-mounted displays (HMDs) access a 3D-enabled VR-DTIoT greenhouse framework that is part of a Virtual Agriculture Interactive System (VAIS). The system allows for smooth decision-making and process improvement by synchronizing DT with real-time IoT data. VR-DTIoT offers a revolutionary solution for precision agriculture and rural development in Agriculture 5.0 by enabling quick communication and remote task execution. With a System Usability Scale (SUS) score of 84.73\%, usability research with 23 participants from various backgrounds showed great user effectiveness and satisfaction. The framework's potential to promote sustainable farming is highlighted by its capacity to record and examine agricultural activities and the evolution of agroecosystems. It also gives users a sneak peek into greenhouse operations, which increases engagement and transparency. This study highlights the revolutionary potential of VR-DTIoT in Agriculture 5.0 by providing a scalable, cutting-edge approach to process management, immersive interactivity, and real-time monitoring. This framework opens the door to a future in agriculture that is more productive, sustainable, and networked by connecting DT, IoT, and Virtual Reality. © 2025 IEEE.},
	author = {Slimani, H. and Jilbab, A. and El Mhamdi, J.},
	year = {2025},
	keywords = {Digital Twin, Greenhouse, Decision-making, IoT, Decision making, Real time monitoring, Agricultural robots, Decisions makings, 3D models, 3d-modeling, Agricultural practices, Agricultural system, Agriculture 5.0, Combines, Data driven decision, Immersive virtual reality, Real-time monitoring, Virtual Reality, Virtual reality technology, Virtualization},
