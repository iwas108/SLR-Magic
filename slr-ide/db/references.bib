@article{xia_degradation-adaptive_2026,
	title = {Degradation-adaptive digital twin for long-term consistency},
	volume = {149},
	issn = {1569190X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1569190X26000250},
	doi = {10.1016/j.simpat.2026.103276},
	abstract = {Digital twin technology faces significant challenges in long-term equipment management due to model mismatch arising from irreversible performance degradation. Conventional approaches such as physics-based model parameter tuning or neural network retraining often encounter difficulties in maintaining physical interpretability or incur prohibitive computational overhead. To address these limitations, this paper proposes a degradation-adaptive digital twin framework that enables the digital twin to co-degrade with its physical counterpart. The framework introduces an equivalent fault injection mechanism into a physics-based model, establishing a dynamic representation where the structure and parameters of the model evolve synchronously with the physical system. Through an optimization-based regression process, health indicators with explicit physical meaning are extracted from the system output and used to drive timeseries forecasting for future state prediction. A case study on the air intake filter element of a screw air compressor demonstrates the efficacy of the approach. Comparative simulations against conventional adaptive strategies confirm that the proposed framework ensures physical consistency in unobservable states, avoiding the superficial consistency often found in parameter-tuning methods. Experimental results show that the framework maintains highfidelity input–output consistency while accurately predicting the clogging trend up to 86.7 h into the future, even with a limited training dataset spanning 517.6 h. Furthermore, quantitative uncertainty analysis validates the robustness and reliability of the predictive outcomes. The degradation-adaptive digital twin framework offers a robust solution for engineering systems dominated by a single and identifiable degradation mode.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Simulation Modelling Practice and Theory},
	author = {Xia, Tianyu and Zuo, Jianyong and Ding, Jingxian and Pan, Yu},
	month = may,
	year = {2026},
	pages = {103276},
	file = {Xia_2026_Degradationadap_a0154:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Xia_2026_Degradationadap_a0154.pdf:application/pdf},
}

@article{zhu_digital_2026-1,
	title = {Digital twin system with physics-tuned {iTransformer} for high-fidelity motion prediction of deep-sea mining vehicles},
	volume = {362},
	issn = {00298018},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0029801826020044},
	doi = {10.1016/j.oceaneng.2026.126170},
	abstract = {Real-time, high- delity motion prediction of deep-sea mining vehicles is critical for the safety and ef ciency of pipeline lifting systems; however, it remains a formidable challenge due to complex hydrodynamics and data scarcity. This paper presents a predictive digital twin (DT) system driven by a novel Physics-Tuned iTransformer (PTI) framework. The PTI addresses the inherent limitations of purely data-driven or physics-based models through an innovative two-stage training pipeline. Initially, the iTransformer is pre-trained on a large-scale virtual dataset generated by a meticulously parameterized six-degree-of-freedom(6-DOF) nonlinear dynamic model, enabling it to internalize fundamental hydrodynamic laws. Subsequently, the model is ne-tuned using a high-quality, albeit limited, experimental dataset acquired from physical 8ume experiments, bridging the Sim2Real gap by adapting generalized knowledge to real-world speci cities. By embedding the PTI engine, the proposed DT system transcends the role of a passive “digital mirror” to become a proactive “digital oracle”. The PTI's variate-centric inverted architecture intrinsically preserves the continuous temporal integration of kinematic variables while implicitly mapping nonlinear cross-axis couplings. System-level experimental validation demonstrates that the DT achieves a remarkable coef cient of determination (R2) of 0.9169 for surge velocity predictions on unseen test data. Furthermore, the system completely eradicates autoregressive error accumulation, exhibiting superior zero-phase lag responsiveness and data ef ciency. This work validates the PTI-driven DT framework as a robust, practical solution for predictive foresight in deep-sea operations, paving the way for safer and autonomous subsea mining.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Ocean Engineering},
	author = {Zhu, Jinzhuo and Liu, Jialin and Lv, Kai and Zou, Yong and Wang, Jiaying and Li, Leiyu and Wang, Yexian and Lv, Pengyu and Li, Hongyuan},
	month = jul,
