@inproceedings{joshi_transforming_2023,
	title = {Transforming {Greenhouse} {Horticulture} {Using} {Artificial} {Intelligence} and {Digital} {Twin}},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184827674&doi=10.1109%2FiQ-CCHESS56596.2023.10391310&partnerID=40&md5=a31627f03f3bbe8e77ffccf0121e36f6},
	doi = {10.1109/iQ-CCHESS56596.2023.10391310},
	abstract = {In todays, to cope with the problems caused by the rising worldwide need for basic foodstuffs, it is vital to discover ecologically friendly solutions. Vegetable crops may be grown all year long, regardless of the climate or season, thanks to horticulture. The production process for horticulture may be categorized as an unstructured \& extremely complicated system that is influenced by the climate, environment, pests, disease, herbicides, nutrients, pricing, \& combinations of these numerous aspects. Digital twins might be seen as the beginning of a new era in data-driven \& intelligent greenhouse horticulture. The study of the article is about the advancement of horticulture via the application of reducing technologies, especially digital technology. The purpose of this article is to offer, with the need for technology, the vital information that producers may utilize to harvest a range of crops to reap the most rewards. This study describes the outcomes of structured use of the Digital Twin application throughout greenhouse horticulture, as Artificial Intelligence applies to learn approaches throughout its applications to proclaim the best cost-effective \& maximal benefit for the agriculturist. Based on the analysis, the article identifies challenges and suggests a few vital recommendations for future work. The findings of this study on the efficiency of concept in the growth of concentrated fruits and vegetables are examined. © 2023 IEEE.},
	author = {Joshi, K. and Gupta, A. and Rawat, A.J. and Kumar, R. and Gupta, O.},
