@inproceedings{fink_machine_2025,
	address = {Birmingham, United Kingdom},
	title = {Machine {Learning}-{Based} {Degradation} {State} {Prediction} of {SiC} {MOSFETS} {Aged} by {Static} {Power} {Cycling} {Tests}},
