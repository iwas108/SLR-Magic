@inproceedings{zhang_research_2026,
	address = {Guangzhou, China},
	title = {Research on the {Construction} and {Application} of a {Big} {Data} {Analysis} {Platform} for {New} {Power} {Systems} {Based} on {IoT} and {Digital} {Twin} {Technologies}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-7218-1},
	url = {https://ieeexplore.ieee.org/document/11484347/},
	doi = {10.1109/ISBDAS69350.2026.11484347},
	abstract = {With the deep integration of digital-intelligent technologies, such as Cloud Computing, Big Data, Internet of Things (IoT), Mobile Internet, Artificial Intelligence (AI), Blockchain, and Edge Computing, into the power industry, the traditional power system is rapidly transforming towards a new type of power system. This new system is characterized by a dominant share of new energy sources and synergistic interaction among generation, grid, load, and storage. It faces challenges arising from the high penetration of volatile renewable energy and the complexities of deep physical-information coupling. This paper aims to construct a multi-layer digital-intelligent platform architecture based on IoT, Big Data, and Digital Twin (DT) technologies. It seeks to enhance the perception, decision-making, and control capabilities of the power system through coordinated optimization across physical, operational, transactional, and value layers. In the methodology section, this paper focuses on a case study of photovoltaic power forecasting based on statistical big data analysis. It provides a detailed derivation of the mathematical mechanisms of the Seasonal Autoregressive Integrated Moving Average (SARIMA) model and the Long Short-Term Memory (LSTM) network, followed by a comparative analysis of experimental results. Empirical analysis demonstrates that the digital-intelligent platform can significantly reduce photovoltaic curtailment rates and improve system security. Finally, addressing challenges in policy, standards, security, and computing power, the paper proposes a phased evolutionary pathway, providing theoretical support for the high-quality green and low-carbon transition of the power industry.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 9th {International} {Symposium} on {Big} {Data} and {Applied} {Statistics} ({ISBDAS})},
	publisher = {IEEE},
