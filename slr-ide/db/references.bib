	file = {Yang_2026_Modelpredictive_4be31:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Yang_2026_Modelpredictive_4be31.pdf:application/pdf},
