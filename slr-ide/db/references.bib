@inproceedings{jharko_digital_2026,
	address = {Sochi, Russian Federation},
	title = {Digital {Twin} of a {Nuclear} {Power} {Plant} {Unit} {Based} on a {Flexible} {Modeling} {System} with {Integration} of {Machine} {Learning} {Methods}},
	copyright = {https://doi.org/10.15223/policy-029},
