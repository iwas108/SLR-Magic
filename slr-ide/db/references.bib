@inproceedings{petalas_operational_2025,
	address = {BREST, France},
	title = {Operational {Oil}-{Spill} {Detection} in the {Framework} of {Digital} {Twin} {Using} {SAR} {Imagery} and {Deep} {Learning}},
	copyright = {https://doi.org/10.15223/policy-029},
