	file = {VasquezMunoz_2026_EarlyStagePredi_827e5:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\VasquezMunoz_2026_EarlyStagePredi_827e5.pdf:application/pdf},
}

@article{mohanraj_tool_2026,
	title = {Tool condition monitoring in the milling process using a data-driven {Digital} {Twin} framework},
	volume = {275},
	issn = {02632241},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0263224126009425},
	doi = {10.1016/j.measurement.2026.121233},
	abstract = {The entry of industries into the era of digitalization paved the way for the growth of numerous technologies and advancements over the past decade. Technologies like blockchain, big data analytics, Digital Twin, etc., have played a signi0cant role in industrial growth. Despite being a relatively new concept, Digital Twin has gained suf0cient attention among researchers and industry experts. The study aims to develop a data-driven model of a Digital Twin for tool condition monitoring (TCM) in the milling process and predict the tool condition. The machining process was performed on AISI Stainless Steel (SS) 304 with selected cutting parameters and tool conditions. During machining, vibration and sound pressure signals were acquired from the tri-axial accelerometer and microphone, respectively, for three different tool conditions. The features are extracted from the raw sound and vibration signal to train the machine learning algorithms (MLA). These datasets are trained in Support Vector Machine (SVM), Discriminant Analysis (DA), Naïve Bayes (NB), and Bootstrap Aggregating (BA) algorithms. The performance of the selected MLA is evaluated through performance metrics like confusion matrix, accuracy, recall, precision, F1-score, and Kappa statistics. The overall classi0cation accuracy for SVM, DA, NB, and BA is 93.14\%, 91.33\%, 95.62\%, and 97.28\% respectively. BA stands 0rst, followed by NB, SVM, and DA to predict tool conditions accurately, thereby enhancing overall process ef0ciency. The best performing (BA) model is used to build a data-driven Digital Twin model using MATLAB Simulink. The TCM and prediction setup is used for successful monitoring of the tool insert during milling operations using sound and vibration signals. This research leads to the development of the TCM system by spotlighting the application of MLA and Digital Twins to transform manufacturing processes in Industry 5.0.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Measurement},
	author = {Mohanraj, T. and Suresh, G. and Praveen Kumar, T. and Pramanik, A. and Siarry, Patrick},
