@article{tu_serviceability_2026,
	title = {Serviceability assessment and structural response forecasting of near-coast utility tunnels under soft-soil conditions},
	volume = {90},
	issn = {23520124},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2352012426012890},
	doi = {10.1016/j.istruc.2026.112340},
	abstract = {Near-coast utility tunnels constructed in soft-soil environments are vulnerable to long-term settlement accumulation and structural response evolution, posing challenges for serviceability assessment and operational safety management. Existing studies generally focus on either deformation monitoring or structural response prediction, while integrated forecasting frameworks for heterogeneous monitoring data remain limited. This study proposes a dual-stream monitoring and predictive framework for operational-phase assessment of nearcoast utility tunnels. Hydrostatic leveling system (HLS) measurements are employed to characterize vertical deformation and are modeled using the AutoRegressive Integrated Moving Average (ARIMA) approach after stationarity diagnosis and differencing treatment. Meanwhile, strain-monitoring data are represented as a weighted sensor network and analyzed using a spatiotemporal graph neural network (STGNN) capable of capturing nonlinear temporal evolution and spatial coupling effects among monitoring locations. To ensure realistic operational evaluation, a rolling-origin forecasting strategy with missing-data masking and round-wise normalization is adopted. Results indicate that the ARIMA model achieved an RMSE of 0.62 mm and an R² value of 0.93 for one-day deformation forecasting, demonstrating strong short-term predictive capability. For strainresponse prediction, the weighted STGNN achieved a 30-day forecasting RMSE of 0.025 mm and maintained a Pearson correlation coef8cient exceeding 0.94. Comparative analyses show that the proposed multi-indicator STGNN outperformed single-indicator forecasting models by reducing prediction errors by approximately 15–20\% for long-horizon forecasts. Ablation experiments further reveal that removing graph-based spatial coupling increased forecasting errors by 12.8\%, con8rming the importance of explicitly modeling inter-sensor dependencies. The proposed framework provides an effective and reproducible solution for structural prognosis, early warning, and maintenance planning of underground utility tunnels and offers a practical foundation for future digital-twin-driven infrastructure management systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Structures},
	author = {Tu, Wenrong and Fang, Shibiao},
	month = aug,
	year = {2026},
	pages = {112340},
	file = {Tu_2026_Serviceabilitya_9569f:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Tu_2026_Serviceabilitya_9569f.pdf:application/pdf},
}

@article{ba-alawi_adaptive_2026,
	title = {Adaptive optimization of combined steam and {CO2} reforming for hydrogen production from variable biogas feed},
	volume = {448},
	issn = {09608524},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0960852426003640},
	doi = {10.1016/j.biortech.2026.134283},
	abstract = {Biogas-to-hydrogen (B2H2) conversion offers a sustainable pathway for valorizing organic waste–derived biogas from anaerobic digestion (AD) into clean energy carriers. However, temporal variations in biogas composition strongly in+uence the endothermic nature of direct reforming reactions, burner fuel quality, and overall process stability. This study systematically investigates the effect of biogas variability on the B2H2 process through a comprehensive parametric analysis, based on a techno-economic-environmental analysis, evaluating three key indicators: unit hydrogen production cost (UPC), net CO2 emissions (NCE), and hydrogen production ef,ciency (EFF). Then, a novel multi-task digital twin optimization (MT-DTO) framework is developed for feed-adaptive operation of the B2H2 process based on combined steam and CO2 reforming (CSCR), enabling ef,cient biohydrogen production under dynamically changing biogas conditions. The MT-DTO framework integrates a deep learning surrogate model, a multi-task evolutionary optimization algorithm, and a K-nearest neighbors classi,er to simultaneously optimize multiple operational objectives under varying biogas compositions. Results indicate that increasing methane content from 55\% to 75\% reduces UPC from 3.14 to 2.66 USD/kg H2 and improves EFF from 0.33 to 0.36. The operational temperature of CSCR, critical for endothermic hydrogen production, exerts signi,cant in+uence on UPC, NCE, and EFF. Validation using real biogas data from a full-scale AD plant in Korea con,rms annual operating cost reductions from 56.06 to 53.25 million USD and a 6\% decrease in CO2 emissions, from 47.18 to 44.53 kilotons. Therefore, the proposed MT-DTO framework can provide practical guidance for designing and operating waste-to-hydrogen systems ef,ciently and sustainably under variable biogas feed conditions.},
	language = {en},
