@article{gu_hierarchical_nodate,
	title = {A {Hierarchical} {Physics}-{Informed} {Machine} {Learning} {Framework} for {Battery} {Pack} {Capacity} {Estimation} {With} {Limited} {Data}},
	abstract = {Accurate and robust estimation of battery pack capacity is essential for intelligent battery management. However, complex degradation mechanisms, cell-tocell inconsistencies, and the scarcity of labeled data pose signiﬁcant challenges. To address these issues, a hierarchical physics-informed machine learning (HPIML) framework is proposed to enhance model training and transferability with minimal labeled data. First, a simulation model of battery pack is constructed to emulate dynamic behavior across multiple aging scenarios, replacing costly and time-consuming experimental data acquisition. A dualbranch deep learning model is then developed, combining degradation mechanisms and data-driven information to improve estimation robustness and adaptability. Finally, the model is pretrained using simulated data and adapted to real-world scenarios through a transfer learning strategy to enhance adaptability. Experimental results demonstrate that using only four labeled samples, the HPIML framework can accurately estimate the capacity of battery packs under different materials and operating conditions, with the root mean square error and mean absolute percentage error maintained below 0.2 Ah and 0.5\%, respectively. Compared to conventional methods, the proposed approach improves estimation accuracy by at least 27.89\%, while saving 492 kWh of electricity and reducing CO2 emissions by 383.76 kg.},
	language = {en},
	author = {Gu, Pingwei and Zhang, Ying and Duan, Bin and Zhang, Chenghui and Li, Changlong and Liu, Kailong},
	file = {Gu_2026_AHierarchicalPh_f8cb4:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Gu_2026_AHierarchicalPh_f8cb4.pdf:application/pdf},
}

@article{cheng_universal_2026,
	title = {A universal framework for high- delity ow eld prediction in scroll machinery based on {POD} and time series forecasting: {A} case study of co-rotating scroll hydrogen recirculation pump},
	abstract = {Solely relying on computational uid dynamics (CFD) is insuf cient to support the development of scroll machinery digital twins, primarily due to its high computational cost and poor real-time performance. With the rapid advancement of data-driven technology, reduced order models (ROMs) have emerged as a promising pathway to facilitate it. This paper proposes a universal framework for high- delity ow eld prediction in scroll machinery, utilizing Proper Orthogonal Decomposition (POD) for dimensionality reduction combined with time series forecasting. To address the time-varying grid topology of scroll machinery, an innovative data extraction method based on xed background grid is proposed. Furthermore, modal coef cients are grouped via wavelet transform and K-means clustering analysis for improved prediction model training ef ciency, with the grouped counterparts predicted using the Patch Time Series Transformer (PatchTST). The results indicate that the POD of the ow eld in scroll machinery is rstly realized through background grid interpolation. Compared with individual prediction, group prediction reduces the number of prediction models required for training to 1/20. With 99.99\% energy truncation, the method achieves a mean absolute percentage error of approximately 0.67\% for ow eld prediction, while requiring only 0.16 s to reconstruct the ow eld at each rotation angle. The proposed framework substantially lowers computational costs while satisfying the requirements for real-time, high-precision performance characterization in digital twin applications. This novel methodology can be extended to the ow eld prediction and digital twin construction for other types of positive displacement uid machinery.},
	language = {en},
	author = {Cheng, Ming and Song, Panpan and Wei, Mingshan and Dan, Dan and Zhuge, Weilin and Zhang, Yangjun},
	year = {2026},
	file = {Cheng_2026_Auniversalframe_4772a:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Cheng_2026_Auniversalframe_4772a.pdf:application/pdf},
}

@article{liu_neural_2026,
	title = {Neural operator-based damage sensing digital twin for piezocomposites with {Parametrically} {Upscaled} {Coupled} {Constitutive} {Damage} {Model}},
	volume = {461},
	issn = {00457825},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0045782526004421},
	doi = {10.1016/j.cma.2026.119169},
	abstract = {Early detection and tracking of damage for structural health monitoring (SHM) in challenging environments is critical for ensuring safety by preventing catastrophic failure and extending service life. This is particularly relevant as many techniques rely on sparse surface-mounted sensors, providing limited information on subsurface cracks that evolve to cause structural failure. Efficient in-situ reconstruction of temporally evolving deformation and damage fields in the bulk from sparse surface measurements can alleviate significant challenges faced by the SHM community. Coupling a machine learning-enabled multiscale multiphysics model, viz. the Parametrically Upscaled Coupled Constitutive Damage Model (PUCCDM) with Fourier neural operator (FNO) learning, this paper develops a Virtual Damage Sensing Digital Twin (VDSDT) platform for piezoelectric composites. This platform interfaces with actual surface sensor measurements for efficient prediction of full-field temporally evolving deformation, electrical, and damage fields in the entire structure. A key feature of the framework is the incorporation of Representative Aggregated Microstructural Parameters (RAMPs), representing the characteristics of the underlying microstructure. These descriptors act as essential priors that regularize the inverse mapping and render the learned operator identifiable under sparse sensing. The mapping is learned using the FNO, trained on data generated by PUCCDM-based FE simulations, whose constitutive coefficients are explicitly represented as functions of the RAMPs. Furthermore, a genetic algorithm (GA) is employed to optimize sensor number and placement. Systematic studies demonstrate that the proposed VDS-DT platform achieves high-fidelity prediction of spatiotemporal damage evolution for both in-distribution and out-of-distribution testing cases, while revealing the complementary roles of sensor density and microstructure-informed priors (RAMPs). These results establish a unified paradigm for physics-informed, operator-based digital twins, providing a scalable pathway for real-time SHM with sparse sensing.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Computer Methods in Applied Mechanics and Engineering},
	author = {Liu, Yangyuanchen and Ghosh, Somnath},
	month = nov,
	year = {2026},
	pages = {119169},
	file = {Liu_2026_Neuraloperatorb_bb5df:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Liu_2026_Neuraloperatorb_bb5df.pdf:application/pdf},
}

@article{zhu_research_nodate,
	title = {Research on {Structural} {Fatigue} {Life} {Prediction} of {Container} {Gantry} {Cranes} {Based} on {Digital} {Twin}},
	abstract = {Accurate assessment of cumulative fatigue damage in container gantry cranes under longterm cyclic loading is hindered by the inability of traditional single-model methods to capture real-time structural conditions. This paper proposes a digital twin-driven framework that fuses multi-source data for dynamic fatigue life prediction. The framework’s core is an improved Extended Hyper-Heuristic Neural Network (EHH-NN), which incorporates regularization optimization, a split node structure, and ANOVA-based function decomposition to model complex stress responses under limited training data. The improved model achieves a goodness of ﬁt (R2) of 0.942 and a mean relative error of 4.4\%, outperforming standard BP and LSTM models while maintaining a prediction time of 42 ms. A closed-loop correction mechanism driven by measured stress feedback is designed to dynamically adjust model outputs, and a prototype system integrating PLC-based data acquisition with Unity3D 2022.3 visualization is developed to demonstrate engineering applicability.},
	language = {en},
	author = {Zhu, Ze and Han, Yujin and Zhu, Feng and Sun, Jie and Chen, Keming and Yan, Yushuang and Zhao, Yadong},
	file = {Zhu_2026_ResearchonStruc_3e894:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Zhu_2026_ResearchonStruc_3e894.pdf:application/pdf},
}

@article{xiang_digital_2026,
	title = {Digital twin-driven key events and product quality prediction for time-varying manufacturing system},
	abstract = {Real-time monitoring and precise quality prediction in modern manufacturing face severe challenges due to the dynamic time-varying characteristics of production systems. To address the limitations of traditional methods in adapting to these characteristics and the disjointedness between event identi,cation and quality prediction, a collaborative prediction framework based on a Time-Varying Digital Twin System (TV-DTS) is proposed. First, a key event identi,cation method that fuses temporal reconstruction deviations with multi-dimensional dynamic statistical features is designed to simultaneously capture global dynamic pattern deviations and local 4uctuations during system operation. Second, by combining rule-based reasoning with mutual information analysis, an eventscenario matching mechanism is established to achieve an effective association between key events and production scenario semantics. Finally, event information and scenario semantics were incorporated into a quality prediction model to form an event-scenario fusion-driven quality prediction approach. A case study on the tobacco loosening and conditioning process demonstrated that the proposed framework effectively distinguished complex anomaly patterns, improved the accuracy of key event identi,cation, and signi,cantly reduced quality prediction errors, indicating its potential applicability for continuous manufacturing processes with similar timevarying characteristics.},
	language = {en},
	author = {Xiang, Feng},
	year = {2026},
	file = {Xiang_2026_Digitaltwindriv_e41d3:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Xiang_2026_Digitaltwindriv_e41d3.pdf:application/pdf},
}

@article{deng_real-time_2026,
	title = {Real-time capable deep learning framework for stable long-term forecasting of solids holdup in fluidized beds},
	volume = {473},
	issn = {00325910},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0032591026001233},
	doi = {10.1016/j.powtec.2026.122234},
	abstract = {Digital twin technology for gas-solid uidized beds is urgently needed for the upgrading of chemical industries, prompting the development of various deep learning-based approaches aimed at achieving accurate, real-time, and long-term simulations of chemical processes. However, existing models often face challenges of error accumulation in delivering accurate long-term and real-time recursive predictions. To address the issue, we propose a lightweight deep learning framework based on the U-Net architecture integrated with a Dynamic Distortion Monitoring and Replacement (DDMR) module. The lightweight U-Net serves as the core spatiotemporal forecasting backbone, capturing the characteristics of gas-solid ows to generate initial physical 6elds. The DDMR module monitors distorted outputs and replaces them with samples from the historical training set's data selected based on pressure drop similarity, effectively mitigating error accumulation. The proposed framework maintains stable, distortion-free predictions over 2000 consecutive time steps, achieves real-time inference (inference time is 62–93\% of physical time), and exhibits robust generalization (the relative error of bed expansion ratio {\textless} 4\%; structural similarity for time-averaged solids holdup 6elds {\textgreater}0.9). These 6ndings demonstrate the potential of the proposed framework in facilitating long-term real-time monitoring and control of industrial uidized bed systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Powder Technology},
	author = {Deng, Song and He, Xieyu and Chen, Xiao and Zhou, Qiang},
