@article{guerrero_ramirez_calibrated_2026,
	title = {A calibrated white-box digital twin for predictive blind control: {A} passive strategy to balance solar-driven thermal loads mitigation and daylight availability},
	volume = {367},
	issn = {03787788},
	shorttitle = {A calibrated white-box digital twin for predictive blind control},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0378778826008595},
	doi = {10.1016/j.enbuild.2026.117799},
	abstract = {The intensiﬁcation of heatwaves is increasing the vulnerability of buildings lacking dedicated cooling systems, particularly in educational environments where daylight must also be considered. This study presents a proofof-concept evaluation of a digital twin (DT) under controlled conditions for predictive blind control as a passive strategy to modulate solar-driven thermal loads while incorporating an indicative daylighting screening constraint. Building on a previously validated winter-oriented framework, the DT integrates a calibrated white-box Building Energy Model (BEM), real-time indoor monitoring, weather forecasts, and a rule-based multi-criteria selection routine capable of evaluating hundreds of hourly shading conﬁgurations per room. A novel modelling approach represents each blind as modular shading elements, enabling partial coverage and individualised actuation beyond the capabilities of standard EnergyPlus shading objects. The BEM was calibrated using an envelopedominant approach based on free-oscillation periods and NSGA-II, achieving CIBSE-compliant accuracy across the analysed thermal zones. During 14 valid implementation periods, the DT generated hourly schedules by evaluating up to 256 conﬁgurations per room and selecting those that minimise net window heat transfer subject to an indicative daylighting screening constraint. Given the discrete structure of the problem, the hierarchical decision process relies on exhaustive enumeration of the feasible conﬁgurations combined with rule-based multi-criteria decision logic, identifying the best-performing conﬁguration within the adopted reduced discrete set without the computational burden of classical optimisation solvers. Results show that the best-performing strategy within the discrete set reduced net window heat transfer by 49–68\% relative to an always-open conﬁguration, indicating a lower ideal loads cooling demand potential. Performance was strongly inﬂuenced by façade orientation and solar conditions, resulting in distinct control responses across the analysed rooms. As the case-study building was not actively cooled, the results reﬂect thermal demand reduction potential rather than measured energy savings. Validation against measured indoor temperatures conﬁrms the predictive consistency of the calibrated model during operation. Limitations include uncertainty in simulated illuminance due to EnergyPlus sky model assumptions and the absence of active cooling, which restricts the assessment to thermal demand rather than cooling energy use. Nevertheless, the ﬁndings demonstrate the methodological feasibility of lightweight, simulation-assisted DT control for passive cooling management under controlled conditions.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Energy and Buildings},
	author = {Guerrero Ramírez, Karla and Nuevo-Gallardo, Cristina and Santamaría Ulecia, Jesús Miguel and Montalbán Pozas, Beatriz and Fernández Bandera, Carlos},
	month = sep,
	year = {2026},
	pages = {117799},
	file = {GuerreroRamrez_2026_Acalibratedwhit_0e5c5:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\GuerreroRamrez_2026_Acalibratedwhit_0e5c5.pdf:application/pdf},
}

@article{zhu_integrated_2026,
	title = {Integrated {Multi}-{Mode} {Image}-{Based} {Corrosion} {Assessment} and {Probabilistic} {Reliability} {Framework} for {Steel} {Tower} {Structures} {Under} {Uncertainty}},
	volume = {16},
	issn = {2075-5309},
	url = {https://www.mdpi.com/2075-5309/16/11/2250},
	doi = {10.3390/buildings16112250},
	abstract = {Corrosion-driven section loss in steel tower structures erodes load-carrying capacity, yet ﬁeld assessment still relies on subjective visual grading. This paper presents a closed-loop framework coupling quantitative image-based corrosion measurement with stochastic degradation modeling, Monte Carlo reliability simulation, and Sobol’ variance-based global sensitivity decomposition. Two complementary segmentation paths—hue–saturation–value (HSV) color-space thresholding for ﬂeet-scale screening and DeepLabV3+ deep learning for detailed evaluation—convert imagery into calibrated section-loss estimates via nonlinear regression. Three analysis modes (single-image, multi-angle weighted-median fusion, and Oriented FAST and Rotated BRIEF (ORB) feature-matched temporal differencing) feed a Bayesian-updated power-law corrosion growth model whose outputs propagate through a time-dependent limit-state function via 106-sample Monte Carlo simulation. Sobol’ indices rank each uncertain input’s contribution to the reliability-index variance. A ﬁeld demonstration on a 40-year-old galvanized lattice tower in an ISO 9223 C4 coastal environment shows that the corrosion rate constant and zinc coating thickness together govern 65\% of the total reliability variance and that a risk-ranked selective maintenance strategy reduces expected life-cycle cost by 71\% relative to blanket intervention.},
	language = {en},
	number = {11},
	urldate = {2026-07-23},
	journal = {Buildings},
	author = {Zhu, Hao and Ying, Chunli and Chen, Yulong and Chen, Jun and Han, Daguang},
	month = jun,
	year = {2026},
	pages = {2250},
	file = {Zhu_2026_IntegratedMulti_66a57:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Zhu_2026_IntegratedMulti_66a57.pdf:application/pdf},
