@article{laperle_digital_2026,
	title = {Digital twin of a pipe conveying fluid: {Flow} rate anomaly detection and quantification via multi-fidelity {Kalman} filters and event based cameras signals},
	volume = {248},
	issn = {08883270},
	shorttitle = {Digital twin of a pipe conveying fluid},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0888327026001846},
	doi = {10.1016/j.ymssp.2026.114027},
	abstract = {This work is motivated by the need for scalable Digital Twins (DT) for hydro turbines. We propose a DT framework using Bayesian algorithms embedded with machine learning techniques to study a simplified pipe conveying fluid (PCF) system. The Unscented Kalman Filter (UKF) is employed for parameter identification by estimating the unknown flow rate that excites the pipe by leveraging the known nonlinear dynamical equations. Experimental validation using event-based camera data and a 3D reconstruction algorithm demonstrates the effectiveness of the UKF, estimating the flow rate with an average estimation error of 6\%. To enhance scalability and enable real-time anomaly detection, a Linear Kalman Filter (LKF) is coupled with Dynamic Mode Decomposition (DMD). DMD is trained on the states estimated by the UKF, providing physical insight to the data-driven model order reduction method. This embedded LKF-DMD approach reduces the complexity of the model and accelerates the computation by three orders of magnitude, from 12 s to 10−3 s per iteration. When the flow velocity changes, anomaly detection is performed by applying a steepest-ascent hill climbing method which quantifies the change in entropy of the distribution of the Euclidean distance between the trained DMD modal phase diagram and the LKF estimates. The integration of the UKF for system identification, and the accelerated LKF-DMD for state estimation and anomaly detection within a unified DT framework, which have been validated using the lab-scale PCF setup, highlights the potential of these techniques to develop scalable and predictive maintenance tools for engineering systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Mechanical Systems and Signal Processing},
	author = {Laperle, Vincent and Ghorbani, Esmaeil and Dollon, Quentin and Gosselin, Frédérick P.},
	month = mar,
	year = {2026},
	pages = {114027},
	file = {Laperle_2026_Digitaltwinofap_86a3b:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Laperle_2026_Digitaltwinofap_86a3b.pdf:application/pdf},
}

@inproceedings{chathankandath_transfer_2026,
	address = {Coimbatore, India},
	title = {Transfer {Learning} for {Predictive} {Maintenance} in {E}-{Mobility} {Using} {IoT} and {Digital} {Twins}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-4596-3},
	url = {https://ieeexplore.ieee.org/document/11447972/},
	doi = {10.1109/ICISCoIS62701.2026.11447972},
	abstract = {As electric vehicles (EVs) are becoming more popular, intelligent, data-driven maintenance is essential. Smart maintenance is the only way to guarantee a longer lifespan, reliability, and safety. A concept for e-mobility system maintenance prediction is the first thing that comes to mind in this paper. The focus is primarily on the three subsystems: heating, ventilation, and air conditioning (HVAC), thermal management, and lithium-ion battery condition. The design involves digital twin technologies and transfer learning. These techniques, which are able to achieve accurate remaining useful life (RUL) estimation and early fault detection even in the case of limited labeled data, are combined. Real-time sensor data is used together with pretrained models to allow learning to be carried out across different EV configurations. As a result, the system becomes more generalizable and flexible. The Internet of Things (IoT)-based setup is responsible for the continuous monitoring of the plant. Simultaneously, the digital twins are leveraged to track and predict battery, thermal, and HVAC system conditions. The foremost methods are deep learning, model predictive control (MPC), and adaptive thermal diagnostics. Moreover, the system is designed for the cloud and can be scaled up or down. Transfer learning is used to lessen the differences between the various domains. System intelligence is also improved with digital twins-based cyber-physical synchronization. All these enhance the reliability and efficiency of future EV maintenance systems.},
	language = {en},
	urldate = {2026-07-23},
