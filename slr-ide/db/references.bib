@article{chehrehzad_tool_2024,
	title = {Tool wear prediction through {AI}-assisted digital shadow using industrial edge device},
	volume = {113},
	issn = {15266125},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1526612524000719},
	doi = {10.1016/j.jmapro.2024.01.052},
	abstract = {Flank wear of drilling tools in manufacturing is among the main factors affecting product quality and productivity. In this study, an AI-assisted digital shadow was created for the instant prediction of the drilling /ank tool wear. The drilling data were collected simultaneously using an industrial edge device and a rotary dynamometer. Feature engineering was conducted on the collected data from devices in time and frequency domains. A recurrent neural network (RNN) based on bidirectional long short-term memory (Bi-LSTM) and bidirectional gated recurrent unit (Bi-GRU) architectures was implemented on speci2ed tool wear regions dataset. The digital shadow was created using the industrial edge device and the predictive AI model to minimize costs by reducing the need for expensive multi-sensors, manufacturing downtime, and tool underuse or overuse in a smart manufacturing system. The proposed model predicts with high accuracy and computational time ef2ciency and can be integrated into digital twin systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Journal of Manufacturing Processes},
	author = {Chehrehzad, Mohammadreza and Kecibas, Gamze and Besirova, Cemile and Uresin, Ugur and Irican, Mumin and Lazoglu, Ismail},
