@article{singh_proof--concept_2025,
	title = {A proof-of-concept study towards developing digital twins for operational excellence in large-scale water distribution networks},
	volume = {22},
	issn = {1573-062X, 1744-9006},
	url = {https://www.tandfonline.com/doi/full/10.1080/1573062X.2025.2480632},
	doi = {10.1080/1573062X.2025.2480632},
	abstract = {In the current face of water scarcity, water losses due to leakages in large-scale water distribution networks (WDN) and non-revenue water are challenging factors. In this direction, Digital Twins integrate concepts like IoT, ML (machine learning), and DL (deep learning) with a water pave path for smart urban water infrastructure. Herein, we propose a holistic digital twin systems framework and its application in leak detection, validated with ﬁeld-data on Indian Institute of Technology Jodhpur (IIT-J) campus WDN. A detailed methodology developing monitoring digital twins supported on the python platform and using open-source WDN simulators; EPANET and WNTR for hydraulic simulations and a Graph-convolution Neural Network-based leak detection model is elucidated. Results are analysed and demonstrated for the highest water consumption zone of the campus, with the model giving an accuracy of 90\% for leakage detection. Further, a test scenario is described where the proposed framework shows water savings of up to 58\% which would have been otherwise lost due to leaks in WDN.},
	language = {en},
	number = {5},
	urldate = {2026-07-23},
	journal = {Urban Water Journal},
	author = {Singh, Anushka and Singh, Shobhana and Maheshwari, Abhilasha},
	month = may,
	year = {2025},
	pages = {507--525},
	file = {Singh_2025_Aproofofconcept_aaeee:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Singh_2025_Aproofofconcept_aaeee.pdf:application/pdf},
}

@inproceedings{ali_digital_2025,
	address = {Worcester, MA, USA},
	title = {Digital {Twin} {Synchronization}: {Bridging} the {Sim}-{RL} {Agent} to a {Real}-{Time} {Robotic} {Additive} {Manufacturing} {Control}},
