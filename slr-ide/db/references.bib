	title = {Detection of {Cyber} {Attack} in a {Digital} {Twin}-{Enabled} {Grid}-{Connected} {Microgrid}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-7640-0},
	url = {https://ieeexplore.ieee.org/document/11401813/},
	doi = {10.1109/ETFG61999.2025.11401813},
	abstract = {Modern microgrids (MGs) face growing cyber threats, notably false data injection attacks (FDIAs) on inverter set points that disrupt grid stability. Conventional voltage- and current-based detection methods often yield high false positives due to the similarities of impacts of FDIA with overload or PV fault signatures. This paper proposes a digital twin (DT)enhanced detection framework to address this limitation. The DT serves as a high-ﬁdelity replica of the MG, capable of forecasting load demand and generation, thereby providing the classiﬁers with additional features that encapsulate fault conditions and load uncertainty. Furthermore, comparative analysis demonstrates that incorporating DT-generated insights signiﬁcantly improves the performance of various machine learning and deep learning based classiﬁers. The results highlight the DT’s potential to enhance resilience against cyber-attacks in MGs.},
	language = {en},
