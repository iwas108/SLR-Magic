@article{li_iot-based_2024,
	title = {{IoT}-based framework for digital twins in steel production: {A} case study of key parameter prediction and optimization for {CSR}},
	volume = {250},
	issn = {09574174},
	shorttitle = {{IoT}-based framework for digital twins in steel production},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0957417424007759},
	doi = {10.1016/j.eswa.2024.123909},
	abstract = {Cold-rolled strips are a pivotal product of advanced strip rolling technology in iron and steel production with stringent process standards. Over an extended period, the existence of ’information silos’ between cold strip rolling (CSR) and its upstream processes, particularly hot strip rolling (HSR), causes a persistent challenge in achieving collaborative optimization throughout the entire process, thereby constraining progress in product quality. To overcome this challenge, a digital twin framework was proposed to consolidate diverse data from HSR and CSR production lines into a centralized data centre, forming a ’data continent.’ This approach establishes a comprehensive dataset for model-driven training and prediction in virtual space. An improved Light gradient boosting machine (IlightGBM) is introduced, enabling high-precision rolling force prediction in unsteady-state rolling and providing essential variables for establishing the tension optimization objective function. A control function is implemented to minimize rolling force 9uctuations, and three population algorithms (TPA) are devised for its solution. This strategy successfully realizes collaborative tension optimization across multiple stands, with the rolling speed acting as a follower. The proposed approach was implemented in a large-scale steel plant equipped with a complete HSR and CSR production line, effectively mitigating 9atness defects and thickness deviation in the strip’s head section. Thus, the proposed framework is reliable and can be 9exibly applied to strip manufacturing processes.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Expert Systems with Applications},
	author = {Li, Jingdong and Wang, Xiaochen and Yang, Quan and Sun, Youzhao and Zhao, Jianwei and Mao, Xing and Qie, Haotang},
	month = sep,
	year = {2024},
	pages = {123909},
	file = {Li_2024_IoTbasedframewo_edb2f:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Li_2024_IoTbasedframewo_edb2f.pdf:application/pdf},
}

@article{siatras_production_2024,
	title = {Production {Scheduling} {Based} on a {Multi}-{Agent} {System} and {Digital} {Twin}: {A} {Bicycle} {Industry} {Case}},
	volume = {15},
	issn = {2078-2489},
	shorttitle = {Production {Scheduling} {Based} on a {Multi}-{Agent} {System} and {Digital} {Twin}},
	url = {https://www.mdpi.com/2078-2489/15/6/337},
	doi = {10.3390/info15060337},
	abstract = {The emerging digitalization in today’s industrial environments allows manufacturers to store online knowledge about production and use it to make better informed management decisions. This paper proposes a multi-agent framework enhanced with digital twin (DT) for production scheduling and optimization. Decentralized scheduling agents interact to efﬁciently manage the work allocation in different segments of production. A DT is used to evaluate the performance of different scheduling decisions and to avoid potential risks and bottlenecks. Production managers can supervise the system’s decision-making processes and manually regulate them online. The multi-agent system (MAS) uses asset administration shells (AASs) for data modelling and communication, enabling interoperability and scalability. The framework was deployed and tested in an industrial pilot coming from the bicycle production industry, optimizing and controlling the short-term production schedule of the different departments. The evaluation resulted in a higher production rate, thus achieving higher production volume in a shorter time span. Managers were also able to coordinate schedules from different departments in a dynamic way and achieve early bottleneck detection.},
	language = {en},
	number = {6},
	urldate = {2026-07-23},
	journal = {Information},
	author = {Siatras, Vasilis and Bakopoulos, Emmanouil and Mavrothalassitis, Panagiotis and Nikolakis, Nikolaos and Alexopoulos, Kosmas},
	month = jun,
	year = {2024},
	pages = {337},
	file = {Siatras_2024_ProductionSched_a37d2:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Siatras_2024_ProductionSched_a37d2.pdf:application/pdf},
}

@article{chen_adaptive_2025,
	title = {Adaptive physically consistent neural networks for data center thermal dynamics modeling},
	volume = {377},
	issn = {03062619},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0306261924020208},
	doi = {10.1016/j.apenergy.2024.124637},
	abstract = {Data centers (DCs) are vital for large-scale Internet services, yet their energy consumption poses a signi\%cant concern. Energy modeling for DCs is crucial for design, control, and retro\%tting. Traditional physic-based models lack )exibility, while Neural Networks (NN) may not strictly adhere to physical principles and demand extensive data. The Physically Consistent Neural Networks (PCNN) framework, which incorporates physical laws into NN through positive coef\%cients, is introduced. Despite its innovative approach, PCNN struggles with accuracy and generalization in real-world thermal environments due to its reliance on empirically predetermined, static coef\%cients, which are costly to derive and limit adaptability to dynamic conditions. To address these limitations, this study proposes the Adaptive Physically Consistent Neural Networks (A-PCNN) framework. A-PCNN leverages NN with Softplus activation functions, replacing traditional preset and \%xed coef\%cients to reduce trial-and-error costs and increase )exibility. Over a six-month real data center dataset case study, the A-PCNN framework signi\%cantly outperformed the traditional PCNN model. Speci\%cally, it reduced the Mean Absolute Error by 17.3 \% for a 15-min forecast and by 79.2 \% over a seven-day period, using a Multilayer Perceptron (MLP) as the base model. Furthermore, the A-PCNN framework demonstrates remarkable adaptability. Whether based on a MLP or Long Short-Term Memory (LSTM) model, it consistently surpasses traditional methods in predictive accuracy across time frames from 15 min to 7 days. Its superior performance is especially notable in longer forecast periods.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Applied Energy},
	author = {Chen, Dong and Chui, Chee-Kong and Lee, Poh Seng},
	month = jan,
	year = {2025},
	pages = {124637},
	file = {Chen_2025_Adaptivephysica_10bc5:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Chen_2025_Adaptivephysica_10bc5.pdf:application/pdf},
}

