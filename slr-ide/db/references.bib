	pages = {101935},
	file = {PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\4R5FPZJD\\Ojo et al. - 2026 - A crop digital twin system for predictive growth monitoring and adaptive light control in controlled.pdf:application/pdf},
}

@article{khlifi_edge-intelligent_2026,
	title = {Edge-{Intelligent} {IoT} {Cyber}-{Physical} {Architecture} for {Secure} {BLDC} {UAV} {Propulsion} with {Digital} {Twin} and {Real}-{Time} {OTA} {Control}},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {2327-4662, 2372-2541},
	url = {https://ieeexplore.ieee.org/document/11614825/},
	doi = {10.1109/JIOT.2026.3715434},
	abstract = {The Internet of Things (IoT) is transforming autonomous aerial vehicle operations by enabling real-time fleet coordination, predictive maintenance, and remote monitoring. This paper presents a unified edge-integrated, IoT-ready sensorless control framework for brushless DC (BLDC) motors, transforming the propulsion drive into a secure, connected IoT edge node. The architecture features a hybrid observer combining high-frequency square-wave injection (HFSWI) for zero-speed operation with a digital twin-enhanced adaptive extended Kalman filter (AEKF) for real-time parameter identification. A minimumorder observer reconstructs three-phase currents from a single DC-link sensor, reducing hardware complexity while supporting deterministic field-oriented control (FOC). MQTT-based cloud connectivity enables secure telemetry streaming, fleet management, and over-the-air (OTA) updates with end-to-end latency {\textless}50 ms. Implemented on an STM32H743 + ESP32-S3 platform at 40 kHz PWM, the system demonstrates seamless 0–22,000 RPM operation, rotor position error {\textless}4∞ electrical, parameter tracking under 65∞C temperature variation, end-to-end IoT latency {\textless}50 ms, and predictive maintenance detection 20+ hours before failure. Experimental results confirm that real-time motor control, cloud connectivity, and OTA management can coexist without violating deterministic timing constraints, establishing a foundation for scalable, secure, and intelligent UAV propulsion systems within connected IoT ecosystems.},
	language = {en},
	urldate = {2026-08-13},
	journal = {IEEE Internet of Things Journal},
	author = {Khlifi, Mohamed Arbi and Slimene, Marwa Ben},
	year = {2026},
	pages = {1--1},
	file = {PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\466492GB\\Khlifi and Slimene - 2026 - Edge-Intelligent IoT Cyber-Physical Architecture for Secure BLDC UAV Propulsion with Digital Twin an.pdf:application/pdf},
}

@article{sharida_digital-twin-based_2023,
	title = {Digital-{Twin}-{Based} {Diagnosis} and {Tolerant} {Control} of {T}-{Type} {Three}-{Level} {Rectifiers}},
	volume = {4},
	copyright = {https://creativecommons.org/licenses/by/4.0/legalcode},
	issn = {2644-1284},
	url = {https://ieeexplore.ieee.org/document/10167800/},
	doi = {10.1109/OJIES.2023.3290169},
	abstract = {This article proposes a digital twin (DT)-based diagnosis and fault-tolerant control for T-type three-level rectiﬁers. To develop the DT, a dense deep neural network (DNN) machine learning approach is used. The DT is trained ofﬂine using a set of experimental data and updated online to get the maximum possible accuracy. Then, the DT is used for the diagnosis and tolerance of open-switch faults (OSFs) and faults related to voltage and current sensors or for sensorless control. The OSF detection and localization algorithm is implemented based on the dynamic response difference between the physical system and its DT. First, the OSF is detected and localized based on the grid current dynamics, where each switch fault generates a speciﬁc pattern in the current dynamics. OSF is tolerated by changing the switching function based on the location of the fault. Second, the voltage and current sensor fault is detected when the DT provides a speciﬁc amplitude of currents while the physical sensors do not provide a correct measurement. This case is tolerated by feeding back the grid currents or voltages from the DT as an alternative to the physical sensors. The proposed technique has low overhead, enhances the reliability of the power converter, and is applicable for sensorless mode of control. Experimental investigations are conducted to validate the proposed concept.},
	language = {en},
	urldate = {2026-08-13},
	journal = {IEEE Open Journal of the Industrial Electronics Society},
	author = {Sharida, Ali and Kamal, Naheel Faisal and Alnuweiri, Hussein and Bayhan, Sertac and Abu-Rub, Haitham},
	year = {2023},
	pages = {230--241},
	file = {PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\7DTE9PJW\\Sharida et al. - 2023 - Digital-Twin-Based Diagnosis and Tolerant Control of T-Type Three-Level Rectifiers.pdf:application/pdf},
}

