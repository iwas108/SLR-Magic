	isbn = {979-8-3315-6752-1},
	url = {https://ieeexplore.ieee.org/document/11238386/},
	doi = {10.1109/ECCE-Europe62795.2025.11238386},
	abstract = {Accurately assessing the degradation state of power semiconductor devices is crucial to enable predictive maintenance. Estimating this degradation state is possible by having a digital twin of the device which is subjected to similar stresses or by using models based on data gathered during accelerated lifetime tests. In this paper the state of health of the module is estimated by gathering temperature and degradation sensitive electrical parameter data over the lifetime of SiC power MOSFETs during a static active power cycling test. For the estimation of the degradation state machine learning models based on different architectures are compared. For those architectures, time series data and features are extracted and models are trained on the respective datasets. For each architecture the sensitivity of the error metrics to the parameter with the most inﬂuence on model complexity is examined. The best model achieves a R2 value higher than 99\%, whilst the worst model achieves 85\%. Additionally, the applicability of the degradation models to real world applications is evaluated.},
