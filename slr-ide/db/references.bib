@inproceedings{reddy_explainable_2026,
	address = {Ottapalam, India},
	title = {Explainable {Datadriven} {Digital} {Twins} for {Predicting} {Battery} {States} in {Electric} {Vehicles} {Using} {Deep} {Learning} {Models}},
