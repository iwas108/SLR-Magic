@article{andruccioli_toward_2026,
	title = {Toward data-driven {Digital} {Twins} for regional transportation networks: {A} scalable traffic forecasting study},
	volume = {185},
	issn = {0167739X},
	shorttitle = {Toward data-driven {Digital} {Twins} for regional transportation networks},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0167739X26003237},
	doi = {10.1016/j.future.2026.108689},
	abstract = {Traffic flow forecasting is a key analytical capability for data-driven Digital Twins (DTs) of transportation infrastructures, enabling predictive monitoring and proactive decision support. This study investigates deployable traffic forecasting for a regional road network using a two-year dataset collected from 255 monitoring stations. Two complementary forecasting settings are considered: network-level forecasting, where traffic demand is aggregated across the monitored infrastructure, and station-level forecasting, where local traffic dynamics are predicted for individual sensors. A unified experimental pipeline is used to evaluate statistical baselines, Machine Learning (ML) models, recurrent neural networks, ensemble methods, and a spatio-temporal graph convolutional network across multiple temporal resolutions. The evaluation considers not only predictive accuracy, but also training time, inference time, and serialized model footprint, reflecting practical constraints of edge, fog, and cloud DT architectures. Results show that ensemble methods provide robust performance for network-level and coarse-resolution forecasting, while graph-based neural modeling is particularly effective for fine-grained station-level prediction. The analysis also highlights the importance of look-back window selection, which explains a substantial share of the performance gains and often has a stronger impact than subsequent hyperparameter optimization. Overall, the findings provide practical guidance for designing scalable forecasting modules within DT-ready transportation systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Future Generation Computer Systems},
	author = {Andruccioli, Manuel and Delnevo, Giovanni and Mirri, Silvia and Salomoni, Paola},
