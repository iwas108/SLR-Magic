}

@inproceedings{bc_battery_2025,
	address = {Bangalore, India},
	title = {Battery {Health} {Management} {Based} on {Digital} {Twin} {Technology}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9773-3},
	url = {https://ieeexplore.ieee.org/document/11337264/},
	doi = {10.1109/CISCON66933.2025.11337264},
	abstract = {This paper presents an IoT-enabled battery health management system that integrates real-time multi-parameter monitoring (voltage, current, temperature) with cloud analytics for DC motor applications. The system employs a Raspberry Pi microcontroller with precision sensors (0.5\% accurate voltage measurement, ±1.2\% current sensing) sampling at 10Hz, achieving 93.7\% measurement accuracy and 380ms response time for fault protection through threshold-based algorithms. Dynamic load conditions are simulated using PWM-controlled DC motors while integrated safety mechanisms (30A relays, active cooling) autonomously maintain optimal operating parameters. Data transmission via MQTT protocol to ThingSpeak cloud enables remote monitoring and MATLAB-based analytics. Experimental validation over 200 operational hours demonstrates the system's effectiveness in preventing overvoltage incidents and maintaining temperature within ±2∞C of target range, while extending battery lifespan by 28\% compared to conventional methods. Key innovations include a hybrid state-of-charge estimation method with {\textless}3.5\% error, adaptive sampling reducing cloud data usage by 40\%, and predictive fault detection with 98.3\% accuracy. The cost-effective ({\textless}\$50 BOM) solution offers significant potential for industrial and electric vehicle applications, with future enhancements planned for machine learningbased degradation pattern recognition and blockchain-secured data transmission.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 {Control} {Instrumentation} {System} {Conference} ({CISCON})},
