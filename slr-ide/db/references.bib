@article{sang_dynamic_2026,
	title = {A dynamic data driven application system for ocean environment prediction using reduced-order modeling and adaptive glider sensing networks},
	volume = {353},
	issn = {00298018},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0029801826006463},
	doi = {10.1016/j.oceaneng.2026.124812},
	abstract = {This paper presents a novel Dynamic Data-Driven Application System (DDDAS) framework for real-time prediction of regional three-dimensional ocean environments, informed by observations from autonomous underwater glider networks. The proposed framework integrates data-driven ocean modeling, sparse-aware data assimilation, and intelligent sensing optimization to enable adaptive and accurate environmental forecasting. A hybrid reduced-order modeling approach is developed by combining multiresolution Dynamic Mode Decomposition with Gaussian Process Regression, effectively capturing dominant spatiotemporal ocean dynamics while compensating for model residuals. To assimilate sparse, noisy, and non-grid glider observations, a Kriged Ensemble Kalman Filter with Group Lasso regularization framework is proposed, enhancing assimilation accuracy and computational ef5ciency through modal sparsity. Furthermore, Deep Reinforcement Learning is employed to optimize glider placements based on information gain, while a task assignment strategy incorporating 6ow-aware path planning is proposed to enable dynamic and optimal recon5guration of the glider network. The proposed DDDAS framework was evaluated through both numerical simulations and real-world glider datasets, demonstrating its performance and validating its capabilities. The proposed DDDAS establishes a solid foundation for developing intelligent ocean digital twins and real-time adaptive cyber-physical monitoring systems.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Ocean Engineering},
	author = {Sang, Qiming and Tian, Yu and Yu, Jiancheng and Zhang, Fumin},
