@inproceedings{m_integrating_2026,
	address = {Virudhunagar, India},
	title = {Integrating {AI}, {Digital} {Twins} and {Smart} {Deterrence} {Technologies} to {Mitigate} {Wildlife} and {Livestock} {Intrusion} on {Railway} {Networks}},
	copyright = {https://doi.org/10.15223/policy-029},
