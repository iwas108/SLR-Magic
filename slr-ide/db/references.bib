@inproceedings{venkateswarlu_hybrid_2025,
    address = {Trichy, India},
    title = {Hybrid {Deep} {Learning} {Model} for {Fault} {Diagnosis} in {Smart} {Manufacturing} using {Edge} {AI} and {Digital} {Twin} {Integration}},
