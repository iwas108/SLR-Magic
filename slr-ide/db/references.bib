@inproceedings{regula_ai-iot-based_2025,
	address = {Denpasar, Bali, Indonesia},
	title = {{AI}-{IoT}-{Based} {Federated} {Edge} and {Digital} {Twin} {Framework} for {Real}-{Time} {Climate}-{Resilient} {Hazard} {Forecasting}},
	copyright = {https://doi.org/10.15223/policy-029},
