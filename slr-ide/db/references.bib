@inproceedings{shi_ai-driven_2025,
	address = {Shenyang, China},
	title = {{AI}-{Driven} {Fault} {Diagnosis} and {Health} {Management} for {Power} {Equipment} {Using} a {Hybrid} {Deep} {Learning} {Framework}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9711-5},
	url = {https://ieeexplore.ieee.org/document/11379153/},
	doi = {10.1109/ICCSIE67394.2025.11379153},
	abstract = {The growing complexity of modern power systems necessitates intelligent and automated solutions for fault diagnosis and health management (FDHM) of critical power equipment. This paper proposes a novel AI-driven framework that integrates multi-modal sensor data, deep learning models, and digital twin technology to achieve accurate fault detection, health assessment, and remaining useful life (RUL) prediction. The proposed system employs a hybrid CNN-LSTM architecture for spatiotemporal feature extraction, an improved particle swarm optimization (IPSO) algorithm for model tuning, and a physics-informed digital twin for simulation and prediction. Validated on real-world datasets from 500 kV transformers and GIS switchgear, the system achieves 98.7\% fault classification accuracy, 95.3\% RUL prediction precision, and reduces false alarms by 87\%. The framework enables proactive maintenance and is estimated to save up to \$2.3 million annually per substation.},
