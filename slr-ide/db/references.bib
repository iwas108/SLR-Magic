}

@article{al-hamzawi_machine_2025,
	title = {Machine learning-enhanced optimization of exhaust gas recirculation strategies for superior diesel engine performance and emissions control: {A} synergistic experimental and computational study},
	volume = {169},
	issn = {03603199},
	shorttitle = {Machine learning-enhanced optimization of exhaust gas recirculation strategies for superior diesel engine performance and emissions control},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0360319925041862},
	doi = {10.1016/j.ijhydene.2025.151184},
	abstract = {This study presents a pioneering approach to optimizing diesel engine exhaust gas recirculation (EGR) strategies through a hybrid physics-informed machine learning (ML) framework, integrating experimental data with computational modeling to enhance performance and emissions control. This study introduces a novel hybrid physics-informed machine learning (PIML) framework that integrates thermodynamic constraints with neural network and gradient boosting models, coupled with a real-time digital twin for adaptive EGR control, achieving superior performance-emission trade-offs compared to conventional static calibration methods. Utilizing a comprehensive dataset from 300 test cases conducted on a single-cylinder Kirloskar Variable Compression Ratio (VCR) diesel engine, operating at a constant 1500 rpm across six load levels (0–22.5 N m) and 1ve EGR rates (0–20 \%), we systematically evaluated key performance metrics including brake power (BP), brake thermal ef1ciency (BTE), brake speci1c fuel consumption (BSFC), and exhaust gas temperature (EGT), alongside emission pro1les (NOx, CO, HC, CO2, O2, and smoke opacity). Experimental results revealed a signi1cant NOx reduction of 60–70 \% at 15 \% EGR, albeit with trade-offs in increased CO and HC emissions due to incomplete combustion. Leveraging this data, our ML framework, constrained by empirical thermodynamic relationships, identi1ed optimal EGR ranges (10–12.5 \% at moderate loads) that minimize BSFC while maintaining acceptable NOx levels, achieving up to a 5 \% enhancement in BTE compared to static EGR con1gurations. The developed digital twin enables real-time EGR adjustments, offering a scalable solution for emission-critical diesel engines. These 1ndings, visualized through high-1delity predictive models and optimization maps, underscore the transformative potential of ML-driven strategies in decoupling performance emission trade-offs, paving the way for sustainable engine design in compliance with stringent global regulations.},
	language = {en},
	urldate = {2026-07-23},
	journal = {International Journal of Hydrogen Energy},
	author = {Al-Hamzawi, Hassan A.Hameed and Al Sailawi, Ali S.Abed and Homod, Raad Z. and Kadhim, Hamza Abdul Yemma and Mohammed, Hayder I. and Al-Shareeda, Mahmood A.},
	month = sep,
	year = {2025},
	pages = {151184},
