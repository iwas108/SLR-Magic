@article{wei_data-mechanism_2026,
	title = {Data-mechanism hybrid-driven digital twin for spatiotemporal prediction of multiple evolving risk in deep excavation},
	volume = {173},
	issn = {08867798},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S088677982600146X},
	doi = {10.1016/j.tust.2026.107588},
	abstract = {Given the prevalence of multi-source risks in deep excavation, accurately forecasting their joint spatiotemporal evolution is critical for safe and ef1cient project delivery. Existing data-driven methods often lack physical interpretability and have dif1culty capturing cross-risk interactions over space and time. To address these limitations, this study develops a data–mechanism hybrid digital twin framework that couples the physical excavation system with graph-based spatiotemporal prediction. The framework infers data–mechanism hybrid (DMH) features from 1eld monitoring data and organizes heterogeneous risk variables and their spatiotemporal dependencies into a uni1ed graph representation. Based on this representation, a Temporal Heterogeneous Graph Attention Network (THGAN) is developed as the digital twin model, where hierarchical attention enables relation-aware spatial aggregation and temporal dynamics modeling of nonlinear risk propagation. Validation on a deep excavation project in Shanghai shows that THGAN accurately predicts the spatiotemporal evolution of multi-source risks and reduces key prediction errors by more than 25\% compared with representative spatiotemporal baselines. Feature ablation further indicates that DMH features improve prediction accuracy and responsiveness in deformation-sensitive zones and support physically interpretable model updating. Overall, these results suggest that the proposed framework enables physically informed forecasting of multiple evolving risks for safety management in deep excavation.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Tunnelling and Underground Space Technology},
	author = {Wei, Jian and Pan, Yue and Zhen, Liang and Chen, Jin-Jian},
	month = jul,
