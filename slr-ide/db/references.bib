	doi = {10.1016/j.rineng.2025.107096},
	abstract = {Concentrating solar power (CSP) is a promising renewable energy source because of its potential contribution to power generation and fuel synthesis (among others). However, several constraints continue to limit the economic and environmental attractiveness of this technology. One of the most important issues to address is measuring receiver ef1ciency, yet current methods are disruptive, expensive and complex. To overcome this, the present work introduces a data-driven digital-twin model for solar ux density predictions in central receiver systems (solar power towers). It consists of a real-time data agent that integrates signals collected at a CSP plant into ux density prediction tools. This ux prediction is coupled with a self-correction module based on graph neural networks (attention-gated U-Net) designed to replace simulations’ mathematical with deep-learning algorithms trained on realistic ux density measurements. The outcome is a semi-autonomous cyber-physical model that achieves latencies below 30 s for common CSP operations and ux density characterization accuracies up to 95 \%, which makes it readily scalable, industrially applicable and more accurate than SOTA models. Its industrial relevance is boosted by a comprehensive training routine based on several heliostats’ superposed uxes at realistic conditions.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Results in Engineering},
	author = {Sergio, Diaz Alonso and Christian, Raeder and Bernhard, Hoffschmidt},
