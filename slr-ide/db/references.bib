	file = {Full Text PDF:C\:\\Users\\Aditya Suranata\\Zotero\\storage\\7SKYB3LU\\Bersani et al. - 2020 - Model Predictive Control of Smart Greenhouses as the Path towards Near Zero Energy Consumption.pdf:application/pdf},
}

