@inproceedings{samsher_digital_2026,
	address = {Bhubaneswar, India},
	title = {Digital {Twin}–{Driven} {Predictive} {Maintenance} {Using} a {Hybrid} {CNN}–{LSTM} {Framework} for {Intelligent} {IoT} {Systems}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-4949-7},
	url = {https://ieeexplore.ieee.org/document/11541534/},
	doi = {10.1109/ETAACT69135.2026.11541534},
	abstract = {The paper introduces the Digital Twin driven intelligent framework for predictive maintenance in Industrial Internet of Things (IIoT) environments as the increasing demand for proactive and data-driven asset management in-industry. Motivated by the drawback of using traditional reactive maintenance strategies, the general idea is to take advantage of a Digital Twin in order to virtually represent the physical equipment and allow its continuous monitoring and analysis. Multivariate IoT sensor data are used to record complex operational behavior and degradation patterns of industrial assets. In order to positively model these spatial--temporal characteristics, a hybrid CNN-LSTM deep learning architecture is implemented, in which convolutional layers capture discriminative spatial features and LSTMs learn temporal dependencies from the sequential sensor readings. The framework is stated as a predictive maintenance challenge, where it is intended to determine the maintenance-required conditions accurately before the failure takes place. Extensive experiments conducted on a real-world sensor maintenance data shows the robustness and effectiveness of the proposed approach. The model has high classification accuracy at 96\% which is higher than traditional machine learning methods and standalone deep learning models. The obtained results validate the suitability of the proposed Digital Twin - CNN - LSTM framework for intelligent, scalable and reliable maintenance in IIoT systems.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 1st {International} {Conference} on {Emerging} {Trends} in {Advancements} and {Applications} of {Computational} {Intelligence} {Techniques} ({ETAACT})},
