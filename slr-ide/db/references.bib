@article{tang_physics-informed_2026,
	title = {Physics-informed spatiotemporal architecture in digital twin modeling for condition monitoring of aircraft engines},
	volume = {69},
	issn = {14740346},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1474034625009322},
	doi = {10.1016/j.aei.2025.104039},
	abstract = {Condition monitoring is pivotal in ensuring the safety and reliability of aircraft engines. Digital twin (DT) technology builds an interactive bridge between digital and physical spaces, offering benefits in real-time condition monitoring and fault prognostics. This study proposes a novel physics-informed spatiotemporal modeling framework for aircraft engine DT, integrating domain-specific physical knowledge, transformerbased feature learning, and transfer learning. The architecture comprises two core components: (1) temporal feature encoders with causal attention mechanisms to capture component-specific operational patterns while preserving temporal causality, and (2) a spatial coupling module employing bidirectional attention to model inter-component interactions based on the engine’s physical topology. To improve computational efficiency, we further introduce a temporal-transfer paradigm that leverages pretrained temporal encoders to generate generalized temporal features, which are then fed into task-specific spatial modules for localized learning—reducing substantial computational costs without sacrificing accuracy. Validation on three operational datasets demonstrated that the proposed method achieves optimized mean absolute percentage errors (MAPE) of 0.5\%, 0.3\%, and 2\% for 𝐹 (thrust), 𝑃3 (total pressure at high-pressure compressor outlet), and 𝐸𝐺𝑇 (exhaust gas temperature) predictions, respectively, representing reductions of 43.9–79.8\%, 41.9–87.3\%, and 12.1–25.0\% compared with temporal-only, spatial-only attention and long short-term memory (LSTM)-based baselines. By integrating causal-temporal attention mechanisms and physics-guided spatial coupling, the proposed framework not only ensures high prediction precision but also reduces computational costs through temporal feature transfer. This dual capability addresses the critical requirements of high-fidelity simulation and real-time responsiveness for industrial DT deployments.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Advanced Engineering Informatics},
	author = {Tang, Ke and Xiao, Hong and Wang, Donghuan and Chen, Guo},
	month = jan,
