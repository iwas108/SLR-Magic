    month = nov,
    year = {2024},
    pages = {1--6},
}
@inproceedings{kamal_low-cost_2024,
    address = {Doha, Qatar},
    title = {Low-cost {Digital} {Twin} {Design} for {Power} {Electronics} using {Deep} {Neural} {Networks}},
    copyright = {https://doi.org/10.15223/policy-029},
