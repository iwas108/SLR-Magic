	isbn = {979-8-3315-9628-6},
	url = {https://ieeexplore.ieee.org/document/11337622/},
	doi = {10.1109/CARS67163.2025.11337622},
	abstract = {Pathﬁnding is essential for autonomous robots. Graph-based classical and machine learning approaches are often compared separately. This paper compares end-to-end pathﬁnding with Proximal Policy Optimization and an Alexnet architecture against Hybrid A*. A digital twin in Unity3D with the Clearpath Dingo robot is used for testing. PPO controls the robot using ROS-Noetic with a camera as its sensor. Hybrid A* and its controls are implemented in Unity3D. Path length, traversal time, training time, path calculation time, and storage space are evaluated. PPO had a 28.68\% success rate over 10,801 test runs. In successful runs, PPO produced paths averaging 13.91 meters with a standard deviation of ±0.22 meters, traversed in 34.32 seconds with a standard deviation of ±4.54 seconds. Hybrid A* produced a path averaging 13.36 meters, traversed in 22.69 seconds.},
