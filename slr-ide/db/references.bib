@inproceedings{m_edge_2025,
	address = {Jamshedpur, India},
	title = {Edge {Computing} for {Real}-{Time} {Process} {Optimisation} in {Factories}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-7436-9},
	url = {https://ieeexplore.ieee.org/document/11387556/},
	doi = {10.1109/GIEST66547.2025.11387556},
	abstract = {The real-time optimization of the processes in the factories is critical today to overcome the challenges of the highly-speed processes, the massive volume of sensor data sent to the IoT, and to achieve very low latency of the traditional cloud-based analytics that in the vast majority of the cases is the cause of the delay in the fault detection, of the inefficient production effectiveness and the rising downtimes. Mechanical and electrical anomalies, as well as software errors, require prompt solutions; however, current centralised developments do not guarantee that time-sensitive interventions are taken at decentralised production lines. The study proposes an Edge-Integrated Hybrid Digital Twin (EIHDT) solution to address these issues, which combines physics-based modelling of machines and processes via simulation with AI-based predictive analytics, etc., implemented on distributed edge nodes. The digital twin hybrid continuously mirrors the real-life processes, predicts the deviation, foresees the reduction of the equipment, and suggests the optimal behavior of control in real-time. This leads to the control policy implementation being a hybridized centralized-decentralized approach, where a central coordinator sets global goals, and localized decisions are made by edge nodes to achieve the goals without consultation among themselves. The federated learning FEDprox-based predictive models of heterogeneous edge devices are trained to minimize the model drift and to maintain constant the accuracy, adaptively combine models and 5G Time-Sensitive Networking (TSN) in the delivery of control commands to the edge nodes and the actuators with a low degree of latency and accuracy. The system continually observes and categorizes faults as critical, moderate, and minor in severity, initiating the relevant proportionate correction actions to ensure production continuity. On heterogeneous devices, EI-HDT has been demonstrated to improve process efficiency (top 85 percent and fault response latency (by approximately 3 orders of magnitude) and predictive accuracy (high) when simulated and on experiment data. Solution can be extended and scaled and improves industry productivity, fault tolerance and Industry 4.0 and efficient channel to real-time optimization and processes in the modern smart factory.},
	language = {en},
