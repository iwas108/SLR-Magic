@article{pawar_hybrid_2021,
	title = {Hybrid analysis and modeling for next generation of digital twins},
	volume = {2018},
	issn = {1742-6588, 1742-6596},
	url = {https://iopscience.iop.org/article/10.1088/1742-6596/2018/1/012031},
	doi = {10.1088/1742-6596/2018/1/012031},
	abstract = {The physics-based modeling has been the workhorse for many decades in many scientiﬁc and engineering applications ranging from wind power, weather forecasting, and aircraft design. Recently, data-driven models are increasingly becoming popular in many branches of science and engineering due to their non-intrusive nature (i.e., they are equationfree) and online learning capability. Despite the robust performance of data-driven models, they are faced with challenges of poor generalizability and diﬃculty in interpretation. These challenges have encouraged the integration of physics-based models with data-driven models, herein denoted hybrid analysis and modeling (HAM). We propose two diﬀerent frameworks under the HAM paradigm for applications relevant to wind energy in order to bring the physical realism within emerging digital twin technologies. The physics-guided machine learning (PGML) framework reduces the uncertainty of neural network predictions by embedding physics-based features from a simpliﬁed model at intermediate layers and its performance is demonstrated for the aerodynamic force prediction task. Our results show that the proposed PGML framework achieves approximately 75\% reduction in uncertainty for smaller angle of attacks. The interface learning (IL) framework illustrates how diﬀerent solvers can be coupled to produce a multiﬁdelity model and is successfully applied for the Boussinesq equations that govern a broad class of transport processes. The IL approach paves the way for seamless integration of multi-scale, multi-physics and multi-ﬁdelity models (M 3 models).},
	language = {en},
	number = {1},
	urldate = {2026-07-23},
	journal = {Journal of Physics: Conference Series},
	author = {Pawar, Suraj and Ahmed, Shady E. and San, Omer and Rasheed, Adil},
	month = sep,
	year = {2021},
	pages = {012031},
	file = {Pawar_2021_Hybridanalysisa_5c7c6:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Pawar_2021_Hybridanalysisa_5c7c6.pdf:application/pdf},
}

@inproceedings{naing_data-driven_2021,
	address = {Virtual Event USA},
	title = {Data-driven {Microscopic} {Traffic} {Modelling} and {Simulation} using {Dynamic} {LSTM}},
	isbn = {978-1-4503-8296-0},
	url = {https://dl.acm.org/doi/10.1145/3437959.3459258},
	doi = {10.1145/3437959.3459258},
	abstract = {With the increasing popularity of Digital Twin, there is an opportunity to employ deep learning models in symbiotic simulation system. Symbiotic simulation can replicate multiple what-if simulation instances from its real-time reference simulation (base simulation) for short-term forecasting. Hence, it is a useful tool for just-in-time decision making process. Recent trends on symbiotic simulation studies emphasize on its combination with machine learning. Despite its success and usefulness, very few works focus on application of such a hybrid system in microscopic traﬃc simulation. Existing application of machine (deep) learning models in microscopic traﬃc simulation is conﬁned to either predictive analysis or oﬄine simulation-based prescriptive analysis. Thus, there is also lack of work on updating parameters of a deep learning model dynamically for real-time traﬃc simulation. This is necessary if the learning-based model is to be used as part of the base simulation so that "Just-in-time (JIT)" what-if simulation initialized from the model can make better short-term forecasts. This paper proposes a data-driven modelling and simulation framework to dynamically update parameters of Long Short-term Memory (LSTM) for JIT microscopic traﬃc simulation. Extensive experiments were carried out to demonstrate its eﬀectiveness in terms of more accurate short-term forecasting than other baseline models.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {Proceedings of the 2021 {ACM} {SIGSIM} {Conference} on {Principles} of {Advanced} {Discrete} {Simulation}},
	publisher = {ACM},
	author = {Naing, Htet and Cai, Wentong and Hu, Nan and Wu, Tiantian and Yu, Liang},
	month = may,
	year = {2021},
	pages = {1--12},
	file = {Naing_2021_DatadrivenMicro_039af:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Naing_2021_DatadrivenMicro_039af.pdf:application/pdf},
}

@article{ni_improving_2021,
