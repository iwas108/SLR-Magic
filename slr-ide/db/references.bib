@article{christopher_ai-augmented_2026,
	title = {{AI}-augmented digital twin framework for predictive thermo-mechanical degradation monitoring in solid oxide fuel cell {Stacks}: {Integration} of multi-physics models and uncertainty quantification},
	volume = {52},
	issn = {02728842},
	shorttitle = {{AI}-augmented digital twin framework for predictive thermo-mechanical degradation monitoring in solid oxide fuel cell {Stacks}},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0272884225031657},
	doi = {10.1016/j.ceramint.2025.07.004},
	abstract = {Solid oxide fuel cells (SOFCs) are important for sustainable energy systems, even if their ef ciency and longevity are limited by thermo-mechanical damage such delamination and creep. Current monitoring methods are reactive and need a lot of processing power to make predictions in real time. This study presents the rst digital twin framework that combines physics-informed neural networks (PINNs), Bayesian uncertainty quanti cation (UQ), and federated learning (FL) for real-time, uncertainty-aware SOFC degradation control. This lls in important gaps in predictive maintenance for high-temperature energy systems. Compared to nite element analysis (FEA), physics-informed neural networks (PINNs) sped up multi-physics simulations by 90 \% while keeping the error margin for stress predictions to 5 \%. Bayesian uncertainty quanti cation indicated that thermal expansion coef cients were the main source of the variation and giving 95 \% con dence ranges for how cracks may spread. FL was able to nd delamination in distant SOFC devices with 85 \% accuracy using strain-voltage covariance thresholds (Table 4) without having to share data with a central location. This was a rst in the industry that protected privacy. An industrial evaluation showed that interfacial stress dropped by 23 \%, the lifespan went raised from 4.2 to 5.1 years, and maintenance expenses were down by 30 \% when the loads were dynamic. Reinforcement learning-based temperature management reduced thermal gradients by 18 \%, which helped prevent failures caused by fatigue. This full integration of multi-physics accuracy, distributed intelligence, and uncertainty quanti cation sets a new standard for energy infrastructure that doesn’t use fossil fuels. Validation on a representative commercial SOFC con guration showed that interfacial stress dropped by 23 \%.},
	language = {en},
	number = {1},
	urldate = {2026-07-23},
	journal = {Ceramics International},
	author = {Christopher, George Gershom and Olalekan, Olajide Rasheed and Huguette Maeva, Monkam Ngameni and Hassan, Butera and Sayed, Hassan A.A.},
	month = jan,
	year = {2026},
	pages = {10--22},
	file = {Christopher_2026_AIaugmenteddigi_cd3fa:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Christopher_2026_AIaugmenteddigi_cd3fa.pdf:application/pdf},
}

@inproceedings{jing_digital_2026,
	address = {Tuticorin, India},
	title = {A {Digital} {Twin}–{Oriented} {Predictive} {Maintenance} {Method} using {Dual}-{Stage} {Reinforcement} {Learning} and {Multi}-{Sensor} {Data} {Fusion}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-4881-0},
	url = {https://ieeexplore.ieee.org/document/11416767/},
	doi = {10.1109/ICEARS67481.2026.11416767},
	abstract = {As complex industrial equipment evolves towards higher precision, higher reliability, and longer lifespan, predictive maintenance methods are gradually shifting from single fault prediction to integrated "prediction-decisionfeedback" modeling. However, in reality, existing methods still have serious shortcomings in the system coupling of predictive models and maintenance decisions, causal modeling of multisource heterogeneous data, and long-term value optimization of maintenance strategies. To address these issues, this paper proposes a two-stage reinforcement learning predictive maintenance method for digital twins (DT–DSRL-PM). This algorithm uses a digital twin model as its core carrier to construct a closed-loop predictive maintenance framework that integrates multi-source sensor data fusion, causal risk modeling, joint reasoning of remaining life and risk, and maintenance decision optimization. At the modeling level, this paper introduces a multi-timescale sliding embedding mechanism. This mechanism can help achieve a unified representation of heterogeneous sensor data such as vibration, temperature, current, and visual defects. Simultaneously, an extended Granger causality index and a risk-weighted mechanism are used to characterize the dynamic causal driving relationship between potential fault features and defect evolution. At the core inference level, this study constructs parallel risk trajectories and combines them with Bayesian updates to estimate the remaining lifetime interval. At the decision-making level, this study designs a maintenance prioritization model based on OEE marginal contributions and proposes a two-stage reinforcement learning strategy. In real-world scenarios, these strategies are used for maintenance object selection (SRL-1) and maintenance execution timing and resource scheduling optimization (SRL-2), respectively. Experimental results show that after introducing risk-weighted causal modeling, the false causality rate under high-risk conditions is reduced by approximately 18.6\%, and the convergence speed of RUL interval prediction is improved by approximately 23\%. Meanwhile, at the system level, compared with the fixed-period maintenance strategy, DT–DSRL-PM steadily improved OEE to the range of 0.89–0.92 in the later stages of the experiment. Simultaneously, the overall improvement was approximately 14.7\%, and unplanned downtime was reduced by a cumulative 31.5\%. Maintenance preparation time was shortened by 16.8\%, and maintenance resource utilization was improved by 12.3\%.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 {International} {Conference} on {Electronics} and {Renewable} {Systems} ({ICEARS})},
	publisher = {IEEE},
	author = {Jing, Sun},
	month = feb,
	year = {2026},
	pages = {1575--1582},
	file = {Jing_2026_ADigitalTwinOri_450ce:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Jing_2026_ADigitalTwinOri_450ce.pdf:application/pdf},
}

@article{nikolakis_physics-aware_nodate,
	title = {A {Physics}-{Aware} {Latent} {Diffusion} {Framework} for {Mitigating} {Adversarial} {Perturbations} in {Manufacturing} {Quality} {Control}},
	abstract = {Data-driven quality control (QC) systems for the hot forming of steel parts increasingly rely on deep learning models deployed at the network edge, making multivariate sensor time series a critical asset for both local decisions and management information system (MIS) reporting. However, these models are vulnerable to adversarial perturbations and realistic signal disturbances, which can induce misclassiﬁcation and distort key performance indicators (KPIs) such as ﬁrst-pass yield (FPY), scrap-related losses, and latency service-level objectives (SLOs). To address this risk, this study introduces a Digital-Twin-Conditioned Diffusion Puriﬁcation (DTCDP) framework that constrains latent diffusion-based denoising using process states from a lightweight digital twin of the hot-forming line. At each reverse-denoising step, the twin provides physics residuals that are converted into a scalar penalty, and the diffusion latent is updated with a guidance term. This directly bends the sampling trajectory toward reconstructions that adhere to process constraints while removing adversarial perturbations. DTCDP operates as an edge-side preprocessing module that puriﬁes sensor sequences before they are consumed by existing long short-term memory (LSTM)-based QC models, while exposing puriﬁcation metadata and physics-guidance diagnostics to the plant MIS. In a four-week production dataset comprising more than 40,000 bars, with white-box ℓ∞ attacks crafted on multivariate sensor time series using Fast Gradient Sign Method and Projected Gradient Descent at perturbation budgets of 1–3\% of the physical range, combined with additional realistic disturbances, DTCDP improves the robust classiﬁcation performance of an LSTM-based QC model from 61.0\% to 81.5\% robust accuracy, while keeping clean accuracy (≈93\%) and FPY on clean data (≈97\%) essentially unchanged. These results indicate that physics-aware, digital-twin-guided diffusion puriﬁcation can enhance the adversarial robustness of edge QC in hot forming without compromising operational KPIs.},
	language = {en},
	author = {Nikolakis, Nikolaos and Catti, Paolo},
	file = {Nikolakis_2026_APhysicsAwareLa_5d5f0:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Nikolakis_2026_APhysicsAwareLa_5d5f0.pdf:application/pdf},
}

@inproceedings{pouya_real-time_2026,
	address = {Orlando, FL, USA},
	title = {A {Real}-{Time} {Resistance} {Monitoring} {Architecture} for {Prognostics} and {Health} {Management} of {Electronic} {Packages}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-6417-9},
	url = {https://ieeexplore.ieee.org/document/11561299/},
	doi = {10.1109/ECTC51846.2026.00247},
	abstract = {This paper presents a real-time resistance monitoring architecture for Prognostics and Health Management (PHM) of electronic packages under thermal cycling. The system integrates automated daisy-chain resistance acquisition, SQLbased time-series storage, and a live prediction service that estimates the probability of failure within a configurable future horizon using resistance-only input. A horizon-based forecasting formulation converts sequential resistance measurements into continuously updated probabilistic risk estimates, enabling early warning prior to conventional threshold-based open-circuit detection. Operating on a two-minute cadence across 768 channels with approximately 75 seconds end-to-end latency, the architecture demonstrates scalable multi-channel monitoring. By separating acquisition, storage, prediction, and notification into modular services, the framework establishes a deployable PHM pipeline rather than an offline predictive model, bridging accelerated reliability testing and operational PHM workflows. The modular architecture also provides a practical healthmonitoring and predictive layer for digital twin oriented representations of electronic packages, enabling integration of synchronized sensing, time-series storage, and probabilistic forecasting without claiming full physics-based digital twin simulation.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2026 {IEEE} 76th {Electronic} {Components} and {Technology} {Conference} ({ECTC})},
	publisher = {IEEE},
	author = {Pouya, Shaheen and Rahgouy, Mostafa and Hamasha, Sa’d and Suhling, Jeffrey C.},
	month = may,
	year = {2026},
	pages = {1506--1513},
	file = {Pouya_2026_ARealTimeResist_4b505:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Pouya_2026_ARealTimeResist_4b505.pdf:application/pdf},
