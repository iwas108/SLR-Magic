@inproceedings{alzubi_digital_2025,
	address = {Vienna, Austria},
	title = {The {Digital} {Farmer} {Agents} in {Precise} and {Sustainable} {Agricultural} {Ecosystems}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9409-1},
	url = {https://ieeexplore.ieee.org/document/11391213/},
	doi = {10.1109/FLLM67465.2025.11391213},
	abstract = {ÐAgentic artiﬁcial intelligence is shifting precision agriculture from descriptive analytics to coordinated, goaldirected decision making. This paper presents Digital Farmer Agents (DFAs), goal-conditioned planning agents that combine inﬁeld IoT telemetry, weather forecasts, and satellite indicators with a calibrated farm digital twin to schedule irrigation, fertilization, pest management, and crop rotation under operational and environmental limits. Each agent solves a multi-objective problem that balances yield with water and nutrient efﬁciency, enforces policy constraints such as seasonal allocations, nitrate thresholds, and yield-scaled greenhouse gas caps, and produces concise, human-auditable rationales for proposed actions. The framework is evaluated on multi-season, real-world data integrating soil moisture, canopy temperature, meteorology, vegetation indices, and management logs, including TERRA-REF/Maricopa phenotyping products and a public IoT telemetry set with pump states. To probe edge conditions, we augment evaluation with a digital-twin dataset that is explicitly marked as simulated and used for counterfactual stress tests of heat, drought, and policy shocks. Results are consistent across wheat and rice. Yield prediction accuracy improves over strong machine learning baselines. Water use per unit yield declines. Fertilizer intensity is reduced. Robustness to climate variability increases through proactive re-planning and closed-loop feedback. Methodologically, the work integrates a distributed multi-agent architecture, a digital-twin-in-the-loop training and evaluation workﬂow that fuses sensing, simulation, and optimization, and an interpretable multi-objective formulation aligned with sustainability targets and farmer constraints. Case studies illustrate clear whatif analyses, quantiﬁed trade-offs, and transfer to data-scarce plots where simulation accelerates learning. Coupling agentic planning with calibrated digital twins and human oversight offers a practical path to precise, resource-efﬁcient, and climateresilient agricultural ecosystems and points to how agentic AI can underpin the next generation of intelligent food systems.},
	language = {en},
	urldate = {2026-07-23},
	booktitle = {2025 3rd {International} {Conference} on {Foundation} and {Large} {Language} {Models} ({FLLM})},
	publisher = {IEEE},
	author = {AlZu’bi, Shadi and Mughaid, Ala},
	month = nov,
	year = {2025},
	pages = {202--209},
	file = {AlzuBi_2025_TheDigitalFarme_818ad:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\AlzuBi_2025_TheDigitalFarme_818ad.pdf:application/pdf},
