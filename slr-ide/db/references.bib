@inproceedings{rajput_finance-oriented_2025,
	address = {Bhopal, India},
	title = {Finance-{Oriented} {Modelling} of {Energy} and {Reliability} {Trade}-{Offs} in {Smart} {Home} {Automation}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-9126-7},
	url = {https://ieeexplore.ieee.org/document/11507532/},
	doi = {10.1109/RCSM67767.2025.11507532},
	abstract = {The systems of Smart-home energy are using in variable loads, distributed renewables and changing power costs. However, present automation frameworks have trouble handling multimodal data, financial risk, and dependability when things are unclear. This divide makes it harder for homes to run smoothly when the market is unstable or when devices go down. The goal of this project was to create and test a smart home energy management model that focuses on finance and reliability and can use different types of data to make better decisions. We created an experimental framework that combines multimodal inputs (like load, PV, EV, occupancy, weather, and market prices), long-sequence probabilistic forecasting using AutoFormer-TS/Informer models, a GNNbased device encoder, and a differentiable constrained RL optimizer with CVaR-based risk control. The system was trained and tested using data that was accessible to the public, as well as on digital-twin simulations. It was then put into use in both centralized and federated learning environments. The results demonstrate that the suggested model cuts forecasting error to 2–5\% MAPE, decreases home energy costs by around 25\%, and raises reliability (Pmeet) to over 99.4\%, beating both rule-based and hybrid baselines. Computational study also shows that a distilled edge version performs almost perfectly while using a lot less FLOPs and GPU-hours. In general, the outcomes of the study about the risk-sensitive optimization, finance-aware with device-graph modelling and multimodal forecasting makes the operations more reliable and the economy more efficient. This study shows all the possible approaches to create smart-home automation for future development.},
