@article{yu_deep_2023,
	title = {Deep learning and {IoT} enabled digital twin framework for monitoring open-pit coal mines},
	volume = {11},
	issn = {2296-598X},
	url = {https://www.frontiersin.org/articles/10.3389/fenrg.2023.1265111/full},
	doi = {10.3389/fenrg.2023.1265111},
	abstract = {Early detection of cracks enables timely mitigation and maintenance actions, ensuring the safety of personnel and equipment within the open-pit coal mine. Monitoring open-pit coal mines and cracks is essential for the safety of workers and for saving national assets. Digital twins (DTs) can be crucial in open-pit coal mine crack detection. DTs enable continuous real-time monitoring of the open-pit mine, including its structures and surrounding environment. Various sensors and internet-of-things devices can be deployed to collect data on factors such as ground movement and strain. Integrating this data into the DT makes it possible to identify and analyze anomalous behavior or changes that may indicate crack formation or propagation. Deep learning-based networks are a crucial factor in detecting open-pit coal mine cracks. In this work, we propose a deep learning-based densely connected lightweight network incorporated into the DT-based framework for detecting cracks and taking predictive maintenance-based decisions by combining historical data, real-time sensor data, and predictive models. The proposed DT-based framework provides insights into the potential crack formation, allowing for proactive maintenance and mitigation measures. We compare the performance of our proposed network on different evaluation measures such as precision, recall, overall accuracy, mean average precision, F1-score, and kappa coefficient, where our proposed lightweight multiscale feature fusion-based network outperformed all other state-of-the-art deep neural networks. We also achieved the best performance on mean average precision by surpassing all other models. Additionally, we also compared the performance of our proposed network with U-Net and recurrent neural network on model training and prediction time benchmarks by outperforming those cutting-edge models.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Frontiers in Energy Research},
	author = {Yu, Rui and Yang, Xiuyu and Cheng, Kai},
	month = oct,
	year = {2023},
	pages = {1265111},
	file = {Yu_2023_Deeplearningand_28272:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Yu_2023_Deeplearningand_28272.pdf:application/pdf},
}

@article{meng_prediction_2023,
	title = {Prediction of fault evolution and remaining useful life for rolling bearings with spalling fatigue using digital twin technology},
	volume = {53},
	issn = {0924-669X, 1573-7497},
	url = {https://link.springer.com/10.1007/s10489-023-05010-8},
	doi = {10.1007/s10489-023-05010-8},
	abstract = {Quantifying fault severity is a critical part of rolling bearing health management. There are numerous methods for evaluating the severity of rolling bearing faults that utilize various signals to predict the remaining useful life (RUL). However, the fault severity assessment methods based on digital twins still cannot accurately track the fault evolution. To address this issue, this paper proposes a data/physics-driven digital twin model for predicting the RUL of rolling bearings. Firstly, using theoretical damage mechanics, the evolution of fatigue damage of rolling bearings throughout their entire life cycle is described, for which a spalling fatigue evolution model is constructed. Secondly, fatigue defects predicted by the spalling fatigue evolution model are introduced into a dynamic model to construct a bearing high-ﬁdelity model. Thirdly, a local-to-global dynamic updating framework is designed for the interactive coupling of real-time monitoring data of rolling bearings and corresponding simulated data, as well as updating the high-ﬁdelity model parameters. Finally, a neural network is used to predict the RUL of rolling bearings. The approach is veriﬁed using test data of rolling bearings. The results demonstrate that the proposed digital twin model can more accurately address the problem of RUL prediction of rolling bearings.},
	language = {en},
	number = {23},
	urldate = {2026-07-23},
	journal = {Applied Intelligence},
	author = {Meng, Weiying and Wang, Yutong and Zhang, Xiaochen and Li, Sihui and Bai, Xu and Hou, Lingling},
	month = dec,
	year = {2023},
	pages = {28611--28626},
	file = {Meng_2023_Predictionoffau_66658:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Meng_2023_Predictionoffau_66658.pdf:application/pdf},
}

@article{kumar_vibration_2023,
	title = {Vibration signal-based fault prediction using few-shot learning in the digital twin ecosystem},
	volume = {2023},
	issn = {2732-4494},
	url = {http://digital-library.theiet.org/doi/10.1049/icp.2023.2906},
	doi = {10.1049/icp.2023.2906},
	abstract = {The current era is the era of digital transformation. Various concepts such as Cyber-Physical Systems, digital twins, etc. are proposed to implement this transformation. A digital twin is a virtual replica that can monitor and predict the state of any asset or process enabling the use of various cutting-edge technologies. A digital twin has a variety of applications. Maintenance is one area where digital twins are actively used for predictive maintenance. To work efficiently a real time data collection mechanism is required. Also, it may not always feasible to capture and train large data sets for Machine learning models due to the cost and other limitations associated with it. In this paper, a digital twin is created using OPCUA server. Digital Twin captures the data from the IoT sensors with the help of various protocols. This data is intelligently analyzed with various machine learning algorithms built into the digital twin to monitor health status. Few-shot learning, an algorithm in which a machine learning model can learn with a limited amount of data and perform reasonably accurately is used. For this study, a rotary asset is explored for fault prediction. The vibration signals are converted into 2D images which are then trained on CNN models using the Siamese Neural Networks method. The performed analysis proven to be very effective in various fault classifications. The knowledge gained through few-shot learning remains with digital twins to monitor similar kinds of newly added assets without any much training.},
