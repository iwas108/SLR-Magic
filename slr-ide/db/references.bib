	abstract = {Household energy usage can be actively managed by home users through the smart grid, utilizing the Home Energy Management (HEM) system. Within the framework of a demand response program, the HEM system adjusts the ON/OFF states and operations of household devices to minimize energy costs and peak loads. This involves addressing a constrained multi-objective optimization problem that includes integer decision parameters. Two de3ciencies exist in current methods for scheduling domestic device operation. Firstly, user satisfaction is often overlooked, and secondly, there is a lack of an effective global optimization algorithm to solve the problem. In this study, the optimization of domestic appliance planning in the HEM system is conceptualized as a constrained multi-objective optimization problem, employing the Improved Whale Optimization Algorithm (IWOA). Ten different case studies are conducted to determine the optimal planning of devices based on various demand response programs. Two smart houses, each with 10 and 11 devices, including electric vehicles as signi3cant domestic loads, are considered. To accurately estimate the total load demand, a Long-Short Term Memory (LSTM) model is employed for predicting smart building load demand. The system’s validity and model performance are assessed by applying results to the digital twin of the smart building and later to the real test system. Simulation results indicate that the proposed framework outperforms conventional algorithms such as WOA, PSO, DEA, and dragon8y algorithms. The paper thoroughly explores the impact of weight factors on houses’ optimal energy costs and user satisfaction within the suggested multi-objective approach.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Sustainable Energy Technologies and Assessments},
	author = {Li, Wei and Xu, Xian},
	month = may,
	year = {2024},
