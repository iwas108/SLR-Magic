@article{ji_real-time_2026,
	title = {Real-time backpressure optimization for direct air-cooled units driven by digital twin technology and adversarial reinforcement learning},
	volume = {351},
	issn = {03605442},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0360544226009606},
	doi = {10.1016/j.energy.2026.140857},
	abstract = {To support China’s carbon peaking and carbon neutrality goals, thermal power plants must perform peak shaving efficiently. Cold-end backpressure optimization is key to unit economy but is challenged by uncertainty, multi-objective constraints, and real-time requirements. This study proposes a closed-loop optimization framework that couples digital twin technology with deep reinforcement learning for backpressure setpoint optimization. A condenser dynamic model is formulated using sparse identification of nonlinear dynamics, and its coefficients are recursively corrected using forgetting factor recursive least squares with hard-threshold sparsification to track time-varying behavior and reduce modeling error. The condenser model is integrated with a turbine thermodynamic model to form a hybrid digital twin model that balances fidelity and computational speed. Twin delayed deep deterministic policy gradient is enhanced with a generative adversarial discriminator to guide policy exploration while maintaining exploitation of high-value operating regions. Tests on a 600 MW subcritical direct air-cooled unit show reduced backpressure simulation deviation and approximately 70\% lower single-step simulation time versus a conventional mechanistic model. Across seasons, the framework achieves higher economic benefits than benchmark methods while meeting minute-level industrial real-time constraints, providing a practical pathway for the cold-end optimization.},
	language = {en},
	urldate = {2026-07-23},
	journal = {Energy},
	author = {Ji, Litao and Yan, Gaowei and Liu, Hongyue and Zhu, Zhujun and Xu, Jing and Ma, Suxia},
