}

@inproceedings{nasri_machine_2026,
	address = {Muscat, Oman},
	title = {Machine {Learning}-{Based} {Fault} {Classification} for {KPCA} {Digital} {Twin} {Model} {Predictive} {Control} in {Autonomous} {Vehicles}},
