	doi = {10.1016/j.ifacol.2025.12.150},
	abstract = {The integration of predictive industrial agents into Industry 4.0 (I4.0) systems offers new possibilities for adaptive learning and intelligent control in industrial and educational contexts. This paper presents a framework leveraging predictive agents, developed using the Python Agent Development Environment (PADE), embedded within programmable logic controllers (PLCs) to enhance the predictability and interoperability of digital twin (DTs) environments. By incorporating Asset Administration Shells (AAS) and adhering to IEC 61131-3 and IEC 61499 standards into the various PLCs, the system enables seamless communication and integration between flexible manufacturing cells in a remotely operated I4.0 laboratory. The predictive agents utilize supervised learning algorithms to forecast operational outcomes and optimize system performance, adapting dynamically to process requirements. Experimental results demonstrate the framework¥s ability to enhance interoperability, and usability. Additionally, the proposed system addresses the educational gap by equipping engineering students with practical experience in predictive control and industrial standards. This research advances the field of intelligent adaptive control systems and highlights the potential of integrating predictive agents with digital twins by agentbased AAS to meet the evolving demands of I4.0.},
	language = {en},
	number = {14},
