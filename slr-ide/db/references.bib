	title = {[{No} title found]},
	isbn = {978-1-6654-6399-7},
	abstract = {To overcome the limitations of passive responsive control in smart highways, such as decision-making delays and inefficient resource allocation, this study proposes a digital twin (DT)-driven proactive operational control framework. The framework integrates real-time Internet of Things (IoT) sensing data, historical traffic flow, and high-precision Geographic Information System (GIS)/Building Information Modeling (BIM) models to construct a dynamic digital twin. Multi-scale simulation (macro-scale cell transmission model, meso-scale car-following model, and micro-scale reinforcement learning-based behavior model) enables traffic state prediction and incident evolution analysis. Leveraging Vehicle-to-Everything (V2X) technology, a vehicle-road-cloud collaboration mechanism is established: roadside units (RSUs) collect real-time vehicle trajectories and anomaly event data, while the digital twin generates strategies such as congestion warnings, dynamic speed limits, and route guidance. These strategies are disseminated via a Quality of Service (QoS) prioritization mechanism based on the IEEE 802.11p protocol, ensuring critical command latency below 50 ms. A mixed-integer programming model jointly optimizes traffic efficiency and safety objectives, with decision variables covering speed limits, ramp control, and guidance information, while constraints incorporate V2X communication bandwidth and vehicle dynamics. Validation on a 53 km smart highway testbed demonstrated a full-process latency reduction to 65 ms, a 17.3\% increase in average speed, a 34.7\% decrease in emergency braking incidents, and 95.6\% of command delays below 82 ms. The results confirm that the framework achieves a "prediction-decision-execution" closed loop, significantly enhancing proactive intervention capabilities.},
	language = {en},
	booktitle = {2022 4th {International} {Conference} on {Artificial} {Intelligence} and {Advanced} {Manufacturing} ({AIAM})},
	publisher = {IEEE},
