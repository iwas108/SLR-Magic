	file = {Ren_2023_AnEdgeFogCloudC_54bbe:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Ren_2023_AnEdgeFogCloudC_54bbe.pdf:application/pdf},
}

@inproceedings{jharko_digital_2023,
