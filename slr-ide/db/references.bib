@article{xiang_topology-cognizant_2026,
	title = {Topology-{Cognizant} {Machine} {Learning} for {Multiparameter} {Estimation} and {Digital} {Twin} of {LLC} {Resonant} {Converters}},
	volume = {14},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {2168-6777, 2168-6785},
	url = {https://ieeexplore.ieee.org/document/11363425/},
	doi = {10.1109/JESTPE.2026.3657716},
	abstract = {System parameters, particularly those within the resonant tank, fundamentally govern the converter’s dynamic behavior and operational performance of LLC resonant converters. Accurate estimation of these system parameters is essential for enabling real-time condition monitoring, high-eﬃciency operation, and advanced model-based control of LLC resonant converters. However, due to strong parameter coupling, high system nonlinearity, and unobservable topology transitions, performing accurate multiparameter estimation for LLC converters remains considerably challenging and has rarely been eﬀectively solved in existing works. To address this issue, this study proposes a topology-cognizant machine learning (TCML), which explicitly embeds the converter’s discrete-time topology-dependent dynamics into a neural network architecture. In contrast to conventional physics-informed neural network (PINN), TCML introduces a semi-supervised data-reconstruction mechanism to infer system states at unobservable topological transitions, enabling consistent supervision across discontinuous dynamic regimes. This physics-guided structure compels the network to jointly satisfy observed data consistency and converter-speciﬁc physical laws, thereby achieving high-accuracy multiparameter identiﬁcation under a data sampling conﬁguration compatible with commonly used microcontroller units (MCUs). Furthermore, the proposed method oﬀers additional advantages, including reduced reliance on accurate parameter preestimation, nanosecond-scale digital twin (DT) capability, and online implementation. The eﬀectiveness is veriﬁed through both simulations and experiments.},
	language = {en},
	number = {2},
	urldate = {2026-07-23},
	journal = {IEEE Journal of Emerging and Selected Topics in Power Electronics},
	author = {Xiang, Yangxiao and Yuan, Weiting and Du, Xiong and Xie, Zhuojun and Chen, Yunzhi and Lin, Hongjian and Liu, Chaoran and Zhang, Yechi},
	month = apr,
	year = {2026},
	pages = {1668--1684},
	file = {Xiang_2026_TopologyCogniza_e3a40:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Xiang_2026_TopologyCogniza_e3a40.pdf:application/pdf},
}

@inproceedings{b_cloud-fog_2026,
	address = {Coimbatore, India},
	title = {A {Cloud}-{Fog} {Digital} {Twin} {Framework} for {Intelligent} and {Scalable} {Structural} {Health} {Monitoring}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-4596-3},
	url = {https://ieeexplore.ieee.org/document/11448025/},
	doi = {10.1109/ICISCoIS62701.2026.11448025},
	abstract = {Structural Health Monitoring (SHM) is critical for guaranteeing the safety and long-term operation of civil infrastructure. cDTSHM, Cloud-Fog Digital Twin Framework proposed in this work for real-time monitoring and preventive maintenance, maps physical and virtual structures bidirectionally using fog computing to limit data transfer and computation requirements. Deep learning (DL) models have been applied to the structural damage detection with an accuracy of 92\% for bridge case studies. Still, issues exist, including DL model accuracy, the lack of abundant labeled damage data, and inadequate ﬂexibility to unexpected defects. Statistical models are used as baselines to oppose them, and SHM data are supplemented with 3D numerical simulations of various damage levels. A hybrid data approach is used by integrating FEM-synthetic data with hierarchical feature learning for the purpose of maximizing efﬁciency. Though promising, the application of pre-deﬁned damage classes and vibration sensing limits localization of localized defects by the system. Future work will explore the implementation of unsupervised learning, incorporate optical ﬁber sensors to enable enhanced localization, and determine long-term scalability and robustness of cDTSHM for green infrastructure monitoring.},
