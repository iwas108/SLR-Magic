@inproceedings{ali_deep_2026,
	address = {Dubai, United Arab Emirates},
	title = {A {Deep} {Learning} and {Digital} {Twin} {Architecture} for {Intelligent} {Demand} {Response} in {Smart} {Grids}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-4531-4},
	url = {https://ieeexplore.ieee.org/document/11565446/},
	doi = {10.1109/ICIICE69672.2026.11565446},
	abstract = {The rapid growth of renewable generation and electric mobility introduces substantial uncertainty into modern power systems, requiring demand-response (DR) strategies that are both intelligent and physically reliable. This paper proposes DR-DL, a uniﬁed deep learning and digital-twin architecture for real-time, adaptive DR in smart grids. Using a high-resolution 100,000-sample operational dataset capturing consumer load, coordinated EV charging, solar/wind proﬁles, and time-varying prices, DR-DL combines multi-horizon probabilistic forecasting (Temporal Fusion Transformers) with a deep reinforcement learning controller to achieve peak-load mitigation, cost-effective load shifting, and constraint-aware EV charging. A physicsinformed digital twin operates in parallel to synchronise grid states, validate control actions, and assess robustness under disturbances. Results show that DR-DL reduces the peak-toaverage ratio by up to 27\%, increases renewable utilization, and eliminates violations of voltage and operational constraints. DRDL also exhibits faster, more stable convergence during learning than conventional deep reinforcement learning baselines, yielding sustained cost savings and improved resilience to abrupt load and generation ﬂuctuations. These results demonstrate a scalable, grid-aware DR solution suitable for practical deployment.},
	language = {en},
	urldate = {2026-07-23},
