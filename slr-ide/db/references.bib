	file = {Xu_2025_IntelligentFaul_1e20c:C\:\\Users\\Aditya Suranata\\Downloads\\github\\SLR-Magic\\slr-ide\\pdf_library\\repo\\default_project\\Xu_2025_IntelligentFaul_1e20c.pdf:application/pdf},
