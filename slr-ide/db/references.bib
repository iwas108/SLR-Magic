@inproceedings{wang_mamba_2025,
	address = {Chongqing, China},
	title = {Mamba {Deep} {Learning}-{Based} {Intelligent} {Energy} {Consumption} {Regulation} and {Sustainable} {Design} for {Digital} {Twin} {Office} {Spaces}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-6028-7},
	url = {https://ieeexplore.ieee.org/document/11405775/},
	doi = {10.1109/FTCS68006.2025.11405775},
	abstract = {Buildings account for approximately 40\% of global energy consumption, presenting significant opportunities for sustainability improvements through intelligent energy management. Traditional building energy prediction models suffer from either limited temporal modeling capabilities or prohibitive computational complexity, hindering their deployment in real-time digital twin applications. This paper proposes a novel Mamba deep learning-based intelligent energy consumption regulation framework integrated with digital twin technology for office spaces. The framework comprises four layers: physical sensing, data processing, model inference, and application services, enabling bidirectional synchronization between physical and virtual environments. We introduce selective state-space models (Mamba) for energy consumption prediction, leveraging their linear-time complexity and superior long-range dependency modeling to achieve both accuracy and efficiency. A multi-objective intelligent regulation strategy combining model predictive control with adaptive reinforcement learning autonomously optimizes HVAC systems, lighting, and ventilation while maintaining occupant comfort. Experimental results on the CU-BEMS dataset demonstrate that the proposed Mamba model achieves 10.7\% lower RMSE compared to Transformer baselines for 24-hour ahead prediction, with 4.2× faster inference speed and 35\% reduced memory consumption. The framework achieves subsystem-specific improvements of 18.3\% for HVAC and 11.8\% for lighting energy prediction, validating its effectiveness for sustainable office space management and demonstrating significant potential for digital twin-based building automation systems.},
	language = {en},
