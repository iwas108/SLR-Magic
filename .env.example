# Copy this file to .env or .env.local to customize host/port bindings.

# Default Host & Port for SLR-IDE
HOSTNAME=0.0.0.0
PORT=3000

# Per-Module Specific Overrides (Optional)
SLR_IDE_HOST=0.0.0.0
SLR_IDE_PORT=3000

INTER_RATER_HOST=0.0.0.0
INTER_RATER_PORT=3001

SLR_VIEWER_HOST=0.0.0.0
SLR_VIEWER_PORT=3002

WORKER_SERVER_HOST=0.0.0.0
WORKER_SERVER_PORT=7291
