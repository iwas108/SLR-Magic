{
  "name": "slr-magic-monorepo",
  "version": "1.2.0",
  "private": true,
  "description": "Systematic Literature Review Magic - SLR-IDE & SLR-Viewer monorepo",
  "scripts": {
    "setup": "node scripts/install-launcher.mjs",
    "mirror:viewer": "node scripts/mirror-to-viewer.mjs",
    "dev:ide": "npm --prefix slr-ide run dev",
    "dev:inter-rater": "npm --prefix inter-rater run dev",
    "dev:viewer": "npm --prefix slr-viewer run dev",
    "start:ide": "npm --prefix slr-ide run start",
    "start:viewer": "npm --prefix slr-viewer run preview",
    "build:viewer": "npm --prefix slr-viewer run build",
    "build:ide": "npm --prefix slr-ide run build",
    "build:all": "npm run mirror:viewer && npm run build:ide && npm run build:viewer",
    "typecheck": "npm --prefix slr-viewer run typecheck"
  },
  "keywords": [
    "systematic-literature-review",
    "slr",
    "prisma",
    "echarts",
    "research"
  ],
  "author": "SLR Magic Team",
  "license": "MIT"
}
